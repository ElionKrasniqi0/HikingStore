@page
@model ConfirmEmailChangeModel
@{
    ViewData["Title"] = Model.Succeeded ? "Email address updated" : "Email change not completed";
    ViewData["NoIndex"] = true;
}

<div class="container-hs">
    <div class="auth-wrap">
        <div class="card-hs">
            @if (Model.Succeeded)
            {
                <div class="auth-icon"><i class="fa-solid fa-check" aria-hidden="true"></i></div>
                <h1>Email address updated</h1>
                <p class="text-muted mb-0">Your new email address is confirmed. Use it the next time you sign in.</p>
                <div class="auth-actions">
                    <a asp-area="" asp-controller="Account" asp-action="Index" class="btn btn-primary">Go to my account</a>
                </div>
            }
            else
            {
                <div class="auth-icon warn"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i></div>
                <h1>Email change not completed</h1>
                <p class="text-muted mb-0">@(Model.StatusMessage ?? "This link has expired or was already used.") Request the change again from your account settings.</p>
                <div class="auth-actions">
                    <a asp-page="./Manage/Email" class="btn btn-primary">Change email</a>
                </div>
            }
        </div>
    </div>
</div>
