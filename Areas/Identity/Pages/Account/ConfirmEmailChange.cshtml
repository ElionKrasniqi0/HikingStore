@page
@model ConfirmEmailChangeModel
@{
    ViewData["Title"] = "Confirm email change";
}

<div class="min-vh-100 d-flex align-items-center justify-content-center bg-light py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-7">
                <!-- Email Change Confirmation Card -->
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                    <!-- Card Header -->
                    <div class="card-header bg-gradient-primary text-white text-center py-4 border-0">
                        <div class="icon-wrapper bg-opacity-20 rounded-circle p-3 mx-auto mb-3">
                            @if (Model.StatusMessage?.Contains("Thank you") == true || Model.StatusMessage?.Contains("confirmed") == true)
                            {
                                <i class="fas fa-check-circle fa-lg text-white"></i>
                            }
                            else
                            {
                                <i class="fas fa-exclamation-circle fa-lg text-white"></i>
                            }
                        </div>
                        <h2 class="h4 fw-bold mb-2">Email Change Confirmation</h2>
                        <p class="mb-0 opacity-75">
                            @(Model.StatusMessage?.Contains("Thank you") == true || Model.StatusMessage?.Contains("confirmed") == true 
                                ? "Email successfully updated" 
                                : "Email change confirmation")
                        </p>
                    </div>

                    <!-- Card Body -->
                    <div class="card-body p-4 text-center">
                        <partial name="_StatusMessage" model="Model.StatusMessage" />
                        
                        @if (Model.StatusMessage?.Contains("Thank you") == true || Model.StatusMessage?.Contains("confirmed") == true)
                        {
                            <div class="mb-4">
                                <div class="success-icon-wrapper mx-auto mb-3">
                                    <i class="fas fa-envelope-check fa-3x text-success"></i>
                                </div>
                                <h3 class="h5 fw-semibold text-dark mb-3">Email Changed Successfully!</h3>
                                <p class="text-muted mb-4">
                                    Your email address has been successfully updated. 
                                    You can now use your new email address to sign in.
                                </p>
                            </div>

                            <div class="d-grid gap-2">
                                <a asp-page="./Login" class="btn btn-primary btn-lg py-3 fw-semibold">
                                    <i class="fas fa-sign-in-alt me-2"></i>Sign In Now
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="mb-4">
                                <div class="warning-icon-wrapper mx-auto mb-3">
                                    <i class="fas fa-exclamation-triangle fa-3x text-warning"></i>
                                </div>
                                <h3 class="h5 fw-semibold text-dark mb-3">Confirmation Issue</h3>
                                <p class="text-muted mb-4">
                                    There was an issue confirming your email change. Please try again or contact support.
                                </p>
                            </div>

                            <div class="d-grid gap-2">
                                <a href="/Home/Contact" class="btn btn-primary btn-lg py-3 fw-semibold">
                                    <i class="fas fa-headset me-2"></i>Contact Support
                                </a>
                                <a href="/" class="btn btn-outline-secondary py-2">
                                    <i class="fas fa-home me-2"></i>Return to Home
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-gradient-primary {
        background: linear-gradient(135deg, #3b5d50 0%, #2d4a3f 100%);
    }

    .icon-wrapper {
        width: 60px;
        height: 60px;
        background: rgba(255, 255, 255, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .success-icon-wrapper {
        width: 100px;
        height: 100px;
        background: rgba(40, 167, 69, 0.1);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .warning-icon-wrapper {
        width: 100px;
        height: 100px;
        background: rgba(255, 193, 7, 0.1);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .btn-primary {
        background: linear-gradient(135deg, #3b5d50 0%, #2d4a3f 100%);
        border: none;
        transition: all 0.3s ease;
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, #2d4a3f 0%, #1e3329 100%);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(59, 93, 80, 0.3);
    }

    .btn-outline-secondary {
        border-color: #dee2e6;
        transition: all 0.3s ease;
    }

    .btn-outline-secondary:hover {
        background-color: #f8f9fa;
        border-color: #adb5bd;
        transform: translateY(-1px);
    }

    .card {
        transition: transform 0.3s ease;
    }

    .card:hover {
        transform: translateY(-5px);
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .card-body {
        animation: fadeIn 0.5s ease-in;
    }
</style>