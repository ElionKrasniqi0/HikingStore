@page
@model LogoutModel
@{
    ViewData["Title"] = "Sign out";
    ViewData["NoIndex"] = true;
    var signedIn = User.Identity?.IsAuthenticated == true;
}

<div class="container-hs">
    <div class="auth-wrap">
        <div class="card-hs">
            @if (signedIn)
            {
                <h1>Sign out</h1>
                <p class="text-muted">Your cart stays saved to your account for next time.</p>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Content("~/")" method="post" data-once>
                    <button type="submit" class="btn btn-primary w-100" data-busy-text="Signing out…">Sign out</button>
                </form>
            }
            else
            {
                <div class="auth-icon"><i class="fa-solid fa-check" aria-hidden="true"></i></div>
                <h1>You're signed out</h1>
                <p class="text-muted mb-0">Thanks for visiting HikingStore.</p>
                <div class="auth-actions">
                    <a asp-page="./Login" class="btn btn-primary">Sign in again</a>
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Keep shopping</a>
                </div>
            }
        </div>
    </div>
</div>
