@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "Set up authenticator app";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h2>Set up authenticator app</h2>

<ol class="steps-list">
    <li>
        <strong>Install an authenticator app</strong> such as Microsoft Authenticator, Google Authenticator or another app that supports time-based codes.
    </li>
    <li>
        <strong>Add HikingStore to the app.</strong> On this phone, <a href="@Model.AuthenticatorUri">open the setup link</a>. On another device, choose "enter a setup key" in the app and type:
        <p class="my-2"><kbd class="fs-6">@Model.SharedKey</kbd></p>
        <span class="small text-muted">Spaces and capital letters don't matter.</span>
    </li>
    <li>
        <strong>Enter the 6-digit code</strong> the app shows:
        <form id="send-code" method="post" class="mt-2" style="max-width:320px" data-once>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <label asp-for="Input.Code" class="form-label">Verification code</label>
            <input asp-for="Input.Code" class="form-control code-input mb-1" autocomplete="one-time-code" inputmode="numeric" />
            <span asp-validation-for="Input.Code" class="text-danger small d-block mb-2"></span>
            <button type="submit" class="btn btn-primary" data-busy-text="Verifying…">Verify</button>
        </form>
    </li>
</ol>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
