@inject SignInManager<ApplicationUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    string? Current(string css) => css == "active" ? "page" : null;
}
<nav aria-label="Security settings">
    <ul class="manage-tabs">
        <li><a class="@ManageNavPages.EmailNavClass(ViewContext)" aria-current="@Current(ManageNavPages.EmailNavClass(ViewContext))" asp-page="./Email">Email</a></li>
        <li><a class="@ManageNavPages.ChangePasswordNavClass(ViewContext)" aria-current="@Current(ManageNavPages.ChangePasswordNavClass(ViewContext))" asp-page="./ChangePassword">Password</a></li>
        @if (hasExternalLogins)
        {
            <li><a class="@ManageNavPages.ExternalLoginsNavClass(ViewContext)" aria-current="@Current(ManageNavPages.ExternalLoginsNavClass(ViewContext))" asp-page="./ExternalLogins">Connected accounts</a></li>
        }
        <li><a class="@ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext)" aria-current="@Current(ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext))" asp-page="./TwoFactorAuthentication">Two-factor</a></li>
        <li><a class="@ManageNavPages.PersonalDataNavClass(ViewContext)" aria-current="@Current(ManageNavPages.PersonalDataNavClass(ViewContext))" asp-page="./PersonalData">Your data</a></li>
    </ul>
</nav>
