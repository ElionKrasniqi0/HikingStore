@page
@model EmailModel
@{
    ViewData["Title"] = "Email address";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<partial name="_StatusMessage" model="Model.StatusMessage" />
<h2>Email address</h2>
<p class="text-muted">You sign in with this address, and we send order updates to it.</p>

<form id="email-form" method="post" data-once>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label">Current email</label>
        <div class="input-group">
            <input asp-for="Email" class="form-control" disabled />
            @if (Model.IsEmailConfirmed)
            {
                <span class="input-group-text text-success"><i class="fa-solid fa-circle-check me-1" aria-hidden="true"></i>Confirmed</span>
            }
            else
            {
                <span class="input-group-text text-warning">Not confirmed</span>
            }
        </div>
        @if (!Model.IsEmailConfirmed)
        {
            <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" formnovalidate class="btn btn-link px-0">Send confirmation email again</button>
        }
    </div>
    <div class="mb-4">
        <label asp-for="Input.NewEmail" class="form-label">New email</label>
        <input asp-for="Input.NewEmail" class="form-control" autocomplete="email" inputmode="email" />
        <span asp-validation-for="Input.NewEmail" class="text-danger small"></span>
        <p class="small text-muted mt-1 mb-0">We'll send a confirmation link to the new address. Nothing changes until you open it.</p>
    </div>
    <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="btn btn-primary" data-busy-text="Sending…">Change email</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
