@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Close account";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h2>Close account</h2>
<div class="alert alert-warning" role="alert">
    <strong>This can't be undone.</strong> Your account, saved cart, wishlist, addresses and reviews will be deleted. Accounts with orders can't be closed online because we have to keep order records; contact us instead.
</div>

<form id="delete-user" method="post" data-once data-confirm="Permanently close your HikingStore account?">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    @if (Model.RequirePassword)
    {
        <div class="mb-3" style="max-width:360px">
            <label asp-for="Input.Password" class="form-label">Confirm with your password</label>
            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Input.Password" class="text-danger small"></span>
        </div>
    }
    <button class="btn btn-danger" type="submit" data-busy-text="Closing account…">Close my account</button>
    <a asp-page="./PersonalData" class="btn btn-outline-secondary ms-2">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
