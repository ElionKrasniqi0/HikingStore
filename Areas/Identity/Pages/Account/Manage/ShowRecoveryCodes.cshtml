@page
@model ShowRecoveryCodesModel
@{
    ViewData["Title"] = "Recovery codes";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h2>Recovery codes</h2>
<div class="alert alert-warning" role="alert">
    <strong>Save these codes somewhere safe now.</strong> They're shown only once. If you lose your phone, each code lets you sign in one time.
</div>
<ul class="recovery-codes">
    @foreach (var code in Model.RecoveryCodes)
    {
        <li><code>@code</code></li>
    }
</ul>
<a asp-page="./TwoFactorAuthentication" class="btn btn-primary mt-2">Done</a>
