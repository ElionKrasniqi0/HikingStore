@page
@model GenerateRecoveryCodesModel
@{
    ViewData["Title"] = "New recovery codes";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h2>New recovery codes</h2>
<p class="text-muted">Generating new codes makes all your old recovery codes stop working. Your authenticator app keeps working as before.</p>
<form method="post" data-once data-confirm="Replace your recovery codes? The old ones will stop working.">
    <button class="btn btn-primary" type="submit" data-busy-text="Generating…">Generate new codes</button>
</form>
