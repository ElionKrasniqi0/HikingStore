@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Your data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h2>Your data</h2>
<p class="text-muted">Download a copy of the personal information stored with your account, or close your account. See our <a asp-area="" asp-controller="Home" asp-action="Privacy">privacy policy</a> for details.</p>

<div class="d-flex flex-column gap-4">
    <div>
        <h3 class="h6">Download</h3>
        <p class="small text-muted">A JSON file with your profile details and sign-in information.</p>
        <form id="download-data" asp-page="DownloadPersonalData" method="post">
            <button class="btn btn-outline-secondary" type="submit"><i class="fa-solid fa-download me-2" aria-hidden="true"></i>Download my data</button>
        </form>
    </div>
    <div>
        <h3 class="h6">Close account</h3>
        <p class="small text-muted">Permanently deletes your account, saved cart, wishlist and addresses.</p>
        <a id="delete" asp-page="DeletePersonalData" class="btn btn-outline-danger">Close my account</a>
    </div>
</div>
