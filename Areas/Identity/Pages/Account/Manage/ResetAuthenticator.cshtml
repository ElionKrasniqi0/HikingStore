@page
@model ResetAuthenticatorModel
@{
    ViewData["Title"] = "Reset authenticator key";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h2>Reset authenticator key</h2>
<div class="alert alert-warning" role="alert">
    Resetting the key turns off two-factor authentication. Your current authenticator app will stop working until you set it up again with the new key.
</div>
<form id="reset-authenticator-form" method="post" data-once>
    <button id="reset-authenticator-button" class="btn btn-danger" type="submit" data-busy-text="Resetting…">Reset key</button>
    <a asp-page="./TwoFactorAuthentication" class="btn btn-outline-secondary ms-2">Cancel</a>
</form>
