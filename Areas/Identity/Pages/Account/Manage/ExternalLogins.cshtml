@page
@model ExternalLoginsModel
@{
    ViewData["Title"] = "Connected accounts";
    ViewData["ActivePage"] = ManageNavPages.ExternalLogins;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h2>Connected accounts</h2>
<p class="text-muted">Sign in to HikingStore with an account you already have.</p>

@if (Model.CurrentLogins?.Count > 0)
{
    <ul class="list-unstyled d-flex flex-column gap-2 mb-4">
        @foreach (var login in Model.CurrentLogins)
        {
            <li class="d-flex align-items-center justify-content-between gap-3 border rounded p-3">
                <span><i class="fa-brands fa-@login.LoginProvider.ToLowerInvariant() me-2" aria-hidden="true"></i>@login.ProviderDisplayName</span>
                @if (Model.ShowRemoveButton)
                {
                    <form asp-page-handler="RemoveLogin" method="post" data-confirm="Disconnect @login.ProviderDisplayName from your account?">
                        <input type="hidden" name="LoginProvider" value="@login.LoginProvider" />
                        <input type="hidden" name="ProviderKey" value="@login.ProviderKey" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Disconnect</button>
                    </form>
                }
                else
                {
                    <span class="small text-muted">Set a password before disconnecting</span>
                }
            </li>
        }
    </ul>
}

@if (Model.OtherLogins?.Count > 0)
{
    <h3 class="h6">Connect another account</h3>
    <form id="link-login-form" asp-page-handler="LinkLogin" method="post" class="d-flex flex-wrap gap-2">
        @foreach (var provider in Model.OtherLogins)
        {
            <button type="submit" class="btn btn-outline-secondary" name="provider" value="@provider.Name">
                <i class="fa-brands fa-@provider.Name.ToLowerInvariant() me-2" aria-hidden="true"></i>Connect @provider.DisplayName
            </button>
        }
    </form>
}
else if (!(Model.CurrentLogins?.Count > 0))
{
    <p class="mb-0">No sign-in providers are configured.</p>
}
