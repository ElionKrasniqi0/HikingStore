@page
@model TwoFactorAuthenticationModel
@{
    ViewData["Title"] = "Two-factor authentication";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h2>Two-factor authentication</h2>

@if (Model.Is2faEnabled)
{
    <p><span class="badge text-bg-success me-2">On</span>We'll ask for a code from your authenticator app when you sign in.</p>
    if (Model.RecoveryCodesLeft == 0)
    {
        <div class="alert alert-danger" role="alert">You have no recovery codes left. <a asp-page="./GenerateRecoveryCodes">Generate a new set</a> before you can sign in with a recovery code.</div>
    }
    else if (Model.RecoveryCodesLeft <= 3)
    {
        <div class="alert alert-warning" role="alert">You have @Model.RecoveryCodesLeft recovery code@(Model.RecoveryCodesLeft == 1 ? "" : "s") left. <a asp-page="./GenerateRecoveryCodes">Generate a new set</a>.</div>
    }
    <div class="d-flex flex-wrap gap-2 mb-4">
        @if (Model.IsMachineRemembered)
        {
            <form method="post">
                <button type="submit" class="btn btn-outline-secondary">Forget this browser</button>
            </form>
        }
        <a asp-page="./GenerateRecoveryCodes" class="btn btn-outline-secondary">New recovery codes</a>
        <a asp-page="./Disable2fa" class="btn btn-outline-danger">Turn off</a>
    </div>
}
else
{
    <p class="text-muted">Add a second step to sign-in: after your password, you'll enter a 6-digit code from an authenticator app on your phone.</p>
}

<h3 class="h6">Authenticator app</h3>
<div class="d-flex flex-wrap gap-2">
    @if (!Model.HasAuthenticator)
    {
        <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-primary">Set up authenticator app</a>
    }
    else
    {
        <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-primary">Set up on another app</a>
        <a id="reset-authenticator" asp-page="./ResetAuthenticator" class="btn btn-outline-secondary">Reset key</a>
    }
</div>
