@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["AccountSection"] = "security";
    ViewData["NoIndex"] = true;
}

<div class="container-hs">
    <div class="page-head"><h1>Sign-in &amp; security</h1></div>
    <div class="account-layout">
        <partial name="_AccountNav" />
        <section class="d-flex flex-column gap-3 min-w-0">
            <partial name="_ManageNav" />
            <div class="card-hs manage-body">
                @RenderBody()
            </div>
        </section>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
