@page
@model Disable2faModel
@{
    ViewData["Title"] = "Turn off two-factor authentication";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h2>Turn off two-factor authentication</h2>
<p class="text-muted">You'll sign in with just your password. Your authenticator app keeps its key; to change it, <a asp-page="./ResetAuthenticator">reset the key</a> instead.</p>
<form method="post" data-once>
    <button class="btn btn-danger" type="submit" data-busy-text="Turning off…">Turn off two-factor</button>
    <a asp-page="./TwoFactorAuthentication" class="btn btn-outline-secondary ms-2">Cancel</a>
</form>
