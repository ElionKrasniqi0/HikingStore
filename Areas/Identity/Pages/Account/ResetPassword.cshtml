@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
}

<div class="min-vh-100 d-flex align-items-center justify-content-center bg-light py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-7">
                <!-- Reset Password Card -->
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                    <!-- Card Header -->
                    <div class="card-header bg-gradient-primary text-white text-center py-4 border-0">
                        <div class="icon-wrapper bg-opacity-20 rounded-circle p-3 mx-auto mb-3">
                            <i class="fas fa-key fa-lg text-white"></i>
                        </div>
                        <h2 class="h4 fw-bold mb-2">Reset Your Password</h2>
                        <p class="mb-0 opacity-75">Create a new secure password for your account</p>
                    </div>

                    <!-- Card Body -->
                    <div class="card-body p-4">
                        <form method="post" class="needs-validation" novalidate>
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-2 mb-4 small"></div>
                            <input asp-for="Input.Code" type="hidden" />

                            <!-- Email Field -->
                            <div class="form-group mb-3">
                                <label asp-for="Input.Email" class="form-label fw-semibold text-dark mb-2">Email Address</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="fas fa-envelope text-muted"></i>
                                    </span>
                                    <input asp-for="Input.Email" class="form-control border-start-0 py-3"
                                           placeholder="Enter your email address"
                                           autocomplete="username"
                                           aria-required="true" />
                                </div>
                                <span asp-validation-for="Input.Email" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- Password Field -->
                            <div class="form-group mb-3">
                                <label asp-for="Input.Password" class="form-label fw-semibold text-dark mb-2">New Password</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="fas fa-lock text-muted"></i>
                                    </span>
                                    <input asp-for="Input.Password" class="form-control border-start-0 py-3"
                                           placeholder="Enter your new password"
                                           autocomplete="new-password"
                                           aria-required="true" />
                                    <span class="input-group-text bg-light border-start-0">
                                        <i class="fas fa-eye text-muted password-toggle" style="cursor: pointer;"></i>
                                    </span>
                                </div>
                                <span asp-validation-for="Input.Password" class="text-danger small mt-1 d-block"></span>
                                <div class="form-text mt-1">
                                    <small class="text-muted">Use a strong password with at least 6 characters</small>
                                </div>
                            </div>

                            <!-- Confirm Password Field -->
                            <div class="form-group mb-4">
                                <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold text-dark mb-2">Confirm New Password</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="fas fa-lock text-muted"></i>
                                    </span>
                                    <input asp-for="Input.ConfirmPassword" class="form-control border-start-0 py-3"
                                           placeholder="Confirm your new password"
                                           autocomplete="new-password"
                                           aria-required="true" />
                                    <span class="input-group-text bg-light border-start-0">
                                        <i class="fas fa-eye text-muted password-toggle" style="cursor: pointer;"></i>
                                    </span>
                                </div>
                                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- Submit Button -->
                            <button type="submit" class="btn btn-primary btn-lg w-100 py-3 fw-semibold mb-3">
                                <i class="fas fa-check-circle me-2"></i>Reset Password
                            </button>

                            <!-- Back to Login -->
                            <div class="text-center">
                                <a asp-page="./Login" class="text-primary small fw-semibold text-decoration-none">
                                    <i class="fas fa-arrow-left me-1"></i>Back to Login
                                </a>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Security Info -->
                <div class="text-center mt-4">
                    <p class="text-muted small mb-2">
                        <i class="fas fa-shield-alt me-1"></i>
                        Your password reset link is secure and will expire after use
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-gradient-primary {
        background: linear-gradient(135deg, #3b5d50 0%, #2d4a3f 100%);
    }

    .icon-wrapper {
        width: 60px;
        height: 60px;
        background: rgba(255, 255, 255, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .form-control:focus {
        border-color: #3b5d50;
        box-shadow: 0 0 0 0.2rem rgba(59, 93, 80, 0.25);
    }

    .btn-primary {
        background: linear-gradient(135deg, #3b5d50 0%, #2d4a3f 100%);
        border: none;
        transition: all 0.3s ease;
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, #2d4a3f 0%, #1e3329 100%);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(59, 93, 80, 0.3);
    }

    .input-group-text {
        border-color: #dee2e6;
    }

    .card {
        transition: transform 0.3s ease;
    }

    .card:hover {
        transform: translateY(-5px);
    }

    .password-toggle {
        cursor: pointer;
        transition: color 0.3s ease;
    }

    .password-toggle:hover {
        color: #3b5d50 !important;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Password toggle functionality
        const passwordToggles = document.querySelectorAll('.password-toggle');
        passwordToggles.forEach(toggle => {
            toggle.addEventListener('click', function() {
                const input = this.closest('.input-group').querySelector('input[type="password"], input[type="text"]');
                if (input.type === 'password') {
                    input.type = 'text';
                    this.classList.remove('fa-eye');
                    this.classList.add('fa-eye-slash');
                } else {
                    input.type = 'password';
                    this.classList.remove('fa-eye-slash');
                    this.classList.add('fa-eye');
                }
            });
        });
    });
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
