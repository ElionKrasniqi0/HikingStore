@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
    ViewData["NoIndex"] = true;
}

<div class="container-hs">
    <div class="auth-wrap">
        <div class="card-hs">
            <div class="auth-icon warn"><i class="fa-solid fa-lock" aria-hidden="true"></i></div>
            <h1>Access denied</h1>
            <p class="text-muted mb-0">Your account doesn't have permission to open this page. If you think it should, sign in with a different account or contact us.</p>
            <div class="auth-actions">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary">Go to the homepage</a>
                <a asp-area="" asp-controller="Home" asp-action="Contact" class="btn btn-outline-secondary">Contact us</a>
            </div>
        </div>
    </div>
</div>
