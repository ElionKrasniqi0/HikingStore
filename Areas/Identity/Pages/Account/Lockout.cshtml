@page
@model LockoutModel
@{
    ViewData["Title"] = "Account temporarily locked";
    ViewData["NoIndex"] = true;
}

<div class="container-hs">
    <div class="auth-wrap">
        <div class="card-hs">
            <div class="auth-icon warn"><i class="fa-solid fa-user-lock" aria-hidden="true"></i></div>
            <h1>Account temporarily locked</h1>
            <p class="text-muted mb-0">There were too many unsuccessful sign-in attempts, so we've locked this account for 15 minutes to protect it. Try again later, or reset your password if you've forgotten it.</p>
            <div class="auth-actions">
                <a asp-page="./ForgotPassword" class="btn btn-primary">Reset password</a>
                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Go to the homepage</a>
            </div>
        </div>
    </div>
</div>
