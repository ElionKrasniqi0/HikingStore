@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = Model.Succeeded ? "Email confirmed" : "Confirmation link not valid";
    ViewData["NoIndex"] = true;
}

<div class="container-hs">
    <div class="auth-wrap">
        <div class="card-hs">
            @if (Model.Succeeded)
            {
                <div class="auth-icon"><i class="fa-solid fa-check" aria-hidden="true"></i></div>
                <h1>Email confirmed</h1>
                <p class="text-muted mb-0">Thanks — your account is active. You can sign in now.</p>
                <div class="auth-actions">
                    <a asp-page="./Login" class="btn btn-primary">Sign in</a>
                </div>
            }
            else
            {
                <div class="auth-icon warn"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i></div>
                <h1>Confirmation link not valid</h1>
                <p class="text-muted mb-0">This link has expired or was already used. Request a new one and use the most recent email we send.</p>
                <div class="auth-actions">
                    <a asp-page="./ResendEmailConfirmation" class="btn btn-primary">Send a new link</a>
                    <a asp-page="./Login" class="btn btn-outline-secondary">Sign in</a>
                </div>
            }
        </div>
    </div>
</div>
