@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Password changed";
    ViewData["NoIndex"] = true;
}

<div class="container-hs">
    <div class="auth-wrap">
        <div class="card-hs">
            <div class="auth-icon"><i class="fa-solid fa-check" aria-hidden="true"></i></div>
            <h1>Password changed</h1>
            <p class="text-muted mb-0">If the link was valid, your password has been updated. Sign in with your new password.</p>
            <div class="auth-actions">
                <a asp-page="./Login" class="btn btn-primary">Sign in</a>
            </div>
        </div>
    </div>
</div>
