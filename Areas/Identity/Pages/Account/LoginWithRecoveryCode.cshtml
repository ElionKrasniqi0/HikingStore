@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Sign in with a recovery code";
    ViewData["NoIndex"] = true;
}

<div class="container-hs">
    <div class="auth-wrap">
        <div class="card-hs">
            <h1>Sign in with a recovery code</h1>
            <p class="text-muted">Enter one of the recovery codes you saved when you set up two-factor authentication. Each code works once.</p>
            <form method="post" asp-route-returnUrl="@Model.ReturnUrl" data-once>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="mb-4">
                    <label asp-for="Input.RecoveryCode" class="form-label">Recovery code</label>
                    <input asp-for="Input.RecoveryCode" class="form-control code-input" autocomplete="off" autofocus />
                    <span asp-validation-for="Input.RecoveryCode" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100" data-busy-text="Signing in…">Sign in</button>
            </form>
            <p class="mt-4 mb-0 text-center"><a asp-page="./Login"><i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>Back to sign in</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
