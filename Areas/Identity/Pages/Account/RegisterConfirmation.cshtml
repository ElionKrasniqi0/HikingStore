@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Confirm your email";
    ViewData["NoIndex"] = true;
}

<div class="container-hs">
    <div class="auth-wrap">
        <div class="card-hs">
            <div class="auth-icon"><i class="fa-regular fa-envelope" aria-hidden="true"></i></div>
            <h1>Confirm your email</h1>
            <p class="text-muted">We've sent a confirmation link to <strong>@Model.Email</strong>. Open it to activate your account, then sign in.</p>
            <p class="small text-muted mb-0">Nothing after a few minutes? Check your spam folder, or ask for a new link.</p>
            <form asp-page="./ResendEmailConfirmation" method="post" class="auth-actions" data-once>
                <input type="hidden" name="Input.Email" value="@Model.Email" />
                <button type="submit" class="btn btn-outline-secondary" data-busy-text="Sending…">Send a new link</button>
                <a asp-page="./Login" class="btn btn-primary">Go to sign in</a>
            </form>
        </div>
    </div>
</div>
