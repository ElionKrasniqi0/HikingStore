@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Check your email";
    ViewData["NoIndex"] = true;
}

<div class="container-hs">
    <div class="auth-wrap">
        <div class="card-hs">
            <div class="auth-icon"><i class="fa-regular fa-envelope" aria-hidden="true"></i></div>
            <h1>Check your email</h1>
            <p class="text-muted mb-0">If a confirmed account exists for that address, we've sent a link to reset your password. It can take a few minutes to arrive — check your spam folder too.</p>
            <div class="auth-actions">
                <a asp-page="./Login" class="btn btn-primary">Back to sign in</a>
                <a asp-page="./ForgotPassword" class="btn btn-outline-secondary">Try another email</a>
            </div>
        </div>
    </div>
</div>
