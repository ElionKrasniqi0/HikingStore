@page
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
    ViewData["NoIndex"] = true;
}

<div class="container-hs">
    <div class="auth-wrap">
        <div class="card-hs">
            <h1>Sign in</h1>
            <p class="text-muted">Track orders, save addresses and check out faster.</p>

            <partial name="_ExternalLoginButtons" model="(Model.ExternalLogins, Model.ReturnUrl)" />

            <form id="account" method="post" asp-route-returnUrl="@Model.ReturnUrl" data-once>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label">Email address</label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" inputmode="email" />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <div class="d-flex justify-content-between">
                        <label asp-for="Input.Password" class="form-label">Password</label>
                        <a asp-page="./ForgotPassword" class="small">Forgot password?</a>
                    </div>
                    <div class="input-group">
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
                        <button class="btn btn-outline-secondary" type="button" data-toggle-password="Input_Password" aria-label="Show password" aria-pressed="false"><i class="fa-regular fa-eye" aria-hidden="true"></i></button>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label class="form-check-label" asp-for="Input.RememberMe">Keep me signed in</label>
                </div>
                <button type="submit" class="btn btn-primary w-100" data-busy-text="Signing in…">Sign in</button>
            </form>

            <p class="mt-4 mb-1 text-center">New here? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="fw-semibold">Create an account</a></p>
            <p class="small text-center text-muted m-0">Didn't get the confirmation email? <a asp-page="./ResendEmailConfirmation">Send it again</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
