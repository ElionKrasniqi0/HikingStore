@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var store = StoreOptions.Value;
    var maxRevenue = Model.SalesByDay.Count == 0 ? 0 : Model.SalesByDay.Max(d => d.Revenue);
}

<div class="admin-page-head">
    <div>
        <h1>Dashboard</h1>
        <p>Figures exclude cancelled orders. Last 30 days unless noted.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary btn-sm" asp-controller="Reports" asp-action="Index">Full report</a>
        <a class="btn btn-primary btn-sm" asp-controller="Products" asp-action="Create"><i class="fa-solid fa-plus me-1" aria-hidden="true"></i>Add product</a>
    </div>
</div>

<div class="kpis">
    <div class="kpi">
        <div class="l">Revenue · 30 days</div>
        <div class="v">@store.FormatPrice(Model.Revenue30Days)</div>
        <div class="s">All time @store.FormatPrice(Model.TotalRevenue)</div>
    </div>
    <a class="kpi" asp-controller="Orders" asp-action="Index">
        <div class="l">Orders · 30 days</div>
        <div class="v">@Model.Orders30Days</div>
        <div class="s">@Model.OrderCount all time</div>
    </a>
    <a class="kpi @(Model.OpenOrders > 0 ? "warn" : "")" asp-controller="Orders" asp-action="Index">
        <div class="l">Open orders</div>
        <div class="v">@Model.OpenOrders</div>
        <div class="s">Received, verified or processing</div>
    </a>
    <a class="kpi @(Model.PendingReviews > 0 ? "warn" : "")" asp-controller="Reviews" asp-action="Index">
        <div class="l">Reviews to moderate</div>
        <div class="v">@Model.PendingReviews</div>
        <div class="s">Awaiting approval</div>
    </a>
    <a class="kpi" asp-controller="Home" asp-action="Users">
        <div class="l">Customers</div>
        <div class="v">@Model.CustomerCount</div>
        <div class="s">Registered accounts</div>
    </a>
    <a class="kpi" asp-controller="Products" asp-action="Index">
        <div class="l">Products in store</div>
        <div class="v">@Model.ActiveProducts</div>
        <div class="s">Visible to customers</div>
    </a>
    <a class="kpi" asp-controller="Home" asp-action="ShowMessage">
        <div class="l">Contact messages</div>
        <div class="v">@Model.MessageCount</div>
        <div class="s">In the inbox</div>
    </a>
    <a class="kpi" asp-controller="Reports" asp-action="Newsletter">
        <div class="l">Newsletter</div>
        <div class="v">@Model.NewsletterSubscribers</div>
        <div class="s">Subscribers</div>
    </a>
</div>

<div class="row g-3">
    <div class="col-12 col-xl-8">
        <section class="panel h-100" aria-labelledby="sales-h">
            <div class="panel-head"><h2 id="sales-h">Sales · last 14 days</h2><span class="small text-muted">@store.FormatPrice(Model.SalesByDay.Sum(d => d.Revenue)) from @Model.SalesByDay.Sum(d => d.Orders) orders</span></div>
            <div class="panel-body">
                <div class="bar-chart" role="img" aria-label="Daily revenue for the last 14 days">
                    @foreach (var day in Model.SalesByDay)
                    {
                        var pct = maxRevenue == 0 ? 0 : (int)Math.Round(day.Revenue / maxRevenue * 100);
                        <div class="bar" title="@day.Date.ToString("ddd d MMM"): @store.FormatPrice(day.Revenue) · @day.Orders orders">
                            <span style="height:@(pct)%"></span>
                            <small>@day.Date.ToString("d/M")</small>
                        </div>
                    }
                </div>
            </div>
        </section>
    </div>
    <div class="col-12 col-xl-4">
        <section class="panel h-100" aria-labelledby="status-h">
            <div class="panel-head"><h2 id="status-h">Orders by status</h2></div>
            <ul class="list-group list-group-flush">
                @foreach (var status in System.Enum.GetValues<OrderStatus>())
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <a asp-controller="Orders" asp-action="Index" asp-route-status="@status" class="text-decoration-none"><partial name="_StatusBadge" model="status" /></a>
                        <strong>@Model.OrdersByStatus.GetValueOrDefault(status)</strong>
                    </li>
                }
            </ul>
        </section>
    </div>

    <div class="col-12 col-xl-8">
        <section class="panel" aria-labelledby="recent-h">
            <div class="panel-head"><h2 id="recent-h">Recent orders</h2><a asp-controller="Orders" asp-action="Index" class="small">All orders</a></div>
            @if (Model.RecentOrders.Count == 0)
            {
                <p class="panel-body text-muted m-0">No orders yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table admin-table">
                        <thead><tr><th scope="col">Order</th><th scope="col">Customer</th><th scope="col">Date</th><th scope="col">Status</th><th scope="col" class="text-end">Total</th></tr></thead>
                        <tbody>
                            @foreach (var o in Model.RecentOrders)
                            {
                                <tr>
                                    <td><a asp-controller="Orders" asp-action="Details" asp-route-id="@o.OrderId" class="fw-semibold">@o.OrderNumber</a></td>
                                    <td class="text-truncate" style="max-width:220px">@(o.FullName ?? o.Email ?? o.User?.Email)</td>
                                    <td class="text-nowrap">@o.OrderDate.ToString("d MMM yyyy")</td>
                                    <td><partial name="_StatusBadge" model="o.Status" /></td>
                                    <td class="text-end text-nowrap">@store.FormatPrice(o.TotalAmount)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
    <div class="col-12 col-xl-4">
        <section class="panel" aria-labelledby="low-h">
            <div class="panel-head"><h2 id="low-h">Low stock</h2><a asp-controller="Products" asp-action="Index" asp-route-stock="low" class="small">Manage</a></div>
            @if (Model.LowStock.Count == 0)
            {
                <p class="panel-body text-muted m-0">All visible products have more than 5 units.</p>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var p in Model.LowStock)
                    {
                        <li class="list-group-item d-flex justify-content-between gap-2">
                            <a asp-controller="Products" asp-action="Edit" asp-route-id="@p.ProId" class="text-truncate">@p.ProName</a>
                            <span class="badge @(p.StockQuantity == 0 ? "text-bg-danger" : "text-bg-warning")">@(p.StockQuantity == 0 ? "Sold out" : $"{p.StockQuantity} left")</span>
                        </li>
                    }
                </ul>
            }
        </section>
        <section class="panel" aria-labelledby="top-h">
            <div class="panel-head"><h2 id="top-h">Best sellers</h2></div>
            @if (Model.TopProducts.Count == 0)
            {
                <p class="panel-body text-muted m-0">No sales yet.</p>
            }
            else
            {
                <ol class="list-group list-group-flush list-group-numbered">
                    @foreach (var t in Model.TopProducts)
                    {
                        <li class="list-group-item d-flex justify-content-between gap-2">
                            <span class="text-truncate min-w-0 flex-grow-1">@t.Name</span>
                            <span class="text-nowrap small text-muted">@t.Units sold</span>
                        </li>
                    }
                </ol>
            }
        </section>
    </div>
</div>
