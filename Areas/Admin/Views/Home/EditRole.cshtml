@model EditRoleViewModel
@{
    ViewData["Title"] = "Customer roles";
    var roles = ViewBag.roles as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new();
    var available = roles.Where(r => !Model.UserRoles.Contains(r.Text)).ToList();
}

<div class="admin-page-head">
    <div>
        <h1>Roles for @ViewBag.UserEmail</h1>
        <p>Role changes sign the user out of other sessions.</p>
    </div>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Users"><i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>Customers</a>
</div>

<div class="row g-3">
    <div class="col-12 col-lg-6">
        <section class="panel" aria-labelledby="current-h">
            <div class="panel-head"><h2 id="current-h">Current roles</h2></div>
            @if (Model.UserRoles.Count == 0)
            {
                <p class="panel-body text-muted m-0">This account has no roles.</p>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var role in Model.UserRoles)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span class="fw-semibold">@role</span>
                            <form method="post" asp-action="RemoveRole" data-confirm="Remove the @role role from this account?">
                                <input type="hidden" name="roleName" value="@role" />
                                <input type="hidden" name="userId" value="@Model.UserId" />
                                <button class="btn btn-sm btn-outline-danger" type="submit">Remove</button>
                            </form>
                        </li>
                    }
                </ul>
            }
        </section>
    </div>
    <div class="col-12 col-lg-6">
        <section class="panel" aria-labelledby="add-h">
            <div class="panel-head"><h2 id="add-h">Add a role</h2></div>
            <div class="panel-body">
                @if (available.Count == 0)
                {
                    <p class="text-muted m-0">This account already has every role.</p>
                }
                else
                {
                    <form method="post" asp-action="EditRole" class="d-flex flex-wrap gap-2 align-items-end">
                        <input type="hidden" asp-for="UserId" />
                        <div class="flex-grow-1">
                            <label class="form-label small" asp-for="RoleId">Role</label>
                            <select class="form-select" asp-for="RoleId" asp-items="available" required>
                                <option value="">Choose a role…</option>
                            </select>
                        </div>
                        <button class="btn btn-primary" type="submit">Add role</button>
                    </form>
                }
            </div>
        </section>
    </div>
</div>
