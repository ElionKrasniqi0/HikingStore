@model List<Contact>
@{
    ViewData["Title"] = "Messages";
}

<div class="admin-page-head">
    <div>
        <h1>Contact messages</h1>
        <p>@Model.Count message@(Model.Count == 1 ? "" : "s") from the contact form. Replies are sent by email.</p>
    </div>
</div>

<div class="panel" data-messages>
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <i class="fa-regular fa-envelope-open" aria-hidden="true"></i>
            <h2>Inbox is empty</h2>
            <p>Messages sent through the contact page will appear here.</p>
        </div>
    }
    @foreach (var m in Model)
    {
        <article class="message-card" data-message="@m.CoId" aria-labelledby="msg-@m.CoId">
            <div class="d-flex flex-wrap justify-content-between gap-2 mb-2">
                <div class="min-w-0">
                    <h2 class="h6 font-body fw-bold m-0" id="msg-@m.CoId">@(string.IsNullOrWhiteSpace(m.Subject) ? "(No subject)" : m.Subject)</h2>
                    <div class="small text-muted text-break">@m.Name · <a href="mailto:@m.Email">@m.Email</a></div>
                </div>
                <div class="small text-muted text-nowrap">@m.CreatedDate.ToString("d MMM yyyy, HH:mm") UTC</div>
            </div>
            <p class="body mb-3">@m.Message</p>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#reply-@m.CoId" aria-expanded="false" aria-controls="reply-@m.CoId">
                    <i class="fa-solid fa-reply me-1" aria-hidden="true"></i>Reply
                </button>
                <button class="btn btn-sm btn-outline-danger" type="button" data-delete-message="@m.CoId">Delete</button>
            </div>
            <form class="collapse mt-3" id="reply-@m.CoId" data-reply-form="@m.CoId">
                <div class="mb-2">
                    <label class="form-label small" for="subject-@m.CoId">Subject</label>
                    <input class="form-control" id="subject-@m.CoId" name="replySubject" value="Re: @m.Subject" maxlength="200" required />
                </div>
                <div class="mb-2">
                    <label class="form-label small" for="body-@m.CoId">Message</label>
                    <textarea class="form-control" id="body-@m.CoId" name="replyMessage" rows="5" maxlength="5000" required></textarea>
                </div>
                <button class="btn btn-primary btn-sm" type="submit" data-busy-text="Sending…">Send reply</button>
            </form>
        </article>
    }
</div>

@section Scripts {
    <script>
        (function () {
            const replyUrl = '@Url.Action("SendReply", "Home", new { area = "Admin" })';
            const deleteUrl = '@Url.Action("DeleteMessage", "Home", new { area = "Admin" })';

            async function post(url, data) {
                const response = await fetch(url, { method: 'POST', body: data, headers: { 'Accept': 'application/json' } });
                if (!response.ok) throw new Error(response.status);
                return response.json();
            }

            document.querySelectorAll('[data-reply-form]').forEach(form => {
                form.addEventListener('submit', async e => {
                    e.preventDefault();
                    const button = form.querySelector('button[type=submit]');
                    const data = new FormData(form);
                    data.append('id', form.dataset.replyForm);
                    button.disabled = true;
                    try {
                        const result = await post(replyUrl, data);
                        HS.toast(result.message, result.success ? 'success' : 'error');
                        if (result.success) {
                            form.reset();
                            bootstrap.Collapse.getOrCreateInstance(form).hide();
                        }
                    } catch {
                        HS.toast('The reply could not be sent. Please try again.', 'error');
                    } finally {
                        button.disabled = false;
                    }
                });
            });

            document.querySelectorAll('[data-delete-message]').forEach(button => {
                button.addEventListener('click', async () => {
                    if (!confirm('Delete this message permanently?')) return;
                    const data = new FormData();
                    data.append('id', button.dataset.deleteMessage);
                    try {
                        const result = await post(deleteUrl, data);
                        HS.toast(result.message, result.success ? 'success' : 'error');
                        if (result.success) button.closest('[data-message]').remove();
                    } catch {
                        HS.toast('The message could not be deleted.', 'error');
                    }
                });
            });
        })();
    </script>
}
