@model Coupon
@{
    var isNew = Model.CouponId == 0;
    ViewData["Title"] = isNew ? "New coupon" : $"Edit {Model.Code}";
}

<div class="admin-page-head">
    <div>
        <h1>@(isNew ? "New coupon" : $"Edit {Model.Code}")</h1>
        @if (!isNew) { <p>Used @Model.TimesUsed time@(Model.TimesUsed == 1 ? "" : "s").</p> }
    </div>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Index"><i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>Coupons</a>
</div>

<form method="post" asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? null : Model.CouponId)" data-once style="max-width:820px">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <section class="panel">
        <div class="panel-head"><h2>Discount</h2></div>
        <div class="panel-body">
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label asp-for="Code" class="form-label"></label>
                    <input asp-for="Code" class="form-control text-uppercase font-monospace" maxlength="40" autocomplete="off" aria-describedby="code-help" />
                    <span asp-validation-for="Code" class="text-danger small"></span>
                    <p class="small text-muted mt-1 mb-0" id="code-help">Letters, numbers, dashes or underscores. Not case-sensitive for customers.</p>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Description" class="form-label">Description</label>
                    <input asp-for="Description" class="form-control" maxlength="200" aria-describedby="couponDescriptionHelp" placeholder="e.g. 10% off orders over €50" />
                    <div id="couponDescriptionHelp" class="form-text">Shown to customers in the cart when the code is applied.</div>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="DiscountType" class="form-label"></label>
                    <select asp-for="DiscountType" class="form-select" asp-items="Html.GetEnumSelectList<DiscountType>()"></select>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Value" class="form-label">Value (% or @StoreOptions.Value.CurrencySymbol)</label>
                    <input asp-for="Value" class="form-control" type="number" step="0.01" min="0.01" />
                    <span asp-validation-for="Value" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </section>

    <section class="panel">
        <div class="panel-head"><h2>Conditions</h2></div>
        <div class="panel-body">
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label asp-for="MinimumOrderAmount" class="form-label"></label>
                    <input asp-for="MinimumOrderAmount" class="form-control" type="number" step="0.01" min="0" />
                    <span asp-validation-for="MinimumOrderAmount" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="MaxDiscountAmount" class="form-label"></label>
                    <input asp-for="MaxDiscountAmount" class="form-control" type="number" step="0.01" min="0" aria-describedby="max-help" />
                    <p class="small text-muted mt-1 mb-0" id="max-help">Caps percentage discounts. Leave empty for no cap.</p>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="StartsAt" class="form-label"></label>
                    <input asp-for="StartsAt" class="form-control" type="datetime-local" />
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="ExpiresAt" class="form-label"></label>
                    <input asp-for="ExpiresAt" class="form-control" type="datetime-local" />
                    <span asp-validation-for="ExpiresAt" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="UsageLimit" class="form-label"></label>
                    <input asp-for="UsageLimit" class="form-control" type="number" min="1" step="1" placeholder="Unlimited" />
                    <span asp-validation-for="UsageLimit" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="UsageLimitPerUser" class="form-label"></label>
                    <input asp-for="UsageLimitPerUser" class="form-control" type="number" min="1" step="1" placeholder="Unlimited" />
                    <span asp-validation-for="UsageLimitPerUser" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" role="switch" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary" data-busy-text="Saving…">@(isNew ? "Create coupon" : "Save changes")</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
