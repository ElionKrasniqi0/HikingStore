@using Microsoft.AspNetCore.Identity
@{
    ViewData["Title"] = "Roles";
    var roles = ViewBag.roles as List<IdentityRole> ?? new();
    var protectedRoles = ViewBag.ProtectedRoles as string[] ?? Array.Empty<string>();
}

<div class="admin-page-head">
    <div>
        <h1>Roles</h1>
        <p>Admin grants access to this dashboard. User is given to every customer at registration. Both are built in and can't be renamed or deleted.</p>
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-lg-7">
        <section class="panel" aria-labelledby="roles-h">
            <div class="panel-head"><h2 id="roles-h">All roles</h2></div>
            <ul class="list-group list-group-flush">
                @foreach (var role in roles)
                {
                    var isProtected = protectedRoles.Contains(role.Name);
                    <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <span class="fw-semibold">@role.Name @if (isProtected) { <span class="badge text-bg-light border ms-1">Built in</span> }</span>
                        <span class="d-flex gap-2">
                            <a class="btn btn-sm btn-outline-primary" asp-action="EditRole" asp-route-id="@role.Id">@(isProtected ? "View members" : "Edit")</a>
                            @if (!isProtected)
                            {
                                <form method="post" asp-action="RemoveRole" asp-route-id="@role.Id" data-confirm="Delete the role “@role.Name”? Members will lose it.">
                                    <button class="btn btn-sm btn-outline-danger" type="submit" aria-label="Delete role @role.Name"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
                                </form>
                            }
                        </span>
                    </li>
                }
            </ul>
        </section>
    </div>
    <div class="col-12 col-lg-5">
        <section class="panel" aria-labelledby="new-h">
            <div class="panel-head"><h2 id="new-h">Create a role</h2></div>
            <div class="panel-body">
                <form method="post" asp-action="CreateRole" class="d-flex flex-wrap gap-2 align-items-end">
                    <div class="flex-grow-1">
                        <label class="form-label small" for="roleName">Role name</label>
                        <input class="form-control" id="roleName" name="roleName" minlength="2" maxlength="50" required />
                    </div>
                    <button class="btn btn-primary" type="submit">Create</button>
                </form>
                <p class="small text-muted mt-2 mb-0">Assign roles to people from <a asp-controller="Home" asp-action="Users">Customers</a>.</p>
            </div>
        </section>
    </div>
</div>
