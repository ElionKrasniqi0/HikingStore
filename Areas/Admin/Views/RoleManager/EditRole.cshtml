@model EditRoleNameViewModel
@{
    ViewData["Title"] = $"Role {Model.RoleName}";
    var isProtected = ViewBag.IsProtected is true;
}

<div class="admin-page-head">
    <div><h1>Role: @Model.RoleName</h1></div>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Index"><i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>Roles</a>
</div>

<div class="row g-3">
    @if (!isProtected)
    {
        <div class="col-12 col-lg-5">
            <section class="panel" aria-labelledby="rename-h">
                <div class="panel-head"><h2 id="rename-h">Rename</h2></div>
                <div class="panel-body">
                    <form method="post" asp-action="EditRoleConfirmed" asp-route-id="@Model.Id" class="d-flex flex-wrap gap-2 align-items-end">
                        <div class="flex-grow-1">
                            <label class="form-label small" for="roleName">Role name</label>
                            <input class="form-control" id="roleName" name="roleName" value="@Model.RoleName" minlength="2" maxlength="50" required />
                        </div>
                        <button class="btn btn-primary" type="submit">Save</button>
                    </form>
                </div>
            </section>
        </div>
    }
    <div class="col-12 @(isProtected ? "" : "col-lg-7")">
        <section class="panel" aria-labelledby="members-h">
            <div class="panel-head"><h2 id="members-h">Members (@Model.Users.Count)</h2></div>
            @if (Model.Users.Count == 0)
            {
                <p class="panel-body text-muted m-0">No accounts have this role.</p>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var u in Model.Users.OrderBy(u => u))
                    {
                        <li class="list-group-item text-break">@u</li>
                    }
                </ul>
            }
        </section>
    </div>
</div>
