@model PaginationModel
@if (Model.PageCount > 1)
{
    <nav class="d-flex justify-content-center p-3" aria-label="Pagination">
        <ul class="pagination pagination-sm m-0 flex-wrap">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" href="@(Model.Page <= 1 ? "#" : Model.UrlFor(Model.Page - 1))" aria-label="Previous page">&lsaquo;</a>
            </li>
            @for (var i = Math.Max(1, Model.Page - 3); i <= Math.Min(Model.PageCount, Model.Page + 3); i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" href="@Model.UrlFor(i)" aria-current="@(i == Model.Page ? "page" : null)">@i</a>
                </li>
            }
            <li class="page-item @(Model.Page >= Model.PageCount ? "disabled" : "")">
                <a class="page-link" href="@(Model.Page >= Model.PageCount ? "#" : Model.UrlFor(Model.Page + 1))" aria-label="Next page">&rsaquo;</a>
            </li>
        </ul>
    </nav>
}
