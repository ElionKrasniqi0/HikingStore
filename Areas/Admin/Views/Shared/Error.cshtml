@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="panel">
    <div class="empty-state">
        <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
        <h2>Something went wrong</h2>
        <p>The request couldn't be completed. Try again, or go back to the dashboard.</p>
        @if (Model?.ShowRequestId == true)
        {
            <p class="small">Reference: <code>@Model.RequestId</code></p>
        }
        <a class="btn btn-primary" asp-area="Admin" asp-controller="Home" asp-action="Index">Dashboard</a>
    </div>
</div>
