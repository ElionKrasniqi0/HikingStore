@model Product
@{
    var isNew = Model.ProId == 0;
    ViewData["Title"] = isNew ? "Add product" : $"Edit {Model.ProName}";
}

<div class="admin-page-head">
    <div>
        <h1>@(isNew ? "Add product" : "Edit product")</h1>
        @if (!isNew) { <p>#@Model.ProId · @Model.ProName</p> }
    </div>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Index"><i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>Products</a>
</div>

<form method="post" asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? null : Model.ProId)" enctype="multipart/form-data" data-once>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="row g-3">
        <div class="col-12 col-xl-8">
            <section class="panel" aria-labelledby="basics-h">
                <div class="panel-head"><h2 id="basics-h">Basics</h2></div>
                <div class="panel-body">
                    <div class="mb-3">
                        <label asp-for="ProName" class="form-label"></label>
                        <input asp-for="ProName" class="form-control" maxlength="200" />
                        <span asp-validation-for="ProName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Descreption" class="form-label"></label>
                        <textarea asp-for="Descreption" class="form-control" rows="6"></textarea>
                        <span asp-validation-for="Descreption" class="text-danger small"></span>
                    </div>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="Brand" class="form-label"></label>
                            <input asp-for="Brand" class="form-control" maxlength="100" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Material" class="form-label"></label>
                            <input asp-for="Material" class="form-control" maxlength="200" />
                        </div>
                    </div>
                </div>
            </section>

            <section class="panel" aria-labelledby="variants-h">
                <div class="panel-head"><h2 id="variants-h">Variants &amp; specifications</h2></div>
                <div class="panel-body">
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="Sizes" class="form-label"></label>
                            <input asp-for="Sizes" class="form-control" placeholder="S, M, L, XL" maxlength="500" aria-describedby="variants-help" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Colors" class="form-label"></label>
                            <input asp-for="Colors" class="form-control" placeholder="Forest, Charcoal" maxlength="500" aria-describedby="variants-help" />
                        </div>
                    </div>
                    <p class="small text-muted" id="variants-help">Customers must choose a size and colour when these are filled in. Stock is tracked for the product as a whole, not per variant.</p>
                    <label asp-for="Specifications" class="form-label"></label>
                    <textarea asp-for="Specifications" class="form-control" rows="5" placeholder="Weight: 1.2 kg&#10;Waterproof: Yes" aria-describedby="spec-help"></textarea>
                    <p class="small text-muted mt-1 mb-0" id="spec-help">One per line as <code>Name: Value</code>. Shown as a table on the product page.</p>
                </div>
            </section>

            <section class="panel" aria-labelledby="images-h">
                <div class="panel-head"><h2 id="images-h">Images</h2></div>
                <div class="panel-body">
                    <div class="row g-3 align-items-start">
                        @if (!string.IsNullOrEmpty(Model.ProImage))
                        {
                            <div class="col-auto">
                                <img src="~/Product/@Model.ProImage" alt="Current main image" class="rounded border bg-white p-1" width="120" height="120" style="object-fit:contain" />
                            </div>
                        }
                        <div class="col">
                            <label asp-for="File" class="form-label">@(isNew ? "Main image" : "Replace main image")</label>
                            <input asp-for="File" type="file" class="form-control" accept="image/jpeg,image/png,image/webp,image/gif" required="@isNew" aria-describedby="img-help" />
                            <span asp-validation-for="File" class="text-danger small"></span>
                        </div>
                    </div>
                    <hr />
                    @if (Model.AdditionalImageList.Count > 0)
                    {
                        <fieldset class="mb-3">
                            <legend class="form-label fs-6">Gallery — tick images to remove</legend>
                            <div class="img-picker">
                                @foreach (var img in Model.AdditionalImageList)
                                {
                                    <label>
                                        <input type="checkbox" name="removeImages" value="@img" class="form-check-input" aria-label="Remove this gallery image" />
                                        <img src="~/Product/@img" alt="" loading="lazy" />
                                    </label>
                                }
                            </div>
                        </fieldset>
                    }
                    <label asp-for="GalleryFiles" class="form-label">Add gallery images</label>
                    <input asp-for="GalleryFiles" type="file" multiple class="form-control" accept="image/jpeg,image/png,image/webp,image/gif" aria-describedby="img-help" />
                    <p class="small text-muted mt-1 mb-0" id="img-help">JPG, PNG, WebP or GIF up to 5 MB each. Up to 8 gallery images per upload.</p>
                </div>
            </section>
        </div>

        <div class="col-12 col-xl-4">
            <section class="panel" aria-labelledby="pricing-h">
                <div class="panel-head"><h2 id="pricing-h">Pricing &amp; stock</h2></div>
                <div class="panel-body">
                    <div class="mb-3">
                        <label asp-for="Price" class="form-label">Selling price (@StoreOptions.Value.CurrencySymbol)</label>
                        <input asp-for="Price" class="form-control" type="number" step="0.01" min="0.01" />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CompareAtPrice" class="form-label"></label>
                        <input asp-for="CompareAtPrice" class="form-control" type="number" step="0.01" min="0" aria-describedby="sale-help" />
                        <span asp-validation-for="CompareAtPrice" class="text-danger small"></span>
                        <p class="small text-muted mt-1 mb-0" id="sale-help">Fill in to show the product as on sale. Must be higher than the selling price.</p>
                    </div>
                    <div class="mb-0">
                        <label asp-for="StockQuantity" class="form-label"></label>
                        <input asp-for="StockQuantity" class="form-control" type="number" min="0" step="1" />
                        <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                    </div>
                </div>
            </section>

            <section class="panel" aria-labelledby="org-h">
                <div class="panel-head"><h2 id="org-h">Organisation</h2></div>
                <div class="panel-body">
                    <div class="mb-3">
                        <label asp-for="CatId" class="form-label"></label>
                        <select asp-for="CatId" class="form-select" asp-items="ViewBag.CategoryId">
                            <option value="0">Choose a category…</option>
                        </select>
                        <span asp-validation-for="CatId" class="text-danger small"></span>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input asp-for="IsActive" class="form-check-input" role="switch" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>
                    <div class="form-check form-switch">
                        <input asp-for="IsFeatured" class="form-check-input" role="switch" />
                        <label asp-for="IsFeatured" class="form-check-label"></label>
                    </div>
                </div>
            </section>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary btn-lg" data-busy-text="Saving…">@(isNew ? "Create product" : "Save changes")</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
