@model List<Product>
@{
    ViewData["Title"] = "Products";
    var store = StoreOptions.Value;
    string? search = ViewBag.Search;
    int? category = ViewBag.Category;
    string? stock = ViewBag.Stock;
    string? status = ViewBag.Status;
    int total = ViewBag.Total;
    var filtered = !string.IsNullOrEmpty(search) || category.HasValue || !string.IsNullOrEmpty(stock) || !string.IsNullOrEmpty(status);
    var pagination = new PaginationModel((int)ViewBag.Page, (int)ViewBag.PageCount,
        p => Url.Action("Index", new { search, category, stock, status, page = p })!);
}

<div class="admin-page-head">
    <div>
        <h1>Products</h1>
        <p>@total product@(total == 1 ? "" : "s")@(filtered ? " match the filters" : "")</p>
    </div>
    <a class="btn btn-primary" asp-action="Create"><i class="fa-solid fa-plus me-1" aria-hidden="true"></i>Add product</a>
</div>

<div class="panel">
    <div class="panel-body">
        <form method="get" class="filter-bar" role="search">
            <div class="grow">
                <label class="form-label small" for="search">Search</label>
                <input id="search" name="search" value="@search" class="form-control" placeholder="Name, brand or ID" />
            </div>
            <div>
                <label class="form-label small" for="category">Category</label>
                <select id="category" name="category" class="form-select" asp-items="ViewBag.Categories">
                    <option value="">All categories</option>
                </select>
            </div>
            <div>
                <label class="form-label small" for="stock">Stock</label>
                <select id="stock" name="stock" class="form-select">
                    <option value="">Any stock</option>
                    <option value="low" selected="@(stock == "low")">Low (1–5)</option>
                    <option value="out" selected="@(stock == "out")">Sold out</option>
                </select>
            </div>
            <div>
                <label class="form-label small" for="status">Visibility</label>
                <select id="status" name="status" class="form-select">
                    <option value="">All</option>
                    <option value="active" selected="@(status == "active")">Visible</option>
                    <option value="hidden" selected="@(status == "hidden")">Hidden</option>
                    <option value="sale" selected="@(status == "sale")">On sale</option>
                </select>
            </div>
            <div class="btns">
                <button class="btn btn-primary" type="submit">Filter</button>
                @if (filtered) { <a class="btn btn-outline-secondary" asp-action="Index">Clear</a> }
            </div>
        </form>
    </div>
</div>

<div class="panel">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <i class="fa-solid fa-box-open" aria-hidden="true"></i>
            <h2>@(filtered ? "No products match" : "No products yet")</h2>
            <p>@(filtered ? "Try different filters." : "Add your first product to start selling.")</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table admin-table">
                <thead>
                    <tr>
                        <th scope="col"><span class="visually-hidden">Image</span></th>
                        <th scope="col">Product</th>
                        <th scope="col">Category</th>
                        <th scope="col" class="text-end">Price</th>
                        <th scope="col">Stock</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(p.ProImage))
                                {
                                    <img class="thumb" src="~/Product/@p.ProImage" alt="" loading="lazy" width="48" height="48" />
                                }
                            </td>
                            <td class="min-w-0" style="max-width:320px">
                                <a asp-action="Edit" asp-route-id="@p.ProId" class="fw-semibold d-block text-truncate">@p.ProName</a>
                                <span class="small text-muted">#@p.ProId@(string.IsNullOrEmpty(p.Brand) ? "" : $" · {p.Brand}")</span>
                            </td>
                            <td class="text-nowrap">@p.Category?.CatName</td>
                            <td class="text-end text-nowrap">
                                @store.FormatPrice(p.Price)
                                @if (p.IsOnSale) { <div class="small text-muted text-decoration-line-through">@store.FormatPrice(p.CompareAtPrice!.Value)</div> }
                            </td>
                            <td>
                                <form class="d-flex gap-1 align-items-center" data-stock-form="@p.ProId" style="min-width:130px">
                                    <label class="visually-hidden" for="stock-@p.ProId">Stock for @p.ProName</label>
                                    <input id="stock-@p.ProId" type="number" min="0" max="1000000" step="1" class="form-control form-control-sm @(p.StockQuantity == 0 ? "is-invalid" : "")" style="width:80px" value="@p.StockQuantity" name="stockQuantity" required />
                                    <button class="btn btn-sm btn-outline-primary" type="submit" aria-label="Save stock for @p.ProName"><i class="fa-solid fa-check" aria-hidden="true"></i></button>
                                </form>
                            </td>
                            <td class="text-nowrap">
                                @if (p.IsActive) { <span class="badge text-bg-success">Visible</span> } else { <span class="badge text-bg-secondary">Hidden</span> }
                                @if (p.IsFeatured) { <span class="badge text-bg-light border ms-1">Featured</span> }
                                @if (p.IsOnSale) { <span class="badge ms-1" style="background:var(--hs-sale)">-@p.DiscountPercent%</span> }
                            </td>
                            <td class="actions">
                                @if (p.IsActive)
                                {
                                    <a class="btn btn-sm btn-outline-secondary" asp-area="" asp-controller="Home" asp-action="ProductDetailes" asp-route-id="@p.ProId" target="_blank" rel="noopener" aria-label="View @p.ProName in store"><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>
                                }
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@p.ProId">Edit</a>
                                <form method="post" asp-action="ToggleActive" asp-route-id="@p.ProId">
                                    <button class="btn btn-sm btn-outline-secondary" type="submit">@(p.IsActive ? "Hide" : "Show")</button>
                                </form>
                                <form method="post" asp-action="Delete" asp-route-id="@p.ProId" data-confirm="Delete “@p.ProName”? If it appears in past orders it will be hidden instead.">
                                    <button class="btn btn-sm btn-outline-danger" type="submit" aria-label="Delete @p.ProName"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_AdminPagination" model="pagination" />
    }
</div>

@section Scripts {
    <script>
        document.querySelectorAll('[data-stock-form]').forEach(form => {
            form.addEventListener('submit', async e => {
                e.preventDefault();
                const input = form.querySelector('input');
                const button = form.querySelector('button');
                const data = new FormData();
                data.append('id', form.dataset.stockForm);
                data.append('stockQuantity', input.value);
                button.disabled = true;
                try {
                    const response = await fetch('@Url.Action("UpdateStock")', { method: 'POST', body: data, headers: { 'Accept': 'application/json' } });
                    const result = await response.json();
                    HS.toast(result.message, result.success ? 'success' : 'error');
                    if (result.success) input.classList.toggle('is-invalid', Number(input.value) === 0);
                } catch {
                    HS.toast('Stock could not be updated.', 'error');
                } finally {
                    button.disabled = false;
                }
            });
        });
    </script>
}
