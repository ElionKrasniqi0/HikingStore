@model List<Product>
<br />
<br />
<br />
<br />
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <div class="card-tools">
                            <div class="input-group input-group-sm" style="width: 150px;">
                                <a asp-action="Create" asp-controller="Products" asp-area="Admin"
                                   class="btn btn-outline-success"> Add Product</a>
                            </div>
                        </div>
                    </div>

                    <div class="card-body table-responsive p-0">
                        <table class="table table-head-fixed">
                            <thead>
                                <tr>
                                    <th>Product Name</th>
                                    <th>Category</th>
                                    <th>Description</th>
                                    <th>Price</th>
                                    <th>Stock</th>
                                    <th>Status</th>
                                    <th>Image</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.ProName</td>
                                        <td>@item.Category?.CatName</td>
                                        <td>@item.Descreption</td>
                                        <td>€@item.Price.ToString("N2")</td>
                                        <td>
                                            <div class="stock-info">
                                                <span class="stock-quantity">@item.StockQuantity</span>
                                                <div class="stock-actions">
                                                    <button class="btn btn-xs btn-info update-stock-btn"
                                                            data-product-id="@item.ProId"
                                                            data-current-stock="@item.StockQuantity">
                                                        Update
                                                    </button>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            @if (item.IsInStock)
                                            {
                                                <span class="badge badge-success">In Stock</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-danger">Out of Stock</span>
                                            }
                                        </td>
                                        <td>
                                            <img src="~/Product/@item.ProImage" style="width:150px; height:150px;" />
                                        </td>
                                        <td>
                                            <a asp-action="Edit" asp-controller="Products" asp-route-id="@item.ProId"
                                               class="btn btn-outline-primary btn-sm">
                                                Edit
                                            </a>
                                            <a asp-action="Delete" asp-controller="Products" asp-route-id="@item.ProId"
                                               class="btn btn-outline-danger btn-sm">
                                                Delete
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Modal for updating stock -->
<div class="modal fade" id="updateStockModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Update Stock Quantity</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="updateStockForm">
                    <input type="hidden" id="productId" name="id">
                    <div class="form-group">
                        <label for="stockQuantity">Stock Quantity</label>
                        <input type="number" class="form-control" id="stockQuantity" name="stockQuantity" min="0" required>
                        <small class="form-text text-muted">Set to 0 to mark as out of stock</small>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveStockBtn">Save Changes</button>
            </div>
        </div>
    </div>
</div>

<style>
    .stock-info {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .stock-quantity {
        font-weight: bold;
        min-width: 40px;
    }

    .stock-actions .btn {
        padding: 0.1rem 0.5rem;
        font-size: 0.8rem;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Update stock button click
            $('.update-stock-btn').click(function() {
                var productId = $(this).data('product-id');
                var currentStock = $(this).data('current-stock');

                $('#productId').val(productId);
                $('#stockQuantity').val(currentStock);
                $('#updateStockModal').modal('show');
            });

            // Save stock changes
            $('#saveStockBtn').click(function() {
                var productId = $('#productId').val();
                var stockQuantity = $('#stockQuantity').val();

                $.ajax({
                    url: '@Url.Action("UpdateStock", "Products", new { area = "Admin" })',
                    type: 'POST',
                    data: {
                        id: productId,
                        stockQuantity: stockQuantity
                    },
                    success: function(response) {
                        if (response.success) {
                            location.reload();
                        } else {
                            alert('Error: ' + response.message);
                        }
                    },
                    error: function() {
                        alert('An error occurred while updating stock.');
                    }
                });
            });
        });
    </script>
}