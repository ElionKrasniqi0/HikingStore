@model List<Category>
@{
    ViewData["Title"] = "Categories";
    var counts = ViewBag.ProductCounts as Dictionary<int, int> ?? new();
    var parents = Model.Where(c => c.ParentCatId == null).ToList();
    var childrenOf = Model.Where(c => c.ParentCatId != null).ToLookup(c => c.ParentCatId!.Value);
    var rows = parents.SelectMany(p => new[] { p }.Concat(childrenOf[p.CatId])).ToList();
}

<div class="admin-page-head">
    <div>
        <h1>Categories</h1>
        <p>Top-level categories appear in the store menu; subcategories appear inside them. Lower display order shows first.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create"><i class="fa-solid fa-plus me-1" aria-hidden="true"></i>Add category</a>
</div>

<div class="panel">
    @if (rows.Count == 0)
    {
        <div class="empty-state">
            <i class="fa-solid fa-sitemap" aria-hidden="true"></i>
            <h2>No categories yet</h2>
            <p>Create a category before adding products.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table admin-table">
                <thead>
                    <tr>
                        <th scope="col"><span class="visually-hidden">Image</span></th>
                        <th scope="col">Name</th>
                        <th scope="col">Order</th>
                        <th scope="col">Products</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in rows)
                    {
                        var isChild = c.ParentCatId != null;
                        var count = counts.GetValueOrDefault(c.CatId);
                        var hasChildren = childrenOf[c.CatId].Any();
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(c.CatPhoto))
                                {
                                    <img class="thumb" src="~/category/@c.CatPhoto" alt="" loading="lazy" width="48" height="48" />
                                }
                            </td>
                            <td class="@(isChild ? "ps-4" : "")">
                                @if (isChild) { <i class="fa-solid fa-turn-up fa-rotate-90 text-muted me-2" aria-hidden="true"></i><span class="visually-hidden">Subcategory of @c.Parent?.CatName: </span> }
                                <a asp-action="Edit" asp-route-id="@c.CatId" class="fw-semibold">@c.CatName</a>
                                @if (!string.IsNullOrEmpty(c.Description)) { <div class="small text-muted text-truncate" style="max-width:360px">@c.Description</div> }
                            </td>
                            <td>@c.DisplayOrder</td>
                            <td>
                                @if (count > 0) { <a asp-controller="Products" asp-action="Index" asp-route-category="@c.CatId">@count</a> }
                                else { <span class="text-muted">0</span> }
                            </td>
                            <td class="actions">
                                <a class="btn btn-sm btn-outline-secondary" asp-area="" asp-controller="Home" asp-action="Shop" asp-route-category="@c.CatId" target="_blank" rel="noopener" aria-label="View @c.CatName in store"><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.CatId">Edit</a>
                                @if (count == 0 && !hasChildren)
                                {
                                    <form method="post" asp-action="Delete" asp-route-id="@c.CatId" data-confirm="Delete the category “@c.CatName”?">
                                        <button class="btn btn-sm btn-outline-danger" type="submit" aria-label="Delete @c.CatName"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-danger" type="button" disabled title="Move its products and subcategories first" aria-label="@c.CatName can't be deleted while it has products or subcategories"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
