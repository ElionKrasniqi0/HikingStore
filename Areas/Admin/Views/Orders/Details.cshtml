@model Order
@{
    ViewData["Title"] = $"Order {Model.OrderNumber}";
    var store = StoreOptions.Value;
    var isCancelled = Model.Status == OrderStatus.Cancelled;
    var milestones = new (string Label, DateTime? Date)[]
    {
        ("Placed", Model.OrderDate), ("Verified", Model.VerifiedDate), ("Processing", Model.ProcessingDate),
        ("Shipped", Model.ShippedDate), ("Completed", Model.CompletedDate), ("Cancelled", Model.CancelledDate)
    };
}

<div class="admin-page-head">
    <div>
        <h1>Order @Model.OrderNumber <partial name="_StatusBadge" model="Model.Status" /></h1>
        <p>Placed @Model.OrderDate.ToString("d MMM yyyy, HH:mm") UTC · @PaymentMethods.DisplayName(Model.PaymentMethod) · payment @Model.PaymentStatusLabel.ToLowerInvariant()</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary btn-sm" asp-action="Index"><i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>Orders</a>
        <a class="btn btn-outline-primary btn-sm" asp-action="Invoice" asp-route-id="@Model.OrderId" target="_blank" rel="noopener"><i class="fa-solid fa-print me-1" aria-hidden="true"></i>Invoice</a>
    </div>
</div>

@if (Model.PaymentStatus is PaymentStatuses.RefundDue or PaymentStatuses.RequiresReview)
{
    <div class="alert alert-danger" role="alert">
        <strong>@(Model.PaymentStatus == PaymentStatuses.RefundDue ? "Refund due." : "Payment needs review.")</strong>
        @(Model.PaymentStatus == PaymentStatuses.RefundDue
            ? $"Money was captured for this cancelled order. Refund payment {Model.PaymentTransactionId} in the {Model.PaymentProvider} dashboard; the status updates to Refunded when the provider confirms it."
            : $"The confirmed payment didn't match this order. Check payment {Model.PaymentTransactionId} in the {Model.PaymentProvider} dashboard before fulfilling it. See the admin notes for details.")
    </div>
}
else if (Model.IsAwaitingCardPayment)
{
    <div class="alert alert-warning" role="alert">
        <strong>Awaiting card payment.</strong> Don't prepare this order yet — it can only move past Received once @Model.PaymentProvider confirms the payment.
        @if (Model.PaymentExpiresAt.HasValue)
        {
            <text>It's released automatically if unpaid after @Model.PaymentExpiresAt.Value.ToString("d MMM, HH:mm") UTC.</text>
        }
    </div>
}

@if (Model.IsCardPayment)
{
    <section class="panel mb-3" aria-labelledby="payment-h">
        <div class="panel-head"><h2 id="payment-h">Card payment</h2></div>
        <dl class="row small m-0 p-3">
            <dt class="col-sm-4">Provider</dt><dd class="col-sm-8">@(Model.PaymentProvider ?? "—")</dd>
            <dt class="col-sm-4">Status</dt><dd class="col-sm-8">@Model.PaymentStatusLabel</dd>
            <dt class="col-sm-4">Paid</dt><dd class="col-sm-8">@(Model.PaidAt.HasValue ? $"{store.FormatPrice(Model.PaidAmount ?? 0)} on {Model.PaidAt.Value:d MMM yyyy, HH:mm} UTC" : "—")</dd>
            <dt class="col-sm-4">Payment reference</dt><dd class="col-sm-8 text-break">@(Model.PaymentTransactionId ?? "—")</dd>
            <dt class="col-sm-4">Checkout session</dt><dd class="col-sm-8 text-break">@(Model.PaymentSessionId ?? "—") (attempts: @Model.PaymentAttempts)</dd>
            @if (!string.IsNullOrEmpty(Model.PaymentFailureReason))
            {
                <dt class="col-sm-4">Last failure</dt><dd class="col-sm-8">@Model.PaymentFailureReason</dd>
            }
        </dl>
    </section>
}

<div class="row g-3">
    <div class="col-12 col-xl-8">
        <section class="panel" aria-labelledby="items-h">
            <div class="panel-head"><h2 id="items-h">Items</h2></div>
            <div class="table-responsive">
                <table class="table admin-table">
                    <thead><tr><th scope="col">Product</th><th scope="col" class="text-end">Price</th><th scope="col" class="text-end">Qty</th><th scope="col" class="text-end">Total</th></tr></thead>
                    <tbody>
                        @foreach (var line in Model.OrderDetails)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex gap-2 align-items-center">
                                        @if (!string.IsNullOrEmpty(line.Product?.ProImage))
                                        {
                                            <img class="thumb" src="~/Product/@line.Product.ProImage" alt="" loading="lazy" width="48" height="48" />
                                        }
                                        <div class="min-w-0">
                                            <a asp-controller="Products" asp-action="Edit" asp-route-id="@line.ProId" class="fw-semibold">@line.DisplayName</a>
                                            @if (!string.IsNullOrEmpty(line.SelectedSize) || !string.IsNullOrEmpty(line.SelectedColor))
                                            {
                                                <div class="small text-muted">@string.Join(" · ", new[] { line.SelectedColor, line.SelectedSize }.Where(v => !string.IsNullOrEmpty(v)))</div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td class="text-end text-nowrap">@store.FormatPrice(line.Price)</td>
                                <td class="text-end">@line.Quantity</td>
                                <td class="text-end text-nowrap">@store.FormatPrice(line.LineTotal)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="panel-body border-top">
                <dl class="row m-0 ms-auto small" style="max-width:340px">
                    <dt class="col-7 fw-normal">Subtotal</dt><dd class="col-5 text-end m-0">@store.FormatPrice(Model.Subtotal)</dd>
                    @if (Model.DiscountAmount > 0)
                    {
                        <dt class="col-7 fw-normal">Discount (@Model.CouponCode)</dt><dd class="col-5 text-end m-0">−@store.FormatPrice(Model.DiscountAmount)</dd>
                    }
                    <dt class="col-7 fw-normal">Shipping (@Model.ShippingService)</dt><dd class="col-5 text-end m-0">@store.FormatPrice(Model.ShippingCost)</dd>
                    <dt class="col-7 fs-6 pt-2 border-top mt-2">Total</dt><dd class="col-5 text-end fs-6 fw-bold pt-2 border-top mt-2 mb-0">@store.FormatPrice(Model.TotalAmount)</dd>
                </dl>
            </div>
        </section>

        <section class="panel" aria-labelledby="tracking-h">
            <div class="panel-head"><h2 id="tracking-h">Tracking history</h2></div>
            <div class="panel-body" data-tracking-history>
                <partial name="~/Views/Orders/_TrackingHistory.cshtml" model="Model.TrackingEvents" />
            </div>
            <div class="panel-body border-top">
                <h3 class="h6 font-body fw-bold">Add a tracking update</h3>
                <form class="row g-2" data-tracking-form>
                    <div class="col-12 col-md-4">
                        <label class="form-label small" for="t-status">Status</label>
                        <input class="form-control" id="t-status" name="status" maxlength="100" placeholder="In transit" required />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label small" for="t-location">Location</label>
                        <input class="form-control" id="t-location" name="location" maxlength="100" placeholder="Prishtina hub" required />
                    </div>
                    <div class="col-12 col-md-4 d-flex align-items-end">
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="t-milestone" name="isMilestone" value="true" />
                            <label class="form-check-label small" for="t-milestone">Highlight as milestone</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label small" for="t-desc">Description (visible to the customer)</label>
                        <input class="form-control" id="t-desc" name="description" maxlength="500" required />
                    </div>
                    <div class="col-12"><button class="btn btn-outline-primary btn-sm" type="submit">Add update</button></div>
                </form>
            </div>
        </section>
    </div>

    <div class="col-12 col-xl-4">
        <section class="panel" aria-labelledby="status-h">
            <div class="panel-head"><h2 id="status-h">Update order</h2></div>
            <div class="panel-body">
                @if (isCancelled)
                {
                    <p class="small text-muted">This order was cancelled and its stock has been returned. Cancelled orders can't be reopened.</p>
                }
                <form data-status-form>
                    <div class="mb-3">
                        <label class="form-label small" for="o-status">Status</label>
                        <select class="form-select" id="o-status" name="status" disabled="@isCancelled">
                            @foreach (var s in System.Enum.GetValues<OrderStatus>())
                            {
                                <option value="@s" selected="@(s == Model.Status)">@s</option>
                            }
                        </select>
                        <p class="small text-muted mt-1 mb-0">Cancelling returns the items to stock. The customer is emailed when the status changes.</p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small" for="o-carrier">Carrier</label>
                        <input class="form-control" id="o-carrier" name="carrier" value="@Model.Carrier" maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small" for="o-tracking">Tracking number</label>
                        <input class="form-control" id="o-tracking" name="trackingNumber" value="@Model.TrackingNumber" maxlength="100" aria-describedby="o-tracking-help" />
                        <p class="small text-muted mt-1 mb-0" id="o-tracking-help">Generated automatically when the order moves to Processing or Shipped, if left empty.</p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small" for="o-notes">Internal notes</label>
                        <textarea class="form-control" id="o-notes" name="adminNotes" rows="3" maxlength="2000">@Model.AdminNotes</textarea>
                    </div>
                    <button class="btn btn-primary w-100" type="submit" data-busy-text="Saving…">Save changes</button>
                </form>
            </div>
        </section>

        <section class="panel" aria-labelledby="cust-h">
            <div class="panel-head"><h2 id="cust-h">Customer</h2></div>
            <div class="panel-body small">
                <p class="mb-2"><strong>@(Model.FullName ?? Model.User?.DisplayName)</strong><br />
                    <a href="mailto:@(Model.Email ?? Model.User?.Email)">@(Model.Email ?? Model.User?.Email)</a><br />
                    <a href="tel:@Model.PhoneNumber">@Model.PhoneNumber</a></p>
                <h3 class="small-caps text-muted mt-3 mb-1">Ship to</h3>
                <p class="mb-0">@Model.ShippingAddress<br />@Model.PostalCode @Model.City<br />@Model.Country</p>
                @if (!string.IsNullOrWhiteSpace(Model.Comment))
                {
                    <h3 class="small-caps text-muted mt-3 mb-1">Customer note</h3>
                    <p class="mb-0" style="white-space:pre-wrap">@Model.Comment</p>
                }
                @if (Model.EstimatedDelivery.HasValue && !isCancelled && Model.Status != OrderStatus.Completed)
                {
                    <h3 class="small-caps text-muted mt-3 mb-1">Estimated delivery</h3>
                    <p class="mb-0">@Model.EstimatedDelivery.Value.ToString("ddd d MMM yyyy")</p>
                }
            </div>
        </section>

        <section class="panel" aria-labelledby="dates-h">
            <div class="panel-head"><h2 id="dates-h">Timeline (UTC)</h2></div>
            <ul class="list-group list-group-flush small">
                @foreach (var m in milestones.Where(m => m.Date.HasValue))
                {
                    <li class="list-group-item d-flex justify-content-between"><span>@m.Label</span><span class="text-muted">@m.Date!.Value.ToString("d MMM yyyy, HH:mm")</span></li>
                }
            </ul>
        </section>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const orderId = @Model.OrderId;
            const originalStatus = '@Model.Status';

            async function post(url, data) {
                const response = await fetch(url, { method: 'POST', body: data, headers: { 'Accept': 'application/json' } });
                if (!response.ok) throw new Error(response.status);
                return response.json();
            }

            const statusForm = document.querySelector('[data-status-form]');
            statusForm.addEventListener('submit', async e => {
                e.preventDefault();
                const data = new FormData(statusForm);
                const newStatus = statusForm.elements.status.value;
                if (newStatus === 'Cancelled' && originalStatus !== 'Cancelled'
                    && !confirm('Cancel this order? Items will be returned to stock and the customer will be notified.')) return;
                if (!data.has('status')) data.append('status', originalStatus);
                data.append('id', orderId);
                const button = statusForm.querySelector('button[type=submit]');
                button.disabled = true;
                try {
                    const result = await post('@Url.Action("UpdateStatus")', data);
                    HS.toast(result.message, result.success ? 'success' : 'error');
                    if (result.success) setTimeout(() => window.location.reload(), 900);
                    else button.disabled = false;
                } catch {
                    HS.toast('The order could not be updated.', 'error');
                    button.disabled = false;
                }
            });

            const trackingForm = document.querySelector('[data-tracking-form]');
            trackingForm.addEventListener('submit', async e => {
                e.preventDefault();
                const data = new FormData(trackingForm);
                data.append('orderId', orderId);
                const button = trackingForm.querySelector('button[type=submit]');
                button.disabled = true;
                try {
                    const result = await post('@Url.Action("AddTrackingEvent")', data);
                    HS.toast(result.message, result.success ? 'success' : 'error');
                    if (result.success) {
                        trackingForm.reset();
                        const html = await (await fetch('@Url.Action("GetTrackingHistory")?orderId=' + orderId)).text();
                        document.querySelector('[data-tracking-history]').innerHTML = html;
                    }
                } catch {
                    HS.toast('The tracking update could not be added.', 'error');
                } finally {
                    button.disabled = false;
                }
            });
        })();
    </script>
}
