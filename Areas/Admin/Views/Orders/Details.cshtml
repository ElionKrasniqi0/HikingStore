@model Order
@using HikingStore.Enum
<br />
<br />
<br />
<br />
<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1 text-gray-800">Order Details</h1>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary me-2">
                <i class="fas fa-arrow-left me-2"></i>Back to Orders
            </a>

            @if (Model.Status == OrderStatus.Cancelled || Model.Status == OrderStatus.Received)
            {
                <form asp-action="DeleteOrder" method="post"
                      onsubmit="return confirm('Are you sure you want to delete this order? This action cannot be undone.');"
                      class="d-inline">
                    <input type="hidden" name="id" value="@Model.OrderId" />
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger flex-grow-1">
                        <i class="fas fa-trash me-2"></i>Delete Order
                    </button>
                </form>
            }
            <a href="/Home/Product" class="btn btn-primary flex-grow-1">
                <i class="fas fa-shopping-bag me-2"></i>Shop Again
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <!-- Order Summary Card -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">Order Summary</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label text-muted small mb-1">Order ID</label>
                                <p class="fw-bold mb-0">#ORD@(Model.OrderId.ToString("D6"))</p>
                            </div>
                            <div class="mb-3">
                                <label class="form-label text-muted small mb-1">Order Date</label>
                                <p class="mb-0">@Model.OrderDate.ToString("MMMM dd, yyyy 'at' h:mm tt")</p>
                            </div>
                            <div class="mb-3">
                                <label class="form-label text-muted small mb-1">Customer</label>
                                <p class="mb-0">@Model.User.UserName</p>
                                <small class="text-muted">@Model.User.Email</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label text-muted small mb-1">Total Amount</label>
                                <p class="h5 text-success fw-bold mb-0">@Model.TotalAmount.ToString("C")</p>
                            </div>
                            <div class="mb-3">
                                <label class="form-label text-muted small mb-1">Status</label>
                                <div>
                                    @{
                                        var statusClass = Model.Status switch
                                        {
                                            OrderStatus.Received => "badge bg-primary",
                                            OrderStatus.Verified => "badge bg-info",
                                            OrderStatus.Processing => "badge bg-warning",
                                            OrderStatus.Shipped => "badge bg-secondary",
                                            OrderStatus.Completed => "badge bg-success",
                                            OrderStatus.Cancelled => "badge bg-danger",
                                            _ => "badge bg-primary"
                                        };
                                    }
                                    <span class="@statusClass">@Model.Status</span>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.TrackingNumber) && Model.TrackingNumber != "N/A")
                            {
                                <div class="mb-3">
                                    <label class="form-label text-muted small mb-1">Tracking Number</label>
                                    <p class="mb-0 font-monospace">@Model.TrackingNumber</p>
                                    <small class="text-muted">Carrier: @Model.Carrier</small>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Order Items Card -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">Order Items (@Model.OrderDetails.Sum(od => od.Quantity) items)</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="border-0">Product</th>
                                    <th class="border-0">Price</th>
                                    <th class="border-0">Quantity</th>
                                    <th class="border-0 text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderDetails)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="flex-shrink-0">
                                                    <img src="~/Product/@item.Product.ProImage"
                                                         alt="@item.Product.ProName"
                                                         class="rounded"
                                                         style="width: 50px; height: 50px; object-fit: cover;">
                                                </div>
                                                <div class="flex-grow-1 ms-3">
                                                    <h6 class="mb-0">@item.Product.ProName</h6>
                                                    <small class="text-muted">@item.Product.Category?.CatName</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>@item.Price.ToString("C")</td>
                                        <td>@item.Quantity</td>
                                        <td class="text-end fw-bold">@((item.Price * item.Quantity).ToString("C"))</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="3" class="text-end fw-bold">Subtotal:</td>
                                    <td class="text-end fw-bold">@Model.TotalAmount.ToString("C")</td>
                                </tr>
                                <tr>
                                    <td colspan="3" class="text-end fw-bold">Shipping:</td>
                                    <td class="text-end text-success">Free</td>
                                </tr>
                                <tr>
                                    <td colspan="3" class="text-end fw-bold">Total:</td>
                                    <td class="text-end fw-bold text-success">@Model.TotalAmount.ToString("C")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Shipping Information Card -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">Shipping Information</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label text-muted small mb-1">Shipping Address</label>
                        <p class="mb-0">@Model.ShippingAddress</p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small mb-1">City</label>
                        <p class="mb-0">@Model.City</p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small mb-1">Phone Number</label>
                        <p class="mb-0">@Model.PhoneNumber</p>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Comment))
                    {
                        <div class="mb-3">
                            <label class="form-label text-muted small mb-1">Customer Comment</label>
                            <p class="mb-0 text-muted">@Model.Comment</p>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.AdminNotes))
                    {
                        <div class="mb-3">
                            <label class="form-label text-muted small mb-1">Admin Notes</label>
                            <p class="mb-0 text-muted">@Model.AdminNotes</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Order Timeline Card -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">Order Timeline</h5>
                </div>
                <div class="card-body">
                    <div class="timeline">
                        <div class="timeline-item @(Model.OrderDate != null ? "completed" : "")">
                            <div class="timeline-marker bg-primary"></div>
                            <div class="timeline-content">
                                <h6 class="mb-1">Order Placed</h6>
                                <small class="text-muted">@Model.OrderDate.ToString("MMM dd, yyyy hh:mm tt")</small>
                            </div>
                        </div>
                        @if (Model.VerifiedDate != null)
                        {
                            <div class="timeline-item completed">
                                <div class="timeline-marker bg-success"></div>
                                <div class="timeline-content">
                                    <h6 class="mb-1">Order Verified</h6>
                                    <small class="text-muted">@Model.VerifiedDate.Value.ToString("MMM dd, yyyy hh:mm tt")</small>
                                </div>
                            </div>
                        }
                        @if (Model.ShippedDate != null)
                        {
                            <div class="timeline-item completed">
                                <div class="timeline-marker bg-info"></div>
                                <div class="timeline-content">
                                    <h6 class="mb-1">Order Shipped</h6>
                                    <small class="text-muted">@Model.ShippedDate.Value.ToString("MMM dd, yyyy hh:mm tt")</small>
                                </div>
                            </div>
                        }
                        @if (Model.CompletedDate != null)
                        {
                            <div class="timeline-item completed">
                                <div class="timeline-marker bg-success"></div>
                                <div class="timeline-content">
                                    <h6 class="mb-1">Order Completed</h6>
                                    <small class="text-muted">@Model.CompletedDate.Value.ToString("MMM dd, yyyy hh:mm tt")</small>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Delete Order #ORD@(Model.OrderId.ToString("D6"))</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Warning:</strong> This action cannot be undone!
                </div>
                <p>Are you sure you want to delete this order?</p>
                <ul class="text-danger">
                    <li>Order details will be permanently removed</li>
                    <li>Tracking information will be deleted</li>
                    <li>This action cannot be reversed</li>
                </ul>
                <div class="form-check mt-3">
                    <input class="form-check-input" type="checkbox" id="confirmDeleteCheck">
                    <label class="form-check-label" for="confirmDeleteCheck">
                        I understand this action is permanent
                    </label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn" disabled>
                    <i class="fas fa-trash me-2"></i>Delete Order
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Status Update Modal -->
<div class="modal fade" id="statusModal" tabindex="-1" aria-labelledby="statusModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="statusModalLabel">Update Order Status</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="orderIdForStatus">
                <div class="mb-3">
                    <label class="form-label">New Status</label>
                    <select class="form-select" id="newStatus">
                        <option value="Received">Received</option>
                        <option value="Verified">Verified</option>
                        <option value="Processing">Processing</option>
                        <option value="Shipped">Shipped</option>
                        <option value="Completed">Completed</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Tracking Number (if shipping)</label>
                    <input type="text" class="form-control" id="trackingNumber" placeholder="Enter tracking number">
                </div>
                <div class="mb-3">
                    <label class="form-label">Admin Notes</label>
                    <textarea class="form-control" id="adminNotes" rows="3" placeholder="Add internal notes..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="updateStatusBtn">Update Status</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .timeline {
            position: relative;
            padding-left: 30px;
        }

        .timeline-item {
            position: relative;
            padding-bottom: 20px;
        }

            .timeline-item:last-child {
                padding-bottom: 0;
            }

        .timeline-marker {
            position: absolute;
            left: -30px;
            top: 0;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            border: 3px solid white;
            z-index: 2;
        }

        .timeline-item.completed .timeline-marker {
            background-color: #28a745 !important;
        }

        .timeline-item:not(.completed) .timeline-marker {
            background-color: #e9ecef !important;
        }

        .timeline-item:not(:last-child):after {
            content: '';
            position: absolute;
            left: -23px;
            top: 16px;
            bottom: -20px;
            width: 2px;
            background-color: #e9ecef;
            z-index: 1;
        }

        .timeline-item.completed:not(:last-child):after {
            background-color: #28a745;
        }

        .timeline-content h6 {
            font-size: 0.9rem;
            margin-bottom: 2px;
        }

        .timeline-content small {
            font-size: 0.8rem;
        }

        .badge {
            font-size: 0.75rem;
            font-weight: 500;
            padding: 0.35em 0.65em;
        }

        .font-monospace {
            font-family: 'Courier New', monospace;
            font-size: 0.9rem;
        }
    </style>
}

@section Scripts {
    <script>
        // Enable delete button when checkbox is checked
        document.getElementById('confirmDeleteCheck')?.addEventListener('change', function() {
            document.getElementById('confirmDeleteBtn').disabled = !this.checked;
        });

        // Handle delete confirmation
        document.getElementById('confirmDeleteBtn')?.addEventListener('click', function() {
            deleteOrder(@Model.OrderId);
        });

        function deleteOrder(orderId) {
            const deleteButton = document.getElementById('confirmDeleteBtn');
            const originalText = deleteButton.innerHTML;

            // Show loading state
            deleteButton.disabled = true;
            deleteButton.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Deleting...';

            // Get anti-forgery token
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            fetch('@Url.Action("DeleteOrder", "Orders", new { area = "Admin" })', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: `id=${orderId}`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Show success message
                    showNotification('Order deleted successfully! Redirecting...', 'success');

                    // Close modal
                    const modal = bootstrap.Modal.getInstance(document.getElementById('deleteModal'));
                    modal.hide();

                    // Redirect to orders list after a short delay
                    setTimeout(() => {
                        window.location.href = '@Url.Action("Index", "Orders", new { area = "Admin" })';
                    }, 1500);
                } else {
                    showNotification(data.message || 'Error deleting order', 'error');
                    deleteButton.disabled = false;
                    deleteButton.innerHTML = originalText;
                }
            })
            .catch(error => {
                showNotification('Error deleting order: ' + error.message, 'error');
                deleteButton.disabled = false;
                deleteButton.innerHTML = originalText;
            });
        }

        function updateStatus(orderId, currentStatus) {
            document.getElementById('orderIdForStatus').value = orderId;
            document.getElementById('newStatus').value = currentStatus;

            const modal = new bootstrap.Modal(document.getElementById('statusModal'));
            modal.show();
        }

        // Handle status update
        document.getElementById('updateStatusBtn')?.addEventListener('click', function() {
            const orderId = document.getElementById('orderIdForStatus').value;
            const status = document.getElementById('newStatus').value;
            const trackingNumber = document.getElementById('trackingNumber').value;
            const adminNotes = document.getElementById('adminNotes').value;

            const updateButton = this;
            const originalText = updateButton.innerHTML;

            // Show loading state
            updateButton.disabled = true;
            updateButton.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Updating...';

            // Get anti-forgery token
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            fetch('@Url.Action("UpdateStatus", "Orders", new { area = "Admin" })', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: `id=${orderId}&status=${status}&trackingNumber=${encodeURIComponent(trackingNumber)}&adminNotes=${encodeURIComponent(adminNotes)}&carrier=Standard Shipping`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showNotification('Order status updated successfully!', 'success');

                    // Close modal and refresh page
                    setTimeout(() => {
                        bootstrap.Modal.getInstance(document.getElementById('statusModal')).hide();
                        location.reload();
                    }, 1500);
                } else {
                    showNotification(data.message || 'Error updating status', 'error');
                    updateButton.disabled = false;
                    updateButton.innerHTML = originalText;
                }
            })
            .catch(error => {
                showNotification('Error updating status: ' + error.message, 'error');
                updateButton.disabled = false;
                updateButton.innerHTML = originalText;
            });
        });

        function printOrder() {
            window.print();
        }

        function showNotification(message, type) {
            // Create toast notification
            const toast = document.createElement('div');
            toast.className = `toast align-items-center text-white bg-${type === 'success' ? 'success' : 'danger'} border-0 position-fixed top-0 end-0 m-3`;
            toast.style.zIndex = '1060';
            toast.innerHTML = `
                <div class="d-flex">
                    <div class="toast-body">${message}</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            `;
            document.body.appendChild(toast);

            const bsToast = new bootstrap.Toast(toast);
            bsToast.show();

            // Remove toast after hiding
            toast.addEventListener('hidden.bs.toast', () => {
                toast.remove();
            });
        }

        // Auto-hide notifications after 5 seconds
        setTimeout(() => {
            const toasts = document.querySelectorAll('.toast');
            toasts.forEach(toast => {
                const bsToast = bootstrap.Toast.getInstance(toast);
                if (bsToast) {
                    bsToast.hide();
                }
            });
        }, 5000);
    </script>
}