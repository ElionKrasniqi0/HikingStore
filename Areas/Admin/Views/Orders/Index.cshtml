@model List<Order>
@{
    ViewData["Title"] = "Orders";
    var store = StoreOptions.Value;
    string currentStatus = ViewBag.CurrentStatus ?? "";
    string search = ViewBag.SearchQuery ?? "";
    int total = ViewBag.Total;
    var counts = ViewBag.StatusCounts as Dictionary<OrderStatus, int> ?? new();
    var pagination = new PaginationModel((int)ViewBag.Page, (int)ViewBag.PageCount,
        p => Url.Action("Index", new { status = currentStatus, search, page = p })!);
}

<div class="admin-page-head">
    <div>
        <h1>Orders</h1>
        <p>@total order@(total == 1 ? "" : "s")@(string.IsNullOrEmpty(search) ? "" : $" matching “{search}”"). Times are UTC.</p>
    </div>
    <a class="btn btn-outline-primary" asp-action="ExportToExcel" asp-route-status="@currentStatus" asp-route-search="@search">
        <i class="fa-solid fa-file-excel me-1" aria-hidden="true"></i>Export to Excel
    </a>
</div>

<nav class="status-tabs" aria-label="Filter by status">
    <a class="@(string.IsNullOrEmpty(currentStatus) ? "active" : "")" asp-action="Index" asp-route-search="@search" aria-current="@(string.IsNullOrEmpty(currentStatus) ? "page" : null)">All<span class="n">@counts.Values.Sum()</span></a>
    @foreach (var s in System.Enum.GetValues<OrderStatus>())
    {
        var active = currentStatus == s.ToString();
        <a class="@(active ? "active" : "")" asp-action="Index" asp-route-status="@s" asp-route-search="@search" aria-current="@(active ? "page" : null)">@s<span class="n">@counts.GetValueOrDefault(s)</span></a>
    }
</nav>

<div class="panel">
    <div class="panel-body">
        <form method="get" class="filter-bar" role="search">
            <input type="hidden" name="status" value="@currentStatus" />
            <div class="grow">
                <label class="form-label small" for="search">Search</label>
                <input id="search" name="search" value="@search" class="form-control" placeholder="Order number, name, email, phone or tracking number" />
            </div>
            <div class="btns">
                <button class="btn btn-primary" type="submit">Search</button>
                @if (!string.IsNullOrEmpty(search)) { <a class="btn btn-outline-secondary" asp-action="Index" asp-route-status="@currentStatus">Clear</a> }
            </div>
        </form>
    </div>
</div>

<div class="panel">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <i class="fa-solid fa-receipt" aria-hidden="true"></i>
            <h2>No orders found</h2>
            <p>@(string.IsNullOrEmpty(search) && string.IsNullOrEmpty(currentStatus) ? "Orders will appear here once customers check out." : "Try a different status or search.")</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table admin-table">
                <thead>
                    <tr>
                        <th scope="col">Order</th>
                        <th scope="col">Customer</th>
                        <th scope="col">Date</th>
                        <th scope="col">Items</th>
                        <th scope="col">Payment</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model)
                    {
                        <tr>
                            <td><a asp-action="Details" asp-route-id="@o.OrderId" class="fw-semibold">@o.OrderNumber</a></td>
                            <td class="min-w-0" style="max-width:260px">
                                <div class="text-truncate">@(o.FullName ?? o.User?.DisplayName)</div>
                                <div class="small text-muted text-truncate">@(o.Email ?? o.User?.Email)</div>
                            </td>
                            <td class="text-nowrap">@o.OrderDate.ToString("d MMM yyyy")<div class="small text-muted">@o.OrderDate.ToString("HH:mm")</div></td>
                            <td>@o.OrderDetails.Sum(d => d.Quantity)</td>
                            <td class="text-nowrap small">@PaymentMethods.DisplayName(o.PaymentMethod)<div class="@(o.PaymentStatus is PaymentStatuses.RefundDue or PaymentStatuses.RequiresReview ? "text-danger fw-semibold" : "text-muted")">@o.PaymentStatusLabel</div></td>
                            <td><partial name="_StatusBadge" model="o.Status" /></td>
                            <td class="text-end text-nowrap fw-semibold">@store.FormatPrice(o.TotalAmount)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_AdminPagination" model="pagination" />
    }
</div>
