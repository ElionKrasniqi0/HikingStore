@model ChatRoom
@{
    ViewData["Title"] = $"Chat: {Model.Subject}";
    var isOpen = Model.Status is ChatRoomStatus.Open or ChatRoomStatus.InProgress;
}

<div class="admin-page-head">
    <div>
        <h1>@Model.Subject</h1>
        <p>@(Model.User?.Email ?? "Unknown customer") · started @Model.CreatedAt.ToString("d MMM yyyy, HH:mm") UTC · <span class="badge text-bg-light border">@Model.Status</span></p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-secondary btn-sm" asp-action="Index"><i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>All chats</a>
        @if (isOpen)
        {
            <form method="post" asp-action="ResolveRoom" asp-route-id="@Model.Id"><button class="btn btn-sm btn-primary" type="submit">Mark resolved</button></form>
            <form method="post" asp-action="CloseRoom" asp-route-id="@Model.Id" data-confirm="Close this chat?"><button class="btn btn-sm btn-outline-secondary" type="submit">Close</button></form>
        }
        else
        {
            <form method="post" asp-action="ReopenRoom" asp-route-id="@Model.Id"><button class="btn btn-sm btn-outline-primary" type="submit">Reopen</button></form>
            <form method="post" asp-action="DeleteRoom" asp-route-id="@Model.Id" data-confirm="Permanently delete this conversation?"><button class="btn btn-sm btn-outline-danger" type="submit">Delete</button></form>
        }
    </div>
</div>

<section class="panel chat-panel" aria-label="Conversation">
    <div class="chat-log" id="chatLog" role="log" aria-live="polite">
        @foreach (var message in Model.Messages.OrderBy(m => m.SentAt))
        {
            <div class="chat-msg @(message.IsAgentMessage ? "mine" : "")">
                <div class="chat-bubble">
                    <div class="chat-meta">@(message.IsAgentMessage ? "Support" : "Customer") · @message.SentAt.ToString("d MMM, HH:mm")</div>
                    <div class="chat-body">@message.Message</div>
                </div>
            </div>
        }
        <p class="small text-muted m-0" id="typingIndicator" hidden>Customer is typing…</p>
    </div>
    <div class="chat-compose">
        @if (!isOpen)
        {
            <p class="small text-muted mb-2">This chat is @Model.Status.ToString().ToLowerInvariant(). Sending a message will reopen it.</p>
        }
        <form id="messageForm" class="d-flex gap-2">
            <label for="messageInput" class="visually-hidden">Message</label>
            <input type="text" id="messageInput" class="form-control" placeholder="Type a reply…" autocomplete="off" maxlength="2000" />
            <button type="submit" class="btn btn-primary" id="sendButton" aria-label="Send"><i class="fa-solid fa-paper-plane" aria-hidden="true"></i></button>
        </form>
        <p class="small text-danger mt-2 mb-0" id="connectionStatus" hidden>Connecting to chat…</p>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            const chatRoomId = @Model.Id;
            const log = document.getElementById('chatLog');
            const typing = document.getElementById('typingIndicator');
            const input = document.getElementById('messageInput');
            const sendButton = document.getElementById('sendButton');
            const status = document.getElementById('connectionStatus');
            let isTyping = false, typingTimeout, hideTypingTimeout;

            const connection = new signalR.HubConnectionBuilder()
                .withUrl('/chatHub')
                .withAutomaticReconnect()
                .build();

            const scrollToBottom = () => { log.scrollTop = log.scrollHeight; };
            function setStatus(text) { status.textContent = text || ''; status.hidden = !text; }

            function appendMessage(m) {
                const row = document.createElement('div');
                row.className = 'chat-msg' + (m.isAgentMessage ? ' mine' : '');
                const bubble = document.createElement('div');
                bubble.className = 'chat-bubble';
                const meta = document.createElement('div');
                meta.className = 'chat-meta';
                const sent = new Date(m.sentAt);
                meta.textContent = (m.isAgentMessage ? 'Support' : 'Customer') + ' · ' + sent.toLocaleString(undefined, { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
                const body = document.createElement('div');
                body.className = 'chat-body';
                body.textContent = m.message;
                bubble.append(meta, body);
                row.appendChild(bubble);
                log.insertBefore(row, typing);
                scrollToBottom();
            }

            connection.on('ReceiveMessage', m => { typing.hidden = true; appendMessage(m); });
            connection.on('UserTyping', data => {
                typing.hidden = !data.isTyping;
                clearTimeout(hideTypingTimeout);
                if (data.isTyping) { scrollToBottom(); hideTypingTimeout = setTimeout(() => typing.hidden = true, 4000); }
            });
            connection.on('ErrorMessage', message => HS.toast(message, 'error'));
            connection.onreconnecting(() => setStatus('Connection lost. Reconnecting…'));
            connection.onreconnected(() => { setStatus(''); connection.invoke('JoinRoom', chatRoomId); });
            connection.onclose(() => setStatus('Disconnected from chat. Refresh the page to reconnect.'));

            async function start() {
                try {
                    await connection.start();
                    await connection.invoke('JoinRoom', chatRoomId);
                    setStatus('');
                } catch {
                    setStatus('Could not connect to chat. Retrying…');
                    setTimeout(start, 5000);
                }
            }

            document.getElementById('messageForm').addEventListener('submit', async e => {
                e.preventDefault();
                const message = input.value.trim();
                if (!message) return;
                sendButton.disabled = true;
                try {
                    await connection.invoke('SendMessage', chatRoomId, message);
                    input.value = '';
                    stopTyping();
                } catch {
                    HS.toast('The message could not be sent. Please try again.', 'error');
                } finally {
                    sendButton.disabled = false;
                    input.focus();
                }
            });

            input.addEventListener('input', () => {
                if (!isTyping && connection.state === signalR.HubConnectionState.Connected) {
                    isTyping = true;
                    connection.invoke('Typing', chatRoomId, true).catch(() => { });
                }
                clearTimeout(typingTimeout);
                typingTimeout = setTimeout(stopTyping, 1200);
            });
            function stopTyping() {
                if (!isTyping) return;
                isTyping = false;
                connection.invoke('Typing', chatRoomId, false).catch(() => { });
            }

            scrollToBottom();
            setStatus('Connecting to chat…');
            start();
        })();
    </script>
}
