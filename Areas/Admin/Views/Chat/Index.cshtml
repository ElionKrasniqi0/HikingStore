@model IEnumerable<ChatRoom>
@{
    ViewData["Title"] = "Live chat";
    string StatusClass(ChatRoomStatus s) => s switch
    {
        ChatRoomStatus.Open => "text-bg-warning",
        ChatRoomStatus.InProgress => "text-bg-primary",
        ChatRoomStatus.Resolved => "text-bg-success",
        _ => "text-bg-secondary"
    };
}

<div class="admin-page-head">
    <div>
        <h1>Live chat</h1>
        <p>Conversations started by signed-in customers. Opening an unassigned chat assigns it to you.</p>
    </div>
    <span class="badge text-bg-danger fs-6" data-unread hidden><span data-unread-count>0</span> with unread messages</span>
</div>

<div class="panel">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="fa-regular fa-comments" aria-hidden="true"></i>
            <h2>No conversations yet</h2>
            <p>Chats appear here when customers start one from the store.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table admin-table">
                <thead>
                    <tr>
                        <th scope="col">Subject</th>
                        <th scope="col">Customer</th>
                        <th scope="col">Agent</th>
                        <th scope="col">Status</th>
                        <th scope="col">Last message (UTC)</th>
                        <th scope="col">Unread</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var room in Model)
                    {
                        var unread = room.Messages.Count(m => !m.IsRead && !m.IsAgentMessage);
                        <tr class="@(unread > 0 ? "fw-semibold" : "")">
                            <td><a asp-action="Room" asp-route-id="@room.Id">@room.Subject</a></td>
                            <td class="text-break">@(room.User?.Email ?? "Unknown")</td>
                            <td>@(room.Agent?.DisplayName ?? "Unassigned")</td>
                            <td><span class="badge @StatusClass(room.Status)">@room.Status</span></td>
                            <td class="text-nowrap small">@room.LastMessageAt.ToString("d MMM yyyy, HH:mm")</td>
                            <td>@if (unread > 0) { <span class="badge text-bg-danger">@unread</span> } else { <span class="text-muted">–</span> }</td>
                            <td class="actions">
                                <a class="btn btn-sm btn-primary" asp-action="Room" asp-route-id="@room.Id">Open</a>
                                @if (room.Status is ChatRoomStatus.Resolved or ChatRoomStatus.Closed)
                                {
                                    <form method="post" asp-action="DeleteRoom" asp-route-id="@room.Id" data-confirm="Permanently delete this conversation?">
                                        <button class="btn btn-sm btn-outline-danger" type="submit" aria-label="Delete conversation"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            const badge = document.querySelector('[data-unread]');
            const count = document.querySelector('[data-unread-count]');
            async function refresh() {
                try {
                    const data = await (await fetch('@Url.Action("GetUnreadCount")')).json();
                    count.textContent = data.count;
                    badge.hidden = data.count === 0;
                } catch { }
            }
            refresh();
            setInterval(refresh, 15000);
        })();
    </script>
}
