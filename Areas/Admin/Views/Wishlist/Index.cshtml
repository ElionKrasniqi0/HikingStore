@model List<Wishlist>
@{
    ViewData["Title"] = "Wishlists";
    var store = StoreOptions.Value;
    string search = ViewBag.Search ?? "";
}

<div class="admin-page-head">
    <div>
        <h1>Wishlists</h1>
        <p>@Model.Count saved item@(Model.Count == 1 ? "" : "s")@(string.IsNullOrEmpty(search) ? "" : $" matching “{search}”").</p>
    </div>
    <a class="btn btn-outline-primary" asp-action="Statistics"><i class="fa-solid fa-chart-simple me-1" aria-hidden="true"></i>Insights</a>
</div>

<div class="panel">
    <div class="panel-body">
        <form method="get" class="filter-bar" role="search">
            <div class="grow">
                <label class="form-label small" for="search">Search</label>
                <input id="search" name="search" value="@search" class="form-control" placeholder="Product name or customer email" />
            </div>
            <div class="btns">
                <button class="btn btn-primary" type="submit">Search</button>
                @if (!string.IsNullOrEmpty(search)) { <a class="btn btn-outline-secondary" asp-action="Index">Clear</a> }
            </div>
        </form>
    </div>
</div>

<div class="panel">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <i class="fa-regular fa-heart" aria-hidden="true"></i>
            <h2>No saved items</h2>
            <p>Products customers save to their wishlist will appear here.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table admin-table">
                <thead><tr><th scope="col">Product</th><th scope="col">Customer</th><th scope="col" class="text-end">Price</th><th scope="col">Saved (UTC)</th><th scope="col" class="text-end">Actions</th></tr></thead>
                <tbody>
                    @foreach (var w in Model)
                    {
                        <tr data-wishlist-row>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    @if (!string.IsNullOrEmpty(w.Product?.ProImage)) { <img class="thumb" src="~/Product/@w.Product.ProImage" alt="" loading="lazy" width="48" height="48" /> }
                                    <div class="min-w-0">
                                        <a asp-controller="Products" asp-action="Edit" asp-route-id="@w.ProId">@w.Product?.ProName</a>
                                        <div class="small text-muted">@w.Product?.Category?.CatName</div>
                                    </div>
                                </div>
                            </td>
                            <td class="text-break">@w.ApplicationUser?.Email</td>
                            <td class="text-end text-nowrap">@(w.Product == null ? "" : store.FormatPrice(w.Product.Price))</td>
                            <td class="text-nowrap">@w.AddedDate.ToString("d MMM yyyy")</td>
                            <td class="actions">
                                <button class="btn btn-sm btn-outline-danger" type="button" data-remove-wishlist="@w.WishlistId" aria-label="Remove from this customer's wishlist"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.querySelectorAll('[data-remove-wishlist]').forEach(button => {
            button.addEventListener('click', async () => {
                if (!confirm('Remove this item from the customer\'s wishlist?')) return;
                const data = new FormData();
                data.append('id', button.dataset.removeWishlist);
                try {
                    const result = await (await fetch('@Url.Action("Delete")', { method: 'POST', body: data, headers: { 'Accept': 'application/json' } })).json();
                    HS.toast(result.message, result.success ? 'success' : 'error');
                    if (result.success) button.closest('[data-wishlist-row]').remove();
                } catch {
                    HS.toast('The item could not be removed.', 'error');
                }
            });
        });
    </script>
}
