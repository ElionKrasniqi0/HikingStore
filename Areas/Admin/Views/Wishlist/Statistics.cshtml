@using HikingStore.Models
@using Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    var totalWishlists = ViewBag.TotalWishlists ?? 0;
    var uniqueUsers = ViewBag.UniqueUsers ?? 0;
    var mostWishedProducts = ViewBag.MostWishedProducts as List<dynamic> ?? new List<dynamic>();
}

<style>
    .hero-section {
        background: linear-gradient(135deg, #3b5d50 0%, #2d4a3f 100%);
        color: white;
        padding: 30px 0;
        margin-bottom: 40px;
    }

    .stat-card {
        border-radius: 12px;
        border: none;
        transition: all 0.3s ease;
        overflow: hidden;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
    }
</style>
<br />
<br />
<br />

<!-- Hero Section -->
<div class="hero-section">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <h1>Wishlist Statistics</h1>
            <p>Analytics and insights about customer wishlists</p>
        </div>
        <div class="col-lg-4 text-end">
            <a href="@Url.Action("Index", "Wishlist", new { area = "Admin" })" class="btn btn-light btn-lg">
                <i class="fas fa-arrow-left me-2"></i>Back to Wishlists
            </a>
        </div>
    </div>
</div>

<div class="pb-5">
    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-xl-6 col-md-6 mb-3">
            <div class="card stat-card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="flex-grow-1">
                            <h4 class="mb-0">@totalWishlists</h4>
                            <p class="mb-0">Total Wishlist Items</p>
                        </div>
                        <div class="flex-shrink-0">
                            <i class="fas fa-heart fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-6 col-md-6 mb-3">
            <div class="card stat-card bg-info text-white">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="flex-grow-1">
                            <h4 class="mb-0">@uniqueUsers</h4>
                            <p class="mb-0">Unique Users with Wishlists</p>
                        </div>
                        <div class="flex-shrink-0">
                            <i class="fas fa-users fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Most Wished Products -->
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0 fw-semibold">Most Wished Products</h5>
        </div>
        <div class="card-body">
            @if (mostWishedProducts.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Rank</th>
                                <th>Product</th>
                                <th>Category</th>
                                <th>Price</th>
                                <th>Wishlist Count</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rank = 1;
                            }
                            @foreach (var item in mostWishedProducts)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-primary">#@rank</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="~/Product/@(item.Product?.ProImage ?? "")" 
                                                 alt="@(item.Product?.ProName ?? "")" 
                                                 class="rounded me-3" 
                                                 style="width: 50px; height: 50px; object-fit: cover;">
                                            <div>
                                                <h6 class="mb-0">@(item.Product?.ProName ?? "N/A")</h6>
                                                <small class="text-muted">@(item.Product?.Category?.CatName ?? "")</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@(item.Product?.Category?.CatName ?? "N/A")</td>
                                    <td><strong>€@((item.Product?.Price ?? 0).ToString("N2"))</strong></td>
                                    <td>
                                        <span class="badge bg-danger">@item.Count</span>
                                    </td>
                                    <td>
                                        <a href="/Home/ProductDetailes/@(item.Product?.ProId ?? 0)" 
                                           class="btn btn-sm btn-outline-primary" 
                                           target="_blank">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                                rank++;
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="far fa-heart fa-4x text-muted mb-3"></i>
                    <p class="text-muted">No wishlist data available</p>
                </div>
            }
        </div>
    </div>
</div>
