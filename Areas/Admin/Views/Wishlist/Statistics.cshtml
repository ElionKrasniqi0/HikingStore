@using HikingStore.Areas.Admin.Controllers
@{
    ViewData["Title"] = "Wishlist insights";
    var store = StoreOptions.Value;
    int totalWishlists = ViewBag.TotalWishlists ?? 0;
    int uniqueUsers = ViewBag.UniqueUsers ?? 0;
    var mostWished = ViewBag.MostWishedProducts as List<MostWishedProduct> ?? new();
}

<div class="admin-page-head">
    <div>
        <h1>Wishlist insights</h1>
        <p>What customers are saving for later — useful for restocking and promotions.</p>
    </div>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Index"><i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>All saved items</a>
</div>

<div class="kpis">
    <div class="kpi"><div class="l">Saved items</div><div class="v">@totalWishlists</div></div>
    <div class="kpi"><div class="l">Customers with a wishlist</div><div class="v">@uniqueUsers</div></div>
    <div class="kpi"><div class="l">Average per customer</div><div class="v">@(uniqueUsers == 0 ? "0" : (totalWishlists / (double)uniqueUsers).ToString("0.#"))</div></div>
</div>

<section class="panel" aria-labelledby="top-h">
    <div class="panel-head"><h2 id="top-h">Most wished-for products</h2></div>
    @if (mostWished.Count == 0)
    {
        <p class="panel-body text-muted m-0">No products have been saved yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table admin-table">
                <thead><tr><th scope="col">Product</th><th scope="col">Category</th><th scope="col" class="text-end">Price</th><th scope="col">Stock</th><th scope="col" class="text-end">Saved by</th></tr></thead>
                <tbody>
                    @foreach (var item in mostWished)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    @if (!string.IsNullOrEmpty(item.Product.ProImage)) { <img class="thumb" src="~/Product/@item.Product.ProImage" alt="" loading="lazy" width="48" height="48" /> }
                                    <a asp-controller="Products" asp-action="Edit" asp-route-id="@item.ProductId">@item.Product.ProName</a>
                                </div>
                            </td>
                            <td>@item.Product.Category?.CatName</td>
                            <td class="text-end text-nowrap">@store.FormatPrice(item.Product.Price)</td>
                            <td>@if (item.Product.StockQuantity == 0) { <span class="badge text-bg-danger">Sold out</span> } else { @item.Product.StockQuantity }</td>
                            <td class="text-end fw-semibold">@item.Count</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
