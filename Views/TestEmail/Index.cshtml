@{
    ViewData["Title"] = "Email test";
    ViewData["NoIndex"] = true;
}

<div class="container-hs">
    <div class="auth-wrap wide">
        <div class="card-hs">
            <h1>Email test</h1>
            <p class="text-muted">Send a test message to check that the store's SMTP settings work. Account confirmation, password reset and order emails all use these settings.</p>

            @if (ViewBag.Success != null)
            {
                <div class="alert alert-success" role="status">@ViewBag.Success</div>
            }
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger" role="alert">@ViewBag.Error</div>
            }

            <form method="post" asp-action="SendTestEmail" data-once>
                <div class="mb-3">
                    <label for="testEmail" class="form-label">Send to</label>
                    <input type="email" class="form-control" id="testEmail" name="testEmail" required autocomplete="email" />
                </div>
                <button type="submit" class="btn btn-primary w-100" data-busy-text="Sending…">Send test email</button>
            </form>

            <h2 class="h6 mt-4">Configuring email</h2>
            <p class="small text-muted mb-2">Keep credentials out of <code>appsettings.json</code>. In development, use user secrets:</p>
            <pre class="small bg-light border rounded p-2 mb-2"><code>dotnet user-secrets set "EmailSettings:SenderEmail" "you@example.com"
dotnet user-secrets set "EmailSettings:SenderPassword" "app-password"</code></pre>
            <p class="small text-muted mb-0">In production, set the environment variables <code>EmailSettings__SenderEmail</code> and <code>EmailSettings__SenderPassword</code>. For Gmail, turn on 2-Step Verification and create an <a href="https://myaccount.google.com/apppasswords" target="_blank" rel="noopener">app password</a>; your normal password won't work.</p>
        </div>
    </div>
</div>
