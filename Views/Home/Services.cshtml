@inject IOptions<StoreSettings> StoreOptions
@{
    var store = StoreOptions.Value;
    ViewData["Title"] = "Services";
    ViewData["Description"] = $"Gear advice, fitting, rental, repairs and guided hikes from {store.Name} in Prishtina.";
    ViewData["HelpSection"] = "Services";
    var services = new (string Icon, string Name, string Price, string Text)[]
    {
        ("fa-comments", "Gear consultation", "Free", "One-to-one advice on choosing gear for your skill level, budget and the trips you're planning."),
        ("fa-shoe-prints", "Boot & pack fitting", $"From {store.FormatPrice(25)}", "Fitting for boots, backpacks and technical clothing so your kit is comfortable over long days on the trail."),
        ("fa-campground", "Gear rental", $"From {store.FormatPrice(15)} / day", "Try quality equipment before you buy, or rent for a one-off trip. Daily and weekly rates, cleaned between rentals."),
        ("fa-screwdriver-wrench", "Repair & maintenance", $"From {store.FormatPrice(10)}", "From tent poles to zips and boot care, we keep your equipment in working order and help with warranty claims."),
        ("fa-person-hiking", "Guided hikes", $"From {store.FormatPrice(35)} / person", "Small-group hikes on Kosovo trails with an experienced guide. Suitable for different levels."),
        ("fa-box-archive", "Seasonal gear storage", $"From {store.FormatPrice(20)} / month", "Dry, temperature-controlled storage for seasonal equipment when you need space at home.")
    };
}

<div class="container-hs">
    <nav class="breadcrumb-bar" aria-label="Breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Services</li>
        </ol>
    </nav>
    <div class="page-head"><h1>Services</h1></div>
    <div class="help-layout">
        <partial name="_HelpNav" />
        <div>
            <p class="lead-muted">Beyond selling gear, our team in Prishtina can help you choose, fit, maintain and use it. Services are arranged in person — send a request and we'll reply by email to agree the details and price.</p>
            <div class="service-list">
                @foreach (var s in services)
                {
                    <article class="service-card">
                        <i class="fa-solid @s.Icon" aria-hidden="true"></i>
                        <h3>@s.Name</h3>
                        <p>@s.Text</p>
                        <div class="d-flex justify-content-between align-items-center gap-2 mt-2">
                            <strong>@s.Price</strong>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Contact" asp-route-subject="Service request: @s.Name">Request</a>
                        </div>
                    </article>
                }
            </div>
            <p class="small text-muted">Prices are starting prices; the final price depends on the item and is confirmed before any work begins. Services are offered at our store@(string.IsNullOrEmpty(store.Address) ? "" : $" ({store.Address})").</p>
        </div>
    </div>
</div>
