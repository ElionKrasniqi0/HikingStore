@{
    ViewData["Title"] = "Our Services";
}

<!-- Hero Section -->
<section class="services-hero py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <span class="badge bg-opacity-10 text-primary px-3 py-2 mb-3 fw-semibold">
                    <i class="fas fa-concierge-bell me-2"></i>Premium Services
                </span>
                <h1 class="display-4 fw-bold text-dark mb-4">Beyond Gear: Our Services</h1>
                <p class="lead text-muted mb-4">
                    At HikingStore, we provide comprehensive outdoor solutions that go beyond just selling equipment. From expert consultations to maintenance services, we're here to support your entire hiking journey.
                </p>
                <div class="hero-stats d-flex flex-wrap gap-4 mb-4">
                    <div class="stat">
                        <div class="stat-number text-primary fw-bold display-6">24/7</div>
                        <div class="stat-label">Expert Support</div>
                    </div>
                    <div class="stat">
                        <div class="stat-number text-primary fw-bold display-6">100%</div>
                        <div class="stat-label">Satisfaction Guarantee</div>
                    </div>
                    <div class="stat">
                        <div class="stat-number text-primary fw-bold display-6">Free</div>
                        <div class="stat-label">Gear Consultations</div>
                    </div>
                </div>
                <a href="#consultation" class="btn btn-primary btn-lg">
                    <i class="fas fa-calendar-check me-2"></i>Book Consultation
                </a>
            </div>
            <div class="col-lg-6">
                <div class="services-hero-image">
                    <img src="~/img/services-hero.jpg" alt="HikingStore Services" class="img-fluid rounded-4 shadow-lg">
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Main Services -->
<section class="main-services py-5 bg-light">
    <div class="container">
        <div class="row justify-content-center mb-5">
            <div class="col-lg-8 text-center">
                <span class="badge bg-opacity-10 text-primary px-3 py-2 mb-3 fw-semibold">
                    <i class="fas fa-star me-2"></i>Core Services
                </span>
                <h2 class="display-5 fw-bold text-dark mb-3">Comprehensive Outdoor Solutions</h2>
                <p class="lead text-muted">Everything you need for a successful adventure</p>
            </div>
        </div>

        <div class="row g-4">
            <!-- Gear Consultation -->
            <div class="col-lg-4 col-md-6">
                <div class="service-card">
                    <div class="service-icon">
                        <i class="fas fa-hiking"></i>
                    </div>
                    <h3 class="service-title">Personal Gear Consultation</h3>
                    <p class="service-description">
                        One-on-one sessions with our certified hiking experts to help you select the perfect gear based on your skill level, budget, and planned adventures.
                    </p>
                    <ul class="service-features">
                        <li><i class="fas fa-check text-success me-2"></i>Personalized gear recommendations</li>
                        <li><i class="fas fa-check text-success me-2"></i>Budget planning assistance</li>
                        <li><i class="fas fa-check text-success me-2"></i>Trail-specific equipment advice</li>
                    </ul>
                    <div class="service-footer">
                        <span class="service-price text-primary fw-bold">Free</span>
                        <a href="#consultation" class="btn btn-outline-primary btn-sm">Book Now</a>
                    </div>
                </div>
            </div>

            <!-- Gear Rental -->
            <div class="col-lg-4 col-md-6">
                <div class="service-card">
                    <div class="service-icon">
                        <i class="fas fa-suitcase-rolling"></i>
                    </div>
                    <h3 class="service-title">Premium Gear Rental</h3>
                    <p class="service-description">
                        Access top-quality equipment without the commitment of purchase. Perfect for beginners, occasional hikers, or those wanting to test gear before buying.
                    </p>
                    <ul class="service-features">
                        <li><i class="fas fa-check text-success me-2"></i>Daily, weekly, and monthly rates</li>
                        <li><i class="fas fa-check text-success me-2"></i>Professional cleaning included</li>
                        <li><i class="fas fa-check text-success me-2"></i>Delivery and pickup options</li>
                    </ul>
                    <div class="service-footer">
                        <span class="service-price text-primary fw-bold">From €15/day</span>
                        <a href="/Home/Rental" class="btn btn-outline-primary btn-sm">View Inventory</a>
                    </div>
                </div>
            </div>

            <!-- Repair & Maintenance -->
            <div class="col-lg-4 col-md-6">
                <div class="service-card">
                    <div class="service-icon">
                        <i class="fas fa-tools"></i>
                    </div>
                    <h3 class="service-title">Gear Repair & Maintenance</h3>
                    <p class="service-description">
                        Professional repair services for all types of hiking gear. From tent pole replacements to boot resoling, we keep your equipment in top condition.
                    </p>
                    <ul class="service-features">
                        <li><i class="fas fa-check text-success me-2"></i>Same-day minor repairs</li>
                        <li><i class="fas fa-check text-success me-2"></i>Warranty claim assistance</li>
                        <li><i class="fas fa-check text-success me-2"></i>Seasonal maintenance packages</li>
                    </ul>
                    <div class="service-footer">
                        <span class="service-price text-primary fw-bold">From €10</span>
                        <a href="#repair" class="btn btn-outline-primary btn-sm">Schedule Repair</a>
                    </div>
                </div>
            </div>

            <!-- Guided Hikes -->
            <div class="col-lg-4 col-md-6">
                <div class="service-card">
                    <div class="service-icon">
                        <i class="fas fa-map-marked-alt"></i>
                    </div>
                    <h3 class="service-title">Guided Hiking Tours</h3>
                    <p class="service-description">
                        Join our certified guides on scenic Kosovo trails. Suitable for all skill levels, these tours focus on safety, education, and enjoying nature responsibly.
                    </p>
                    <ul class="service-features">
                        <li><i class="fas fa-check text-success me-2"></i>Small group sizes (max 8)</li>
                        <li><i class="fas fa-check text-success me-2"></i>Safety equipment provided</li>
                        <li><i class="fas fa-check text-success me-2"></i>Local flora/fauna education</li>
                    </ul>
                    <div class="service-footer">
                        <span class="service-price text-primary fw-bold">From €35/person</span>
                        <a href="/Home/Tours" class="btn btn-outline-primary btn-sm">View Tours</a>
                    </div>
                </div>
            </div>

            <!-- Custom Fitting -->
            <div class="col-lg-4 col-md-6">
                <div class="service-card">
                    <div class="service-icon">
                        <i class="fas fa-ruler-combined"></i>
                    </div>
                    <h3 class="service-title">Custom Gear Fitting</h3>
                    <p class="service-description">
                        Professional fitting services for boots, backpacks, and technical clothing. Ensure maximum comfort and performance on the trail with perfectly fitted gear.
                    </p>
                    <ul class="service-features">
                        <li><i class="fas fa-check text-success me-2"></i>3D foot scanning for boots</li>
                        <li><i class="fas fa-check text-success me-2"></i>Backpack load testing</li>
                        <li><i class="fas fa-check text-success me-2"></i>Layering system consultation</li>
                    </ul>
                    <div class="service-footer">
                        <span class="service-price text-primary fw-bold">From €25</span>
                        <a href="#fitting" class="btn btn-outline-primary btn-sm">Book Fitting</a>
                    </div>
                </div>
            </div>

            <!-- Gear Storage -->
            <div class="col-lg-4 col-md-6">
                <div class="service-card">
                    <div class="service-icon">
                        <i class="fas fa-warehouse"></i>
                    </div>
                    <h3 class="service-title">Seasonal Gear Storage</h3>
                    <p class="service-description">
                        Climate-controlled storage solutions for your hiking gear. Perfect for seasonal equipment or when you need extra space at home.
                    </p>
                    <ul class="service-features">
                        <li><i class="fas fa-check text-success me-2"></i>Temperature & humidity control</li>
                        <li><i class="fas fa-check text-success me-2"></i>Regular maintenance checks</li>
                        <li><i class="fas fa-check text-success me-2"></i>Insurance options available</li>
                    </ul>
                    <div class="service-footer">
                        <span class="service-price text-primary fw-bold">From €20/month</span>
                        <a href="#storage" class="btn btn-outline-primary btn-sm">View Plans</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Service Booking -->
<section id="consultation" class="booking-section py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="booking-card">
                    <div class="row g-0">
                        <div class="col-lg-6">
                            <div class="booking-form p-4 p-lg-5">
                                <h2 class="fw-bold text-dark mb-4">Book Your Service</h2>
                                <form id="serviceBookingForm">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="form-label fw-semibold">Select Service</label>
                                                <select class="form-select" required>
                                                    <option value="">Choose a service...</option>
                                                    <option>Gear Consultation</option>
                                                    <option>Gear Rental</option>
                                                    <option>Gear Repair</option>
                                                    <option>Guided Tour</option>
                                                    <option>Custom Fitting</option>
                                                    <option>Gear Storage</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="form-label fw-semibold">Preferred Date</label>
                                                <input type="date" class="form-control" required>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="form-label fw-semibold">Your Name</label>
                                                <input type="text" class="form-control" placeholder="Enter your name" required>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="form-label fw-semibold">Phone Number</label>
                                                <input type="tel" class="form-control" placeholder="Enter your phone" required>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="form-group">
                                                <label class="form-label fw-semibold">Email Address</label>
                                                <input type="email" class="form-control" placeholder="Enter your email" required>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="form-group">
                                                <label class="form-label fw-semibold">Additional Notes</label>
                                                <textarea class="form-control" rows="3" placeholder="Tell us about your needs..."></textarea>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <button type="submit" class="btn btn-primary w-100">
                                                <i class="fas fa-calendar-check me-2"></i>Book Service
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="booking-info text-white p-4 p-lg-5 h-100">
                                <h3 class="text-white mb-4">Why Choose Our Services?</h3>
                                <div class="booking-features">
                                    <div class="feature-item mb-4">
                                        <div class="feature-icon mb-2">
                                            <i class="fas fa-award"></i>
                                        </div>
                                        <h5 class="text-white">Certified Experts</h5>
                                        <p class="text-white-80 mb-0">All our staff are certified hiking professionals with extensive trail experience.</p>
                                    </div>
                                    <div class="feature-item mb-4">
                                        <div class="feature-icon mb-2">
                                            <i class="fas fa-shield-alt"></i>
                                        </div>
                                        <h5 class="text-white">Quality Guarantee</h5>
                                        <p class="text-white-80 mb-0">100% satisfaction guarantee on all services. If you're not happy, we'll make it right.</p>
                                    </div>
                                    <div class="feature-item">
                                        <div class="feature-icon mb-2">
                                            <i class="fas fa-clock"></i>
                                        </div>
                                        <h5 class="text-white">Flexible Scheduling</h5>
                                        <p class="text-white-80 mb-0">Weekend and evening appointments available to fit your busy schedule.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Service FAQ -->
<section class="faq-section py-5 bg-light">
    <div class="container">
        <div class="row justify-content-center mb-5">
            <div class="col-lg-8 text-center">
                <span class="badge bg-opacity-10 text-primary px-3 py-2 mb-3 fw-semibold">
                    <i class="fas fa-question-circle me-2"></i>Service FAQ
                </span>
                <h2 class="display-5 fw-bold text-dark mb-3">Frequently Asked Questions</h2>
                <p class="lead text-muted">Common questions about our services</p>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="accordion" id="serviceFaq">
                    <div class="accordion-item border-0 mb-3">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                                <i class="fas fa-hiking me-3 text-primary"></i>
                                How long does a gear consultation take?
                            </button>
                        </h2>
                        <div id="faq1" class="accordion-collapse collapse" data-bs-parent="#serviceFaq">
                            <div class="accordion-body">
                                A standard consultation lasts 45-60 minutes. For comprehensive gear setups or multiple equipment types, we recommend booking a 90-minute session to ensure we cover all your needs thoroughly.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item border-0 mb-3">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                                <i class="fas fa-suitcase-rolling me-3 text-primary"></i>
                                What's included in gear rental?
                            </button>
                        </h2>
                        <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#serviceFaq">
                            <div class="accordion-body">
                                All rentals include the equipment, basic cleaning, and a quick-use tutorial. We also provide a gear checklist and safety guidelines. Optional add-ons include delivery service, insurance, and accessories.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item border-0 mb-3">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                                <i class="fas fa-calendar-alt me-3 text-primary"></i>
                                How far in advance should I book?
                            </button>
                        </h2>
                        <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#serviceFaq">
                            <div class="accordion-body">
                                We recommend booking at least 48 hours in advance for consultations and fittings. For guided tours, please book at least one week ahead, especially during peak seasons (spring and fall).
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item border-0 mb-3">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq4">
                                <i class="fas fa-tools me-3 text-primary"></i>
                                Do you repair gear not purchased from HikingStore?
                            </button>
                        </h2>
                        <div id="faq4" class="accordion-collapse collapse" data-bs-parent="#serviceFaq">
                            <div class="accordion-body">
                                Yes! We repair all major brands of hiking gear, regardless of where it was purchased. However, we may not be able to handle warranty claims for gear bought elsewhere.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item border-0">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq5">
                                <i class="fas fa-undo-alt me-3 text-primary"></i>
                                What is your cancellation policy?
                            </button>
                        </h2>
                        <div id="faq5" class="accordion-collapse collapse" data-bs-parent="#serviceFaq">
                            <div class="accordion-body">
                                You can cancel or reschedule appointments up to 24 hours in advance at no charge. Late cancellations (less than 24 hours) may incur a 50% fee. Guided tours require 48-hour notice for cancellations.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Contact CTA -->
<section class="cta-section py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <div class="cta-card rounded-4 p-5">
                    <h2 class="text-white mb-3">Ready to Elevate Your Hiking Experience?</h2>
                    <p class="text-white-80 mb-4">Our expert team is here to help you choose the perfect services for your adventure needs.</p>
                    <div class="d-flex flex-wrap justify-content-center gap-3">
                        <a href="tel:+383045804555" class="btn btn-light btn-lg">
                            <i class="fas fa-phone me-2"></i>Call Now
                        </a>
                        <a href="/Home/Contact" class="btn btn-outline-light btn-lg">
                            <i class="fas fa-envelope me-2"></i>Email Us
                        </a>
                        <a href="#consultation" class="btn btn-light btn-lg">
                            <i class="fas fa-calendar me-2"></i>Book Online
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    /* Services Hero */
    .services-hero {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    }

    .hero-stats {
        display: flex;
        gap: 2rem;
        flex-wrap: wrap;
    }

    .stat {
        text-align: center;
    }

    .stat-number {
        line-height: 1;
        margin-bottom: 0.25rem;
    }

    .stat-label {
        font-size: 0.9rem;
        color: #6c757d;
        font-weight: 500;
    }

    .services-hero-image img {
        transition: transform 0.3s ease;
    }

        .services-hero-image img:hover {
            transform: scale(1.02);
        }

    /* Service Cards */
    .service-card {
        background: white;
        border-radius: 16px;
        padding: 2rem;
        height: 100%;
        border: 1px solid rgba(0,0,0,0.05);
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
    }

        .service-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 40px rgba(59, 93, 80, 0.15);
        }

    .service-icon {
        width: 70px;
        height: 70px;
        background: rgba(59, 93, 80, 0.1);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.75rem;
        color: #3b5d50;
        margin-bottom: 1.5rem;
    }

    .service-title {
        color: #2d473d;
        font-weight: 700;
        margin-bottom: 1rem;
        font-size: 1.5rem;
    }

    .service-description {
        color: #6c757d;
        margin-bottom: 1.5rem;
        flex-grow: 1;
    }

    .service-features {
        list-style: none;
        padding: 0;
        margin: 0 0 1.5rem 0;
    }

        .service-features li {
            padding: 0.5rem 0;
            border-bottom: 1px solid rgba(0,0,0,0.05);
        }

            .service-features li:last-child {
                border-bottom: none;
            }

    .service-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: auto;
    }

    .service-price {
        font-size: 1.25rem;
    }

    /* Booking Section */
    .booking-card {
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1);
    }

    .booking-form {
        background: white;
        height: 100%;
    }

    .booking-info {
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .text-white-80 {
        color: rgba(255, 255, 255, 0.8);
    }

    .feature-icon {
        width: 50px;
        height: 50px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    /* FAQ */
    .accordion-button {
        padding: 1.25rem;
        border-radius: 12px !important;
        font-weight: 600;
        border: 1px solid rgba(0,0,0,0.05);
        background: white;
        color: #2d473d;
    }

        .accordion-button:not(.collapsed) {
            background: rgba(59, 93, 80, 0.1);
            color: #3b5d50;
            box-shadow: none;
        }

        .accordion-button:focus {
            box-shadow: 0 0 0 0.2rem rgba(59, 93, 80, 0.25);
        }

    .accordion-body {
        padding: 1.25rem;
        background: #f8f9fa;
        border-radius: 0 0 12px 12px;
    }

    /* CTA Section */
    .cta-card {
        background: linear-gradient(135deg, #2d473d 0%, #3b5d50 100%);
    }

    /* Form Styling */
    .form-select, .form-control {
        border: 1px solid #e9ecef;
        border-radius: 10px;
        padding: 0.75rem 1rem;
    }

        .form-select:focus, .form-control:focus {
            border-color: #3b5d50;
            box-shadow: 0 0 0 0.2rem rgba(59, 93, 80, 0.25);
        }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .display-4 {
            font-size: 2.5rem;
        }

        .display-5 {
            font-size: 2rem;
        }

        .hero-stats {
            gap: 1.5rem;
        }

        .service-card {
            padding: 1.5rem;
        }

        .booking-card {
            flex-direction: column;
        }

            .booking-card > div {
                width: 100%;
            }
    }

    @@media (max-width: 576px) {
        .display-4 {
            font-size: 2rem;
        }

        .display-5 {
            font-size: 1.75rem;
        }

        .service-footer {
            flex-direction: column;
            gap: 1rem;
            align-items: stretch;
        }

        .service-price {
            text-align: center;
        }

        .cta-card {
            padding: 2rem 1.5rem !important;
        }

        .d-flex.flex-wrap {
            flex-direction: column;
        }

            .d-flex.flex-wrap .btn {
                width: 100%;
                margin-bottom: 0.5rem;
            }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Service form submission
        const bookingForm = document.getElementById('serviceBookingForm');
        bookingForm?.addEventListener('submit', function(e) {
            e.preventDefault();

            // Show loading state
            const submitBtn = this.querySelector('button[type="submit"]');
            const originalText = submitBtn.innerHTML;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Booking...';
            submitBtn.disabled = true;

            // Simulate API call
            setTimeout(() => {
                // Show success message
                const successAlert = document.createElement('div');
                successAlert.className = 'alert alert-success mt-3';
                successAlert.innerHTML = `
                    <div class="d-flex align-items-center">
                        <i class="fas fa-check-circle fa-lg text-success me-3"></i>
                        <div>
                            <strong>Booking Request Submitted!</strong>
                            <p class="mb-0 small">We'll contact you within 24 hours to confirm your appointment.</p>
                        </div>
                    </div>
                `;

                this.prepend(successAlert);

                // Reset form and button
                this.reset();
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;

                // Scroll to success message
                successAlert.scrollIntoView({ behavior: 'smooth', block: 'center' });

                // Remove success message after 5 seconds
                setTimeout(() => {
                    successAlert.remove();
                }, 5000);
            }, 1500);
        });

        // Date input - disable past dates
        const dateInput = document.querySelector('input[type="date"]');
        if (dateInput) {
            const today = new Date().toISOString().split('T')[0];
            dateInput.min = today;
        }

        // Service card hover effects
        const serviceCards = document.querySelectorAll('.service-card');
        serviceCards.forEach(card => {
            card.addEventListener('mouseenter', function() {
                const icon = this.querySelector('.service-icon');
                icon.style.transform = 'scale(1.1) rotate(5deg)';
            });

            card.addEventListener('mouseleave', function() {
                const icon = this.querySelector('.service-icon');
                icon.style.transform = 'scale(1) rotate(0)';
            });
        });

        // FAQ accordion enhancement
        const accordionButtons = document.querySelectorAll('.accordion-button');
        accordionButtons.forEach(button => {
            button.addEventListener('click', function() {
                const icon = this.querySelector('i');
                if (this.classList.contains('collapsed')) {
                    icon.style.transform = 'rotate(0deg)';
                } else {
                    icon.style.transform = 'rotate(45deg)';
                }
            });
        });

        // Smooth scroll for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });
    });
</script>