@model HomeViewModel
@inject IOptions<StoreSettings> StoreOptions
@{
    var store = StoreOptions.Value;
    ViewData["Title"] = null;
    var heroImage = string.IsNullOrWhiteSpace(store.HeroImageUrl) ? null : Url.Content(store.HeroImageUrl.StartsWith("/") ? "~" + store.HeroImageUrl : store.HeroImageUrl);
    var hasSale = Model.OnSale.Count > 0;
    var categoriesWithPhotos = Model.Categories.Take(6).ToList();
}
@section Head {
    @if (heroImage != null)
    {
        <link rel="preload" as="image" href="@heroImage" fetchpriority="high" />
    }
}

<section class="hero" style="@(heroImage != null ? $"background-image:url('{heroImage}')" : "")" aria-labelledby="hero-title">
    <div class="container-hs">
        <div class="hero-content">
            <span class="eyebrow">Outdoor &amp; hiking gear</span>
            <h1 id="hero-title">Made for the long way up</h1>
            <p>Boots, packs and layers chosen for real trail conditions — with free standard shipping over @store.FormatPrice(store.FreeShippingThreshold) and @store.ReturnDays-day returns.</p>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-light btn-lg" asp-action="Shop" asp-route-sort="newest">Shop new arrivals</a>
                @if (hasSale)
                {
                    <a class="btn btn-sale btn-lg" asp-action="Shop" asp-route-onSale="true">Shop the sale</a>
                }
                else
                {
                    <a class="btn btn-outline-light btn-lg" asp-action="Shop">Browse all gear</a>
                }
            </div>
        </div>
    </div>
</section>

<section class="benefits" aria-label="Store benefits">
    <div class="container-hs">
        <ul>
            <li><i class="fa-solid fa-truck-fast" aria-hidden="true"></i><div><strong>Free standard shipping</strong><span>On orders over @store.FormatPrice(store.FreeShippingThreshold)</span></div></li>
            <li><i class="fa-solid fa-rotate-left" aria-hidden="true"></i><div><strong>@store.ReturnDays-day returns</strong><span><a asp-action="Returns">How returns work</a></span></div></li>
            <li><i class="fa-solid fa-money-bill-wave" aria-hidden="true"></i><div><strong>Cash on delivery</strong><span>Pay when your order arrives</span></div></li>
            <li><i class="fa-solid fa-headset" aria-hidden="true"></i><div><strong>Real people, real advice</strong><span>@(string.IsNullOrEmpty(store.SupportPhone) ? "Contact our team" : store.SupportPhone)</span></div></li>
        </ul>
    </div>
</section>

@if (categoriesWithPhotos.Count > 0)
{
    <section class="section" aria-labelledby="cat-title">
        <div class="container-hs">
            <div class="section-head">
                <div>
                    <h2 id="cat-title">Shop by category</h2>
                </div>
                <a class="link-more" asp-action="Shop">View all <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
            </div>
            <div class="cat-tiles">
                @foreach (var category in categoriesWithPhotos)
                {
                    <a class="cat-tile" asp-action="Shop" asp-route-category="@category.CatId">
                        <div class="img">
                            @if (!string.IsNullOrEmpty(category.CatPhoto))
                            {
                                <img src="~/category/@category.CatPhoto" alt="" loading="lazy" width="200" height="200" />
                            }
                            else
                            {
                                <i class="fa-solid fa-mountain" aria-hidden="true"></i>
                            }
                        </div>
                        <strong>@category.CatName</strong>
                    </a>
                }
            </div>
        </div>
    </section>
}

@if (Model.NewArrivals.Count > 0)
{
    <section class="section section-beige" aria-labelledby="new-title">
        <div class="container-hs">
            <div class="section-head">
                <div>
                    <span class="eyebrow">Just landed</span>
                    <h2 id="new-title">New arrivals</h2>
                </div>
                <a class="link-more" asp-action="Shop" asp-route-sort="newest">Shop new in <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
            </div>
            <div class="product-rail" tabindex="0" aria-label="New arrivals, scroll horizontally">
                @foreach (var card in Model.NewArrivals)
                {
                    <partial name="_ProductCard" model="card" />
                }
            </div>
        </div>
    </section>
}

<section class="section" aria-label="Collections">
    <div class="container-hs promo-split">
        <a class="promo-card" style="background-image:url('@Url.Content("~/img/banner-1.jpg")')" asp-action="Shop" asp-route-sort="popular">
            <div>
                <span class="eyebrow" style="color:var(--hs-sand)">Customer favourites</span>
                <h3>Trail-tested best sellers</h3>
                <span class="btn btn-light mt-2">Shop best sellers</span>
            </div>
        </a>
        @if (hasSale)
        {
            <a class="promo-card" style="background-image:url('@Url.Content("~/img/banner-3.jpg")')" asp-action="Shop" asp-route-onSale="true">
                <div>
                    <span class="eyebrow" style="color:var(--hs-sand)">Limited stock</span>
                    <h3>Gear on sale</h3>
                    <span class="btn btn-light mt-2">Shop the sale</span>
                </div>
            </a>
        }
        else
        {
            <a class="promo-card" style="background-image:url('@Url.Content("~/img/banner-3.jpg")')" asp-action="Shop" asp-route-inStock="true">
                <div>
                    <span class="eyebrow" style="color:var(--hs-sand)">Ready to ship</span>
                    <h3>In stock now</h3>
                    <span class="btn btn-light mt-2">Shop in-stock gear</span>
                </div>
            </a>
        }
    </div>
</section>

@if (Model.BestSellers.Count > 0)
{
    <section class="section pt-0" aria-labelledby="best-title">
        <div class="container-hs">
            <div class="section-head">
                <div>
                    <span class="eyebrow">Most ordered</span>
                    <h2 id="best-title">Best sellers</h2>
                </div>
                <a class="link-more" asp-action="Shop" asp-route-sort="popular">See all <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
            </div>
            <div class="product-grid">
                @foreach (var card in Model.BestSellers.Take(8))
                {
                    <partial name="_ProductCard" model="card" />
                }
            </div>
        </div>
    </section>
}

@if (Model.Featured.Count > 0)
{
    <section class="section section-beige" aria-labelledby="essentials-title">
        <div class="container-hs">
            <div class="section-head">
                <div>
                    <span class="eyebrow">Picked by our team</span>
                    <h2 id="essentials-title">Trail essentials</h2>
                </div>
            </div>
            <div class="product-grid">
                @foreach (var card in Model.Featured)
                {
                    <partial name="_ProductCard" model="card" />
                }
            </div>
        </div>
    </section>
}

@if (hasSale)
{
    <section class="section" aria-labelledby="sale-title">
        <div class="container-hs">
            <div class="section-head">
                <div>
                    <span class="eyebrow" style="color:var(--hs-sale)">Reduced</span>
                    <h2 id="sale-title">On sale now</h2>
                </div>
                <a class="link-more" asp-action="Shop" asp-route-onSale="true">Shop all sale <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
            </div>
            <div class="product-rail" tabindex="0" aria-label="Sale products, scroll horizontally">
                @foreach (var card in Model.OnSale)
                {
                    <partial name="_ProductCard" model="card" />
                }
            </div>
        </div>
    </section>
}

@if (Model.LatestReviews.Count > 0)
{
    <section class="section section-beige" aria-labelledby="reviews-title">
        <div class="container-hs">
            <div class="section-head">
                <div>
                    <span class="eyebrow">From verified customers</span>
                    <h2 id="reviews-title">What hikers are saying</h2>
                </div>
            </div>
            <div class="row g-4">
                @foreach (var review in Model.LatestReviews)
                {
                    <div class="col-md-4">
                        <figure class="card-hs h-100 m-0">
                            <partial name="_Stars" model="(double)review.Rating" />
                            <blockquote class="mt-2 mb-3">
                                <p class="fw-semibold mb-1">@review.Title</p>
                                <p class="m-0 text-muted">@(review.Comment.Length > 220 ? review.Comment[..220] + "…" : review.Comment)</p>
                            </blockquote>
                            <figcaption class="small">
                                — @(review.User?.FirstName ?? "Customer")@(review.IsVerifiedPurchase ? ", verified buyer" : "") ·
                                <a asp-action="ProductDetailes" asp-route-id="@review.ProId">@review.Product?.ProName</a>
                            </figcaption>
                        </figure>
                    </div>
                }
            </div>
        </div>
    </section>
}
