@model HikingStore.ViewModels.IndexVM

@{
    // Helper function for truncation
    string Truncate(string input, int length)
    {
        if (string.IsNullOrEmpty(input)) return input;
        return input.Length <= length ? input : input.Substring(0, length) + "...";
    }
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-5 fw-bold mb-3">Explore the Great Outdoors</h1>
                <p class="lead mb-3" style="font-size: 1.1rem;">Premium hiking gear and outdoor equipment for your next adventure</p>
                <a href="/Home/Shop" class="btn btn-light btn-sm me-2">Shop Now</a>
                <a href="/Home/Product" class="btn btn-outline-light btn-sm">View Products</a>
            </div>
            <div class="col-lg-6">
                <img src="~/img/banner-1.jpg" alt="Hiking Adventure" class="img-fluid rounded-3" style="max-height: 300px; object-fit: cover;">
            </div>
        </div>
    </div>
</section>

<!-- Search Bar -->
<section class="py-3 bg-light">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="input-group input-group-sm">
                    <input type="text" id="searchInput" class="form-control form-control-sm" placeholder="Search for hiking gear, camping equipment...">
                    <button class="btn btn-primary btn-sm" type="button" onclick="searchProducts()">
                        <i class="fas fa-search"></i> Search
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Categories Section -->
<section class="py-5">
    <div class="container">
        <div class="row mb-4">
            <div class="col-12 text-center">
                <h3 class="h4 fw-bold mb-2">Shop by Category</h3>
                <p class="text-muted small mb-0">Find the perfect gear for your adventure</p>
            </div>
        </div>

        <div class="row g-4 justify-content-center">
            @foreach (var cat in Model.Categories)
            {
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="card category-card h-100 text-center">

                        <!-- Category Image -->
                        <div class="category-image-wrapper">
                            <img src="~/category/@cat.CatPhoto"
                                 alt="@cat.CatName"
                                 class="category-image">
                        </div>

                        <!-- Card Body -->
                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title mb-3">@cat.CatName</h6>

                            <div class="mt-auto">
                                <a href="/Home/ProductCategory/@cat.CatId"
                                   class="btn btn-outline-primary btn-sm px-3">
                                    Explore
                                </a>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Featured Products -->
<section class="py-4 bg-light">
    <div class="container">
        <div class="row mb-4">
            <div class="col-12 text-center">
                <h3 class="h4 fw-bold mb-2">Featured Products</h3>
                <p class="text-muted small mb-0">Top-rated gear for outdoor enthusiasts</p>
            </div>
        </div>
        <div class="row g-3">
            @foreach (var product in Model.Products)
            {
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="card card-hover border-0 shadow-sm h-100 d-flex flex-column">
                        <div class="position-relative flex-grow-0 p-2">
                            <img src="~/Product/@product.ProImage"
                                 class="card-img-top mx-auto"
                                 alt="@product.ProName"
                                 style="height: 100px; width: 100%; object-fit: contain;">

                            <div class="position-absolute top-0 end-0 m-1">
                                <span class="badge bg-primary" style="font-size: 0.7rem; padding: 0.2rem 0.5rem;">Featured</span>
                            </div>
                            <!-- Stock Status Badge -->
                            <div class="position-absolute top-0 start-0 m-1">
                                @if (product.IsInStock)
                                {
                                    <span class="badge bg-success" style="font-size: 0.7rem; padding: 0.2rem 0.5rem;">In Stock</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger" style="font-size: 0.7rem; padding: 0.2rem 0.5rem;">Out of Stock</span>
                                }
                            </div>
                        </div>
                        <div class="card-body d-flex flex-column p-2">
                            <h6 class="card-title mb-1" style="font-size: 1rem; line-height: 1.2; min-height: 38px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">@product.ProName</h6>
                            <p class="card-text text-muted mb-2 flex-grow-1" style="font-size: 0.75rem; line-height: 1.3; min-height: 40px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">@Truncate(product.Descreption, 50)</p>
                            <div class="mt-auto">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="h6 text-primary mb-0" style="font-size: 0.95rem;">€@product.Price.ToString("N2")</span>
                                    <a href="/Home/ProductDetailes/@product.ProId" class="btn btn-primary btn-sm" style="font-size: 0.8rem; padding: 0.25rem 0.75rem;">View Details</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="row mt-4">
            <div class="col-12 text-center">
                <a href="/Home/Product" class="btn btn-outline-primary btn-sm">View All Products</a>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="py-4">
    <div class="container">
        <div class="row g-3">
            <div class="col-md-4 text-center">
                <div class="feature-icon mb-2">
                    <i class="fas fa-shipping-fast fa-2x text-primary"></i>
                </div>
                <h6 class="mb-1" style="font-size: 0.9rem;">Free Shipping</h6>
                <p class="text-muted small mb-0">Free shipping on orders over €50</p>
            </div>
            <div class="col-md-4 text-center">
                <div class="feature-icon mb-2">
                    <i class="fas fa-undo-alt fa-2x text-primary"></i>
                </div>
                <h6 class="mb-1" style="font-size: 0.9rem;">Easy Returns</h6>
                <p class="text-muted small mb-0">30-day return policy</p>
            </div>
            <div class="col-md-4 text-center">
                <div class="feature-icon mb-2">
                    <i class="fas fa-headset fa-2x text-primary"></i>
                </div>
                <h6 class="mb-1" style="font-size: 0.9rem;">24/7 Support</h6>
                <p class="text-muted small mb-0">Expert customer support</p>
            </div>
        </div>
    </div>
</section>

<style>
    .hero-section {
        background: linear-gradient(135deg, #3b5d50 0%, #2d473d 100%);
        color: white;
        padding: 60px 0;
    }

    .card-hover {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border: 1px solid rgba(0,0,0,0.05);
        border-radius: 8px;
    }

        .card-hover:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.1);
            border-color: rgba(59, 93, 80, 0.2);
        }

            .card-hover:hover .category-icon img {
                transform: scale(1.05);
            }

    .feature-icon {
        color: #3b5d50;
        transition: transform 0.3s ease;
    }

        .feature-icon:hover {
            transform: translateY(-3px);
        }

    .btn-primary {
        background-color: #3b5d50;
        border-color: #3b5d50;
        transition: all 0.3s ease;
    }

        .btn-primary:hover {
            background-color: #2d473d;
            border-color: #2d473d;
            transform: translateY(-1px);
        }

    /* Ensures all cards have consistent height */
    .card {
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .card-img-top {
        object-fit: cover;
        width: 100%;
        border-radius: 6px 6px 0 0;
    }

    .card-body {
        flex: 1 0 auto;
    }

    /* Make sure images maintain aspect ratio */
    .category-icon img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 6px;
        transition: transform 0.3s ease;
    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .hero-section {
            padding: 40px 0;
            text-align: center;
        }

        .display-5 {
            font-size: 2rem;
        }

        .col-sm-6 {
            margin-bottom: 1rem;
        }
    }


    /* Smaller & centered product images */
    .product-image {
        height: 110px;
        width: auto;
        max-width: 100%;
        object-fit: contain;
        margin: 12px auto 8px auto;
    }

    /* More air inside cards */
    .card-hover {
        padding: 10px;
        border-radius: 14px;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
    }

    /* Remove heavy image corners */
    .card-img-top {
        border-radius: 10px;
    }

    /* Slight hover – premium feel */
    .card-hover:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 28px rgba(0,0,0,0.08);
    }

    /* Better spacing between text */
    .card-body {
        padding: 10px;
    }

        /* Price & button alignment */
        .card-body .h6 {
            font-weight: 600;
        }

    /* Mobile optimization */
    @@media (max-width: 768px) {
        .product-image {
            height: 95px;
        }
    }
    /* ===============================
       CATEGORY CARD STYLING
    ================================ */

    .category-card {
        border: none;
        border-radius: 16px;
        padding: 12px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 14px rgba(0,0,0,0.05);
    }

        .category-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 28px rgba(0,0,0,0.08);
        }

    /* Image wrapper keeps size consistent */
    .category-image-wrapper {
        height: 110px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 12px;
    }

    .category-image {
        max-height: 100px;
        max-width: 100%;
        object-fit: contain;
    }

    /* Title styling */
    .category-card .card-title {
        font-size: 0.95rem;
        font-weight: 600;
        min-height: 40px;
    }

    /* Mobile optimization */
    @@media (max-width: 768px) {
        .category-image-wrapper {
            height: 90px;
        }

        .category-image {
            max-height: 80px;
        }
    }

</style>

<script>
    function searchProducts() {
        const searchTerm = document.getElementById('searchInput').value;
        if (searchTerm.trim() !== '') {
            window.location.href = '/Home/Search?query=' + encodeURIComponent(searchTerm);
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        // Add hover effects to cards
        const cards = document.querySelectorAll('.card-hover');

        cards.forEach(card => {
            card.addEventListener('mouseenter', function() {
                this.style.transform = 'translateY(-3px)';
                this.style.boxShadow = '0 8px 20px rgba(0,0,0,0.1)';
                this.style.borderColor = 'rgba(59, 93, 80, 0.2)';
            });

            card.addEventListener('mouseleave', function() {
                this.style.transform = 'translateY(0)';
                this.style.boxShadow = '0 2px 8px rgba(0,0,0,0.05)';
                this.style.borderColor = 'rgba(0,0,0,0.05)';
            });
        });
    });
</script>