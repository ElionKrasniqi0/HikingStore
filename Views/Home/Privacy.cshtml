@inject IOptions<StoreSettings> StoreOptions
@{
    var store = StoreOptions.Value;
    ViewData["Title"] = "Privacy policy";
    ViewData["Description"] = $"What personal data {store.Name} collects, why, how long we keep it and your rights.";
    ViewData["HelpSection"] = "Privacy";
}

<div class="container-hs">
    <nav class="breadcrumb-bar" aria-label="Breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Privacy policy</li>
        </ol>
    </nav>
    <div class="page-head"><h1>Privacy policy</h1></div>
    <div class="help-layout">
        <partial name="_HelpNav" />
        <article class="prose">
            <p class="lead-muted">This policy explains what personal data @store.Name collects when you use this website, why we need it and what you can do about it.</p>

            <h2>Who we are</h2>
            <p>@store.Name@(string.IsNullOrEmpty(store.Address) ? "" : $", {store.Address}"), is responsible for your data. Contact us about privacy at <a href="mailto:@store.SupportEmail">@store.SupportEmail</a>.</p>

            <h2>What we collect</h2>
            <ul>
                <li><strong>Account details</strong> — your name, email address, password (stored only as a secure hash) and, if you add it, your phone number.</li>
                <li><strong>Delivery details</strong> — addresses you save and the name, address, phone number and email on each order.</li>
                <li><strong>Orders</strong> — what you bought, prices, discounts, delivery method and order status history.</li>
                <li><strong>Things you send us</strong> — contact form messages, live chat messages and product reviews.</li>
                <li><strong>Newsletter</strong> — your email address, if you sign up.</li>
                <li><strong>Wishlist and cart</strong> — the products you save or add to your cart.</li>
            </ul>
            @if (PaymentProviders.ActiveProvider != null)
            {
                <p>We never see or store your card number or security code. Card payments are entered on our payment provider's secure, PCI DSS-compliant page; we only keep the provider's payment reference, the amount and the payment status for each order.</p>
            }
            else
            {
                <p>We don't collect or store card or bank details: orders are paid cash on delivery.</p>
            }

            <h2>Why we use it</h2>
            <ul>
                <li>To process, deliver and support your orders, and to email you order confirmations and status updates.</li>
                <li>To run your account, cart, wishlist and saved addresses.</li>
                <li>To answer your messages and chats.</li>
                <li>To send the newsletter, only if you subscribed.</li>
                <li>To keep the site secure and prevent fraud, and to meet accounting obligations.</li>
            </ul>

            <h2>Cookies and similar storage</h2>
            <p>We only use cookies needed for the site to work. We don't use advertising or analytics cookies.</p>
            <div class="table-responsive">
                <table class="table table-hs">
                    <thead><tr><th scope="col">Cookie</th><th scope="col">Purpose</th><th scope="col">Duration</th></tr></thead>
                    <tbody>
                        <tr><td>Sign-in cookie</td><td>Keeps you signed in.</td><td>Up to 30 days, or until you sign out</td></tr>
                        <tr><td>.HikingStore.Session</td><td>Your guest cart, applied coupon and recently viewed products.</td><td>7 days of inactivity</td></tr>
                        <tr><td>Anti-forgery cookie</td><td>Protects forms against cross-site request forgery.</td><td>Browser session</td></tr>
                    </tbody>
                </table>
            </div>

            <h2>Other services we use</h2>
            <p>Fonts, icons and some scripts load from Google Fonts, jsDelivr and cdnjs, which receive your IP address when your browser requests them. Emails are delivered through our email provider. If Google sign-in is offered and you use it, Google shares your name and email with us.</p>

            <h2>How long we keep data</h2>
            <p>Order records are kept as long as accounting law requires. Other account data is kept while your account exists. Contact messages, chats and newsletter sign-ups are kept until they're no longer needed or you ask us to delete them.</p>

            <h2>Your rights</h2>
            <p>You can see and change your details under <a asp-controller="Account" asp-action="Index">My account</a>, and download your personal data from your account settings. You can delete your account yourself if it has no orders; otherwise contact us and we'll remove what we aren't required to keep. You can also ask us for a copy of your data, to correct it, or to stop using it for the newsletter at any time.</p>

            <h2>Changes</h2>
            <p>If we change this policy we'll update this page. Significant changes will be announced on the site.</p>
        </article>
    </div>
</div>
