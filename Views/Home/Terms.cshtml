    /* Alert Styling */
    .alert {
        border-radius: 10px;
        border: none;
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .terms-section {
            padding: 1.5rem;
        }

        .agreement-card,
        .ip-card,
        .disclaimer-card {
            flex-direction: column;
            text-align: center;
        }

        .section-title {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.5rem;
        }

        .terms-quick-nav .nav-link {
            width: 100%;
            margin-bottom: 0.5rem;
            text-align: left;
        }

        .display-4 {
            font-size: 2.5rem;
        }
    }

    @@media (max-width: 576px) {
        .terms-section {
            padding: 1rem;
        }

        .purchase-timeline {
            padding-left: 20px;
        }

        .step-number {
            left: -30px;
            width: 25px;
            height: 25px;
            font-size: 0.75rem;
        }

        .display-4 {
            font-size: 2rem;
        }

        .limit-card {
            padding: 1.5rem;
        }

        .limit-amount {
            font-size: 2rem;
        }
