        }

        .guideline-card.prohibited {
            background: rgba(220, 53, 69, 0.05);
            border: 2px solid #dc3545;
        }

    .guideline-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 600;
        margin-bottom: 1rem;
    }

    .guideline-card.permitted .guideline-header {
        color: #28a745;
    }

    .guideline-card.prohibited .guideline-header {
        color: #dc3545;
    }

    .guideline-card ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

        .guideline-card ul li {
            padding: 0.5rem 0;
            border-bottom: 1px solid rgba(0,0,0,0.05);
        }

            .guideline-card ul li:last-child {
                border-bottom: none;
            }

    /* Disclaimer Cards */
    .disclaimer-card {
