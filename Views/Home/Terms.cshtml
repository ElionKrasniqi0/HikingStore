    /* Print Styles */
    @@media print {
        .terms-nav,
        .btn,
        .alert,
        .acceptance-section {
            display: none !important;
        }

        .terms-section {
            box-shadow: none;
            border: 1px solid #000;
            page-break-inside: avoid;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Print terms function
        window.printTerms = function() {
            window.print();
        };

        // Update active tab based on scroll
        const observerOptions = {
            threshold: 0.3
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const tabId = entry.target.id;
                    const correspondingLink = document.querySelector(`[data-bs-target="#${tabId}"]`);

                    if (correspondingLink) {
                        // Remove active class from all links
                        const allLinks = document.querySelectorAll('.terms-quick-nav .nav-link');
                        allLinks.forEach(link => link.classList.remove('active'));

                        // Add active class to current link
                        correspondingLink.classList.add('active');

                        // Update URL hash without scrolling
                        history.replaceState(null, null, `#${tabId}`);
                    }
                }
            });
        }, observerOptions);

        // Observe all tab panes
        const tabPanes = document.querySelectorAll('.tab-pane');
        tabPanes.forEach(pane => observer.observe(pane));

        // Smooth scroll for internal links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function(e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });

        // Initialize tooltips
        const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        const tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });

        // Acceptance button functionality
        const acceptanceBtn = document.querySelector('.acceptance-section .btn');
        acceptanceBtn?.addEventListener('click', function(e) {
            e.preventDefault();

            // Store acceptance in localStorage
            localStorage.setItem('termsAccepted', 'true');
            localStorage.setItem('termsVersion', '2.1');
            localStorage.setItem('termsAcceptanceDate', new Date().toISOString());

            // Show success message
            const originalText = this.innerHTML;
            this.innerHTML = '<i class="fas fa-check-circle me-2"></i>Terms Accepted!';
            this.classList.remove('btn-primary');
            this.classList.add('btn-success');

            // Redirect after delay
            setTimeout(() => {
                window.location.href = '/';
            }, 2000);
        });

        // Check if terms were already accepted
        const termsAccepted = localStorage.getItem('termsAccepted');
        const termsVersion = localStorage.getItem('termsVersion');

        if (termsAccepted === 'true' && termsVersion === '2.1') {
            acceptanceBtn.innerHTML = '<i class="fas fa-check-circle me-2"></i>Terms Already Accepted';
            acceptanceBtn.classList.remove('btn-primary');
            acceptanceBtn.classList.add('btn-success');
            acceptanceBtn.disabled = true;
        }

        // Add animation to section headers
        const sectionHeaders = document.querySelectorAll('.section-header');
        sectionHeaders.forEach(header => {
            header.addEventListener('mouseenter', function() {
                const number = this.querySelector('.section-number');
                if (number) {
                    number.style.transform = 'scale(1.1) rotate(5deg)';
                }
            });

            header.addEventListener('mouseleave', function() {
                const number = this.querySelector('.section-number');
                if (number) {
                    number.style.transform = 'scale(1) rotate(0)';
                }
            });
        });
    });
</script>