    }

    .pricing-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

        .pricing-list li {
            padding: 0.5rem 0;
            border-bottom: 1px solid rgba(0,0,0,0.05);
        }

            .pricing-list li:last-child {
                border-bottom: none;
            }

    /* IP Cards */
    .ip-card {
        display: flex;
        gap: 1.5rem;
        padding: 1.5rem;
        background: #f8f9fa;
