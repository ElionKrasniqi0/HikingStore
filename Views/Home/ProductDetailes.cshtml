@model Product

@{
    var vatRate = 0.18m; // 18% VAT
    var priceWithVat = Model.Price;
    var priceWithoutVat = priceWithVat / (1 + vatRate);
    var monthlyInstallment24 = priceWithVat / 24;
    var monthlyInstallment36 = priceWithVat / 36;
    var protectionPlanPrice = priceWithVat * 0.0477m; // ~4.77% of price
}

<!-- Breadcrumbs -->
<section class="py-2 bg-light">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Shop">Shop</a></li>
                @if (Model.Category != null)
                {
                    <li class="breadcrumb-item"><a href="#">@Model.Category.CatName</a></li>
                }
                <li class="breadcrumb-item active" aria-current="page">@Model.ProName</li>
            </ol>
        </nav>
    </div>
</section>

<!-- Product Details -->
<section class="py-3">
    <div class="container">
        <div class="row g-3">
            <!-- Product Image Section -->
            <div class="col-lg-6">
                <!-- Best Price Guaranteed Banner -->
                <div class="best-price-banner mb-2">
                    <span class="badge bg-danger px-2 py-1" style="font-size: 0.8rem;">
                        <i class="fas fa-tag me-1"></i>BEST PRICE GUARANTEED
                    </span>
                </div>

                <!-- Main Product Image -->
                <div class="product-image-container text-center mb-2">
                    <img id="mainProductImage" src="~/Product/@Model.ProImage" alt="@Model.ProName"
                         class="img-fluid rounded-3 product-main-image"
                         style="max-height: 350px; object-fit: contain; padding: 15px;">
                </div>

                <!-- Thumbnail Gallery -->
                <div class="thumbnail-gallery">
                    <div class="d-flex gap-2 flex-wrap">
                        <div class="thumbnail-item active" data-image="~/Product/@Model.ProImage">
                            <img src="~/Product/@Model.ProImage" alt="Thumbnail 1" class="img-fluid rounded">
                        </div>
                        @for (int i = 2; i <= 6; i++)
                        {
                            <div class="thumbnail-item" data-image="~/Product/@Model.ProImage">
                                <img src="~/Product/@Model.ProImage" alt="Thumbnail @i" class="img-fluid rounded">
                            </div>
                        }
                    </div>
                    <div class="text-center mt-2">
                        <small class="text-muted">1/10</small>
                    </div>
                </div>
            </div>

            <!-- Product Info Section -->
            <div class="col-lg-6">
                <div class="product-info">
                    <!-- Product Title -->
                    <h1 class="h4 fw-bold text-dark mb-1">@Model.ProName</h1>

                    <!-- Brand -->
                    <div class="mb-2">
                        <span class="text-muted small">Brand: </span>
                        <span class="fw-semibold">@(Model.Category?.CatName ?? "HikingStore")</span>
                        <span class="text-muted small ms-3">Code: @Model.ProId.ToString("D6")</span>
                    </div>

                    <!-- Rating -->
                    <div class="d-flex align-items-center mb-2">
                        <div class="rating-stars me-2">
                            <i class="fas fa-star text-warning"></i>
                            <i class="fas fa-star text-warning"></i>
                            <i class="fas fa-star text-warning"></i>
                            <i class="fas fa-star text-warning"></i>
                            <i class="far fa-star text-warning"></i>
                        </div>
                        <a href="#reviews" class="text-muted small text-decoration-none">Rate</a>
                        <span class="text-muted small ms-2">4.2 (128 reviews)</span>
                    </div>

                    <!-- Price Section -->
                    <div class="price-section mb-3">
                        <div class="d-flex align-items-baseline gap-2 mb-1">
                            <span class="h3 fw-bold text-dark">€@priceWithVat.ToString("N2")</span>
                        </div>
                        <div class="mb-1">
                            <span class="text-muted small">Including VAT</span>
                            <span class="text-muted small ms-2">Without VAT: €@priceWithoutVat.ToString("N2")</span>
                        </div>
                        @if (Model.IsInStock && Model.StockQuantity > 0)
                        {
                            <div class="mt-2">
                                <a href="#" class="text-primary small text-decoration-none">Buy outlet product for €@((priceWithVat * 0.87m).ToString("N2"))</a>
                            </div>
                        }
                    </div>

                    <!-- Quantity Selector -->
                    @if (Model.IsInStock)
                    {
                        <form id="addToCartForm" method="post">
                            <div class="quantity-section mb-3">
                                <label class="form-label small fw-semibold mb-1">Quantity</label>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="quantity-controls d-flex border rounded-2" style="width: 120px;">
                                        <button type="button" class="btn btn-light btn-quantity border-0">
                                            <i class="fas fa-minus small"></i>
                                        </button>
                                        <input type="text" id="qtyInput" name="qty"
                                               class="form-control border-0 text-center shadow-none quantity-input"
                                               value="1" style="width: 60px;" max="@Model.StockQuantity">
                                        <button type="button" class="btn btn-light btn-quantity border-0">
                                            <i class="fas fa-plus small"></i>
                                        </button>
                                    </div>
                                    <span class="text-muted small">More than 10 items available</span>
                                </div>
                            </div>

                            <!-- Shipping Information -->
                            <div class="shipping-section mb-3">
                                <h6 class="fw-semibold mb-1" style="font-size: 0.9rem;">Shipping</h6>
                                <p class="text-muted small mb-1" style="font-size: 0.85rem;">
                                    Delivery date for this product is uncertain. However, you can pre-order, and we will do our best to deliver it as soon as possible.
                                </p>
                                <a href="#" class="text-primary small text-decoration-none">More</a>
                            </div>

                            <!-- Secure Payment Options -->
                            <div class="payment-options mb-3">
                                <h6 class="fw-semibold mb-1" style="font-size: 0.9rem;">Secure Payment</h6>
                                <div class="d-flex gap-3 flex-wrap">
                                    <div class="d-flex align-items-center text-muted small">
                                        <i class="fas fa-money-bill-wave me-2"></i>
                                        <span>Pay with cash on delivery</span>
                                    </div>
                                    <div class="d-flex align-items-center text-muted small">
                                        <i class="fas fa-credit-card me-2"></i>
                                        <span>Pay online</span>
                                    </div>
                                    <div class="d-flex align-items-center text-muted small">
                                        <i class="fas fa-university me-2"></i>
                                        <span>Pay with bank transfer</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Action Buttons -->
                            <div class="action-buttons mb-3">
                                <div class="d-flex gap-2 flex-wrap">
                                    <button type="submit" class="btn btn-warning flex-grow-1 buy-now-btn" style="padding: 0.5rem 1rem; font-size: 0.9rem;">
                                        <i class="fas fa-check me-1"></i>BUY NOW
                                    </button>
                                    <button type="button" class="btn btn-outline-primary add-to-cart-btn-action" style="padding: 0.5rem 1rem; font-size: 0.9rem;">
                                        <i class="fas fa-shopping-cart me-1"></i>ADD TO CART
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary wishlist-btn-action" style="width: 42px; height: 42px; padding: 0;">
                                        <i class="far fa-heart"></i>
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary share-btn" style="width: 42px; height: 42px; padding: 0;">
                                        <i class="fas fa-share-alt"></i>
                                    </button>
                                </div>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-4">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            This product is currently out of stock. Check back later!
                        </div>
                    }

                    <!-- Success Message -->
                    <div id="successMessage" class="alert alert-success mt-3 py-2 small" style="display: none;">
                        <i class="fas fa-check-circle me-2"></i>
                        <span>Item added to cart!</span>
                        <a href="/Carts/Index" class="alert-link ms-2">View Cart</a>
                    </div>

                    <!-- Error Message -->
                    <div id="errorMessage" class="alert alert-danger mt-3 py-2 small" style="display: none;">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        <span id="errorText"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Delimiter -->
<div class="container">
    <hr class="my-0" style="border-top: 2px solid #dee2e6;">
</div>

<!-- Product Description Tabs -->
<section class="py-3 bg-light">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="bg-white rounded-3 shadow-sm">
                    <ul class="nav nav-tabs border-0 px-3 pt-2" id="productTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active border-0 fw-semibold" id="description-tab" data-bs-toggle="tab"
                                    data-bs-target="#description" type="button" role="tab">
                                Description
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link border-0 fw-semibold" id="details-tab" data-bs-toggle="tab"
                                    data-bs-target="#details" type="button" role="tab">
                                Details
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link border-0 fw-semibold" id="reviews-tab" data-bs-toggle="tab"
                                    data-bs-target="#reviews" type="button" role="tab">
                                Reviews
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content p-3" id="productTabsContent">
                        <div class="tab-pane fade show active" id="description" role="tabpanel">
                            <div class="product-description">
                                <p class="mb-3">@Model.Descreption</p>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="details" role="tabpanel">
                            <div class="product-details">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="border-bottom py-2">
                                            <strong>Material:</strong>
                                            <span class="text-muted float-end">Premium Quality</span>
                                        </div>
                                        <div class="border-bottom py-2">
                                            <strong>Weight:</strong>
                                            <span class="text-muted float-end">Lightweight</span>
                                        </div>
                                        <div class="border-bottom py-2">
                                            <strong>Dimensions:</strong>
                                            <span class="text-muted float-end">Standard</span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="border-bottom py-2">
                                            <strong>Warranty:</strong>
                                            <span class="text-muted float-end">2 Years</span>
                                        </div>
                                        <div class="border-bottom py-2">
                                            <strong>SKU:</strong>
                                            <span class="text-muted float-end">HS-@Model.ProId.ToString("D4")</span>
                                        </div>
                                        <div class="border-bottom py-2">
                                            <strong>Brand:</strong>
                                            <span class="text-muted float-end">@(Model.Category?.CatName ?? "HikingStore")</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="reviews" role="tabpanel">
                            <div class="product-reviews">
                                <h5 class="mb-3">Customer Reviews</h5>
                                <div class="review-summary mb-4 p-3 bg-light rounded">
                                    <div class="d-flex align-items-center mb-2">
                                        <span class="h3 fw-bold me-2">4.2</span>
                                        <div class="rating-stars me-2">
                                            <i class="fas fa-star text-warning"></i>
                                            <i class="fas fa-star text-warning"></i>
                                            <i class="fas fa-star text-warning"></i>
                                            <i class="fas fa-star text-warning"></i>
                                            <i class="far fa-star text-warning"></i>
                                        </div>
                                        <span class="text-muted">(128 reviews)</span>
                                    </div>
                                </div>
                                <div class="reviews-list">
                                    <p class="text-muted">No reviews yet. Be the first to review this product!</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    /* Breadcrumbs */
    .breadcrumb {
        background: transparent;
        padding: 0;
    }

    .breadcrumb-item a {
        color: #6c757d;
        text-decoration: none;
    }

    .breadcrumb-item a:hover {
        color: #3b5d50;
    }

    /* Best Price Banner */
    .best-price-banner {
        text-align: center;
    }

    .best-price-banner .badge {
        font-size: 0.9rem;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    /* Product Image Styling */
    .product-image-container {
        background: #f8f9fa;
        border-radius: 12px;
        padding: 15px;
        margin-bottom: 15px;
    }

    .product-main-image {
        max-height: 350px;
        width: auto;
        object-fit: contain;
        transition: transform 0.3s ease;
    }

    .product-image-container:hover .product-main-image {
        transform: scale(1.02);
    }

    /* Thumbnail Gallery */
    .thumbnail-gallery .thumbnail-item {
        width: 60px;
        height: 60px;
        border: 2px solid transparent;
        border-radius: 8px;
        cursor: pointer;
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .thumbnail-gallery .thumbnail-item:hover {
        border-color: #3b5d50;
        transform: scale(1.05);
    }

    .thumbnail-gallery .thumbnail-item.active {
        border-color: #ff6b35;
    }

    .thumbnail-gallery .thumbnail-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* Quantity Controls */
    .quantity-controls {
        background: white;
    }

    .btn-quantity {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        transition: all 0.2s ease;
    }

    .btn-quantity:hover {
        background: #f8f9fa;
    }

    .quantity-input {
        height: 36px;
        font-weight: 600;
        font-size: 0.9rem;
        background: transparent;
        border: none;
    }

    /* Action Buttons */
    .buy-now-btn {
        background-color: #ff6b35;
        border-color: #ff6b35;
        color: white;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .buy-now-btn:hover {
        background-color: #e55a2b;
        border-color: #e55a2b;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(255, 107, 53, 0.3);
    }

    .add-to-cart-btn-action {
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .add-to-cart-btn-action:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(59, 93, 80, 0.2);
    }

    .wishlist-btn-action,
    .share-btn {
        transition: all 0.3s ease;
    }

    .wishlist-btn-action:hover,
    .share-btn:hover {
        background: #3b5d50;
        color: white;
        border-color: #3b5d50;
    }

    /* Installment Section */
    .installment-option {
        background: #f8f9fa;
        transition: all 0.2s ease;
    }

    .installment-option:hover {
        background: #e9ecef;
        border-color: #3b5d50;
    }

    /* Protection Plan */
    .protection-plan-section .form-check {
        padding: 8px 16px;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

    .protection-plan-section .form-check:hover {
        border-color: #3b5d50;
        background: #f8f9fa;
    }

    .protection-plan-section .form-check-input:checked {
        background-color: #3b5d50;
        border-color: #3b5d50;
    }

    /* Tabs */
    .nav-tabs .nav-link {
        color: #6c757d;
        padding: 10px 16px;
        margin-right: 8px;
        font-size: 0.9rem;
    }

    .nav-tabs .nav-link.active {
        color: #3b5d50;
        border-bottom: 3px solid #3b5d50;
    }

    .nav-tabs .nav-link:hover {
        color: #3b5d50;
        border-color: transparent;
    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .product-image-container {
            padding: 12px;
        }

        .product-main-image {
            max-height: 250px;
        }

        .thumbnail-gallery .thumbnail-item {
            width: 50px;
            height: 50px;
        }

        .action-buttons .btn {
            width: 100%;
            margin-bottom: 10px;
        }

        .quantity-controls {
            width: 100%;
            max-width: 200px;
        }
    }

    @@media (max-width: 576px) {
        .product-image-container {
            padding: 10px;
        }

        .product-main-image {
            max-height: 200px;
        }

        .h4 {
            font-size: 1.25rem;
        }

        .h3 {
            font-size: 1.5rem;
        }
    }

    /* Success and Error Messages */
    .alert {
        border-radius: 8px;
        border: none;
        animation: fadeIn 0.3s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Thumbnail gallery functionality
        const thumbnailItems = document.querySelectorAll('.thumbnail-item');
        const mainImage = document.getElementById('mainProductImage');

        thumbnailItems.forEach(item => {
            item.addEventListener('click', function() {
                // Remove active class from all thumbnails
                thumbnailItems.forEach(t => t.classList.remove('active'));
                // Add active class to clicked thumbnail
                this.classList.add('active');
                // Update main image
                const imageSrc = this.getAttribute('data-image');
                if (mainImage && imageSrc) {
                    mainImage.src = imageSrc;
                }
            });
        });

        // Quantity controls
        const qtyInput = document.getElementById('qtyInput');
        const quantityButtons = document.querySelectorAll('.btn-quantity');
        const minusButton = Array.from(quantityButtons).find(btn => btn.querySelector('.fa-minus'));
        const plusButton = Array.from(quantityButtons).find(btn => btn.querySelector('.fa-plus'));

        minusButton?.addEventListener('click', function() {
            let currentValue = parseInt(qtyInput.value) || 1;
            if (currentValue > 1) {
                qtyInput.value = currentValue - 1;
            }
        });

        plusButton?.addEventListener('click', function() {
            let currentValue = parseInt(qtyInput.value) || 1;
            const maxStock = @Model.StockQuantity;
            if (currentValue < maxStock) {
                qtyInput.value = currentValue + 1;
            }
        });

        // Wishlist functionality
        const wishlistBtn = document.querySelector('.wishlist-btn-action');
        const productId = @Model.ProId;
        
        // Check if product is in wishlist on load
        fetch(`/Wishlist/IsInWishlist?productId=${productId}`)
            .then(response => response.json())
            .then(data => {
                if (data.inWishlist && wishlistBtn) {
                    const icon = wishlistBtn.querySelector('i');
                    if (icon) {
                        icon.classList.remove('far');
                        icon.classList.add('fas', 'text-danger');
                    }
                }
            })
            .catch(error => console.error('Error checking wishlist status:', error));

        wishlistBtn?.addEventListener('click', function() {
            const icon = this.querySelector('i');
            const isInWishlist = icon.classList.contains('fas');
            
            if (isInWishlist) {
                // Remove from wishlist
                fetch('/Wishlist/RemoveFromWishlist', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: `productId=${productId}`
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        icon.classList.remove('fas', 'text-danger');
                        icon.classList.add('far');
                        showNotification(data.message || 'Removed from wishlist', 'info');
                        updateWishlistCount();
                    } else {
                        showNotification(data.message || 'Failed to remove from wishlist', 'error');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    showNotification('Error removing from wishlist', 'error');
                });
            } else {
                // Add to wishlist
                fetch('/Wishlist/AddToWishlist', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: `productId=${productId}`
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        icon.classList.remove('far');
                        icon.classList.add('fas', 'text-danger');
                        showNotification(data.message || 'Added to wishlist', 'success');
                        updateWishlistCount();
                    } else {
                        showNotification(data.message || 'Failed to add to wishlist', 'error');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    showNotification('Error adding to wishlist', 'error');
                });
            }
        });

        function updateWishlistCount() {
            fetch('/Wishlist/GetWishlistCount')
                .then(response => response.json())
                .then(data => {
                    const wishlistCountElements = document.querySelectorAll('.wishlist-count');
                    wishlistCountElements.forEach(element => {
                        element.textContent = data.count || 0;
                    });
                })
                .catch(error => console.error('Error updating wishlist count:', error));
        }

        function showNotification(message, type) {
            const toast = document.createElement('div');
            toast.className = `toast align-items-center text-white bg-${type} border-0 position-fixed bottom-0 end-0 m-3`;
            toast.style.zIndex = '1060';
            toast.innerHTML = `
                <div class="d-flex">
                    <div class="toast-body">${message}</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            `;
            document.body.appendChild(toast);
            const bsToast = new bootstrap.Toast(toast);
            bsToast.show();
            toast.addEventListener('hidden.bs.toast', () => {
                toast.remove();
            });
        }

        // Share functionality
        const shareBtn = document.querySelector('.share-btn');
        shareBtn?.addEventListener('click', function() {
            if (navigator.share) {
                navigator.share({
                    title: '@Model.ProName',
                    text: 'Check out this product!',
                    url: window.location.href
                });
            } else {
                // Fallback: copy to clipboard
                navigator.clipboard.writeText(window.location.href);
                alert('Link copied to clipboard!');
            }
        });

        // Add to cart functionality (both buttons)
        const addToCartForm = document.getElementById('addToCartForm');
        const addToCartBtn = document.querySelector('.add-to-cart-btn-action');
        const buyNowBtn = document.querySelector('.buy-now-btn');
        const successMessage = document.getElementById('successMessage');
        const errorMessage = document.getElementById('errorMessage');
        const errorText = document.getElementById('errorText');

        function addToCart(redirect = false) {
            if (!addToCartForm) return;

            const quantity = parseInt(qtyInput.value) || 1;
            const productId = @Model.ProId;
            const maxStock = @Model.StockQuantity;

            // Validate quantity
            if (quantity < 1) {
                showError('Please enter a valid quantity.');
                return;
            }

            if (quantity > maxStock) {
                showError(`Only ${maxStock} items available in stock.`);
                return;
            }

            // Show loading state
            const submitBtn = redirect ? buyNowBtn : addToCartBtn;
            const originalText = submitBtn.innerHTML;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Processing...';
            submitBtn.disabled = true;

            // Get anti-forgery token
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            // Submit via AJAX
            fetch('/Carts/AddToCart?ProId=' + productId + '&qty=' + quantity, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Show success message
                    successMessage.style.display = 'block';
                    errorMessage.style.display = 'none';

                    // Update cart count in header
                    updateCartCount(data.cartItemCount);

                    // Reset button after 1 second
                    setTimeout(() => {
                        submitBtn.innerHTML = originalText;
                        submitBtn.disabled = false;

                        // Redirect if buy now
                        if (redirect) {
                            window.location.href = '/Carts/Index';
                        }
                    }, 1000);

                    // Hide success message after 5 seconds
                    setTimeout(() => {
                        successMessage.style.display = 'none';
                    }, 5000);
                } else {
                    showError(data.message || 'Failed to add to cart');
                    submitBtn.innerHTML = originalText;
                    submitBtn.disabled = false;
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showError('Failed to add item to cart. Please try again.');
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
            });
        }

        // Add to cart button
        addToCartBtn?.addEventListener('click', function(e) {
            e.preventDefault();
            addToCart(false);
        });

        // Buy now button
        buyNowBtn?.addEventListener('click', function(e) {
            e.preventDefault();
            addToCart(true);
        });

        // Form submit
        if (addToCartForm) {
            addToCartForm.addEventListener('submit', function(e) {
                e.preventDefault();
                addToCart(false);
            });
        }

        // Function to show error messages
        function showError(message) {
            errorText.textContent = message;
            errorMessage.style.display = 'block';
            successMessage.style.display = 'none';

            // Hide error after 5 seconds
            setTimeout(() => {
                errorMessage.style.display = 'none';
            }, 5000);
        }

        // Function to update cart count in header
        function updateCartCount(count) {
            const cartCountElements = document.querySelectorAll('.cart-count');
            cartCountElements.forEach(element => {
                element.textContent = count;
            });
        }

        // Input validation
        qtyInput?.addEventListener('change', function() {
            let value = parseInt(this.value);
            const maxStock = @Model.StockQuantity;
            if (isNaN(value) || value < 1) {
                this.value = 1;
            } else if (value > maxStock) {
                this.value = maxStock;
            }
        });
    });
</script>