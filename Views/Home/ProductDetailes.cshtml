@model Product

@{
    ViewData["Title"] = Model?.ProName ?? "Product details";
    var maxStock = Model?.StockQuantity ?? 0;
}

<nav class="bg-light border-bottom py-2" aria-label="breadcrumb">
    <div class="container">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item">
                <a class="text-decoration-none" asp-controller="Home" asp-action="Index">Home</a>
            </li>
            <li class="breadcrumb-item">
                <a class="text-decoration-none" asp-controller="Home" asp-action="Shop">Shop</a>
            </li>
            @if (Model?.Category != null)
            {
                <li class="breadcrumb-item">
                    <a class="text-decoration-none" href="/Home/ProductCategory/@Model.Category.CatId">@Model.Category.CatName</a>
                </li>
            }
            <li class="breadcrumb-item active" aria-current="page">@Model?.ProName</li>
        </ol>
    </div>
</nav>

<!-- Product Details -->
<section class="py-4">
    <div class="container">
        <div class="row g-4">
            <!-- Product Image -->
            <div class="col-lg-6">
                <div class="product-image-container text-center">
                    <img src="~/Product/@Model.ProImage" alt="@Model.ProName"
                         class="img-fluid rounded-3 product-main-image"
                         loading="eager"
                         fetchpriority="high"
                         decoding="async"
                         width="900"
                         height="900">
                </div>
            </div>

            <!-- Product Info -->
            <div class="col-lg-6">
                <div class="product-info">
                    <!-- Category -->
                    <div class="mb-2">
                        <span class="badge bg-primary bg-opacity-10 text-primary px-2 py-1 small">
                            @Model.Category?.CatName
                        </span>
                    </div>

                    <!-- Title -->
                    <h1 class="h4 fw-bold text-dark mb-2">@Model.ProName</h1>

                    <!-- Stock Status -->
                    <div class="mb-3">
                        @if (Model.IsInStock)
                        {
                            <span class="badge bg-success bg-opacity-10 text-success small">
                                <i class="fas fa-check me-1"></i>In Stock (@Model.StockQuantity available)
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger bg-opacity-10 text-danger small">
                                <i class="fas fa-times me-1"></i>Out of Stock
                            </span>
                        }
                    </div>

                    <!-- Rating & Stock -->
                    <div class="d-flex align-items-center mb-3">
                        <div class="rating-stars small me-2">
                            <i class="fas fa-star text-warning"></i>
                            <i class="fas fa-star text-warning"></i>
                            <i class="fas fa-star text-warning"></i>
                            <i class="fas fa-star text-warning"></i>
                            <i class="far fa-star text-warning"></i>
                        </div>
                        <span class="text-muted small me-3">4.2 (128)</span>
                    </div>

                    <!-- Price -->
                    <div class="mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="h3 fw-bold text-primary">€@Model.Price.ToString("N2")</span>
                            <span class="text-muted text-decoration-line-through small">€@((Model.Price * 1.2m).ToString("N2"))</span>
                            <span class="badge bg-danger small">Save 20%</span>
                        </div>
                        <p class="text-success small mb-0 mt-1">
                            <i class="fas fa-shipping-fast me-1"></i>Free shipping over €50
                        </p>
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <p class="text-muted small mb-0">@Model.Descreption</p>
                    </div>

                    <!-- Stock Warning -->
                    @if (!Model.IsInStock)
                    {
                        <div class="alert alert-warning mb-3">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            This product is currently out of stock. Check back later!
                        </div>
                    }
                    else if (Model.StockQuantity <= 5)
                    {
                        <div class="alert alert-info mb-3">
                            <i class="fas fa-info-circle me-2"></i>
                            Only @Model.StockQuantity items left in stock! Order soon.
                        </div>
                    }

                    <!-- Quick Features -->
                    <div class="mb-3">
                        <div class="row g-2 small">
                            <div class="col-6">
                                <div class="d-flex align-items-center text-muted">
                                    <i class="fas fa-check text-success me-2"></i>
                                    <span>Premium Quality</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="d-flex align-items-center text-muted">
                                    <i class="fas fa-check text-success me-2"></i>
                                    <span>2-Year Warranty</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Add to Cart Form -->
                    @if (Model.IsInStock)
                    {
                        <form id="addToCartForm" method="post">
                            @Html.AntiForgeryToken()
                            <div class="row g-2 align-items-end">
                                <div class="col-auto">
                                    <label class="form-label small fw-semibold mb-1">Qty</label>
                                    <div class="quantity-controls d-flex border rounded-2">
                                        <button type="button" class="btn btn-light btn-quantity border-0">
                                            <i class="fas fa-minus small"></i>
                                        </button>
                                        <input type="number" id="qtyInput" name="qty"
                                               class="form-control border-0 text-center shadow-none quantity-input"
                                               value="1"
                                               min="1"
                                               max="@Model.StockQuantity"
                                               step="1"
                                               inputmode="numeric"
                                               style="width: 56px;">
                                        <button type="button" class="btn btn-light btn-quantity border-0">
                                            <i class="fas fa-plus small"></i>
                                        </button>
                                    </div>
                                    <small class="text-muted">Max: @Model.StockQuantity</small>
                                </div>
                                <div class="col">
                                    <button type="submit" class="btn btn-primary w-100 add-to-cart-btn">
                                        <i class="fas fa-shopping-cart me-2"></i>Add to Cart
                                    </button>
                                </div>
                                <div class="col-auto">
                                    <button type="button" class="btn btn-outline-primary wishlist-btn">
                                        <i class="far fa-heart"></i>
                                    </button>
                                </div>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-secondary">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-bell me-3 text-warning fa-lg"></i>
                                <div>
                                    <p class="mb-0 fw-semibold">Notify me when available</p>
                                    <small class="text-muted">Enter your email to get notified when this product is back in stock</small>
                                </div>
                            </div>
                            <div class="mt-3">
                                <div class="input-group">
                                    <input type="email" class="form-control" placeholder="Your email address">
                                    <button class="btn btn-warning" type="button">Notify Me</button>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Success Message -->
                    <div id="successMessage" class="alert alert-success mt-3 py-2 small" style="display: none;">
                        <i class="fas fa-check-circle me-2"></i>
                        <span>Item added to cart!</span>
                        <a href="/Carts/Index" class="alert-link ms-2">View Cart</a>
                    </div>

                    <!-- Error Message -->
                    <div id="errorMessage" class="alert alert-danger mt-3 py-2 small" style="display: none;">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        <span id="errorText"></span>
                    </div>

                    <!-- Trust Badges -->
                    <div class="mt-3 pt-3 border-top">
                        <div class="row text-center g-2 small">
                            <div class="col-4">
                                <div class="text-muted">
                                    <i class="fas fa-shipping-fast d-block mb-1 text-primary"></i>
                                    <span>Free Shipping</span>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="text-muted">
                                    <i class="fas fa-undo d-block mb-1 text-primary"></i>
                                    <span>30-Day Return</span>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="text-muted">
                                    <i class="fas fa-shield-alt d-block mb-1 text-primary"></i>
                                    <span>Secure</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


<!-- Compact Tabs -->
<section class="py-4 bg-light">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="bg-white rounded-3 shadow-sm">
                    <ul class="nav nav-tabs border-0 px-3 pt-3" id="productTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active border-0 small fw-semibold" id="description-tab" data-bs-toggle="tab"
                                    data-bs-target="#description" type="button" role="tab">
                                Description
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link border-0 small fw-semibold" id="specifications-tab" data-bs-toggle="tab"
                                    data-bs-target="#specifications" type="button" role="tab">
                                Specifications
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content p-3" id="productTabsContent">
                        <div class="tab-pane fade show active" id="description" role="tabpanel">
                            <p class="text-muted small mb-0">@Model.Descreption</p>
                        </div>
                        <div class="tab-pane fade" id="specifications" role="tabpanel">
                            <div class="small">
                                <div class="row">
                                    <div class="col-6">
                                        <div class="border-bottom py-2">
                                            <strong>Material:</strong>
                                            <span class="text-muted float-end">Premium</span>
                                        </div>
                                        <div class="border-bottom py-2">
                                            <strong>Weight:</strong>
                                            <span class="text-muted float-end">Light</span>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="border-bottom py-2">
                                            <strong>Warranty:</strong>
                                            <span class="text-muted float-end">2 Years</span>
                                        </div>
                                        <div class="border-bottom py-2">
                                            <strong>SKU:</strong>
                                            <span class="text-muted float-end">HS-@Model.ProId.ToString("D4")</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    /* Compact Styles */
    .breadcrumb {
        background: transparent;
        padding: 0;
        font-size: 0.8rem;
    }

    .product-main-image {
        height: 350px;
        object-fit: cover;
    }

    .rating-stars {
        color: #ffc107;
    }

    /* Quantity Controls */
    .quantity-controls {
        max-width: 120px;
    }

    .btn-quantity {
        width: 35px;
        height: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
    }

    .quantity-input {
        height: 35px;
        font-weight: 600;
        font-size: 0.9rem;
        background: transparent;
    }

    /* Buttons */
    .add-to-cart-btn {
        height: 35px;
        font-size: 0.9rem;
        font-weight: 600;
    }

    .wishlist-btn {
        width: 35px;
        height: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Success Message */
    .alert {
        border-radius: 6px;
        border: none;
    }

    /* Tabs */
    .nav-tabs .nav-link {
        border: none;
        padding: 0.5rem 1rem;
        color: var(--gray-light);
        border-radius: 6px;
        font-size: 0.85rem;
    }

        .nav-tabs .nav-link.active {
            color: white;
        }

        .nav-tabs .nav-link:hover {
            color: var(--primary-light);
        }

    /* Responsive */
    @@media (max-width: 768px) {
        .product-main-image {
            height: 280px;
        }

        .h4 {
            font-size: 1.3rem;
        }

        .h3 {
            font-size: 1.6rem;
        }
    }

    @@media (max-width: 576px) {
        .product-main-image {
            height: 220px;
        }

        .quantity-controls {
            max-width: 110px;
        }

        .btn-quantity {
            width: 32px;
            height: 32px;
        }

        .quantity-input {
            height: 32px;
            width: 45px;
        }

        .add-to-cart-btn {
            height: 32px;
            font-size: 0.85rem;
        }

        .wishlist-btn {
            width: 32px;
            height: 32px;
        }

        .col-6 {
            margin-bottom: 0.5rem;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Quantity controls
        const qtyInput = document.getElementById('qtyInput');
        const quantityButtons = document.querySelectorAll('.btn-quantity');
        const minusButton = Array.from(quantityButtons).find(btn => btn.querySelector('.fa-minus'));
        const plusButton = Array.from(quantityButtons).find(btn => btn.querySelector('.fa-plus'));

        minusButton?.addEventListener('click', function() {
            let currentValue = parseInt(qtyInput.value) || 1;
            if (currentValue > 1) {
                qtyInput.value = currentValue - 1;
            }
        });

        plusButton?.addEventListener('click', function() {
            let currentValue = parseInt(qtyInput.value) || 1;
            if (currentValue < 10) {
                qtyInput.value = currentValue + 1;
            }
        });

        // Wishlist functionality
        const wishlistBtn = document.querySelector('.wishlist-btn');
        wishlistBtn?.addEventListener('click', function() {
            const icon = this.querySelector('i');
            if (icon.classList.contains('far')) {
                icon.classList.remove('far');
                icon.classList.add('fas', 'text-danger');
            } else {
                icon.classList.remove('fas', 'text-danger');
                icon.classList.add('far');
            }
        });

        // Add to cart functionality
         const addToCartForm = document.getElementById('addToCartForm');
    const successMessage = document.getElementById('successMessage');
    const errorMessage = document.getElementById('errorMessage');
    const errorText = document.getElementById('errorText');

    addToCartForm?.addEventListener('submit', function(e) {
        e.preventDefault(); // Prevent form submission

        const quantity = parseInt(qtyInput.value);
        const productId = @Model.ProId;
        const maxStock = @Model.StockQuantity;

        // Validate quantity
        if (quantity < 1) {
            showError('Please enter a valid quantity.');
            return;
        }

        if (quantity > maxStock) {
            showError(`Only ${maxStock} items available in stock.`);
            return;
        }

        // Show loading state
        const submitBtn = this.querySelector('.add-to-cart-btn');
        const originalText = submitBtn.innerHTML;
        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Adding...';
        submitBtn.disabled = true;

        // Submit via AJAX
        fetch('/Carts/AddToCart?ProId=' + productId + '&qty=' + quantity, {
            method: 'POST',
            headers: {
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value,
                'Content-Type': 'application/x-www-form-urlencoded',
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Show success message
                successMessage.style.display = 'block';
                errorMessage.style.display = 'none';

                // Update cart count in header
                updateCartCount(data.cartItemCount);

                // Reset button
                setTimeout(() => {
                    submitBtn.innerHTML = originalText;
                    submitBtn.disabled = false;
                }, 1000);

                // Hide success message after 5 seconds
                setTimeout(() => {
                    successMessage.style.display = 'none';
                }, 5000);
            } else {
                showError(data.message || 'Failed to add to cart');
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
            }
        })
        .catch(error => {
            console.error('Error:', error);
            showError('Failed to add item to cart. Please try again.');
            submitBtn.innerHTML = originalText;
            submitBtn.disabled = false;
        });
    });

    // Function to show error messages
    function showError(message) {
        errorText.textContent = message;
        errorMessage.style.display = 'block';
        successMessage.style.display = 'none';

        // Hide error after 5 seconds
        setTimeout(() => {
            errorMessage.style.display = 'none';
        }, 5000);
    }

        // Function to update cart count
        function updateCartCount(count) {
            const cartCountElements = document.querySelectorAll('.cart-count');
            cartCountElements.forEach(element => {
                element.textContent = count;
            });
        }

        // Input validation
        qtyInput?.addEventListener('change', function() {
            let value = parseInt(this.value);
            if (isNaN(value) || value < 1) {
                this.value = 1;
            } else if (value > 10) {
                this.value = 10;
            }
        });
    });
</script>

