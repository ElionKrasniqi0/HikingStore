@model ProductDetailsViewModel
@inject IOptions<StoreSettings> StoreOptions
@{
    var store = StoreOptions.Value;
    var p = Model.Product;
    var images = p.AllImagePaths;
    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    ViewData["Title"] = p.ProName;
    var plainDescription = (p.Descreption ?? string.Empty).ReplaceLineEndings(" ");
    ViewData["Description"] = plainDescription.Length > 155 ? plainDescription[..155] + "…" : (plainDescription.Length > 0 ? plainDescription : $"{p.ProName} at {store.Name}.");
    ViewData["OgType"] = "product";
    if (images.Count > 0) ViewData["OgImage"] = $"{baseUrl}/Product/{images[0]}";
    ViewData["Canonical"] = $"{baseUrl}{Url.Action("ProductDetailes", new { id = p.ProId })}";
    ViewData["BodyClass"] = "has-buy-bar";
    var lowStock = p.IsInStock && p.StockQuantity <= 5;
    var maxQty = Math.Min(p.StockQuantity, CartService.MaxQuantityPerLine);
    var jsonLd = new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Product",
        ["name"] = p.ProName,
        ["description"] = plainDescription,
        ["sku"] = p.ProId.ToString(),
        ["image"] = images.Select(i => $"{baseUrl}/Product/{i}").ToArray(),
        ["brand"] = string.IsNullOrEmpty(p.Brand) ? null : new Dictionary<string, object> { ["@type"] = "Brand", ["name"] = p.Brand },
        ["offers"] = new Dictionary<string, object>
        {
            ["@type"] = "Offer",
            ["priceCurrency"] = store.Currency,
            ["price"] = p.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture),
            ["availability"] = p.IsInStock ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
            ["url"] = ViewData["Canonical"]!
        }
    };
    if (Model.ReviewCount > 0 && Model.AverageRating.HasValue)
    {
        jsonLd["aggregateRating"] = new Dictionary<string, object>
        {
            ["@type"] = "AggregateRating",
            ["ratingValue"] = Math.Round(Model.AverageRating.Value, 1),
            ["reviewCount"] = Model.ReviewCount
        };
    }
    var jsonLdText = System.Text.Json.JsonSerializer.Serialize(jsonLd, new System.Text.Json.JsonSerializerOptions
    {
        DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull
    }).Replace("</", "<\\/");
}
@section Head {
    <script type="application/ld+json">@Html.Raw(jsonLdText)</script>
}

<div class="container-hs">
    <nav class="breadcrumb-bar" aria-label="Breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-action="Shop">Shop</a></li>
            @foreach (var crumb in Model.Breadcrumb)
            {
                <li class="breadcrumb-item"><a asp-action="Shop" asp-route-category="@crumb.CatId">@crumb.CatName</a></li>
            }
            <li class="breadcrumb-item active text-truncate" style="max-width:280px" aria-current="page">@p.ProName</li>
        </ol>
    </nav>

    <div class="pdp">
        <section class="gallery" aria-label="Product images">
            @if (images.Count > 1)
            {
                <div class="gallery-thumbs">
                    @for (var i = 0; i < images.Count; i++)
                    {
                        <button type="button" data-gallery-thumb="@Url.Content($"~/Product/{images[i]}")" aria-current="@(i == 0 ? "true" : "false")" aria-label="Show image @(i + 1) of @images.Count">
                            <img src="~/Product/@images[i]" alt="" loading="lazy" width="76" height="76" />
                        </button>
                    }
                </div>
            }
            <div class="gallery-main" style="@(images.Count <= 1 ? "grid-column:1 / -1" : "")">
                @if (images.Count > 0)
                {
                    <img id="gallery-main" src="~/Product/@images[0]" alt="@p.ProName" width="800" height="800" fetchpriority="high" />
                    @if (images.Count > 1)
                    {
                        <button type="button" class="gallery-nav prev" data-gallery-step="-1" aria-label="Previous image"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
                        <button type="button" class="gallery-nav next" data-gallery-step="1" aria-label="Next image"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
                        <span class="gallery-count" data-gallery-count aria-hidden="true">1 / @images.Count</span>
                    }
                }
                else
                {
                    <div class="d-grid h-100 text-muted" style="place-items:center"><i class="fa-solid fa-mountain fa-3x" aria-hidden="true"></i><span class="visually-hidden">No image available</span></div>
                }
                <div class="p-badges">
                    @if (p.IsOnSale && p.IsInStock)
                    {
                        <span class="badge-hs badge-sale">−@p.DiscountPercent%</span>
                    }
                </div>
            </div>
        </section>

        <section class="pdp-info" aria-labelledby="product-title">
            @if (!string.IsNullOrEmpty(p.Brand))
            {
                <a class="p-brand text-decoration-none" asp-action="Shop" asp-route-brand="@p.Brand">@p.Brand</a>
            }
            <h1 id="product-title">@p.ProName</h1>
            @if (Model.ReviewCount > 0 && Model.AverageRating.HasValue)
            {
                <a href="#reviews" class="p-meta text-decoration-none mb-2 d-inline-flex">
                    <partial name="_Stars" model="Model.AverageRating.Value" />
                    <span>@Model.AverageRating.Value.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) · @Model.ReviewCount @(Model.ReviewCount == 1 ? "review" : "reviews")</span>
                </a>
            }
            <div class="price my-2">
                <span class="now @(p.IsOnSale ? "on-sale" : "")">@store.FormatPrice(p.Price)</span>
                @if (p.IsOnSale)
                {
                    <span class="was"><span class="visually-hidden">Was </span>@store.FormatPrice(p.CompareAtPrice!.Value)</span>
                    <span class="off">Save @store.FormatPrice(p.CompareAtPrice.Value - p.Price) (@p.DiscountPercent%)</span>
                }
            </div>
            <p class="small text-muted">Price includes VAT. @(store.FreeShippingThreshold > 0 ? $"Free standard shipping over {store.FormatPrice(store.FreeShippingThreshold)}." : "")</p>

            <form method="post" asp-controller="Carts" asp-action="AddToCart" data-add-to-cart id="add-to-cart-form" class="mt-4">
                <input type="hidden" name="proId" value="@p.ProId" />
                <input type="hidden" name="returnUrl" value="@Url.Action("ProductDetailes", new { id = p.ProId })" />

                @if (p.ColorOptions.Count > 0)
                {
                    <fieldset class="mb-4">
                        <legend class="opt-label">Colour <span data-selected-label="color">@(p.ColorOptions.Count == 1 ? p.ColorOptions[0] : "– choose one")</span></legend>
                        <div class="opt-chips">
                            @for (var i = 0; i < p.ColorOptions.Count; i++)
                            {
                                <input type="radio" name="color" id="color-@i" value="@p.ColorOptions[i]" required @(p.ColorOptions.Count == 1 ? "checked" : "") data-label-target="color" />
                                <label for="color-@i">@p.ColorOptions[i]</label>
                            }
                        </div>
                    </fieldset>
                }
                @if (p.SizeOptions.Count > 0)
                {
                    <fieldset class="mb-4">
                        <legend class="opt-label">Size <span data-selected-label="size">@(p.SizeOptions.Count == 1 ? p.SizeOptions[0] : "– choose one")</span></legend>
                        <div class="opt-chips">
                            @for (var i = 0; i < p.SizeOptions.Count; i++)
                            {
                                <input type="radio" name="size" id="size-@i" value="@p.SizeOptions[i]" required @(p.SizeOptions.Count == 1 ? "checked" : "") data-label-target="size" />
                                <label for="size-@i">@p.SizeOptions[i]</label>
                            }
                        </div>
                    </fieldset>
                }

                <div class="stock-line mb-3 @(p.IsInStock ? (lowStock ? "low" : "") : "out")">
                    <span class="dot" aria-hidden="true"></span>
                    @if (!p.IsInStock)
                    {
                        <span>Out of stock</span>
                    }
                    else if (lowStock)
                    {
                        <span>Only @p.StockQuantity left in stock</span>
                    }
                    else
                    {
                        <span>In stock — ready to ship</span>
                    }
                </div>

                @if (p.IsInStock)
                {
                    <div class="buy-row">
                        <div class="qty-stepper">
                            <button type="button" data-step="-1" aria-label="Decrease quantity"><i class="fa-solid fa-minus" aria-hidden="true"></i></button>
                            <label for="qty" class="visually-hidden">Quantity</label>
                            <input id="qty" type="number" name="qty" value="1" min="1" max="@maxQty" inputmode="numeric" required />
                            <button type="button" data-step="1" aria-label="Increase quantity"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
                        </div>
                        <button type="submit" class="btn btn-primary btn-lg" data-busy-text="Adding…">
                            <i class="fa-solid fa-bag-shopping me-2" aria-hidden="true"></i>Add to cart
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-lg" data-wishlist-toggle data-product-id="@p.ProId"
                                aria-pressed="@(Model.InWishlist ? "true" : "false")" aria-label="@(Model.InWishlist ? "Remove from" : "Add to") wishlist">
                            <i class="@(Model.InWishlist ? "fa-solid" : "fa-regular") fa-heart" aria-hidden="true"></i>
                        </button>
                    </div>
                }
                else
                {
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-primary btn-lg flex-grow-1" disabled>Sold out</button>
                        <button type="button" class="btn btn-outline-secondary btn-lg" data-wishlist-toggle data-product-id="@p.ProId"
                                aria-pressed="@(Model.InWishlist ? "true" : "false")" aria-label="@(Model.InWishlist ? "Remove from" : "Add to") wishlist">
                            <i class="@(Model.InWishlist ? "fa-solid" : "fa-regular") fa-heart me-1" aria-hidden="true"></i><span data-label>@(Model.InWishlist ? "Saved" : "Save")</span>
                        </button>
                    </div>
                    <p class="small text-muted mt-2">Save it to your wishlist and check back — we restock popular items regularly.</p>
                }
            </form>

            <ul class="info-list mt-4">
                <li><i class="fa-solid fa-truck-fast" aria-hidden="true"></i><div><strong>Delivery</strong><br />
                    @foreach (var method in store.ShippingMethods)
                    {
                        <span class="d-block text-muted">@method.Name: @(method.Cost == 0 ? "free" : store.FormatPrice(method.Cost))@(method.FreeOverThreshold ? $" (free over {store.FormatPrice(store.FreeShippingThreshold)})" : "") · @method.EstimatedDays</span>
                    }
                </div></li>
                <li><i class="fa-solid fa-rotate-left" aria-hidden="true"></i><div><strong>@store.ReturnDays-day returns</strong><br /><span class="text-muted">Unused items in original condition. <a asp-action="Returns">Returns policy</a></span></div></li>
                <li><i class="fa-solid fa-money-bill-wave" aria-hidden="true"></i><div><strong>Cash on delivery</strong><br /><span class="text-muted">Pay the courier when your order arrives.</span></div></li>
            </ul>

            <div class="accordion pdp-accordion mt-4" id="pdp-details">
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#pdp-desc" aria-expanded="true" aria-controls="pdp-desc">Description</button>
                    </h2>
                    <div id="pdp-desc" class="accordion-collapse collapse show">
                        <div class="accordion-body" style="white-space:pre-line">@(string.IsNullOrWhiteSpace(p.Descreption) ? "No description available." : p.Descreption)</div>
                    </div>
                </div>
                @if (p.SpecificationList.Count > 0 || !string.IsNullOrEmpty(p.Material))
                {
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#pdp-specs" aria-expanded="false" aria-controls="pdp-specs">Specifications</button>
                        </h2>
                        <div id="pdp-specs" class="accordion-collapse collapse">
                            <div class="accordion-body">
                                <table class="spec-table">
                                    <tbody>
                                        @if (!string.IsNullOrEmpty(p.Brand))
                                        {
                                            <tr><th scope="row">Brand</th><td>@p.Brand</td></tr>
                                        }
                                        @if (!string.IsNullOrEmpty(p.Material))
                                        {
                                            <tr><th scope="row">Material</th><td>@p.Material</td></tr>
                                        }
                                        @foreach (var spec in p.SpecificationList)
                                        {
                                            <tr><th scope="row">@spec.Key</th><td>@spec.Value</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>
    </div>

    <section id="reviews" class="section" aria-labelledby="reviews-title">
        <h2 id="reviews-title">Customer reviews</h2>
        @if (Model.ReviewCount > 0 && Model.AverageRating.HasValue)
        {
            <div class="review-summary my-4">
                <div class="review-score">
                    <div class="big">@Model.AverageRating.Value.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)</div>
                    <partial name="_Stars" model="Model.AverageRating.Value" />
                    <div class="small text-muted mt-1">@Model.ReviewCount @(Model.ReviewCount == 1 ? "review" : "reviews")</div>
                </div>
                <ul class="rating-bars list-unstyled m-0">
                    @for (var star = 5; star >= 1; star--)
                    {
                        var count = Model.RatingBreakdown[star - 1];
                        var pct = Model.ReviewCount == 0 ? 0 : (int)Math.Round(100.0 * count / Model.ReviewCount);
                        <li><span>@star star</span><span class="bar" role="img" aria-label="@pct percent"><span style="width:@pct%"></span></span><span class="text-muted">@count</span></li>
                    }
                </ul>
            </div>
        }
        else
        {
            <p class="text-muted">No reviews yet.</p>
        }

        <div class="row gy-4 gx-lg-5">
            <div class="col-lg-7 order-2 order-lg-1">
                @foreach (var review in Model.Reviews)
                {
                    <article class="review-item">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <partial name="_Stars" model="(double)review.Rating" />
                            @if (review.IsVerifiedPurchase)
                            {
                                <span class="verified"><i class="fa-solid fa-circle-check" aria-hidden="true"></i> Verified purchase</span>
                            }
                        </div>
                        <h3>@review.Title</h3>
                        <p class="mb-2" style="white-space:pre-line">@review.Comment</p>
                        <p class="small text-muted m-0">@(review.User?.FirstName ?? "Customer") · <time datetime="@review.CreatedAt.ToString("yyyy-MM-dd")">@review.CreatedAt.ToString("d MMM yyyy")</time></p>
                    </article>
                }
            </div>
            <div class="col-lg-5 order-1 order-lg-2">
                <div class="card-hs beige">
                    <h3 class="h5">Write a review</h3>
                    @if (Model.CanReview)
                    {
                        <form method="post" asp-controller="Reviews" asp-action="Create" data-once>
                            <input type="hidden" name="ProId" value="@p.ProId" />
                            <fieldset class="mb-3">
                                <legend class="form-label">Your rating</legend>
                                <div class="star-input">
                                    @for (var s = 5; s >= 1; s--)
                                    {
                                        <input type="radio" name="Rating" id="rate-@s" value="@s" required />
                                        <label for="rate-@s" title="@s star@(s > 1 ? "s" : "")"><i class="fa-solid fa-star" aria-hidden="true"></i><span class="visually-hidden">@s star@(s > 1 ? "s" : "")</span></label>
                                    }
                                </div>
                            </fieldset>
                            <div class="mb-3">
                                <label class="form-label" for="review-title">Title</label>
                                <input class="form-control" id="review-title" name="Title" required minlength="3" maxlength="100" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="review-comment">Review</label>
                                <textarea class="form-control" id="review-comment" name="Comment" rows="4" required minlength="10" maxlength="2000"></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary w-100" data-busy-text="Submitting…">Submit review</button>
                            <p class="small text-muted mt-2 mb-0">Reviews are checked by our team before they appear.</p>
                        </form>
                    }
                    else
                    {
                        <p class="m-0">@Model.ReviewBlockedReason</p>
                        @if (!User.Identity!.IsAuthenticated)
                        {
                            <a class="btn btn-outline-primary mt-3" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Url.Action("ProductDetailes", new { id = p.ProId })#reviews">Sign in</a>
                        }
                    }
                </div>
            </div>
        </div>
    </section>

    @if (Model.Related.Count > 0)
    {
        <section class="section pt-0" aria-labelledby="related-title">
            <div class="section-head"><h2 id="related-title">You may also like</h2></div>
            <div class="product-rail" tabindex="0" aria-label="Related products, scroll horizontally">
                @foreach (var card in Model.Related)
                {
                    <partial name="_ProductCard" model="card" />
                }
            </div>
        </section>
    }

    @if (Model.RecentlyViewed.Count > 0)
    {
        <section class="section pt-0" aria-labelledby="recent-title">
            <div class="section-head"><h2 id="recent-title">Recently viewed</h2></div>
            <div class="product-rail" tabindex="0" aria-label="Recently viewed products, scroll horizontally">
                @foreach (var card in Model.RecentlyViewed)
                {
                    <partial name="_ProductCard" model="card" />
                }
            </div>
        </section>
    }
</div>

<div class="mobile-buy-bar d-lg-none" aria-hidden="false">
    <div class="price">
        <span class="now @(p.IsOnSale ? "on-sale" : "")">@store.FormatPrice(p.Price)</span>
    </div>
    @if (p.IsInStock)
    {
        <button type="submit" form="add-to-cart-form" class="btn btn-primary" data-busy-text="Adding…">Add to cart</button>
    }
    else
    {
        <button type="button" class="btn btn-primary" disabled>Sold out</button>
    }
</div>

@section Scripts {
    <script>
        (function () {
            const main = document.getElementById('gallery-main');
            const thumbs = [...document.querySelectorAll('[data-gallery-thumb]')];
            const counter = document.querySelector('[data-gallery-count]');
            let current = 0;
            function show(index) {
                if (!main || thumbs.length === 0) return;
                current = (index + thumbs.length) % thumbs.length;
                main.src = thumbs[current].dataset.galleryThumb;
                thumbs.forEach((b, i) => b.setAttribute('aria-current', i === current ? 'true' : 'false'));
                const strip = thumbs[current].parentElement;
                if (strip.scrollWidth > strip.clientWidth) {
                    strip.scrollTo({ left: thumbs[current].offsetLeft - strip.offsetLeft - 8, behavior: 'smooth' });
                }
                if (counter) counter.textContent = (current + 1) + ' / ' + thumbs.length;
            }
            thumbs.forEach((btn, i) => btn.addEventListener('click', () => show(i)));
            document.querySelectorAll('[data-gallery-step]').forEach(btn => {
                btn.addEventListener('click', () => show(current + Number(btn.dataset.galleryStep)));
            });
            const stage = main?.closest('.gallery-main');
            if (stage && thumbs.length > 1) {
                let startX = null, startY = 0;
                stage.addEventListener('touchstart', e => { startX = e.touches[0].clientX; startY = e.touches[0].clientY; }, { passive: true });
                stage.addEventListener('touchend', e => {
                    if (startX === null) return;
                    const dx = e.changedTouches[0].clientX - startX;
                    const dy = e.changedTouches[0].clientY - startY;
                    if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) show(current + (dx < 0 ? 1 : -1));
                    startX = null;
                });
            }
            const buyForm = document.getElementById('add-to-cart-form');
            const buyBar = document.querySelector('.mobile-buy-bar');
            if (buyForm && buyBar && 'IntersectionObserver' in window) {
                new IntersectionObserver(entries => {
                    buyBar.classList.toggle('is-hidden', entries[0].isIntersecting);
                }).observe(buyForm);
            }
            document.querySelectorAll('[data-label-target]').forEach(input => {
                input.addEventListener('change', () => {
                    const label = document.querySelector('[data-selected-label="' + input.dataset.labelTarget + '"]');
                    if (label) label.textContent = input.value;
                });
            });
        })();
    </script>
}
