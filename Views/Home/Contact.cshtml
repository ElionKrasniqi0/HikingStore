@model Contact
@inject IOptions<StoreSettings> StoreOptions
@{
    var store = StoreOptions.Value;
    ViewData["Title"] = "Contact us";
    ViewData["Description"] = $"Questions about gear, an order or a return? Contact the {store.Name} team in Prishtina.";
    ViewData["HelpSection"] = "Contact";
    var subjects = new[] { "Product question", "Order question", "Shipping question", "Return request", "Damaged or wrong item", "Service request", "Other" };
    var currentSubject = Model.Subject;
    var subjectOptions = string.IsNullOrEmpty(currentSubject) || subjects.Contains(currentSubject) ? subjects : subjects.Prepend(currentSubject).ToArray();
    var mapQuery = Uri.EscapeDataString(store.Address);
}

<div class="container-hs">
    <nav class="breadcrumb-bar" aria-label="Breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Contact us</li>
        </ol>
    </nav>
    <div class="page-head"><h1>Contact us</h1></div>
    <div class="help-layout">
        <partial name="_HelpNav" />
        <div>
            <p class="lead-muted">Questions about gear, sizing, an order or a return? Send us a message and we'll reply by email. For order questions, include your order number.</p>

            <div class="contact-cards my-4">
                @if (!string.IsNullOrEmpty(store.SupportEmail))
                {
                    <div class="fact"><i class="fa-solid fa-envelope" aria-hidden="true"></i><h3>Email</h3><p><a href="mailto:@store.SupportEmail">@store.SupportEmail</a></p></div>
                }
                @if (!string.IsNullOrEmpty(store.SupportPhone))
                {
                    <div class="fact"><i class="fa-solid fa-phone" aria-hidden="true"></i><h3>Phone</h3><p><a href="tel:@store.SupportPhone.Replace(" ", "")">@store.SupportPhone</a></p></div>
                }
                @if (!string.IsNullOrEmpty(store.Address))
                {
                    <div class="fact">
                        <i class="fa-solid fa-location-dot" aria-hidden="true"></i><h3>Store</h3>
                        <p>@store.Address<br /><a href="https://www.google.com/maps/search/?api=1&query=@mapQuery" target="_blank" rel="noopener">Get directions</a></p>
                    </div>
                }
                @if (store.OpeningHours.Count > 0)
                {
                    <div class="fact">
                        <i class="fa-solid fa-clock" aria-hidden="true"></i><h3>Opening hours</h3>
                        <p>@for (var i = 0; i < store.OpeningHours.Count; i++) { @store.OpeningHours[i]@if (i < store.OpeningHours.Count - 1) {<br />} }</p>
                    </div>
                }
            </div>

            <section class="card-hs p-4" aria-labelledby="form-h" style="max-width:720px">
                <h2 id="form-h" class="h4">Send a message</h2>
                <form method="post" asp-action="Contact" data-once novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="Name" class="form-label">Your name</label>
                            <input asp-for="Name" class="form-control" autocomplete="name" maxlength="100" required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Email" class="form-label">Email address</label>
                            <input asp-for="Email" class="form-control" type="email" autocomplete="email" maxlength="256" required />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Subject" class="form-label">Subject</label>
                            <select asp-for="Subject" class="form-select">
                                @foreach (var s in subjectOptions)
                                {
                                    <option value="@s" selected="@(s == currentSubject)">@s</option>
                                }
                            </select>
                            <span asp-validation-for="Subject" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Message" class="form-label">Message</label>
                            <textarea asp-for="Message" class="form-control" rows="6" maxlength="2000" required aria-describedby="msg-help"></textarea>
                            <span asp-validation-for="Message" class="text-danger small"></span>
                            <p class="small text-muted mt-1 mb-0" id="msg-help">Up to 2,000 characters. Please don't include card or bank details.</p>
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary" data-busy-text="Sending…">Send message</button>
                        </div>
                    </div>
                </form>
            </section>

            <p class="mt-4">Looking for a quick answer? Check the <a asp-action="Faq">FAQ</a>, <a asp-action="Shipping">shipping</a> or <a asp-action="Returns">returns</a> pages.</p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
