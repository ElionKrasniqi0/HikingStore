@using HikingStore.ViewModels
@model SearchResultViewModel

<!-- Elegant Search Hero -->
<div class="search-hero-section py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <!-- Search Icon -->
                <div class="search-icon-wrapper mb-4">
                    <div class="search-icon-circle">
                        <i class="fas fa-search text-primary"></i>
                    </div>
                </div>

                <!-- Search Title -->
                <h1 class="display-5 fw-bold text-dark mb-3">Search Results</h1>

                <!-- Search Stats -->
                <div class="search-stats mb-4">
                    <div class="d-flex flex-wrap justify-content-center align-items-center gap-3">
                        <span class="search-badge">
                            <i class="fas fa-search me-2"></i>
                            "@Model.Query"
                        </span>
                        <span class="search-stat-item">
                            <i class="fas fa-box me-1"></i>
                            @Model.ProductCount products
                        </span>
                        <span class="search-stat-item">
                            <i class="fas fa-tags me-1"></i>
                            @Model.CategoryCount categories
                        </span>
                    </div>
                </div>

                <!-- Search Box -->
                <div class="search-box-container mb-5">
                    <form action="/Home/Search" method="get" class="search-form">
                        <div class="input-group input-group-lg search-input-group">
                            <span class="input-group-text search-prefix">
                                <i class="fas fa-search"></i>
                            </span>
                            <input type="text"
                                   name="query"
                                   class="form-control search-input"
                                   placeholder="Search for hiking gear, categories..."
                                   value="@Model.Query"
                                   autocomplete="off">
                            <button class="btn btn-primary search-btn" type="submit">
                                Search
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Main Content -->
<div class="search-content-section py-5">
    <div class="container">
        <!-- Categories Section -->
        @if (Model.Categories.Any())
        {
            <div class="section-card mb-5">
                <div class="section-header mb-4">
                    <div class="d-flex align-items-center">
                        <div class="section-icon me-3">
                            <i class="fas fa-tags"></i>
                        </div>
                        <div>
                            <h3 class="section-title mb-1">Categories</h3>
                            <p class="section-subtitle text-muted">
                                Found @Model.CategoryCount categories matching your search
                            </p>
                        </div>
                    </div>
                </div>

                <div class="row g-4">
                    @foreach (var category in Model.Categories)
                    {
                        <div class="col-xl-3 col-lg-4 col-md-6">
                            <div class="category-card card border-0 shadow-sm h-100">
                                <div class="category-image-wrapper">
                                    <img src="~/category/@category.CatPhoto"
                                         alt="@category.CatName"
                                         class="category-image">
                                    <div class="category-overlay"></div>
                                </div>
                                <div class="card-body p-4">
                                    <div class="category-content">
                                        <h5 class="category-title mb-3">@category.CatName</h5>
                                        <a href="/Home/ProductCategory/@category.CatId"
                                           class="btn btn-outline-primary category-btn">
                                            <i class="fas fa-arrow-right me-2"></i>Explore
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Products Section -->
        @if (Model.Products.Any())
        {
            <div class="section-card">
                <div class="section-header mb-4">
                    <div class="d-flex align-items-center">
                        <div class="section-icon me-3">
                            <i class="fas fa-box"></i>
                        </div>
                        <div>
                            <h3 class="section-title mb-1">Products</h3>
                            <p class="section-subtitle text-muted">
                                Found @Model.ProductCount products matching your search
                            </p>
                        </div>
                    </div>
                </div>

                <div class="row g-4">
                    @foreach (var product in Model.Products)
                    {
                        <div class="col-xl-3 col-lg-4 col-md-6">
                            <div class="product-card card border-0 shadow-sm h-100">
                                <!-- Product Image -->
                                <div class="product-image-wrapper">
                                    <a href="/Home/ProductDetailes/@product.ProId" class="product-image-link">
                                        <img src="~/Product/@product.ProImage"
                                             alt="@product.ProName"
                                             class="product-image">
                                        <div class="product-overlay"></div>
                                    </a>

                                    <!-- Category Badge -->
                                    <div class="product-category-badge">
                                        <span class="badge bg-primary">@product.Category?.CatName</span>
                                    </div>
                                </div>

                                <!-- Product Body -->
                                <div class="card-body p-4">
                                    <div class="product-content">
                                        <!-- Product Title -->
                                        <h6 class="product-title mb-2">
                                            <a href="/Home/ProductDetailes/@product.ProId"
                                               class="text-dark text-decoration-none">
                                                @product.ProName
                                            </a>
                                        </h6>

                                        <!-- Product Description -->
                                        <p class="product-description text-muted small mb-3">
                                            @{
                                                var description = product.Descreption ?? "";
                                                var truncatedDescription = description.Length > 80
                                                ? description.Substring(0, 80) + "..."
                                                : description;
                                            }
                                            @truncatedDescription
                                        </p>

                                        <!-- Price and Actions -->
                                        <div class="product-footer">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div class="product-price">
                                                    <span class="h5 text-primary fw-bold">€@product.Price.ToString("N2")</span>
                                                </div>
                                                <a href="/Home/ProductDetailes/@product.ProId"
                                                   class="btn btn-primary btn-sm">
                                                    <i class="fas fa-eye me-1"></i>View
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- No Results Section -->
        @if (!Model.Products.Any() && !Model.Categories.Any())
        {
            <div class="no-results-section text-center py-5">
                <div class="no-results-icon mb-4">
                    <i class="fas fa-search fa-4x text-muted"></i>
                </div>
                <h3 class="h4 fw-bold text-dark mb-3">No Results Found</h3>
                <p class="text-muted mb-4">
                    We couldn't find any matches for "<strong>@Model.Query</strong>".
                    Try different keywords or browse our categories.
                </p>
                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <a href="/Home/Product" class="btn btn-primary btn-lg">
                        <i class="fas fa-shopping-bag me-2"></i>Browse All Products
                    </a>
                    <a href="/Home/ProductCategory" class="btn btn-outline-primary btn-lg">
                        <i class="fas fa-tags me-2"></i>Explore Categories
                    </a>
                </div>

                <!-- Search Tips -->
                <div class="search-tips mt-5 pt-4 border-top">
                    <h6 class="text-muted mb-3">Search Tips:</h6>
                    <div class="row justify-content-center">
                        <div class="col-md-8">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <div class="tip-item">
                                        <i class="fas fa-check-circle text-success me-2"></i>
                                        <span>Check spelling</span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="tip-item">
                                        <i class="fas fa-check-circle text-success me-2"></i>
                                        <span>Try fewer words</span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="tip-item">
                                        <i class="fas fa-check-circle text-success me-2"></i>
                                        <span>Use broader terms</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    /* Elegant Search Hero */
    .search-hero-section {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-bottom: 1px solid rgba(0,0,0,0.05);
    }

    .search-icon-wrapper {
        display: flex;
        justify-content: center;
    }

    .search-icon-circle {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #3b5d50, #2d473d);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 25px rgba(59, 93, 80, 0.25);
    }

        .search-icon-circle i {
            font-size: 2rem;
            color: white;
        }

    .search-badge {
        background: rgba(59, 93, 80, 0.1);
        color: #3b5d50;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-weight: 600;
        font-size: 1.1rem;
        border: 2px solid rgba(59, 93, 80, 0.2);
    }

    .search-stat-item {
        color: #6c757d;
        font-weight: 500;
    }

        .search-stat-item i {
            color: #3b5d50;
        }

    /* Search Box */
    .search-box-container {
        max-width: 700px;
        margin: 0 auto;
    }

    .search-input-group {
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    }

    .search-prefix {
        background: white;
        border: none;
        padding-left: 1.5rem;
        color: #3b5d50;
    }

    .search-input {
        border: none;
        padding: 1rem 1.5rem;
        font-size: 1.1rem;
        box-shadow: none;
    }

        .search-input:focus {
            box-shadow: none;
            border-color: transparent;
        }

    .search-btn {
        padding: 1rem 2rem;
        font-weight: 600;
        border: none;
        background: linear-gradient(135deg, #3b5d50, #2d473d);
    }

        .search-btn:hover {
            background: linear-gradient(135deg, #2d473d, #1a2f26);
        }

    /* Section Cards */
    .section-card {
        background: white;
        border-radius: 16px;
        padding: 2.5rem;
        box-shadow: 0 2px 20px rgba(0,0,0,0.08);
        margin-bottom: 2rem;
    }

    .section-header {
        padding-bottom: 1rem;
        border-bottom: 2px solid rgba(0,0,0,0.05);
    }

    .section-icon {
        width: 50px;
        height: 50px;
        background: linear-gradient(135deg, #3b5d50, #2d473d);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.2rem;
    }

    .section-title {
        color: #2d473d;
        font-weight: 700;
    }

    .section-subtitle {
        font-size: 0.95rem;
    }

    /* Category Cards */
    .category-card {
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        border-radius: 12px;
        overflow: hidden;
    }

        .category-card:hover {
            transform: translateY(-8px) scale(1.02);
            box-shadow: 0 15px 40px rgba(59, 93, 80, 0.15);
        }

    .category-image-wrapper {
        position: relative;
        overflow: hidden;
    }

    .category-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s ease;
    }

    .category-card:hover .category-image {
        transform: scale(1.1);
    }

    .category-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,0.3) 100%);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .category-card:hover .category-overlay {
        opacity: 1;
    }

    .category-content {
        text-align: center;
    }

    .category-title {
        color: #2d473d;
        font-weight: 600;
        min-height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .category-btn {
        border-radius: 8px;
        padding: 0.5rem 1.5rem;
        font-weight: 500;
        transition: all 0.3s ease;
    }

        .category-btn:hover {
            background: #3b5d50;
            color: white;
            transform: translateX(5px);
        }

    /* Product Cards */
    .product-card {
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        border-radius: 12px;
        overflow: hidden;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(59, 93, 80, 0.15);
        }

    .product-image-wrapper {
        position: relative;
        height: 200px;
        overflow: hidden;
        background: #f8f9fa;
    }

    .product-image-link {
        display: block;
        height: 100%;
    }

    .product-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s ease;
    }

    .product-card:hover .product-image {
        transform: scale(1.05);
    }

    .product-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,0.1) 100%);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .product-card:hover .product-overlay {
        opacity: 1;
    }

    .product-category-badge {
        position: absolute;
        top: 15px;
        left: 15px;
        z-index: 2;
    }

        .product-category-badge .badge {
            font-size: 0.7rem;
            padding: 0.4rem 0.8rem;
            border-radius: 6px;
            font-weight: 600;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

    .product-title a {
        color: #2d473d;
        font-weight: 600;
        text-decoration: none;
        transition: color 0.3s ease;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 48px;
    }

        .product-title a:hover {
            color: #3b5d50;
            text-decoration: underline;
        }

    .product-description {
        line-height: 1.5;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 48px;
    }

    .product-footer .btn {
        border-radius: 8px;
        padding: 0.4rem 1rem;
        font-weight: 500;
        transition: all 0.3s ease;
    }

        .product-footer .btn:hover {
            transform: translateX(3px);
            box-shadow: 0 4px 12px rgba(59, 93, 80, 0.2);
        }

    /* No Results Section */
    .no-results-section {
        background: white;
        border-radius: 16px;
        padding: 3rem;
        box-shadow: 0 2px 20px rgba(0,0,0,0.08);
    }

    .no-results-icon {
        opacity: 0.7;
    }

    .search-tips {
        max-width: 600px;
        margin: 0 auto;
    }

    .tip-item {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0.5rem;
        background: #f8f9fa;
        border-radius: 8px;
        font-size: 0.9rem;
    }

        .tip-item i {
            font-size: 0.8rem;
        }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .search-hero-section {
            padding: 2rem 0;
        }

        .display-5 {
            font-size: 2rem;
        }

        .search-icon-circle {
            width: 60px;
            height: 60px;
        }

            .search-icon-circle i {
                font-size: 1.5rem;
            }

        .search-badge {
            font-size: 0.9rem;
        }

        .search-stat-item {
            font-size: 0.9rem;
        }

        .search-input-group {
            flex-direction: column;
        }

            .search-input-group .input-group-text,
            .search-input-group .form-control,
            .search-input-group .btn {
                border-radius: 8px;
                width: 100%;
                margin: 0.25rem 0;
            }

        .section-card {
            padding: 1.5rem;
        }

        .category-image-wrapper,
        .product-image-wrapper {
            height: 160px;
        }

        .product-title a {
            font-size: 0.9rem;
            min-height: 40px;
        }

        .product-description {
            font-size: 0.8rem;
            min-height: 40px;
        }

        .no-results-section {
            padding: 2rem 1rem;
        }
    }

    @@media (max-width: 576px) {
        .search-stats .d-flex {
            flex-direction: column;
            gap: 1rem;
        }

        .category-image-wrapper,
        .product-image-wrapper {
            height: 140px;
        }

        .card-body {
            padding: 1rem !important;
        }

        .section-title {
            font-size: 1.25rem;
        }

        .btn-lg {
            padding: 0.5rem 1rem;
            font-size: 0.9rem;
        }
    }

    /* Animation for search results */
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .category-card,
    .product-card {
        animation: fadeInUp 0.5s ease-out;
        animation-fill-mode: both;
    }

        .category-card:nth-child(1) {
            animation-delay: 0.1s;
        }

        .category-card:nth-child(2) {
            animation-delay: 0.2s;
        }

        .category-card:nth-child(3) {
            animation-delay: 0.3s;
        }

        .category-card:nth-child(4) {
            animation-delay: 0.4s;
        }

        .product-card:nth-child(1) {
            animation-delay: 0.1s;
        }

        .product-card:nth-child(2) {
            animation-delay: 0.2s;
        }

        .product-card:nth-child(3) {
            animation-delay: 0.3s;
        }

        .product-card:nth-child(4) {
            animation-delay: 0.4s;
        }

        .product-card:nth-child(5) {
            animation-delay: 0.5s;
        }

        .product-card:nth-child(6) {
            animation-delay: 0.6s;
        }

    /* Loading state (optional for future AJAX) */
    .search-loading {
        position: relative;
        opacity: 0.7;
        pointer-events: none;
    }

        .search-loading::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 30px;
            height: 30px;
            border: 3px solid #f3f3f3;
            border-top: 3px solid #3b5d50;
            border-radius: 50%;
            animation: search-spin 1s linear infinite;
            transform: translate(-50%, -50%);
        }

    @@keyframes search-spin {
        0% {
            transform: translate(-50%, -50%) rotate(0deg);
        }

        100% {
            transform: translate(-50%, -50%) rotate(360deg);
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Add search input focus effect
        const searchInput = document.querySelector('.search-input');
        const searchForm = document.querySelector('.search-form');

        if (searchInput) {
            searchInput.addEventListener('focus', function() {
                this.parentElement.classList.add('focused');
            });

            searchInput.addEventListener('blur', function() {
                if (this.value === '') {
                    this.parentElement.classList.remove('focused');
                }
            });

            // Auto-focus on search input
            if (!/@Model.Query/.test(window.location.href)) {
                searchInput.focus();
            }
        }

        // Add smooth scrolling to results
        const hash = window.location.hash;
        if (hash) {
            setTimeout(() => {
                const element = document.querySelector(hash);
                if (element) {
                    element.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            }, 100);
        }

        // Add loading state to search button
        if (searchForm) {
            searchForm.addEventListener('submit', function(e) {
                const submitBtn = this.querySelector('.search-btn');
                if (submitBtn) {
                    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Searching...';
                    submitBtn.disabled = true;
                }
            });
        }

        // Add hover effects to cards
        const cards = document.querySelectorAll('.category-card, .product-card');
        cards.forEach(card => {
            card.addEventListener('mouseenter', function() {
                this.style.zIndex = '10';
            });

            card.addEventListener('mouseleave', function() {
                this.style.zIndex = '1';
            });
        });

        // Keyboard shortcuts
        document.addEventListener('keydown', function(e) {
            // Ctrl/Cmd + K to focus search
            if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
                e.preventDefault();
                const searchInput = document.querySelector('.search-input');
                if (searchInput) {
                    searchInput.focus();
                    searchInput.select();
                }
            }

            // Escape to clear search
            if (e.key === 'Escape') {
                const searchInput = document.querySelector('.search-input');
                if (searchInput && document.activeElement === searchInput) {
                    searchInput.value = '';
                }
            }
        });
    });
</script>