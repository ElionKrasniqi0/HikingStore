@inject IOptions<StoreSettings> StoreOptions
@{
    var store = StoreOptions.Value;
    ViewData["Title"] = "About us";
    ViewData["Description"] = $"{store.Name} is an outdoor gear shop in Prishtina, Kosovo, founded by hikers in 2020.";
    ViewData["HelpSection"] = "About";
    var values = new (string Icon, string Title, string Text)[]
    {
        ("fa-helmet-safety", "Safety first", "Our gear recommendations and trail advice start with keeping you safe."),
        ("fa-leaf", "Sustainability", "We favour durable, repairable products and responsible outdoor practice."),
        ("fa-people-group", "Community", "We support local hiking groups and trail work across Kosovo."),
        ("fa-medal", "Quality", "We only stock gear we would trust on our own trips.")
    };
    var team = new (string Name, string Role, string Note)[]
    {
        ("Artan Berisha", "Founder", "15+ years of mountaineering experience"),
        ("Liridona Krasniqi", "Head of operations", "Wilderness first responder"),
        ("Blerim Shala", "Gear specialist", "Former hiking guide"),
        ("Valmira Gashi", "Customer experience", "10+ years in outdoor retail")
    };
}

<div class="container-hs">
    <nav class="breadcrumb-bar" aria-label="Breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">About us</li>
        </ol>
    </nav>
    <div class="page-head"><h1>About @store.Name</h1></div>
    <div class="help-layout">
        <partial name="_HelpNav" />
        <article class="prose" style="max-width:860px">
            <p class="lead-muted">Founded by hikers in 2020, @store.Name started as a small local shop in Prishtina. We believe everyone should have access to reliable equipment for their adventures — and honest advice on what they actually need.</p>

            <h2>Our mission</h2>
            <p>To give outdoor enthusiasts dependable gear that keeps them safe and comfortable, so they can spend more time on the trail and less time worrying about their kit.</p>

            <h2>What we stand for</h2>
            <div class="fact-grid">
                @foreach (var v in values)
                {
                    <div class="fact"><i class="fa-solid @v.Icon" aria-hidden="true"></i><h3>@v.Title</h3><p>@v.Text</p></div>
                }
            </div>

            <h2>The team</h2>
            <div class="fact-grid">
                @foreach (var t in team)
                {
                    <div class="fact"><h3>@t.Name</h3><p>@t.Role · @t.Note</p></div>
                }
            </div>

            <h2>Visit us</h2>
            <p>Come and try gear on at our store@(string.IsNullOrEmpty(store.Address) ? "" : $" at {store.Address}"). See <a asp-action="Contact">contact details and opening hours</a>, or <a asp-action="Shop">shop online</a>.</p>
        </article>
    </div>
</div>
