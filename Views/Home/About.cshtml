@{
    ViewData["Title"] = "About HikingStore";
}

<!-- Hero Section -->
<section class="about-hero-section py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <span class="badge  bg-opacity-10 text-primary px-3 py-2 mb-3 fw-semibold">
                    <i class="fas fa-mountain me-2"></i>Our Story
                </span>
                <h1 class="display-4 fw-bold text-dark mb-4">
                    Gear Up for Every Adventure
                </h1>
                <p class="lead text-muted mb-4">
                    Founded by passionate hikers in 2020, HikingStore has grown from a small local shop to Kosovo's leading provider of premium outdoor gear. We believe that everyone deserves access to quality equipment for their adventures.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a href="/Home/Product" class="btn btn-primary btn-lg">
                        <i class="fas fa-shopping-bag me-2"></i>Explore Gear
                    </a>
                    <a href="/Home/Contact" class="btn btn-outline-primary btn-lg">
                        <i class="fas fa-phone me-2"></i>Contact Us
                    </a>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="about-hero-image position-relative">
                    <img src="~/img/about-hero.jpg" alt="Hiking Adventure" class="img-fluid rounded-4 shadow-lg">
                    <div class="floating-stats d-none d-lg-block">
                        <div class="stats-card">
                            <div class="stats-number text-primary">5,000+</div>
                            <div class="stats-label">Happy Customers</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Mission & Vision -->
<section class="mission-section py-5 bg-light">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-6">
                <div class="mission-card p-4 p-lg-5 h-100">
                    <div class="mission-icon mb-4">
                        <i class="fas fa-bullseye fa-3x text-primary"></i>
                    </div>
                    <h3 class="h2 fw-bold text-dark mb-4">Our Mission</h3>
                    <p class="text-muted fs-5 mb-4">
                        To empower outdoor enthusiasts with premium, reliable gear that enhances their connection with nature while ensuring safety and comfort on every journey.
                    </p>
                    <ul class="list-unstyled">
                        <li class="mb-3"><i class="fas fa-check-circle text-success me-2"></i> Quality gear for all skill levels</li>
                        <li class="mb-3"><i class="fas fa-check-circle text-success me-2"></i> Expert advice and guidance</li>
                        <li><i class="fas fa-check-circle text-success me-2"></i> Sustainable outdoor practices</li>
                    </ul>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="vision-card p-4 p-lg-5 h-100">
                    <div class="vision-icon mb-4">
                        <i class="fas fa-eye fa-3x text-primary"></i>
                    </div>
                    <h3 class="h2 fw-bold text-dark mb-4">Our Vision</h3>
                    <p class="text-muted fs-5 mb-4">
                        To become the Balkans' most trusted outdoor community, inspiring more people to explore nature while promoting sustainable outdoor recreation and conservation.
                    </p>
                    <ul class="list-unstyled">
                        <li class="mb-3"><i class="fas fa-compass text-primary me-2"></i> Expand outdoor accessibility</li>
                        <li class="mb-3"><i class="fas fa-leaf text-primary me-2"></i> Promote eco-friendly gear</li>
                        <li><i class="fas fa-hands-helping text-primary me-2"></i> Build hiking communities</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Core Values -->
<section class="values-section py-5">
    <div class="container">
        <div class="row justify-content-center mb-5">
            <div class="col-lg-8 text-center">
                <span class="badge  bg-opacity-10 text-primary px-3 py-2 mb-3 fw-semibold">
                    <i class="fas fa-star me-2"></i>Our Values
                </span>
                <h2 class="display-5 fw-bold text-dark mb-3">What We Stand For</h2>
                <p class="lead text-muted">Guiding principles that define our approach to business and community</p>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="value-card text-center p-4 h-100">
                    <div class="value-icon mb-4">
                        <div class="icon-wrapper">
                            <i class="fas fa-shield-alt fa-2x text-primary"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold mb-3">Safety First</h4>
                    <p class="text-muted">We prioritize safety in all our gear recommendations and trail advice.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="value-card text-center p-4 h-100">
                    <div class="value-icon mb-4">
                        <div class="icon-wrapper">
                            <i class="fas fa-leaf fa-2x text-primary"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold mb-3">Sustainability</h4>
                    <p class="text-muted">Committed to eco-friendly products and responsible outdoor practices.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="value-card text-center p-4 h-100">
                    <div class="value-icon mb-4">
                        <div class="icon-wrapper">
                            <i class="fas fa-users fa-2x text-primary"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold mb-3">Community</h4>
                    <p class="text-muted">Building and supporting local hiking communities across Kosovo.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="value-card text-center p-4 h-100">
                    <div class="value-icon mb-4">
                        <div class="icon-wrapper">
                            <i class="fas fa-award fa-2x text-primary"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold mb-3">Quality</h4>
                    <p class="text-muted">Only premium, tested gear that meets rigorous standards.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Meet the Team -->
<section class="team-section py-5 bg-light">
    <div class="container">
        <div class="row justify-content-center mb-5">
            <div class="col-lg-8 text-center">
                <span class="badge bg-opacity-10 text-primary px-3 py-2 mb-3 fw-semibold">
                    <i class="fas fa-users me-2"></i>Our Team
                </span>
                <h2 class="display-5 fw-bold text-dark mb-3">Meet the Experts</h2>
                <p class="lead text-muted">Passionate outdoors enthusiasts dedicated to enhancing your hiking experience</p>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="team-card text-center">
                    <div class="team-image mb-4">
                        <img src="~/img/team-1.jpg" alt="Artan Berisha" class="img-fluid rounded-circle">
                        <div class="team-social">
                            <a href="#" class="social-link"><i class="fab fa-linkedin"></i></a>
                            <a href="#" class="social-link"><i class="fab fa-instagram"></i></a>
                        </div>
                    </div>
                    <h5 class="fw-bold mb-1">Artan Berisha</h5>
                    <p class="text-primary mb-3">Founder & CEO</p>
                    <p class="text-muted small">15+ years of mountaineering experience</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="team-card text-center">
                    <div class="team-image mb-4">
                        <img src="~/img/team-2.jpg" alt="Liridona Krasniqi" class="img-fluid rounded-circle">
                        <div class="team-social">
                            <a href="#" class="social-link"><i class="fab fa-linkedin"></i></a>
                            <a href="#" class="social-link"><i class="fab fa-instagram"></i></a>
                        </div>
                    </div>
                    <h5 class="fw-bold mb-1">Liridona Krasniqi</h5>
                    <p class="text-primary mb-3">Head of Operations</p>
                    <p class="text-muted small">Wilderness first responder certified</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="team-card text-center">
                    <div class="team-image mb-4">
                        <img src="~/img/team-3.jpg" alt="Blerim Shala" class="img-fluid rounded-circle">
                        <div class="team-social">
                            <a href="#" class="social-link"><i class="fab fa-linkedin"></i></a>
                            <a href="#" class="social-link"><i class="fab fa-instagram"></i></a>
                        </div>
                    </div>
                    <h5 class="fw-bold mb-1">Blerim Shala</h5>
                    <p class="text-primary mb-3">Gear Specialist</p>
                    <p class="text-muted small">Former professional hiking guide</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="team-card text-center">
                    <div class="team-image mb-4">
                        <img src="~/img/team-4.jpg" alt="Valmira Gashi" class="img-fluid rounded-circle">
                        <div class="team-social">
                            <a href="#" class="social-link"><i class="fab fa-linkedin"></i></a>
                            <a href="#" class="social-link"><i class="fab fa-instagram"></i></a>
                        </div>
                    </div>
                    <h5 class="fw-bold mb-1">Valmira Gashi</h5>
                    <p class="text-primary mb-3">Customer Experience</p>
                    <p class="text-muted small">10+ years in outdoor retail</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Community Impact -->
<section class="impact-section py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-5 mb-lg-0">
                <span class="badge bg-opacity-10 text-primary px-3 py-2 mb-3 fw-semibold">
                    <i class="fas fa-heart me-2"></i>Community Impact
                </span>
                <h2 class="display-5 fw-bold text-dark mb-4">Beyond Business</h2>
                <p class="text-muted mb-4">
                    At HikingStore, we're committed to giving back to the community and environment that inspires us daily.
                </p>

                <div class="impact-stats row g-4">
                    <div class="col-6">
                        <div class="stat-item">
                            <div class="stat-number text-primary fw-bold display-6">50+</div>
                            <div class="stat-label">Trail Cleanups</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="stat-item">
                            <div class="stat-number text-primary fw-bold display-6">1,200+</div>
                            <div class="stat-label">Hours Volunteered</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="stat-item">
                            <div class="stat-number text-primary fw-bold display-6">15</div>
                            <div class="stat-label">Community Events</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="stat-item">
                            <div class="stat-number text-primary fw-bold display-6">100%</div>
                            <div class="stat-label">Eco-Packaging</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="impact-image">
                    <img src="~/img/community-impact.jpg" alt="Community Impact" class="img-fluid rounded-4 shadow-lg">
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    /* About Hero Section */
    .about-hero-section {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    }

    .about-hero-image {
        position: relative;
        overflow: hidden;
    }

        .about-hero-image img {
            transition: transform 0.3s ease;
        }

        .about-hero-image:hover img {
            transform: scale(1.02);
        }

    .floating-stats {
        position: absolute;
        top: 20px;
        right: 20px;
    }

    .stats-card {
        background: rgba(255, 255, 255, 0.95);
        padding: 1.5rem;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        backdrop-filter: blur(10px);
    }

    .stats-number {
        font-size: 2rem;
        font-weight: 700;
        line-height: 1;
    }

    .stats-label {
        font-size: 0.9rem;
        color: #6c757d;
    }

    /* Mission & Vision Cards */
    .mission-card, .vision-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        border: 1px solid rgba(0,0,0,0.05);
        transition: transform 0.3s ease;
    }

        .mission-card:hover, .vision-card:hover {
            transform: translateY(-5px);
        }

    .mission-icon, .vision-icon {
        width: 80px;
        height: 80px;
        background: rgba(59, 93, 80, 0.1);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Value Cards */
    .value-card {
        background: white;
        border-radius: 12px;
        border: 1px solid rgba(0,0,0,0.05);
        transition: all 0.3s ease;
    }

        .value-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 10px 30px rgba(59, 93, 80, 0.15);
            border-color: rgba(59, 93, 80, 0.2);
        }

    .icon-wrapper {
        width: 70px;
        height: 70px;
        background: rgba(59, 93, 80, 0.1);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
    }

    /* Team Cards */
    .team-card {
        padding: 1.5rem;
        background: white;
        border-radius: 12px;
        border: 1px solid rgba(0,0,0,0.05);
        transition: all 0.3s ease;
    }

        .team-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        }

    .team-image {
        position: relative;
    }

        .team-image img {
            width: 150px;
            height: 150px;
            object-fit: cover;
        }

    .team-social {
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 0.5rem;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .team-card:hover .team-social {
        opacity: 1;
    }

    .social-link {
        width: 35px;
        height: 35px;
        background: #3b5d50;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: all 0.3s ease;
    }

        .social-link:hover {
            background: #2d473d;
            transform: translateY(-2px);
        }

    /* Impact Stats */
    .stat-item {
        text-align: center;
        padding: 1.5rem;
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }

    .impact-image img {
        transition: transform 0.3s ease;
    }

    .impact-image:hover img {
        transform: scale(1.02);
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .display-4 {
            font-size: 2.5rem;
        }

        .display-5 {
            font-size: 2rem;
        }

        .team-image img {
            width: 120px;
            height: 120px;
        }

        .stats-card {
            padding: 1rem;
        }
    }

    @@media (max-width: 576px) {
        .display-4 {
            font-size: 2rem;
        }

        .display-5 {
            font-size: 1.75rem;
        }

        .mission-card, .vision-card {
            padding: 1.5rem;
        }

        .stat-item {
            padding: 1rem;
        }
    }
</style>