@model List<Product>

<!-- Products Section -->
<section class="products-section py-5">
    <div class="container">
        <!-- Header -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h1 class="h3 fw-bold text-dark mb-1">All Products</h1>
                        <p class="text-muted mb-0">@Model.Count products available</p>
                    </div>
                    <div class="text-muted small">
                        Page @ViewBag.CurrentPage of @ViewBag.PageCount
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3">
            @foreach (var item in Model)
            {
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="card product-card h-100">

                        <!-- IMAGE BOX -->
                        <div class="product-image-box">
                            <span class="badge stock-badge @(item.IsInStock ? "bg-success" : "bg-danger")">
                                @(item.IsInStock ? "In Stock" : "Out of Stock")
                            </span>

                            <img src="~/Product/@item.ProImage"
                                 alt="@item.ProName"
                                 class="product-img" />
                        </div>

                        <!-- CARD BODY -->
                        <div class="card-body p-2 d-flex flex-column">
                            <h6 class="product-title">@item.ProName</h6>
                            <span class="text-muted small">@item.Category?.CatName</span>

                            <div class="mt-auto d-flex justify-content-between align-items-center">
                                <span class="fw-semibold text-primary">
                                    €@item.Price.ToString("N2")
                                </span>
                                <a href="/Home/ProductDetailes/@item.ProId"
                                   class="btn btn-sm btn-outline-primary">
                                    View
                                </a>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>




        <!-- Pagination -->
        @if (ViewBag.PageCount > 1)
        {
            <div class="row mt-4">
                <div class="col-12">
                    <nav aria-label="Product pagination">
                        <ul class="pagination justify-content-center mb-0">
                            @if (ViewBag.CurrentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="?page=@(ViewBag.CurrentPage - 1)" aria-label="Previous">
                                        <i class="fas fa-chevron-left small"></i>
                                    </a>
                                </li>
                            }

                            @for (int i = 1; i <= ViewBag.PageCount; i++)
                            {
                                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="?page=@i">@i</a>
                                </li>
                            }

                            @if (ViewBag.CurrentPage < ViewBag.PageCount)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="?page=@(ViewBag.CurrentPage + 1)" aria-label="Next">
                                        <i class="fas fa-chevron-right small"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            </div>
        }
    </div>
</section>

<style>
    /* ===============================
       PRODUCT CARD (GJIRAF50 STYLE)
    ================================ */
    .product-card {
        border-radius: 8px;
        box-shadow: 0 2px 6px rgba(0,0,0,.08);
        transition: transform .2s ease;
        height: 100%;
    }

        .product-card:hover {
            transform: translateY(-2px);
        }

    /* IMAGE BOX */
    .product-image-box {
        height: 160px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }
    .card-body {
        padding: 0.75rem !important;
    }
    /* IMAGE */
    .product-img {
        max-height: 120px;
        width: auto;
        object-fit: contain;
    }

    /* STOCK BADGE */
    .stock-badge {
        position: absolute;
        top: 6px;
        left: 6px;
        font-size: 0.65rem;
        padding: 2px 6px;
    }

    /* TITLE */
    .product-title {
        font-size: 0.95rem;
        line-height: 1.3;
        height: 2.8em; /* was ~2.4em */
        margin-bottom: 6px;
    }

    .card-body .mt-auto {
        margin-top: 10px;
    }



    /* ===============================
       PRICE BADGE
    ================================ */
    .product-price .badge {
        font-size: 0.7rem;
        padding: 0.3rem 0.5rem;
        border-radius: 6px;
        font-weight: 500;
    }

    /* ===============================
       ACTION BUTTON
    ================================ */
    .product-actions-bottom .btn {
        border-radius: 8px;
        font-size: 0.8rem;
        padding: 0.4rem 0.75rem;
        transition: all 0.3s ease;
    }

        .product-actions-bottom .btn:hover {
            background: var(--primary-light);
            color: white;
            transform: translateY(-1px);
        }

    /* ===============================
       PAGINATION
    ================================ */
    .pagination .page-link {
        border: none;
        color: var(--gray-light);
        padding: 0.5rem 0.75rem;
        margin: 0 0.1rem;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

        .pagination .page-link:hover {
            background: rgba(59, 93, 80, 0.1);
            color: var(--primary-light);
        }

    .pagination .page-item.active .page-link {
        background: var(--primary-light);
        color: white;
    }

    /* ===============================
       RESPONSIVE
    ================================ */
    @@media (max-width: 400px) {
        .col-sm-6 {
            flex: 0 0 100%;
            max-width: 100%;
        }
    }

    /* ===============================
       ACCESSIBILITY
    ================================ */
    .product-card:focus-within {
        outline: 2px solid var(--primary-light);
        outline-offset: 2px;
    }

    .btn:focus,
    .page-link:focus {
        box-shadow: 0 0 0 3px rgba(59, 93, 80, 0.3);
    }

</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize tooltips
        const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        const tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });

        // Wishlist functionality
        const wishlistButtons = document.querySelectorAll('.wishlist-btn');
        wishlistButtons.forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                const icon = this.querySelector('i');

                if (icon.classList.contains('far')) {
                    icon.classList.remove('far');
                    icon.classList.add('fas', 'text-danger');
                    this.setAttribute('data-bs-title', 'Remove from wishlist');
                } else {
                    icon.classList.remove('fas', 'text-danger');
                    icon.classList.add('far');
                    this.setAttribute('data-bs-title', 'Add to wishlist');
                }

                // Update tooltip
                const tooltip = bootstrap.Tooltip.getInstance(this);
                if (tooltip) {
                    tooltip.hide();
                    tooltip.setContent({ '.tooltip-inner': this.getAttribute('data-bs-title') });
                }
            });
        });

        // Smooth scroll to top when changing pages
        const pageLinks = document.querySelectorAll('.page-link');
        pageLinks.forEach(link => {
            link.addEventListener('click', function() {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        });
    });
        wishlistButtons.forEach(button => {
        button.addEventListener('click', function (e) {
            e.preventDefault();

            const icon = this.querySelector('i');
            const isActive = icon.classList.contains('fas');

            icon.classList.toggle('fas', !isActive);
            icon.classList.toggle('far', isActive);
            icon.classList.toggle('text-danger', !isActive);

            const title = isActive
                ? 'Add to wishlist'
                : 'Remove from wishlist';

            // Proper tooltip refresh
            const tooltip = bootstrap.Tooltip.getInstance(this);
            if (tooltip) tooltip.dispose();

            this.setAttribute('data-bs-title', title);
            new bootstrap.Tooltip(this);
        });
    });

</script>
