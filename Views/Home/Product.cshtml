@model List<Product>

<!-- Products Section -->
<section class="products-section py-5">
    <div class="container">
        <!-- Header -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h1 class="h3 fw-bold text-dark mb-1">All Products</h1>
                        <p class="text-muted mb-0">@Model.Count products available</p>
                    </div>
                    <div class="text-muted small">
                        Page @ViewBag.CurrentPage of @ViewBag.PageCount
                    </div>
                </div>
            </div>
        </div>

        <!-- Products Grid -->
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6">
                    <div class="card product-card h-100 border-0 shadow-sm">
                        <!-- Product Image -->
                        <div class="product-image-container position-relative">
                            <a href="/Home/ProductDetailes/@item.ProId" class="text-decoration-none">
                                <img class="card-img-top product-image" src="~/Product/@item.ProImage"
                                     alt="@item.ProName" loading="lazy">
                                <div class="product-overlay"></div>
                            </a>

                            <!-- Quick Actions -->
                            <div class="product-actions position-absolute top-0 end-0 p-2">
                                <button class="btn btn-light btn-sm rounded-circle shadow-sm wishlist-btn"
                                        data-bs-toggle="tooltip" data-bs-placement="left"
                                        data-bs-title="Add to wishlist">
                                    <i class="far fa-heart"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Product Body -->
                        <div class="card-body d-flex flex-column p-3">
                            <!-- Product Title -->
                            <h6 class="card-title product-title mb-2">
                                <a href="/Home/ProductDetailes/@item.ProId"
                                   class="text-dark text-decoration-none text-truncate d-block"
                                   title="@item.ProName">
                                    @item.ProName
                                </a>
                            </h6>
                            <!-- Stock Status Badge -->
                            <div class="position-absolute top-0 start-0 m-2">
                                @if (item.IsInStock)
                                {
                                    <span class="badge bg-success">In Stock</span>
                                    @if (item.StockQuantity <= 5)
                                    {
                                        <span class="badge bg-warning ms-1">Low Stock</span>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-danger">Out of Stock</span>
                                }
                            </div>
                            <!-- Price -->
                            <div class="product-price mt-auto">
                                <div class="d-flex align-items-center justify-content-between">
                                    <span class="h6 text-primary fw-bold mb-0">€@item.Price.ToString("N2")</span>
                                    <span class="badge bg-opacity-10 text-primary small">
                                        @item.Category?.CatName
                                    </span>
                                </div>
                            </div>

                            <!-- Action Button -->
                            <div class="product-actions-bottom mt-3">
                                <a href="/Home/ProductDetailes/@item.ProId"
                                   class="btn btn-outline-primary btn-sm w-100">
                                    <i class="fas fa-eye me-1 small"></i>View Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (ViewBag.PageCount > 1)
        {
            <div class="row mt-5">
                <div class="col-12">
                    <nav aria-label="Product pagination">
                        <ul class="pagination justify-content-center mb-0">
                            @if (ViewBag.CurrentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="?page=@(ViewBag.CurrentPage - 1)" aria-label="Previous">
                                        <i class="fas fa-chevron-left small"></i>
                                    </a>
                                </li>
                            }

                            @for (int i = 1; i <= ViewBag.PageCount; i++)
                            {
                                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="?page=@i">@i</a>
                                </li>
                            }

                            @if (ViewBag.CurrentPage < ViewBag.PageCount)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="?page=@(ViewBag.CurrentPage + 1)" aria-label="Next">
                                        <i class="fas fa-chevron-right small"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            </div>
        }
    </div>
</section>

<style>
    /* Product Cards */
    .product-card {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border-radius: 12px;
        overflow: hidden;
        background: var(--white);
    }

        .product-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        }

    /* Product Image */
    .product-image-container {
        overflow: hidden;
        background: #f8f9fa;
        position: relative;
    }

    .product-image {
        height: 180px;
        object-fit: cover;
        transition: transform 0.3s ease;
        width: 100%;
    }

    .product-card:hover .product-image {
        transform: scale(1.05);
    }

    .product-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,0.05) 100%);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .product-card:hover .product-overlay {
        opacity: 1;
    }

    /* Product Actions */
    .product-actions .btn {
        opacity: 0;
        transform: translateX(10px);
        transition: all 0.3s ease;
    }

    .product-card:hover .product-actions .btn {
        opacity: 1;
        transform: translateX(0);
    }

    .wishlist-btn:hover {
        background: #dc3545 !important;
        color: white !important;
    }

    /* Product Title */
    .product-title {
        font-weight: 600;
        line-height: 1.3;
        transition: color 0.3s ease;
        font-size: 0.9rem;
    }

        .product-title a:hover {
            color: var(--primary-light) !important;
        }

    /* Price */
    .product-price .badge {
        font-size: 0.7rem;
        padding: 0.3rem 0.5rem;
        border-radius: 6px;
        font-weight: 500;
    }

    /* Action Button */
    .product-actions-bottom .btn {
        border-radius: 8px;
        font-size: 0.8rem;
        padding: 0.4rem 0.75rem;
        transition: all 0.3s ease;
    }

        .product-actions-bottom .btn:hover {
            background: var(--primary-light);
            color: white;
            transform: translateY(-1px);
        }

    /* Pagination */
    .pagination .page-link {
        border: none;
        color: var(--gray-light);
        padding: 0.5rem 0.75rem;
        margin: 0 0.1rem;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

        .pagination .page-link:hover {
            background: rgba(59, 93, 80, 0.1);
            color: var(--primary-light);
        }

    .pagination .page-item.active .page-link {
        background: var(--primary-light);
        color: white;
        border: none;
    }

    /* Responsive Design */
    @@media (max-width: 1200px) {
        .col-xl-2 {
            flex: 0 0 25%;
            max-width: 25%;
        }
    }

    @@media (max-width: 992px) {
        .col-lg-3 {
            flex: 0 0 33.333%;
            max-width: 33.333%;
        }

        .product-image {
            height: 160px;
        }
    }

    @@media (max-width: 768px) {
        .col-md-4 {
            flex: 0 0 50%;
            max-width: 50%;
        }

        .product-image {
            height: 140px;
        }

        .products-section {
            padding: 2rem 0;
        }
    }

    @@media (max-width: 576px) {
        .col-sm-6 {
            flex: 0 0 50%;
            max-width: 50%;
        }

        .product-image {
            height: 120px;
        }

        .card-body {
            padding: 1rem !important;
        }

        .product-title {
            font-size: 0.85rem;
        }

        .h3 {
            font-size: 1.5rem;
        }
    }

    @@media (max-width: 400px) {
        .col-sm-6 {
            flex: 0 0 100%;
            max-width: 100%;
        }
    }

    /* Loading States */
    .product-image {
        background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
        background-size: 200% 100%;
    }

    /* Focus States for Accessibility */
    .product-card:focus-within {
        outline: 2px solid var(--primary-light);
        outline-offset: 2px;
    }

    .btn:focus,
    .page-link:focus {
        box-shadow: 0 0 0 3px rgba(59, 93, 80, 0.3);
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize tooltips
        const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        const tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });

        // Wishlist functionality
        const wishlistButtons = document.querySelectorAll('.wishlist-btn');
        wishlistButtons.forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                const icon = this.querySelector('i');

                if (icon.classList.contains('far')) {
                    icon.classList.remove('far');
                    icon.classList.add('fas', 'text-danger');
                    this.setAttribute('data-bs-title', 'Remove from wishlist');
                } else {
                    icon.classList.remove('fas', 'text-danger');
                    icon.classList.add('far');
                    this.setAttribute('data-bs-title', 'Add to wishlist');
                }

                // Update tooltip
                const tooltip = bootstrap.Tooltip.getInstance(this);
                if (tooltip) {
                    tooltip.hide();
                    tooltip.setContent({ '.tooltip-inner': this.getAttribute('data-bs-title') });
                }
            });
        });

        // Smooth scroll to top when changing pages
        const pageLinks = document.querySelectorAll('.page-link');
        pageLinks.forEach(link => {
            link.addEventListener('click', function() {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        });
    });
</script>
