@model CatalogViewModel
@inject IOptions<StoreSettings> StoreOptions
@{
    var store = StoreOptions.Value;
    var f = Model.Filter;
    ViewData["Title"] = Model.Title + (f.Page > 1 ? $" – page {f.Page}" : "");
    ViewData["Description"] = Model.Description ?? $"Shop {Model.Title.ToLowerInvariant()} at {store.Name}. {Model.TotalCount} products, free standard shipping over {store.FormatPrice(store.FreeShippingThreshold)}.";
    if (!string.IsNullOrEmpty(f.Q) || f.Brand.Count > 0 || !string.IsNullOrEmpty(f.Size) || !string.IsNullOrEmpty(f.Color) || f.MinPrice.HasValue || f.MaxPrice.HasValue || f.Rating.HasValue)
    {
        ViewData["NoIndex"] = true;
    }

    string ShopUrl(Dictionary<string, string> values) =>
        Url.Action("Shop", new RouteValueDictionary(values.ToDictionary(k => k.Key, v => (object?)v.Value)))!;
    string Without(params string[] keys)
    {
        var values = f.ToRouteValues(page: 1);
        foreach (var key in keys) values.Remove(key);
        return ShopUrl(values);
    }
    string WithoutBrand(string brand)
    {
        var values = f.ToRouteValues(page: 1);
        foreach (var key in values.Keys.Where(k => k.StartsWith("brand[")).ToList()) values.Remove(key);
        var remaining = f.Brand.Where(b => !string.Equals(b, brand, StringComparison.OrdinalIgnoreCase)).ToList();
        for (var i = 0; i < remaining.Count; i++) values[$"brand[{i}]"] = remaining[i];
        return ShopUrl(values);
    }
    var activeChips = new List<(string Label, string Url)>();
    if (!string.IsNullOrEmpty(f.Q)) activeChips.Add(($"“{f.Q}”", Without("q")));
    if (Model.CurrentCategory != null) activeChips.Add((Model.CurrentCategory.CatName ?? "Category", Without("category")));
    if (f.MinPrice.HasValue || f.MaxPrice.HasValue)
        activeChips.Add(($"{(f.MinPrice.HasValue ? store.FormatPrice(f.MinPrice.Value) : store.CurrencySymbol + "0")} – {(f.MaxPrice.HasValue ? store.FormatPrice(f.MaxPrice.Value) : "any")}", Without("minPrice", "maxPrice")));
    foreach (var brand in f.Brand) activeChips.Add((brand, WithoutBrand(brand)));
    if (!string.IsNullOrEmpty(f.Size)) activeChips.Add(($"Size {f.Size}", Without("size")));
    if (!string.IsNullOrEmpty(f.Color)) activeChips.Add((f.Color!, Without("color")));
    if (f.InStock) activeChips.Add(("In stock", Without("inStock")));
    if (f.OnSale) activeChips.Add(("On sale", Without("onSale")));
    if (f.Rating.HasValue) activeChips.Add(($"{f.Rating}★ & up", Without("rating")));
    var first = (f.Page - 1) * CatalogFilter.DefaultPageSize + 1;
    var last = Math.Min(f.Page * CatalogFilter.DefaultPageSize, Model.TotalCount);
}

<div class="container-hs">
    <nav class="breadcrumb-bar" aria-label="Breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Home</a></li>
            @if (Model.CurrentCategory != null)
            {
                <li class="breadcrumb-item"><a asp-action="Shop">Shop</a></li>
                @if (Model.CurrentCategory.Parent != null)
                {
                    <li class="breadcrumb-item"><a asp-action="Shop" asp-route-category="@Model.CurrentCategory.Parent.CatId">@Model.CurrentCategory.Parent.CatName</a></li>
                }
                <li class="breadcrumb-item active" aria-current="page">@Model.CurrentCategory.CatName</li>
            }
            else
            {
                <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
            }
        </ol>
    </nav>

    <div class="shop-title">
        <h1>@Model.Title</h1>
        <span class="count">@Model.TotalCount @(Model.TotalCount == 1 ? "product" : "products")</span>
    </div>
    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <p class="text-muted mb-4" style="max-width:720px">@Model.Description</p>
    }

    <div class="shop-layout mt-3">
        <aside class="filters-panel" aria-label="Filters">
            <div class="filters">
                <partial name="_ShopFilters" model="Model" view-data='new ViewDataDictionary(ViewData) { ["Prefix"] = "d" }' />
            </div>
        </aside>

        <section aria-label="Products">
            <div class="shop-toolbar">
                <button class="btn btn-outline-secondary filter-btn-mobile" type="button" data-bs-toggle="offcanvas" data-bs-target="#filterDrawer" aria-controls="filterDrawer">
                    <i class="fa-solid fa-sliders me-2" aria-hidden="true"></i>Filters@(activeChips.Count > 0 ? $" ({activeChips.Count})" : "")
                </button>
                <span class="text-muted small d-none d-md-inline">
                    @if (Model.TotalCount > 0)
                    {
                        <text>Showing @first–@last of @Model.TotalCount</text>
                    }
                </span>
                <form method="get" asp-action="Shop" class="d-flex align-items-center gap-2 ms-auto">
                    @foreach (var kv in f.ToRouteValues(page: 1).Where(k => k.Key != "sort"))
                    {
                        <input type="hidden" name="@(kv.Key.StartsWith("brand[") ? "brand" : kv.Key)" value="@kv.Value" />
                    }
                    <label for="sort" class="small text-muted text-nowrap">Sort by</label>
                    <select id="sort" name="sort" class="form-select form-select-sm" data-auto-submit>
                        @foreach (var option in CatalogViewModel.SortOptions)
                        {
                            <option value="@option.Value" selected="@(f.Sort == option.Value)">@option.Label</option>
                        }
                    </select>
                    <noscript><button class="btn btn-sm btn-primary" type="submit">Sort</button></noscript>
                </form>
            </div>

            @if (activeChips.Count > 0)
            {
                <div class="active-filters" aria-label="Active filters">
                    @foreach (var chip in activeChips)
                    {
                        <a class="chip chip-remove" href="@chip.Url" aria-label="Remove filter @chip.Label">@chip.Label <i class="fa-solid fa-xmark" aria-hidden="true"></i></a>
                    }
                    <a class="small ms-1" asp-action="Shop">Clear all</a>
                </div>
            }

            @if (Model.Products.Count == 0)
            {
                <div class="empty-state">
                    <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                    <h2>No products match</h2>
                    <p>
                        @if (f.HasActiveFilters)
                        {
                            <text>Try removing a filter or searching for something broader.</text>
                        }
                        else
                        {
                            <text>There are no products in this section yet. Check back soon.</text>
                        }
                    </p>
                    <a class="btn btn-primary" asp-action="Shop">Browse all gear</a>
                </div>
            }
            else
            {
                <div class="product-grid">
                    @foreach (var card in Model.Products)
                    {
                        <partial name="_ProductCard" model="card" />
                    }
                </div>
                <partial name="_Pagination" model='new PaginationModel(f.Page, Model.PageCount, page => ShopUrl(f.ToRouteValues(page: page)))' />
            }
        </section>
    </div>
</div>

<div class="offcanvas offcanvas-start" tabindex="-1" id="filterDrawer" aria-labelledby="filterDrawerLabel">
    <div class="offcanvas-header border-bottom">
        <h2 class="offcanvas-title h5 m-0" id="filterDrawerLabel">Filters</h2>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close filters"></button>
    </div>
    <div class="offcanvas-body">
        <partial name="_ShopFilters" model="Model" view-data='new ViewDataDictionary(ViewData) { ["Prefix"] = "m" }' />
    </div>
</div>
