@model List<Product>
@{
    var productDetailUrl = Url.Action("ProductDetailes", "Home");
    var productListUrl = Url.Action("Product", "Home");
}

<!-- Products Section - same layout as Product.cshtml -->
<section class="products-section py-5" aria-label="Category products">
    <div class="container">
        <!-- Header (matches Product.cshtml) -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h1 class="h3 fw-bold text-dark mb-1">Category Products</h1>
                        <p class="text-muted mb-0">@Model.Count product@(Model.Count == 1 ? "" : "s") available</p>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.Any())
        {
            <div class="row g-3">
                @foreach (var item in Model)
                {
                    <div class="col-lg-3 col-md-4 col-sm-6">
                        <div class="card product-card h-100">

                            <!-- IMAGE BOX (same as Product.cshtml) -->
                            <div class="product-image-box">
                                @if (item.Category != null)
                                {
                                    <span class="badge category-badge bg-primary bg-opacity-90">
                                        @item.Category.CatName
                                    </span>
                                }
                                <button type="button"
                                        class="wishlist-btn btn btn-light btn-sm rounded-circle shadow-sm"
                                        data-product-id="@item.ProId"
                                        data-bs-toggle="tooltip"
                                        data-bs-placement="left"
                                        data-bs-title="Add to wishlist"
                                        aria-label="Add to wishlist">
                                    <i class="far fa-heart" aria-hidden="true"></i>
                                </button>

                                <a href="@productDetailUrl/@item.ProId" class="product-image-link d-flex align-items-center justify-content-center h-100">
                                    <img src="~/Product/@item.ProImage"
                                         alt="@item.ProName"
                                         class="product-img"
                                         loading="lazy" />
                                </a>
                            </div>

                            <!-- CARD BODY (same as Product.cshtml) -->
                            <div class="card-body p-2 d-flex flex-column">
                                <h6 class="product-title">@item.ProName</h6>
                                <span class="text-muted small">@item.Category?.CatName</span>

                                <div class="mt-auto d-flex justify-content-between align-items-center">
                                    <span class="fw-semibold text-primary">
                                        €@item.Price.ToString("N2")
                                    </span>
                                    <a href="@productDetailUrl/@item.ProId"
                                       class="btn btn-sm btn-outline-primary">
                                        View
                                    </a>
                                </div>
                            </div>

                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-box-open fa-3x text-muted mb-3" aria-hidden="true"></i>
                <h2 class="h5 text-muted mb-2">No products in this category</h2>
                <p class="text-muted small mb-4">We couldn't find any products here. Browse all products to find what you need.</p>
                <a href="@productListUrl" class="btn btn-primary">
                    <i class="fas fa-shopping-bag me-2" aria-hidden="true"></i>Browse all products
                </a>
            </div>
        }
    </div>
</section>

@section Styles {
<style>
    /* ===============================
       PRODUCT CARD (same as Product.cshtml)
    ================================ */
    .products-section .product-card {
        border-radius: 8px;
        box-shadow: 0 2px 6px rgba(0,0,0,.08);
        transition: transform .2s ease;
        height: 100%;
    }
    .products-section .product-card:hover {
        transform: translateY(-2px);
    }

    /* IMAGE BOX */
    .products-section .product-image-box {
        height: 160px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        background: #f8f9fa;
    }
    .products-section .product-image-link {
        text-decoration: none;
        position: absolute;
        inset: 0;
        z-index: 0;
    }
    .products-section .product-img {
        max-height: 120px;
        width: auto;
        max-width: 100%;
        object-fit: contain;
    }

    /* CATEGORY BADGE (same position as stock-badge on Product) */
    .products-section .category-badge {
        position: absolute;
        top: 6px;
        left: 6px;
        font-size: 0.65rem;
        padding: 2px 6px;
        z-index: 1;
    }

    /* WISHLIST BUTTON */
    .products-section .wishlist-btn {
        position: absolute;
        top: 6px;
        right: 6px;
        width: 28px;
        height: 28px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.875rem;
        z-index: 1;
    }
    .products-section .wishlist-btn:hover {
        background: #dc3545 !important;
        color: #fff !important;
        border-color: #dc3545;
    }
    .products-section .wishlist-btn i.fas {
        color: #dc3545;
    }

    /* CARD BODY */
    .products-section .product-card .card-body {
        padding: 0.75rem !important;
    }
    .products-section .product-title {
        font-size: 0.95rem;
        line-height: 1.3;
        height: 2.8em;
        margin-bottom: 6px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .products-section .product-card .card-body .mt-auto {
        margin-top: 10px;
    }

    /* RESPONSIVE */
    .products-section @@media (max-width: 400px) {
        .col-sm-6 {
            flex: 0 0 100%;
            max-width: 100%;
        }
    }

    /* ACCESSIBILITY */
    .products-section .product-card:focus-within {
        outline: 2px solid var(--primary-light, #3b5d50);
        outline-offset: 2px;
    }
    .products-section .btn:focus {
        box-shadow: 0 0 0 3px rgba(59, 93, 80, 0.3);
    }
</style>
}

@section Scripts {
<script>
(function() {
    'use strict';

    document.addEventListener('DOMContentLoaded', function() {
        var section = document.querySelector('.products-section');
        if (!section) return;

        // Tooltips
        var tooltipEls = section.querySelectorAll('[data-bs-toggle="tooltip"]');
        tooltipEls.forEach(function(el) {
            new bootstrap.Tooltip(el);
        });

        loadWishlistStates(section);
        section.addEventListener('click', handleWishlistClick);

        function getToken() {
            var input = document.querySelector('input[name="__RequestVerificationToken"]');
            return input ? input.value : '';
        }

        function loadWishlistStates(container) {
            var buttons = container.querySelectorAll('.wishlist-btn');
            buttons.forEach(function(btn) {
                var id = btn.getAttribute('data-product-id');
                if (!id) return;
                fetch('/Wishlist/IsInWishlist?productId=' + encodeURIComponent(id))
                    .then(function(r) { return r.json(); })
                    .then(function(data) {
                        if (data.inWishlist) {
                            var icon = btn.querySelector('i');
                            if (icon) {
                                icon.classList.remove('far');
                                icon.classList.add('fas', 'text-danger');
                            }
                            btn.setAttribute('data-bs-title', 'Remove from wishlist');
                        }
                    })
                    .catch(function() {});
            });
        }

        function handleWishlistClick(e) {
            var btn = e.target.closest('.wishlist-btn');
            if (!btn) return;
            e.preventDefault();
            var productId = btn.getAttribute('data-product-id');
            if (!productId) return;

            var icon = btn.querySelector('i');
            var isInWishlist = icon && icon.classList.contains('fas');
            var url = isInWishlist ? '/Wishlist/RemoveFromWishlist' : '/Wishlist/AddToWishlist';
            var body = 'productId=' + encodeURIComponent(productId) + '&__RequestVerificationToken=' + encodeURIComponent(getToken());

            fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: body
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    if (icon) {
                        if (isInWishlist) {
                            icon.classList.remove('fas', 'text-danger');
                            icon.classList.add('far');
                            btn.setAttribute('data-bs-title', 'Add to wishlist');
                        } else {
                            icon.classList.remove('far');
                            icon.classList.add('fas', 'text-danger');
                            btn.setAttribute('data-bs-title', 'Remove from wishlist');
                        }
                    }
                    showNotification(data.message || (isInWishlist ? 'Removed from wishlist' : 'Added to wishlist'), isInWishlist ? 'info' : 'success');
                    updateWishlistCount();
                } else {
                    showNotification(data.message || 'Something went wrong', 'danger');
                }
            })
            .catch(function() {
                showNotification('Request failed. Please try again.', 'danger');
            });

            var tooltip = bootstrap.Tooltip.getInstance(btn);
            if (tooltip) tooltip.hide();
        }

        function updateWishlistCount() {
            fetch('/Wishlist/GetWishlistCount')
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    var els = document.querySelectorAll('.wishlist-count');
                    els.forEach(function(el) { el.textContent = data.count || 0; });
                })
                .catch(function() {});
        }

        function showNotification(message, type) {
            type = type === 'error' ? 'danger' : (type || 'info');
            var toastEl = document.createElement('div');
            toastEl.className = 'toast align-items-center text-white bg-' + type + ' border-0 position-fixed bottom-0 end-0 m-3';
            toastEl.style.zIndex = '1060';
            toastEl.setAttribute('role', 'alert');
            var msgEl = document.createElement('div');
            msgEl.className = 'toast-body';
            msgEl.textContent = message;
            var closeBtn = document.createElement('button');
            closeBtn.type = 'button';
            closeBtn.className = 'btn-close btn-close-white me-2 m-auto';
            closeBtn.setAttribute('data-bs-dismiss', 'toast');
            closeBtn.setAttribute('aria-label', 'Close');
            var flex = document.createElement('div');
            flex.className = 'd-flex';
            flex.appendChild(msgEl);
            flex.appendChild(closeBtn);
            toastEl.appendChild(flex);
            document.body.appendChild(toastEl);

            var bsToast = new bootstrap.Toast(toastEl);
            bsToast.show();
            toastEl.addEventListener('hidden.bs.toast', function() { toastEl.remove(); });
        }
    });
})();
</script>
}
