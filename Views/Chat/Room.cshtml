@model HikingStore.Models.ChatRoom
@{
    ViewData["Title"] = Model.Subject;
    ViewData["NoIndex"] = true;
    var isOpen = Model.Status is ChatRoomStatus.Open or ChatRoomStatus.InProgress;
}

<div class="container-hs">
    <nav class="breadcrumb-bar" aria-label="Breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Account" asp-action="Index">My account</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Support chat</a></li>
            <li class="breadcrumb-item active text-truncate" aria-current="page">@Model.Subject</li>
        </ol>
    </nav>
    <div class="page-head d-flex flex-wrap justify-content-between align-items-start gap-3">
        <div class="min-w-0">
            <h1 class="text-break">@Model.Subject</h1>
            <p class="text-muted m-0">@(Model.Agent != null ? "You're chatting with our support team." : "Waiting for a team member to reply.")</p>
        </div>
        @if (isOpen)
        {
            <form asp-action="CloseRoom" method="post" data-confirm="Close this chat? You can reopen it by sending a new message.">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-outline-secondary btn-sm">Close chat</button>
            </form>
        }
    </div>

    <section class="card-hs chat-panel" aria-label="Conversation">
        <div class="chat-log" id="chatLog" role="log" aria-live="polite">
            @foreach (var message in Model.Messages.OrderBy(m => m.SentAt))
            {
                <div class="chat-msg @(message.IsAgentMessage ? "" : "mine")">
                    <div class="chat-bubble">
                        <div class="chat-meta">@(message.IsAgentMessage ? "Support" : "You") · @message.SentAt.ToString("d MMM, HH:mm") UTC</div>
                        <div class="chat-body">@message.Message</div>
                    </div>
                </div>
            }
            @if (!Model.Messages.Any())
            {
                <p class="small text-muted" id="emptyHint">Write your question below and we'll reply here.</p>
            }
            <p class="small text-muted m-0" id="typingIndicator" hidden>Support is typing…</p>
        </div>
        <div class="chat-compose">
            @if (!isOpen)
            {
                <p class="small text-muted mb-2">This chat is @Model.Status.ToString().ToLowerInvariant(). Sending a message will reopen it.</p>
            }
            <form id="messageForm" class="d-flex gap-2">
                <label for="messageInput" class="visually-hidden">Message</label>
                <input type="text" id="messageInput" class="form-control" placeholder="Type your message…" autocomplete="off" maxlength="2000" />
                <button type="submit" class="btn btn-primary" id="sendButton" aria-label="Send"><i class="fa-solid fa-paper-plane" aria-hidden="true"></i></button>
            </form>
            <p class="small text-danger mt-2 mb-0" id="connectionStatus" hidden></p>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        (function () {
            const chatRoomId = @Model.Id;
            const log = document.getElementById('chatLog');
            const typing = document.getElementById('typingIndicator');
            const input = document.getElementById('messageInput');
            const sendButton = document.getElementById('sendButton');
            const status = document.getElementById('connectionStatus');
            let isTyping = false, typingTimeout, hideTypingTimeout;

            if (!window.signalR) {
                status.textContent = 'Live chat could not load. Please refresh the page.';
                status.hidden = false;
                return;
            }

            const connection = new signalR.HubConnectionBuilder()
                .withUrl('/chatHub')
                .withAutomaticReconnect()
                .build();

            const scrollToBottom = () => { log.scrollTop = log.scrollHeight; };
            function setStatus(text) { status.textContent = text || ''; status.hidden = !text; }

            function appendMessage(m) {
                document.getElementById('emptyHint')?.remove();
                const row = document.createElement('div');
                row.className = 'chat-msg' + (m.isAgentMessage ? '' : ' mine');
                const bubble = document.createElement('div');
                bubble.className = 'chat-bubble';
                const meta = document.createElement('div');
                meta.className = 'chat-meta';
                const sent = new Date(m.sentAt);
                meta.textContent = (m.isAgentMessage ? 'Support' : 'You') + ' · ' + sent.toLocaleString(undefined, { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
                const body = document.createElement('div');
                body.className = 'chat-body';
                body.textContent = m.message;
                bubble.append(meta, body);
                row.appendChild(bubble);
                log.insertBefore(row, typing);
                scrollToBottom();
            }

            connection.on('ReceiveMessage', m => { typing.hidden = true; appendMessage(m); });
            connection.on('UserTyping', data => {
                typing.hidden = !data.isTyping;
                clearTimeout(hideTypingTimeout);
                if (data.isTyping) { scrollToBottom(); hideTypingTimeout = setTimeout(() => typing.hidden = true, 4000); }
            });
            connection.on('ErrorMessage', message => HS.toast(message, 'error'));
            connection.onreconnecting(() => setStatus('Connection lost. Reconnecting…'));
            connection.onreconnected(() => { setStatus(''); connection.invoke('JoinRoom', chatRoomId); });
            connection.onclose(() => setStatus('Disconnected from chat. Refresh the page to reconnect.'));

            async function start() {
                try {
                    await connection.start();
                    await connection.invoke('JoinRoom', chatRoomId);
                    setStatus('');
                } catch {
                    setStatus('Could not connect to chat. Retrying…');
                    setTimeout(start, 5000);
                }
            }

            document.getElementById('messageForm').addEventListener('submit', async e => {
                e.preventDefault();
                const message = input.value.trim();
                if (!message) return;
                sendButton.disabled = true;
                try {
                    await connection.invoke('SendMessage', chatRoomId, message);
                    input.value = '';
                    stopTyping();
                } catch {
                    HS.toast('Your message could not be sent. Please try again.', 'error');
                } finally {
                    sendButton.disabled = false;
                    input.focus();
                }
            });

            input.addEventListener('input', () => {
                if (!isTyping && connection.state === signalR.HubConnectionState.Connected) {
                    isTyping = true;
                    connection.invoke('Typing', chatRoomId, true).catch(() => { });
                }
                clearTimeout(typingTimeout);
                typingTimeout = setTimeout(stopTyping, 1200);
            });
            function stopTyping() {
                if (!isTyping) return;
                isTyping = false;
                connection.invoke('Typing', chatRoomId, false).catch(() => { });
            }

            scrollToBottom();
            start();
        })();
    </script>
}
