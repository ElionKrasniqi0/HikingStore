@model IEnumerable<HikingStore.Models.ChatRoom>
@{
    ViewData["Title"] = "Support chat";
    ViewData["NoIndex"] = true;
    static string StatusLabel(ChatRoomStatus s) => s switch
    {
        ChatRoomStatus.Open => "Waiting for reply",
        ChatRoomStatus.InProgress => "In progress",
        ChatRoomStatus.Resolved => "Resolved",
        _ => "Closed"
    };
}

<div class="container-hs">
    <div class="page-head"><h1>Support chat</h1></div>
    <div class="account-layout">
        <partial name="_AccountNav" />
        <div class="d-flex flex-column gap-4 min-w-0">
            <section class="card-hs">
                <h2 class="h5">Start a conversation</h2>
                <p class="text-muted small">Ask about gear, sizing or an order. Our team replies during opening hours; you'll see replies here.</p>
                <form asp-action="CreateRoom" method="post" class="d-flex flex-column flex-sm-row gap-2" data-once>
                    <label for="subject" class="visually-hidden">Subject</label>
                    <input type="text" class="form-control" id="subject" name="subject" placeholder="What can we help with?" maxlength="150" required />
                    <button type="submit" class="btn btn-primary flex-shrink-0" data-busy-text="Starting…">Start chat</button>
                </form>
            </section>

            <section aria-label="Your conversations">
                @if (Model.Any())
                {
                    <ul class="chat-list">
                        @foreach (var room in Model)
                        {
                            var lastMessage = room.Messages.OrderByDescending(m => m.SentAt).FirstOrDefault();
                            var unread = room.Messages.Count(m => m.IsAgentMessage && !m.IsRead);
                            <li>
                                <a asp-action="Room" asp-route-id="@room.Id">
                                    <strong class="text-truncate">@room.Subject</strong>
                                    <span class="d-flex align-items-center gap-2">
                                        @if (unread > 0)
                                        {
                                            <span class="badge rounded-pill text-bg-danger">@unread new</span>
                                        }
                                        <span class="badge text-bg-light border">@StatusLabel(room.Status)</span>
                                    </span>
                                    <span class="preview">
                                        @if (lastMessage != null)
                                        {
                                            @(lastMessage.IsAgentMessage ? "Support: " : "You: ")@lastMessage.Message
                                        }
                                        else
                                        {
                                            <text>No messages yet</text>
                                        }
                                    </span>
                                    <span class="small text-muted">@room.LastMessageAt.ToString("d MMM yyyy, HH:mm") UTC</span>
                                </a>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="empty-state">
                        <i class="fa-regular fa-comments" aria-hidden="true"></i>
                        <h2>No conversations yet</h2>
                        <p>Start a chat above, or <a asp-controller="Home" asp-action="Contact">send us a message</a>.</p>
                    </div>
                }
            </section>
        </div>
    </div>
</div>
