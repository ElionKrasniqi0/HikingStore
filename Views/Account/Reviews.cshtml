@model List<Review>
@{
    ViewData["Title"] = "My reviews";
    ViewData["NoIndex"] = true;
    ViewData["AccountSection"] = "reviews";
}

<div class="container-hs">
    <div class="page-head"><h1>My reviews</h1></div>
    <div class="account-layout">
        <partial name="_AccountNav" />
        <section aria-label="Your reviews">
            @if (Model.Count == 0)
            {
                <div class="empty-state card-hs">
                    <i class="fa-regular fa-star" aria-hidden="true"></i>
                    <h2>No reviews yet</h2>
                    <p>After you receive an order, you can review the products from the order page.</p>
                    <a class="btn btn-primary" asp-controller="Orders" asp-action="Index">Go to my orders</a>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var review in Model)
                    {
                        <article class="card-hs">
                            <div class="d-flex flex-wrap justify-content-between gap-2">
                                <a class="fw-semibold" asp-controller="Home" asp-action="ProductDetailes" asp-route-id="@review.ProId">@(review.Product?.ProName ?? "Product")</a>
                                @if (review.IsApproved)
                                {
                                    <span class="status-badge status-Shipped">Published</span>
                                }
                                else
                                {
                                    <span class="status-badge status-Processing">Awaiting moderation</span>
                                }
                            </div>
                            <div class="mt-2"><partial name="_Stars" model="(double)review.Rating" /></div>
                            <h2 class="h6 mt-2 mb-1 font-body">@review.Title</h2>
                            <p class="mb-2" style="white-space:pre-line">@review.Comment</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="small text-muted">@review.CreatedAt.ToString("d MMM yyyy")</span>
                                <form method="post" asp-controller="Reviews" asp-action="Delete" asp-route-id="@review.ReviewId" data-confirm="Delete this review?">
                                    <button type="submit" class="link-btn">Delete</button>
                                </form>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    </div>
</div>
