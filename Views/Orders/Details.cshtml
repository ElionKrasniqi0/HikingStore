@using HikingStore.Enum
@model Order

<style>
    /* Custom styling based on the screenshot */
    .order-detail-card {
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        background: white;
    }

    .order-detail-header {
        background: #f8fafc;
        border-bottom: 1px solid #e5e7eb;
        border-radius: 12px 12px 0 0;
        padding: 24px;
    }

    .order-detail-body {
        padding: 24px;
    }

    .order-detail-title {
        color: #3b5d50;
        font-weight: 700;
        font-size: 20px;
        margin: 0;
    }

    .order-detail-subtitle {
        color: #6b7280;
        font-size: 14px;
        margin: 4px 0 0 0;
    }

    .info-card {
        background: #f8fafc;
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 20px;
    }

    .info-card-title {
        color: #374151;
        font-weight: 600;
        font-size: 14px;
        margin-bottom: 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .info-item {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid #e5e7eb;
        align-items: flex-start;
    }

        .info-item:last-child {
            border-bottom: none;
        }

    .info-label {
        color: #6b7280;
        font-size: 14px;
        font-weight: 500;
    }

    .info-value {
        color: #111827;
        font-weight: 500;
        font-size: 14px;
        text-align: right;
        word-break: break-word;
        max-width: 60%;
    }

    .product-row {
        display: flex;
        align-items: center;
        padding: 16px 0;
        border-bottom: 1px solid #e5e7eb;
        transition: background-color 0.2s ease;
    }

        .product-row:hover {
            background-color: #f9fafb;
            border-radius: 8px;
            padding-left: 8px;
            padding-right: 8px;
        }

        .product-row:last-child {
            border-bottom: none;
        }

    .product-image {
        width: 80px;
        height: 80px;
        border-radius: 8px;
        object-fit: cover;
        margin-right: 16px;
        border: 1px solid #e5e7eb;
    }

    .product-name {
        flex: 1;
        color: #374151;
        font-weight: 500;
        font-size: 15px;
        line-height: 1.4;
    }

    .product-qty {
        color: #6b7280;
        font-size: 14px;
        margin-right: 24px;
        background: #f3f4f6;
        padding: 4px 12px;
        border-radius: 20px;
        font-weight: 500;
    }

    .product-price {
        color: #3b5d50;
        font-weight: 600;
        font-size: 16px;
        min-width: 100px;
        text-align: right;
    }

    .total-section {
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-radius: 8px;
        padding: 20px;
        margin-top: 24px;
        border: 1px solid #e5e7eb;
    }

    .total-row {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        align-items: center;
    }

        .total-row.grand-total {
            border-top: 2px solid #3b5d50;
            margin-top: 12px;
            padding-top: 16px;
            font-weight: 700;
            color: #3b5d50;
            font-size: 20px;
        }

    .status-timeline {
        display: flex;
        justify-content: space-between;
        position: relative;
        margin: 24px 0;
    }

        .status-timeline::before {
            content: '';
            position: absolute;
            top: 12px;
            left: 0;
            right: 0;
            height: 2px;
            background: #e5e7eb;
            z-index: 1;
        }

    .status-step {
        position: relative;
        z-index: 2;
        text-align: center;
        flex: 1;
    }

    .status-indicator {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: white;
        border: 2px solid #e5e7eb;
        margin: 0 auto 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
    }

    .status-step.active .status-indicator {
        background: #3b5d50;
        border-color: #3b5d50;
        color: white;
    }

    .status-step.completed .status-indicator {
        background: #10b981;
        border-color: #10b981;
        color: white;
    }

    .status-label {
        color: #6b7280;
        font-size: 12px;
        font-weight: 500;
    }

    .status-step.active .status-label,
    .status-step.completed .status-label {
        color: #374151;
        font-weight: 600;
    }

    .status-timeline::before {
        background: linear-gradient(to right, #10b981 0%, #10b981 var(--progress, 0%), #e5e7eb var(--progress, 0%), #e5e7eb 100%);
    }

    .status-step.completed ~ .status-step .status-indicator {
        border-color: #10b981;
    }

    .action-buttons {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-top: 24px;
    }

    .action-buttons .btn {
        width: 100%;
        justify-content: center;
    }

    .btn-primary {
        background: #3b5d50;
        border-color: #3b5d50;
        padding: 10px 24px;
        font-weight: 500;
    }

        .btn-primary:hover {
            background: #2d473d;
            border-color: #2d473d;
        }

    .btn-outline-primary {
        border-color: #3b5d50;
        color: #3b5d50;
        padding: 10px 24px;
        font-weight: 500;
    }

        .btn-outline-primary:hover {
            background: #3b5d50;
            border-color: #3b5d50;
            color: white;
        }

    .order-number {
        background: #3b5d50;
        color: white;
        padding: 4px 12px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 12px;
        display: inline-block;
    }

    /* Hide print-only elements on screen */
    .print-only {
        display: none !important;
    }

    .print-invoice-header {
        display: none !important;
    }

    .print-tracking {
        display: none !important;
    }

       /* PRINT STYLES - Professional & Compact Invoice */
    @@media print {
        /* Page setup - minimal margins for compact layout */
        @@page {
            size: A4 portrait;
            margin: 0.8cm 1cm;
        }

        /* Hide everything first */
        body * {
            visibility: hidden;
        }

        /* Show only printable content */
        .container,
        .container *,
        .order-detail-card,
        .order-detail-card * {
            visibility: visible !important;
        }

        /* Hide navigation, buttons, icons, and unnecessary elements */
        .navbar,
        .sb-topnav,
        .footer,
        .breadcrumb,
        .hero,
        .action-buttons,
        .btn,
        button,
        .dropdown,
        .status-timeline,
        .status-step,
        .status-indicator,
        .animation,
        .pulse,
        .bounce,
        .spinner,
        [class*="fa-"],
        i,
        .no-print,
        .alert,
        .intro-excerpt {
            display: none !important;
            visibility: hidden !important;
        }

        /* Reset body */
        body {
            font-family: "Arial", "Helvetica", sans-serif !important;
            font-size: 9pt !important;
            line-height: 1.2 !important;
            color: #000 !important;
            background: #fff !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        /* Container - full width, no padding */
        .container {
            width: 100% !important;
            max-width: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        /* Professional Invoice Header */
        .print-invoice-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 12pt;
            padding-bottom: 8pt;
            border-bottom: 2pt solid #000;
        }

        .print-company-info {
            flex: 1;
        }

        .print-company-name {
            font-size: 16pt !important;
            font-weight: bold;
            margin-bottom: 4pt;
            color: #000 !important;
        }

        .print-company-details {
            font-size: 8pt !important;
            line-height: 1.3;
            color: #333 !important;
        }

        .print-order-info {
            text-align: right;
            flex: 1;
        }

        .print-invoice-label {
            font-size: 10pt !important;
            font-weight: bold;
            margin-bottom: 4pt;
            color: #000 !important;
        }

        .print-order-number {
            font-size: 14pt !important;
            font-weight: bold;
            margin-bottom: 8pt;
            color: #000 !important;
        }

        .print-order-date {
            font-size: 8pt !important;
            color: #333 !important;
        }

        /* Compact two-column layout */
        .row {
            display: flex !important;
            flex-wrap: wrap !important;
            margin: 0 !important;
        }

        .col-lg-8,
        .col-lg-4 {
            flex: 0 0 auto !important;
            width: 100% !important;
            padding: 0 !important;
        }

        /* Cards - minimal styling */
        .order-detail-card {
            border: 1pt solid #000 !important;
            box-shadow: none !important;
            border-radius: 0 !important;
            margin-bottom: 10pt !important;
            background: #fff !important;
            page-break-inside: avoid;
        }

        .order-detail-header {
            background: #f0f0f0 !important;
            border-bottom: 1pt solid #000 !important;
            padding: 6pt 8pt !important;
        }

        .order-detail-title {
            font-size: 11pt !important;
            font-weight: bold;
            margin: 0 !important;
            color: #000 !important;
        }

        .order-detail-subtitle {
            font-size: 7pt !important;
            margin: 2pt 0 0 0 !important;
            color: #666 !important;
        }

        .order-detail-body {
            padding: 8pt !important;
        }

        /* Hide status timeline in print */
        .status-timeline {
            display: none !important;
        }

        /* Compact info cards */
        .info-card {
            background: transparent !important;
            border: none !important;
            padding: 0 !important;
            margin: 0 0 8pt 0 !important;
        }

        .info-card-title {
            font-size: 9pt !important;
            font-weight: bold;
            margin-bottom: 4pt !important;
            color: #000 !important;
            text-transform: uppercase;
            letter-spacing: 0.5pt;
        }

        .info-item {
            display: flex !important;
            justify-content: space-between !important;
            padding: 2pt 0 !important;
            border-bottom: 0.5pt solid #ddd !important;
            font-size: 8pt !important;
        }

        .info-item:last-child {
            border-bottom: none !important;
        }

        .info-label {
            font-weight: 600;
            color: #333 !important;
            min-width: 35%;
        }

        .info-value {
            text-align: right;
            color: #000 !important;
        }

        /* Compact product table */
        .product-row {
            display: none !important;
        }

        /* Show print header and tracking */
        .print-invoice-header {
            display: flex !important;
        }

        .print-tracking {
            display: block !important;
        }

        /* Order items as table - show in print, hide product rows */
        .order-items-table {
            width: 100% !important;
            border-collapse: collapse !important;
            margin: 8pt 0 !important;
            font-size: 8pt !important;
            display: table !important;
        }

        .product-row {
            display: none !important;
        }

        /* Show print-only elements */
        .print-only {
            display: table !important;
        }
        
        .print-only.print-tracking {
            display: block !important;
        }

        .order-items-table th {
            background: #f0f0f0 !important;
            border: 1pt solid #000 !important;
            padding: 4pt 6pt !important;
            text-align: left;
            font-weight: bold;
            font-size: 8pt !important;
        }

        .order-items-table td {
            border: 1pt solid #000 !important;
            padding: 4pt 6pt !important;
            font-size: 8pt !important;
        }

        .order-items-table .product-name {
            font-weight: 600;
        }

        .order-items-table .text-right {
            text-align: right;
        }

        /* Totals section - compact */
        .total-section {
            margin-top: 10pt;
            padding-top: 6pt;
            border-top: 1pt solid #000;
        }

        .total-row {
            display: flex !important;
            justify-content: space-between !important;
            padding: 2pt 0 !important;
            font-size: 8pt !important;
        }

        .grand-total {
            border-top: 1pt solid #000 !important;
            font-weight: bold !important;
            font-size: 10pt !important;
            margin-top: 4pt !important;
            padding-top: 4pt !important;
        }

        /* Shipping info compact */
        .print-shipping-box {
            border: 1pt solid #000;
            padding: 6pt;
            margin-top: 8pt;
            font-size: 8pt;
        }

        /* Tracking info if available */
        .print-tracking {
            margin-top: 8pt;
            padding: 6pt;
            border: 1pt solid #000;
            background: #f9f9f9;
            font-size: 8pt;
        }

        .print-tracking-label {
            font-weight: bold;
            margin-bottom: 2pt;
        }

        /* Headers - smaller */
        h1, h2, h3, h4, h5, h6 {
            color: #000 !important;
            page-break-after: avoid;
            margin: 0 0 6pt 0 !important;
        }

        h2 {
            font-size: 11pt !important;
        }

        h3 {
            font-size: 10pt !important;
        }

        /* Remove all spacing utilities for print */
        .mt-1, .mt-2, .mt-3, .mt-4, .mt-5 { margin-top: 0 !important; }
        .mb-1, .mb-2, .mb-3, .mb-4, .mb-5 { margin-bottom: 0 !important; }
        .pt-1, .pt-2, .pt-3, .pt-4, .pt-5 { padding-top: 0 !important; }
        .pb-1, .pb-2, .pb-3, .pb-4, .pb-5 { padding-bottom: 0 !important; }
        .py-1, .py-2, .py-3, .py-4, .py-5 { padding-top: 0 !important; padding-bottom: 0 !important; }

        /* Product images - hide in print */
        .product-image {
            display: none !important;
        }

        /* Colors - all black for print */
        .text-primary,
        .text-success,
        .text-danger,
        .text-warning,
        .text-muted {
            color: #000 !important;
        }

        .bg-primary,
        .bg-success,
        .bg-danger,
        .bg-warning {
            background: #f0f0f0 !important;
        }

        /* Links - no underline */
        a {
            color: #000 !important;
            text-decoration: none !important;
        }

        /* Page breaks */
        .page-break {
            page-break-before: always;
        }

        .no-break {
            page-break-inside: avoid;
        }

        /* Print footer */
        .print-footer {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            text-align: center;
            font-size: 7pt;
            color: #666;
            padding: 4pt;
            border-top: 0.5pt solid #ccc;
            background: #fff;
        }

        /* Compact layout - stack columns vertically but compact */
        .row.g-4 {
            gap: 0 !important;
        }

        /* Remove all shadows and effects */
        * {
            box-shadow: none !important;
            text-shadow: none !important;
        }
    }

    /* Additional compact classes for regular use */
    .compact-table {
        font-size: 0.9em;
    }

    .compact-table th,
    .compact-table td {
        padding: 0.3em 0.5em;
    }

    .compact-card {
        padding: 0.8em;
    }

    .compact-card .card-body {
        padding: 0.8em;
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .order-detail-header {
            padding: 16px !important;
        }

        .order-detail-body {
            padding: 16px !important;
        }

        .product-row {
            flex-wrap: wrap;
            gap: 12px;
        }

        .product-image {
            width: 60px;
            height: 60px;
        }

        .product-name {
            flex: 1 1 100%;
            margin-top: 8px;
        }

        .product-qty {
            margin-right: 12px;
        }

        .status-timeline {
            flex-wrap: wrap;
            gap: 16px;
        }

        .status-step {
            flex: 0 0 calc(50% - 8px);
        }

        .info-item {
            flex-direction: column;
            gap: 4px;
        }

        .info-value {
            text-align: left;
            max-width: 100%;
        }

        .action-buttons {
            margin-top: 16px;
        }
    }

    @@media (max-width: 576px) {
        .status-timeline {
            flex-direction: column;
        }

        .status-step {
            flex: 1;
            width: 100%;
            text-align: left;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .status-indicator {
            margin: 0;
        }

        .status-timeline::before {
            display: none;
        }

        .order-number {
            font-size: 11px;
            padding: 3px 10px;
        }
    }
</style>

@{
    var vatRate = 0.18m; // 18% VAT
    var subtotalWithoutVat = Model.TotalAmount / (1 + vatRate);
    var vatAmount = Model.TotalAmount - subtotalWithoutVat;
}
<br />
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a asp-action="Index" class="text-decoration-none text-muted mb-2 d-inline-block">
                <i class="fas fa-arrow-left me-2"></i>Back to Orders
            </a>
            <h2 class="mb-0" style="color: #3b5d50; font-weight: 600;">
                Order: #@Model.OrderId.ToString("D6")
            </h2>
        </div>
        <div class="d-flex gap-2">
            <div class="dropdown">
                <button class="btn btn-secondary" type="button" id="orderActionsDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fas fa-ellipsis-v"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="orderActionsDropdown">
                    <li>
                        <a class="dropdown-item" asp-action="Invoice" asp-route-id="@Model.OrderId" asp-route-download="true">
                            <i class="fas fa-download me-2"></i>Download Invoice
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">

    <!-- Professional Print Header (only visible when printing) -->
    <div class="print-invoice-header" style="display: none;">
        <div class="print-company-info">
            <div class="print-company-name">HikingStore</div>
            <div class="print-company-details">
                Rr Prshtina Re, Kosovo<br>
                Email: support@hikingstore.com<br>
                Phone: +383 (458) 04-555
            </div>
        </div>
        <div class="print-order-info">
            <div class="print-invoice-label">ORDER INVOICE</div>
            <div class="print-order-number">#ORD@Model.OrderId.ToString("D6")</div>
            <div class="print-order-date">Date: @Model.OrderDate.ToString("MMMM dd, yyyy")</div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Left Column: Order Status & Items -->
        <div class="col-lg-8">
            <!-- Status Timeline -->
            <div class="order-detail-card mb-4">
                <div class="order-detail-header">
                    <h2 class="order-detail-title">Order Status</h2>
                </div>
                <div class="order-detail-body">
                    <div class="mb-3">
                        <div class="small text-muted mb-1">Order Date: @Model.OrderDate.ToString("dd.MM.yyyy")</div>
                        @if (Model.ShippedDate.HasValue)
                        {
                            <div class="small text-muted">Delivery Date: @Model.ShippedDate.Value.ToString("dd MMMM") - @Model.ShippedDate.Value.AddDays(1).ToString("dd MMMM")</div>
                        }
                    </div>
                    @{
                        var statuses = new[]
                        {
                                        (OrderStatus.Received, "Received", "fas fa-inbox"),
                                        (OrderStatus.Verified, "Verified", "fas fa-check-circle"),
                                        (OrderStatus.Processing, "Processing", "fas fa-cog"),
                                        (OrderStatus.Shipped, "Shipped", "fas fa-shipping-fast"),
                                        (OrderStatus.Completed, "Completed", "fas fa-check")
                                        };

                        var currentStatusIndex = Array.FindIndex(statuses, s => s.Item1 == Model.Status);
                    }

                    <div class="status-timeline" style="--progress: @((currentStatusIndex + 1) * 20)%">
                        @for (int i = 0; i < statuses.Length; i++)
                        {
                            var (status, displayName, icon) = statuses[i];
                            var isCompleted = i < currentStatusIndex;
                            var isCurrent = i == currentStatusIndex;
                            var dateProperty = status switch
                            {
                                OrderStatus.Received => Model.OrderDate,
                                OrderStatus.Verified => Model.VerifiedDate,
                                OrderStatus.Processing => Model.ProcessingDate,
                                OrderStatus.Shipped => Model.ShippedDate,
                                OrderStatus.Completed => Model.CompletedDate,
                                _ => (DateTime?)null
                            };

                            <div class="status-step @(isCompleted ? "completed" : "") @(isCurrent ? "active" : "")">
                                <div class="status-indicator">
                                    @if (isCompleted)
                                    {
                                        <i class="fas fa-check"></i>
                                    }
                                    else if (isCurrent)
                                    {
                                        <i class="@icon"></i>
                                    }
                                </div>
                                <div class="status-label">@displayName</div>
                                @if (dateProperty.HasValue)
                                {
                                    <div class="text-muted small mt-1">@dateProperty.Value.ToString("MMM dd, yyyy")</div>
                                }
                            </div>
                        }
                    </div>

                    @if (Model.Status == OrderStatus.Shipped && !string.IsNullOrEmpty(Model.TrackingNumber) && Model.TrackingNumber != "N/A")
                    {
                        <div class="print-tracking" style="display: none;">
                            <div class="print-tracking-label">Tracking Information</div>
                            <div><strong>Tracking Number:</strong> @Model.TrackingNumber</div>
                            @if (!string.IsNullOrEmpty(Model.Carrier))
                            {
                                <div><strong>Carrier:</strong> @Model.Carrier</div>
                            }
                        </div>
                        <div class="alert alert-info mt-3 no-print">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-truck me-2"></i>
                                <div>
                                    <strong>Tracking Number:</strong> @Model.TrackingNumber
                                    @if (!string.IsNullOrEmpty(Model.Carrier))
                                    {
                                        <div class="small">Carrier: @Model.Carrier</div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Order Items -->
            <div class="order-detail-card">
                <div class="order-detail-header d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="order-detail-title mb-0">Products</h2>
                    </div>
                    <div>
                        <span class="text-muted" style="font-weight: 600;">Price</span>
                    </div>
                </div>
                <div class="order-detail-body">
                    <!-- Table for print view -->
                    <table class="order-items-table print-only" style="display: none;">
                        <thead>
                            <tr>
                                <th style="width: 5%;">#</th>
                                <th style="width: 50%;">Product</th>
                                <th style="width: 10%;" class="text-right">Qty</th>
                                <th style="width: 17.5%;" class="text-right">Unit Price</th>
                                <th style="width: 17.5%;" class="text-right">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int itemNumber = 1;
                            }
                            @foreach (var item in Model.OrderDetails)
                            {
                                <tr>
                                    <td>@itemNumber</td>
                                    <td class="product-name">@item.Product.ProName</td>
                                    <td class="text-right">@item.Quantity</td>
                                    <td class="text-right">€@item.Price.ToString("N2")</td>
                                    <td class="text-right">€@((item.Price * item.Quantity).ToString("N2"))</td>
                                </tr>
                                itemNumber++;
                            }
                        </tbody>
                    </table>
                    
                    <!-- Original product rows for screen view -->
                    @foreach (var item in Model.OrderDetails)
                    {
                        <div class="product-row">
                            <img src="~/Product/@item.Product.ProImage"
                                 alt="@item.Product.ProName"
                                 class="product-image">
                            <div class="product-name">@item.Product.ProName</div>
                            <div class="product-qty">Qty: @item.Quantity</div>
                            <div class="product-price">€@((item.Price * item.Quantity).ToString("N2"))</div>
                        </div>
                    }

                    <!-- Order Total -->
                    <div class="total-section">
                        <div class="total-row">
                            <span class="info-label">Subtotal:</span>
                            <span class="info-value">€@subtotalWithoutVat.ToString("N2")</span>
                        </div>
                        <div class="total-row">
                            <span class="info-label">Discount:</span>
                            <span class="info-value">-</span>
                        </div>
                        <div class="total-row">
                            <span class="info-label">Shipping:</span>
                            <span class="info-value text-success">Free</span>
                        </div>
                        <div class="total-row">
                            <span class="info-label">VAT 18%:</span>
                            <span class="info-value">€@vatAmount.ToString("N2")</span>
                        </div>
                        <div class="total-row grand-total">
                            <span>Order Total:</span>
                            <span style="color: #3b5d50;">€@Model.TotalAmount.ToString("N2")</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Shipping and Payment Methods -->
            <div class="row mt-4">
                <div class="col-md-6">
                    <div class="order-detail-card">
                        <div class="order-detail-header">
                            <h3 class="order-detail-title mb-0" style="font-size: 16px;">Shipping Method:</h3>
                        </div>
                        <div class="order-detail-body">
                            <div>
                                <strong>@(Model.Carrier ?? "STANDARD - Free Shipping")</strong>
                            </div>
                            @if (Model.Status == OrderStatus.Shipped || Model.Status == OrderStatus.Completed)
                            {
                                <div class="text-success small mt-1">
                                    <i class="fas fa-check-circle me-1"></i>Delivered
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="order-detail-card">
                        <div class="order-detail-header">
                            <h3 class="order-detail-title mb-0" style="font-size: 16px;">Payment Method:</h3>
                        </div>
                        <div class="order-detail-body">
                            <div>
                                <strong>Cash on Delivery</strong>
                            </div>
                            @if (Model.Status == OrderStatus.Completed)
                            {
                                <div class="text-success small mt-1">
                                    <i class="fas fa-check-circle me-1"></i>Paid
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Customer & Shipping Info -->
        <div class="col-lg-4">
            <!-- Customer Information -->
            <div class="order-detail-card mb-4">
                <div class="order-detail-header">
                    <h2 class="order-detail-title">Customer Information</h2>
                </div>
                <div class="order-detail-body">
                    <div class="info-card">
                        <div class="info-card-title">Contact Details</div>
                        <div class="info-item">
                            <span class="info-label">Name</span>
                            <span class="info-value">@Model.User.UserName</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Email</span>
                            <span class="info-value">@Model.User.Email</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Phone</span>
                            <span class="info-value">@Model.PhoneNumber</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Shipping Information -->
            <div class="order-detail-card mb-4">
                <div class="order-detail-header">
                    <h2 class="order-detail-title">Shipping Information</h2>
                </div>
                <div class="order-detail-body">
                    <div class="info-card">
                        <div class="info-card-title">Delivery Address</div>
                        <div class="info-item">
                            <span class="info-label">Address</span>
                            <span class="info-value">@Model.ShippingAddress</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">City</span>
                            <span class="info-value">@Model.City</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Shipping Method</span>
                            <span class="info-value">@(Model.Carrier ?? "Standard Shipping")</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Order Notes -->
            @if (!string.IsNullOrEmpty(Model.Comment))
            {
                <div class="order-detail-card">
                    <div class="order-detail-header">
                        <h2 class="order-detail-title">Order Notes</h2>
                    </div>
                    <div class="order-detail-body">
                        <div class="alert alert-light">
                            <i class="fas fa-sticky-note text-muted me-2"></i>
                            @Model.Comment
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</div>

<script>
    // Add active class to current status step
    document.addEventListener('DOMContentLoaded', function() {
        const statusSteps = document.querySelectorAll('.status-step');
        statusSteps.forEach((step, index) => {
            if (step.classList.contains('active')) {
                step.classList.add('active');
            }
        });
    });
    // Enhanced print function
    function printOrder() {
        // Add print classes
        document.body.classList.add('printing');

        // Update print elements
        document.getElementById('printOrderId').textContent = '@Model.OrderId';
        document.getElementById('printDate').textContent = new Date().toLocaleDateString();

        // Store original styles
        const originalStyles = {};
        const elements = document.querySelectorAll('.order-detail-card, .card, .container');
        elements.forEach(el => {
            originalStyles[el.className] = {
                margin: el.style.margin,
                padding: el.style.padding
            };
        });

        // Trigger print
        window.print();

        // Restore original styles
        setTimeout(() => {
            document.body.classList.remove('printing');
            elements.forEach(el => {
                if (originalStyles[el.className]) {
                    el.style.margin = originalStyles[el.className].margin;
                    el.style.padding = originalStyles[el.className].padding;
                }
            });
        }, 1000);
    }

    // Auto-add page numbers
    document.addEventListener('DOMContentLoaded', function() {
        if (window.location.href.includes('print')) {
            printOrder();
        }
    });

    // Keyboard shortcut for printing (Ctrl+P)
    document.addEventListener('keydown', function(e) {
        if ((e.ctrlKey || e.metaKey) && e.key === 'p') {
            e.preventDefault();
            printOrder();
        }
    });
</script>