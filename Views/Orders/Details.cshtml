@using HikingStore.Enum
@model Order

<style>
    /* Custom styling based on the screenshot */
    .order-detail-card {
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        background: white;
    }

    .order-detail-header {
        background: #f8fafc;
        border-bottom: 1px solid #e5e7eb;
        border-radius: 12px 12px 0 0;
        padding: 24px;
    }

    .order-detail-body {
        padding: 24px;
    }

    .order-detail-title {
        color: #3b5d50;
        font-weight: 700;
        font-size: 20px;
        margin: 0;
    }

    .order-detail-subtitle {
        color: #6b7280;
        font-size: 14px;
        margin: 4px 0 0 0;
    }

    .info-card {
        background: #f8fafc;
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 20px;
    }

    .info-card-title {
        color: #374151;
        font-weight: 600;
        font-size: 14px;
        margin-bottom: 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .info-item {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid #e5e7eb;
        align-items: flex-start;
    }

        .info-item:last-child {
            border-bottom: none;
        }

    .info-label {
        color: #6b7280;
        font-size: 14px;
        font-weight: 500;
    }

    .info-value {
        color: #111827;
        font-weight: 500;
        font-size: 14px;
        text-align: right;
        word-break: break-word;
        max-width: 60%;
    }

    .product-row {
        display: flex;
        align-items: center;
        padding: 16px 0;
        border-bottom: 1px solid #e5e7eb;
        transition: background-color 0.2s ease;
    }

        .product-row:hover {
            background-color: #f9fafb;
            border-radius: 8px;
            padding-left: 8px;
            padding-right: 8px;
        }

        .product-row:last-child {
            border-bottom: none;
        }

    .product-image {
        width: 80px;
        height: 80px;
        border-radius: 8px;
        object-fit: cover;
        margin-right: 16px;
        border: 1px solid #e5e7eb;
    }

    .product-name {
        flex: 1;
        color: #374151;
        font-weight: 500;
        font-size: 15px;
        line-height: 1.4;
    }

    .product-qty {
        color: #6b7280;
        font-size: 14px;
        margin-right: 24px;
        background: #f3f4f6;
        padding: 4px 12px;
        border-radius: 20px;
        font-weight: 500;
    }

    .product-price {
        color: #3b5d50;
        font-weight: 600;
        font-size: 16px;
        min-width: 100px;
        text-align: right;
    }

    .total-section {
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-radius: 8px;
        padding: 20px;
        margin-top: 24px;
        border: 1px solid #e5e7eb;
    }

    .total-row {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        align-items: center;
    }

        .total-row.grand-total {
            border-top: 2px solid #3b5d50;
            margin-top: 12px;
            padding-top: 16px;
            font-weight: 700;
            color: #3b5d50;
            font-size: 20px;
        }

    .status-timeline {
        display: flex;
        justify-content: space-between;
        position: relative;
        margin: 24px 0;
    }

        .status-timeline::before {
            content: '';
            position: absolute;
            top: 12px;
            left: 0;
            right: 0;
            height: 2px;
            background: #e5e7eb;
            z-index: 1;
        }

    .status-step {
        position: relative;
        z-index: 2;
        text-align: center;
        flex: 1;
    }

    .status-indicator {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: white;
        border: 2px solid #e5e7eb;
        margin: 0 auto 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
    }

    .status-step.active .status-indicator {
        background: #3b5d50;
        border-color: #3b5d50;
        color: white;
    }

    .status-step.completed .status-indicator {
        background: #10b981;
        border-color: #10b981;
        color: white;
    }

    .status-label {
        color: #6b7280;
        font-size: 12px;
        font-weight: 500;
    }

    .status-step.active .status-label,
    .status-step.completed .status-label {
        color: #374151;
        font-weight: 600;
    }

    .status-timeline::before {
        background: linear-gradient(to right, #10b981 0%, #10b981 var(--progress, 0%), #e5e7eb var(--progress, 0%), #e5e7eb 100%);
    }

    .status-step.completed ~ .status-step .status-indicator {
        border-color: #10b981;
    }

    .action-buttons {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-top: 24px;
    }

    .action-buttons .btn {
        width: 100%;
        justify-content: center;
    }

    .btn-primary {
        background: #3b5d50;
        border-color: #3b5d50;
        padding: 10px 24px;
        font-weight: 500;
    }

        .btn-primary:hover {
            background: #2d473d;
            border-color: #2d473d;
        }

    .btn-outline-primary {
        border-color: #3b5d50;
        color: #3b5d50;
        padding: 10px 24px;
        font-weight: 500;
    }

        .btn-outline-primary:hover {
            background: #3b5d50;
            border-color: #3b5d50;
            color: white;
        }

    .order-number {
        background: #3b5d50;
        color: white;
        padding: 4px 12px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 12px;
        display: inline-block;
    }

       /* PRINT STYLES - Professional & Compact */
    @@media print {
        /* Reset everything for print */
        * {
            margin: 0 !important;
            padding: 0 !important;
            box-sizing: border-box !important;
        }

        /* Hide unnecessary elements */
        body * {
            visibility: hidden;
        }

        /* Only show printable content */
        .printable-area,
        .printable-area *,
        .order-detail-card,
        .order-detail-card *,
        #orderDetails,
        #orderDetails *,
        .container,
        .container * {
            visibility: visible !important;
        }

        /* Hide all navigation, buttons, and unnecessary elements */
        .navbar,
        .sb-topnav,
        .footer,
        .breadcrumb,
        .status-filter,
        .action-buttons,
        .order-actions,
        .btn,
        button,
        .dropdown,
        .auth-buttons-container,
        .search-box,
        .cart-summary-wrapper,
        .user-dropdown-toggle,
        .btn-group,
        .status-timeline,
        .animation,
        .pulse,
        .bounce,
        .spinner,
        [class*="fa-"]:not(.fa-print),
        i:not(.fa-print),
        .no-print,
        .status-step,
        .step,
        .status-tracker {
            display: none !important;
        }

        /* Page setup */
        @@page {
            size: A4 portrait;
            margin: 0.5cm;
        }

        /* Container setup */
        .container {
            width: 100% !important;
            max-width: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        /* Font setup for print */
        body {
            font-family: "Arial", "Helvetica", sans-serif !important;
            font-size: 11pt !important;
            line-height: 1.3 !important;
            color: #000 !important;
            background: #fff !important;
        }

        /* Headers */
        h1, h2, h3, h4, h5, h6 {
            color: #000 !important;
            page-break-after: avoid;
            margin-bottom: 0.5em !important;
        }

        h1 {
            font-size: 16pt !important;
            border-bottom: 1px solid #ccc !important;
            padding-bottom: 0.3em !important;
            margin-bottom: 0.8em !important;
        }

        h2 {
            font-size: 14pt !important;
            margin-top: 1em !important;
        }

        h3 {
            font-size: 12pt !important;
        }

        /* Cards and containers */
        .order-detail-card,
        .card,
        .info-card {
            border: 1px solid #000 !important;
            box-shadow: none !important;
            border-radius: 0 !important;
            page-break-inside: avoid;
            margin-bottom: 1em !important;
            background: #fff !important;
        }

        .order-detail-header,
        .card-header {
            background: #f5f5f5 !important;
            color: #000 !important;
            border-bottom: 1px solid #000 !important;
            padding: 0.5em !important;
        }

        .order-detail-body,
        .card-body {
            padding: 0.8em !important;
        }

        /* Tables */
        table {
            width: 100% !important;
            border-collapse: collapse !important;
            margin: 0.5em 0 !important;
            page-break-inside: avoid;
        }

        th, td {
            border: 1px solid #000 !important;
            padding: 0.3em 0.5em !important;
            font-size: 10pt !important;
            text-align: left !important;
            vertical-align: top !important;
        }

        th {
            background: #f5f5f5 !important;
            font-weight: bold !important;
        }

        /* Product rows */
        .product-row {
            border-bottom: 1px solid #ccc !important;
            padding: 0.3em 0 !important;
            margin: 0.2em 0 !important;
            display: table-row !important;
        }

        .product-image {
            max-width: 40px !important;
            max-height: 40px !important;
        }

        /* Status and badges */
        .badge,
        .status-badge,
        .order-number {
            background: #f5f5f5 !important;
            color: #000 !important;
            border: 1px solid #000 !important;
            padding: 0.2em 0.5em !important;
            font-size: 9pt !important;
            border-radius: 0 !important;
        }

        /* Lists */
        ul, ol {
            margin-left: 1.5em !important;
            margin-bottom: 0.5em !important;
        }

        li {
            margin-bottom: 0.2em !important;
        }

        /* Order info sections */
        .info-item {
            display: table-row !important;
            border-bottom: none !important;
            padding: 0.2em 0 !important;
        }

        .info-label {
            width: 30% !important;
            font-weight: bold !important;
            padding-right: 1em !important;
        }

        .info-value {
            width: 70% !important;
        }

        /* Totals section */
        .total-section {
            border-top: 2px solid #000 !important;
            margin-top: 1em !important;
            padding-top: 0.5em !important;
        }

        .total-row {
            display: flex !important;
            justify-content: space-between !important;
            padding: 0.2em 0 !important;
        }

        .grand-total {
            border-top: 1px solid #000 !important;
            font-weight: bold !important;
            margin-top: 0.5em !important;
            padding-top: 0.5em !important;
        }

        /* Page breaks */
        .page-break {
            page-break-before: always;
        }

        .no-break {
            page-break-inside: avoid;
        }

        /* Company header */
        .print-header {
            text-align: center;
            margin-bottom: 1.5em;
            padding-bottom: 0.5em;
            border-bottom: 2px solid #000;
        }

        .company-name {
            font-size: 18pt;
            font-weight: bold;
            margin-bottom: 0.2em;
        }

        .company-details {
            font-size: 10pt;
            color: #666;
        }

        /* Print footer */
        .print-footer {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            text-align: center;
            font-size: 9pt;
            color: #666;
            padding: 0.5em;
            border-top: 1px solid #ccc;
            background: #fff;
        }

        /* Order summary compact */
        .order-summary-compact {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 0.5em;
            margin: 0.5em 0;
        }

        .summary-item {
            font-size: 10pt;
        }

        .summary-label {
            font-weight: bold;
            display: block;
        }

        /* QR Code area (if you add one) */
        .qrcode-area {
            float: right;
            width: 80px;
            margin-left: 1em;
        }

        /* Colors for print */
        .text-primary,
        .text-success,
        .text-danger,
        .text-warning {
            color: #000 !important;
        }

        .bg-primary,
        .bg-success,
        .bg-danger,
        .bg-warning {
            background: #f5f5f5 !important;
        }

        /* Links */
        a {
            color: #000 !important;
            text-decoration: none !important;
        }

        a[href]::after {
            content: " (" attr(href) ")";
            font-size: 8pt;
            color: #666;
        }

        /* Hide specific elements by class */
        .d-none-print,
        .no-print,
        .print-only {
            display: none !important;
        }

        /* Print-only elements */
        .print-only {
            display: block !important;
        }

        /* Compact product display */
        .product-compact {
            display: grid;
            grid-template-columns: auto 1fr auto;
            gap: 0.5em;
            align-items: center;
            padding: 0.2em 0;
        }

        /* Order timeline (compact version) */
        .status-tracker-print {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 0.5em;
            margin: 1em 0;
            text-align: center;
        }

        .status-step-print {
            font-size: 9pt;
            padding: 0.2em;
            border: 1px solid #ccc;
        }

        .status-step-print.active {
            background: #000 !important;
            color: #fff !important;
            font-weight: bold !important;
        }

        /* Invoice styling */
        .invoice-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 1em;
        }

        .invoice-info {
            font-size: 10pt;
        }

        .invoice-number {
            font-size: 14pt;
            font-weight: bold;
        }

        /* Ensure proper spacing */
        .mt-1 { margin-top: 0.25em !important; }
        .mt-2 { margin-top: 0.5em !important; }
        .mt-3 { margin-top: 1em !important; }
        .mb-1 { margin-bottom: 0.25em !important; }
        .mb-2 { margin-bottom: 0.5em !important; }
        .mb-3 { margin-bottom: 1em !important; }
        .pt-1 { padding-top: 0.25em !important; }
        .pt-2 { padding-top: 0.5em !important; }
        .pb-1 { padding-bottom: 0.25em !important; }
        .pb-2 { padding-bottom: 0.5em !important; }
    }

    /* Additional compact classes for regular use */
    .compact-table {
        font-size: 0.9em;
    }

    .compact-table th,
    .compact-table td {
        padding: 0.3em 0.5em;
    }

    .compact-card {
        padding: 0.8em;
    }

    .compact-card .card-body {
        padding: 0.8em;
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .order-detail-header {
            padding: 16px !important;
        }

        .order-detail-body {
            padding: 16px !important;
        }

        .product-row {
            flex-wrap: wrap;
            gap: 12px;
        }

        .product-image {
            width: 60px;
            height: 60px;
        }

        .product-name {
            flex: 1 1 100%;
            margin-top: 8px;
        }

        .product-qty {
            margin-right: 12px;
        }

        .status-timeline {
            flex-wrap: wrap;
            gap: 16px;
        }

        .status-step {
            flex: 0 0 calc(50% - 8px);
        }

        .info-item {
            flex-direction: column;
            gap: 4px;
        }

        .info-value {
            text-align: left;
            max-width: 100%;
        }

        .action-buttons {
            margin-top: 16px;
        }
    }

    @@media (max-width: 576px) {
        .status-timeline {
            flex-direction: column;
        }

        .status-step {
            flex: 1;
            width: 100%;
            text-align: left;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .status-indicator {
            margin: 0;
        }

        .status-timeline::before {
            display: none;
        }

        .order-number {
            font-size: 11px;
            padding: 3px 10px;
        }
    }
</style>

@{
    var vatRate = 0.18m; // 18% VAT
    var subtotalWithoutVat = Model.TotalAmount / (1 + vatRate);
    var vatAmount = Model.TotalAmount - subtotalWithoutVat;
}

<div class="hero">
    <div class="container">
        <div class="row justify-content-between align-items-center">
            <div class="col-lg-8">
                <div class="intro-excerpt">
                    <a asp-action="Index" class="text-decoration-none text-muted mb-2 d-inline-block">
                        <i class="fas fa-arrow-left me-2"></i>Back to Orders
                    </a>
                    <h1>Order Details</h1>
                    <div class="d-flex align-items-center gap-3 mt-2">
                        <span class="order-number">#@Model.OrderId</span>
                        <span class="text-muted">• @Model.OrderDate.ToString("MMM dd, yyyy • hh:mm tt")</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 text-lg-end">
                <button class="btn btn-outline-primary no-print" onclick="printOrder()">
                    <i class="fas fa-print me-2"></i>Print Order
                </button>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">

    <div class="row g-4">
        <!-- Left Column: Order Status & Items -->
        <div class="col-lg-8">
            <!-- Status Timeline -->
            <div class="order-detail-card mb-4">
                <div class="order-detail-header">
                    <h2 class="order-detail-title">Order Status</h2>
                    <p class="order-detail-subtitle">Track your order progress</p>
                </div>
                <div class="order-detail-body">
                    @{
                        var statuses = new[]
                        {
                                        (OrderStatus.Received, "Received", "fas fa-inbox"),
                                        (OrderStatus.Verified, "Verified", "fas fa-check-circle"),
                                        (OrderStatus.Processing, "Processing", "fas fa-cog"),
                                        (OrderStatus.Shipped, "Shipped", "fas fa-shipping-fast"),
                                        (OrderStatus.Completed, "Completed", "fas fa-check")
                                        };

                        var currentStatusIndex = Array.FindIndex(statuses, s => s.Item1 == Model.Status);
                    }

                    <div class="status-timeline" style="--progress: @((currentStatusIndex + 1) * 20)%">
                        @for (int i = 0; i < statuses.Length; i++)
                        {
                            var (status, displayName, icon) = statuses[i];
                            var isCompleted = i < currentStatusIndex;
                            var isCurrent = i == currentStatusIndex;
                            var dateProperty = status switch
                            {
                                OrderStatus.Received => Model.OrderDate,
                                OrderStatus.Verified => Model.VerifiedDate,
                                OrderStatus.Processing => Model.ProcessingDate,
                                OrderStatus.Shipped => Model.ShippedDate,
                                OrderStatus.Completed => Model.CompletedDate,
                                _ => (DateTime?)null
                            };

                            <div class="status-step @(isCompleted ? "completed" : "") @(isCurrent ? "active" : "")">
                                <div class="status-indicator">
                                    @if (isCompleted)
                                    {
                                        <i class="fas fa-check"></i>
                                    }
                                    else if (isCurrent)
                                    {
                                        <i class="@icon"></i>
                                    }
                                </div>
                                <div class="status-label">@displayName</div>
                                @if (dateProperty.HasValue)
                                {
                                    <div class="text-muted small mt-1">@dateProperty.Value.ToString("MMM dd, yyyy")</div>
                                }
                            </div>
                        }
                    </div>

                    @if (Model.Status == OrderStatus.Shipped && !string.IsNullOrEmpty(Model.TrackingNumber) && Model.TrackingNumber != "N/A")
                    {
                        <div class="alert alert-info mt-3">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-truck me-2"></i>
                                <div>
                                    <strong>Tracking Number:</strong> @Model.TrackingNumber
                                    @if (!string.IsNullOrEmpty(Model.Carrier))
                                    {
                                        <div class="small">Carrier: @Model.Carrier</div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Order Items -->
            <div class="order-detail-card">
                <div class="order-detail-header">
                    <h2 class="order-detail-title">Order Items</h2>
                    <p class="order-detail-subtitle">@Model.OrderDetails.Sum(od => od.Quantity) items in this order</p>
                </div>
                <div class="order-detail-body">
                    @foreach (var item in Model.OrderDetails)
                    {
                        <div class="product-row">
                            <img src="~/Product/@item.Product.ProImage"
                                 alt="@item.Product.ProName"
                                 class="product-image">
                            <div class="product-name">@item.Product.ProName</div>
                            <div class="product-qty">Qty: @item.Quantity</div>
                            <div class="product-price">€@((item.Price * item.Quantity).ToString("N2"))</div>
                        </div>
                    }

                    <!-- Order Total -->
                    <div class="total-section">
                        <div class="total-row">
                            <span class="info-label">Subtotal</span>
                            <span class="info-value">€@subtotalWithoutVat.ToString("N2")</span>
                        </div>
                        <div class="total-row">
                            <span class="info-label">Shipping</span>
                            <span class="info-value text-success">Free</span>
                        </div>
                        <div class="total-row">
                            <span class="info-label">VAT (18%)</span>
                            <span class="info-value">€@vatAmount.ToString("N2")</span>
                        </div>
                        <div class="total-row grand-total">
                            <span>Total</span>
                            <span>€@Model.TotalAmount.ToString("N2")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Customer & Shipping Info -->
        <div class="col-lg-4">
            <!-- Customer Information -->
            <div class="order-detail-card mb-4">
                <div class="order-detail-header">
                    <h2 class="order-detail-title">Customer Information</h2>
                </div>
                <div class="order-detail-body">
                    <div class="info-card">
                        <div class="info-card-title">Contact Details</div>
                        <div class="info-item">
                            <span class="info-label">Name</span>
                            <span class="info-value">@Model.User.UserName</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Email</span>
                            <span class="info-value">@Model.User.Email</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Phone</span>
                            <span class="info-value">@Model.PhoneNumber</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Shipping Information -->
            <div class="order-detail-card mb-4">
                <div class="order-detail-header">
                    <h2 class="order-detail-title">Shipping Information</h2>
                </div>
                <div class="order-detail-body">
                    <div class="info-card">
                        <div class="info-card-title">Delivery Address</div>
                        <div class="info-item">
                            <span class="info-label">Address</span>
                            <span class="info-value">@Model.ShippingAddress</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">City</span>
                            <span class="info-value">@Model.City</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Order Notes -->
            @if (!string.IsNullOrEmpty(Model.Comment))
            {
                <div class="order-detail-card">
                    <div class="order-detail-header">
                        <h2 class="order-detail-title">Order Notes</h2>
                    </div>
                    <div class="order-detail-body">
                        <div class="alert alert-light">
                            <i class="fas fa-sticky-note text-muted me-2"></i>
                            @Model.Comment
                        </div>
                    </div>
                </div>
            }

            <!-- Action Buttons -->
            <div class="action-buttons no-print">
                <a href="/Home/Product" class="btn btn-primary flex-grow-1">
                    <i class="fas fa-shopping-bag me-2"></i>Shop Again
                </a>
                <a asp-action="Index" class="btn btn-outline-primary">
                    <i class="fas fa-list me-2"></i>View All Orders
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    // Add active class to current status step
    document.addEventListener('DOMContentLoaded', function() {
        const statusSteps = document.querySelectorAll('.status-step');
        statusSteps.forEach((step, index) => {
            if (step.classList.contains('active')) {
                step.classList.add('active');
            }
        });
    });
    // Enhanced print function
    function printOrder() {
        // Add print classes
        document.body.classList.add('printing');

        // Update print elements
        document.getElementById('printOrderId').textContent = '@Model.OrderId';
        document.getElementById('printDate').textContent = new Date().toLocaleDateString();

        // Store original styles
        const originalStyles = {};
        const elements = document.querySelectorAll('.order-detail-card, .card, .container');
        elements.forEach(el => {
            originalStyles[el.className] = {
                margin: el.style.margin,
                padding: el.style.padding
            };
        });

        // Trigger print
        window.print();

        // Restore original styles
        setTimeout(() => {
            document.body.classList.remove('printing');
            elements.forEach(el => {
                if (originalStyles[el.className]) {
                    el.style.margin = originalStyles[el.className].margin;
                    el.style.padding = originalStyles[el.className].padding;
                }
            });
        }, 1000);
    }

    // Auto-add page numbers
    document.addEventListener('DOMContentLoaded', function() {
        if (window.location.href.includes('print')) {
            printOrder();
        }
    });

    // Keyboard shortcut for printing (Ctrl+P)
    document.addEventListener('keydown', function(e) {
        if ((e.ctrlKey || e.metaKey) && e.key === 'p') {
            e.preventDefault();
            printOrder();
        }
    });
</script>