@model Order
@inject IOptions<StoreSettings> StoreOptions
@{
    var store = StoreOptions.Value;
    ViewData["Title"] = $"Order #{Model.OrderNumber}";
    ViewData["NoIndex"] = true;
    ViewData["AccountSection"] = "orders";
}

<div class="container-hs">
    <nav class="breadcrumb-bar" aria-label="Breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Account" asp-action="Index">My account</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Orders</a></li>
            <li class="breadcrumb-item active" aria-current="page">#@Model.OrderNumber</li>
        </ol>
    </nav>
    <div class="page-head d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h1>Order #@Model.OrderNumber</h1>
            <p class="text-muted m-0">Placed @Model.OrderDate.ToString("d MMM yyyy, HH:mm") UTC</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-secondary" asp-action="Invoice" asp-route-id="@Model.OrderId" target="_blank" rel="noopener"><i class="fa-solid fa-file-invoice me-2" aria-hidden="true"></i>Invoice</a>
            @if (Model.IsAwaitingCardPayment)
            {
                <a class="btn btn-primary" asp-controller="Payments" asp-action="Status" asp-route-id="@Model.OrderId"><i class="fa-solid fa-lock me-2" aria-hidden="true"></i>Complete payment</a>
                <form method="post" asp-controller="Payments" asp-action="Cancel" asp-route-id="@Model.OrderId" data-confirm="Cancel this order? Your items will go back to your cart." data-once>
                    <button type="submit" class="btn btn-outline-danger" data-busy-text="Cancelling…">Cancel order</button>
                </form>
            }
            else if (Model.CanBeCancelledByCustomer)
            {
                <form method="post" asp-action="CancelOrder" asp-route-id="@Model.OrderId" data-confirm="Cancel this order? This can't be undone." data-once>
                    <button type="submit" class="btn btn-outline-danger" data-busy-text="Cancelling…">Cancel order</button>
                </form>
            }
        </div>
    </div>

    <div class="account-layout">
        <partial name="_AccountNav" />
        <div class="d-flex flex-column gap-4">
            <section class="card-hs" aria-labelledby="status-title">
                <div class="d-flex flex-wrap justify-content-between gap-2 mb-4">
                    <h2 id="status-title" class="h5 m-0">Status: @OrderEmailService.StatusLabel(Model.Status)</h2>
                    @if (Model.EstimatedDelivery.HasValue && Model.Status is OrderStatus.Processing or OrderStatus.Shipped)
                    {
                        <span class="small">Estimated delivery <strong>@Model.EstimatedDelivery.Value.ToString("ddd d MMM")</strong></span>
                    }
                </div>
                <partial name="_OrderStatusBadge" model="Model.Status" />
                @if (!string.IsNullOrEmpty(Model.TrackingNumber))
                {
                    <p class="mt-4 mb-0 small">Carrier: <strong>@Model.Carrier</strong> · Tracking number: <strong class="user-select-all">@Model.TrackingNumber</strong></p>
                }
                <h3 class="h6 mt-4">Updates</h3>
                <partial name="_TrackingHistory" model="Model.TrackingEvents" />
            </section>

            <div class="row g-4">
                <div class="col-lg-7">
                    <section class="card-hs h-100" aria-labelledby="items-title">
                        <h2 id="items-title" class="h5">Items</h2>
                        @foreach (var line in Model.OrderDetails)
                        {
                            <div class="summary-line">
                                <div class="thumb">
                                    @if (!string.IsNullOrEmpty(line.Product?.ProImage))
                                    {
                                        <img src="~/Product/@line.Product.ProImage" alt="" loading="lazy" />
                                    }
                                    <span class="qty-pill">×@line.Quantity</span>
                                </div>
                                <div class="min-w-0">
                                    @if (line.Product?.IsActive == true)
                                    {
                                        <a class="d-block fw-semibold" asp-controller="Home" asp-action="ProductDetailes" asp-route-id="@line.ProId">@line.DisplayName</a>
                                    }
                                    else
                                    {
                                        <span class="d-block fw-semibold">@line.DisplayName</span>
                                    }
                                    <span class="text-muted">@string.Join(" · ", new[] { line.SelectedColor, line.SelectedSize, $"{store.FormatPrice(line.Price)} each" }.Where(v => !string.IsNullOrEmpty(v)))</span>
                                    @if (Model.Status == OrderStatus.Completed && line.Product?.IsActive == true)
                                    {
                                        <a class="d-block small" asp-controller="Home" asp-action="ProductDetailes" asp-route-id="@line.ProId" asp-fragment="reviews">Write a review</a>
                                    }
                                </div>
                                <span>@store.FormatPrice(line.LineTotal)</span>
                            </div>
                        }
                        <hr />
                        <ul class="summary-rows m-0">
                            <li><span>Subtotal</span><span>@store.FormatPrice(Model.Subtotal)</span></li>
                            @if (Model.DiscountAmount > 0)
                            {
                                <li class="discount"><span>Discount (@Model.CouponCode)</span><span>−@store.FormatPrice(Model.DiscountAmount)</span></li>
                            }
                            <li><span>Shipping (@Model.ShippingService)</span><span>@(Model.ShippingCost == 0 ? "Free" : store.FormatPrice(Model.ShippingCost))</span></li>
                            <li class="total"><span>Total</span><span>@store.FormatPrice(Model.TotalAmount)</span></li>
                        </ul>
                    </section>
                </div>
                <div class="col-lg-5">
                    <section class="card-hs h-100" aria-labelledby="delivery-title">
                        <h2 id="delivery-title" class="h5">Delivery</h2>
                        <address>
                            <strong>@(Model.FullName ?? "")</strong><br />
                            @Model.ShippingAddress<br />
                            @Model.PostalCode @Model.City<br />
                            @Model.Country<br />
                            @Model.PhoneNumber
                        </address>
                        <h3 class="h6">Payment</h3>
                        <p class="mb-1">@PaymentMethods.DisplayName(Model.PaymentMethod)</p>
                        <p class="small text-muted">Payment status: @Model.PaymentStatusLabel@(Model.PaidAt.HasValue ? $" · {Model.PaidAt.Value:d MMM yyyy, HH:mm} UTC" : "")</p>
                        @if (Model.IsCardPayment && Model.PaymentStatus == PaymentStatuses.Paid && Model.Status < OrderStatus.Shipped)
                        {
                            <p class="small text-muted">Need to cancel a paid order? <a asp-controller="Home" asp-action="Contact">Contact us</a> and we'll refund your card.</p>
                        }
                        @if (!string.IsNullOrEmpty(Model.Comment))
                        {
                            <h3 class="h6">Your notes</h3>
                            <p class="small">@Model.Comment</p>
                        }
                        <p class="small text-muted mb-0">Questions about this order? <a asp-controller="Home" asp-action="Contact">Contact us</a> and mention #@Model.OrderNumber.</p>
                    </section>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.addEventListener('load', () => setTimeout(() => window.realtimeUpdates?.joinOrderGroup(@Model.OrderId), 1500));
    </script>
}
