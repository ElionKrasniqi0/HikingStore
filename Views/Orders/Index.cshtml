@model List<Order>
@inject IOptions<StoreSettings> StoreOptions
@{
    var store = StoreOptions.Value;
    ViewData["Title"] = "My orders";
    ViewData["NoIndex"] = true;
    ViewData["AccountSection"] = "orders";
    var counts = ViewBag.StatusCounts as Dictionary<OrderStatus, int> ?? new();
    var current = ViewBag.CurrentStatus as OrderStatus?;
    var total = (int)(ViewBag.TotalCount ?? 0);
    var page = (int)(ViewBag.Page ?? 1);
    var pageCount = (int)(ViewBag.PageCount ?? 1);
}

<div class="container-hs">
    <div class="page-head"><h1>My orders</h1></div>
    <div class="account-layout">
        <partial name="_AccountNav" />
        <section aria-label="Orders">
            @if (total > 0)
            {
                <div class="chip-row mb-4" role="navigation" aria-label="Filter by status">
                    <a class="chip @(current == null ? "active" : "")" asp-action="Index">All (@total)</a>
                    @foreach (var status in System.Enum.GetValues<OrderStatus>())
                    {
                        if (counts.TryGetValue(status, out var n) && n > 0)
                        {
                            <a class="chip @(current == status ? "active" : "")" asp-action="Index" asp-route-status="@status">@OrderEmailService.StatusLabel(status) (@n)</a>
                        }
                    }
                </div>
            }

            @if (Model.Count == 0)
            {
                <div class="empty-state card-hs">
                    <i class="fa-solid fa-box-open" aria-hidden="true"></i>
                    <h2>@(total == 0 ? "No orders yet" : "No orders with this status")</h2>
                    <p>@(total == 0 ? "When you place an order, you can track it here." : "Try another status filter.")</p>
                    <a class="btn btn-primary" asp-controller="Home" asp-action="Shop">Start shopping</a>
                </div>
            }
            else
            {
                @foreach (var order in Model)
                {
                    <article class="order-row">
                        <div class="min-w-0">
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <h2 class="h6 m-0 font-body"><a asp-action="Details" asp-route-id="@order.OrderId">Order #@order.OrderNumber</a></h2>
                                <span class="status-badge status-@order.Status">@OrderEmailService.StatusLabel(order.Status)</span>
                            </div>
                            <p class="small text-muted mb-0 mt-1">
                                Placed @order.OrderDate.ToString("d MMM yyyy") · @order.OrderDetails.Sum(d => d.Quantity) items · @PaymentMethods.DisplayName(order.PaymentMethod)
                                @if (!string.IsNullOrEmpty(order.TrackingNumber))
                                {
                                    <text> · Tracking @order.TrackingNumber</text>
                                }
                            </p>
                            <div class="order-thumbs">
                                @foreach (var line in order.OrderDetails.Take(5))
                                {
                                    @if (!string.IsNullOrEmpty(line.Product?.ProImage))
                                    {
                                        <img src="~/Product/@line.Product.ProImage" alt="@line.DisplayName" loading="lazy" width="52" height="52" />
                                    }
                                }
                                @if (order.OrderDetails.Count > 5)
                                {
                                    <span class="small text-muted align-self-center">+@(order.OrderDetails.Count - 5) more</span>
                                }
                            </div>
                        </div>
                        <div class="d-flex flex-column align-items-md-end justify-content-between gap-2">
                            <strong>@store.FormatPrice(order.TotalAmount)</strong>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@order.OrderId">View &amp; track</a>
                        </div>
                    </article>
                }
                <partial name="_Pagination" model='new PaginationModel(page, pageCount, p => Url.Action("Index", new { status = current?.ToString(), page = p })!)' />
            }
        </section>
    </div>
</div>
