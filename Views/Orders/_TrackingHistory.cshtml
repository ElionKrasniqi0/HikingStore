@model IEnumerable<TrackingEvent>
@if (Model.Any())
{
    <ol class="timeline">
        @foreach (var tracking in Model.OrderByDescending(t => t.EventDate))
        {
            <li class="@(tracking.IsMilestone ? "milestone" : "")">
                <div class="d-flex justify-content-between flex-wrap gap-2">
                    <strong>@tracking.Description</strong>
                    <time class="small text-muted" datetime="@tracking.EventDate.ToString("o")">@tracking.EventDate.ToString("d MMM yyyy, HH:mm") UTC</time>
                </div>
                <div class="small text-muted">@tracking.Location</div>
            </li>
        }
    </ol>
}
else
{
    <p class="text-muted m-0">No tracking updates yet.</p>
}
