@model Order
@inject IOptions<StoreSettings> StoreOptions
@{
    Layout = null;
    var store = StoreOptions.Value;
    var vat = store.VatRate > 0 ? Math.Round(Model.TotalAmount - Model.TotalAmount / (1 + store.VatRate), 2) : 0;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Invoice #@Model.OrderNumber | @store.Name</title>
    <style>
        body { font-family: "Segoe UI", Arial, sans-serif; color: #252A25; margin: 0; background: #F3EFE5; }
        .sheet { max-width: 820px; margin: 24px auto; background: #fff; padding: 40px; border: 1px solid #DED2BC; border-radius: 8px; }
        header { display: flex; justify-content: space-between; gap: 24px; flex-wrap: wrap; border-bottom: 3px solid #234B35; padding-bottom: 20px; }
        h1 { margin: 0; font-size: 28px; color: #163526; }
        .muted { color: #73786F; font-size: 14px; }
        .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin: 28px 0; }
        table { width: 100%; border-collapse: collapse; font-size: 14px; }
        th { text-align: left; color: #73786F; font-weight: 600; border-bottom: 1px solid #DED2BC; padding: 8px 0; }
        td { padding: 10px 0; border-bottom: 1px solid #EEE8DC; vertical-align: top; }
        .r { text-align: right; }
        .totals { margin-left: auto; width: 320px; max-width: 100%; margin-top: 16px; }
        .totals td { border: 0; padding: 4px 0; }
        .totals .grand td { font-weight: 700; font-size: 17px; border-top: 2px solid #234B35; padding-top: 10px; }
        .actions { max-width: 820px; margin: 0 auto; display: flex; gap: 8px; justify-content: flex-end; padding: 0 16px; }
        .actions button, .actions a { font: inherit; padding: 8px 16px; border-radius: 6px; border: 1px solid #234B35; background: #234B35; color: #fff; cursor: pointer; text-decoration: none; }
        .actions a { background: #fff; color: #234B35; }
        @@media (max-width: 600px) { .sheet { padding: 20px; margin: 0; border-radius: 0; } .grid { grid-template-columns: 1fr; } }
        @@media print { body { background: #fff; } .sheet { border: 0; margin: 0; } .actions { display: none; } }
    </style>
</head>
<body>
    <div class="actions" style="margin-top:16px">
        <a href="@Url.Action("Details", new { id = Model.OrderId })">Back to order</a>
        <button type="button" onclick="window.print()">Print / save as PDF</button>
    </div>
    <main class="sheet">
        <header>
            <div>
                <h1>@store.Name</h1>
                <div class="muted">@store.Address<br />@store.SupportEmail · @store.SupportPhone</div>
            </div>
            <div class="r">
                <h1>Invoice</h1>
                <div class="muted">#@Model.OrderNumber<br />Date: @Model.OrderDate.ToString("dd MMM yyyy")</div>
            </div>
        </header>

        <div class="grid">
            <section>
                <strong>Bill &amp; ship to</strong>
                <div class="muted" style="margin-top:6px">
                    @(Model.FullName ?? Model.User?.DisplayName)<br />
                    @Model.ShippingAddress<br />
                    @Model.PostalCode @Model.City, @Model.Country<br />
                    @Model.PhoneNumber<br />
                    @(Model.Email ?? Model.User?.Email)
                </div>
            </section>
            <section>
                <strong>Payment</strong>
                <div class="muted" style="margin-top:6px">
                    @PaymentMethods.DisplayName(Model.PaymentMethod)<br />
                    Status: @Model.PaymentStatusLabel<br />
                    @if (Model.PaidAt.HasValue)
                    {
                        <text>Paid: @Model.PaidAt.Value.ToString("d MMM yyyy") @(string.IsNullOrEmpty(Model.PaymentTransactionId) ? "" : $"· Ref. {Model.PaymentTransactionId}")<br /></text>
                    }
                    Order status: @OrderEmailService.StatusLabel(Model.Status)
                </div>
            </section>
        </div>

        <table>
            <thead>
                <tr><th>Item</th><th class="r">Qty</th><th class="r">Unit price</th><th class="r">Total</th></tr>
            </thead>
            <tbody>
                @foreach (var line in Model.OrderDetails)
                {
                    <tr>
                        <td>@line.DisplayName
                            @if (!string.IsNullOrEmpty(line.SelectedSize) || !string.IsNullOrEmpty(line.SelectedColor))
                            {
                                <br /><span class="muted">@string.Join(" · ", new[] { line.SelectedColor, line.SelectedSize }.Where(v => !string.IsNullOrEmpty(v)))</span>
                            }
                        </td>
                        <td class="r">@line.Quantity</td>
                        <td class="r">@store.FormatPrice(line.Price)</td>
                        <td class="r">@store.FormatPrice(line.LineTotal)</td>
                    </tr>
                }
            </tbody>
        </table>

        <table class="totals">
            <tr><td>Subtotal</td><td class="r">@store.FormatPrice(Model.Subtotal)</td></tr>
            @if (Model.DiscountAmount > 0)
            {
                <tr><td>Discount (@Model.CouponCode)</td><td class="r">−@store.FormatPrice(Model.DiscountAmount)</td></tr>
            }
            <tr><td>Shipping (@Model.ShippingService)</td><td class="r">@store.FormatPrice(Model.ShippingCost)</td></tr>
            <tr class="grand"><td>Total</td><td class="r">@store.FormatPrice(Model.TotalAmount)</td></tr>
            @if (vat > 0)
            {
                <tr><td class="muted">Includes VAT (@((store.VatRate * 100).ToString("0.#"))%)</td><td class="r muted">@store.FormatPrice(vat)</td></tr>
            }
        </table>

        <p class="muted" style="margin-top:40px">Thank you for shopping with @store.Name. Returns are accepted within @store.ReturnDays days of delivery.</p>
    </main>
</body>
</html>
