@model OrderStatus
@{
    var steps = new[] { OrderStatus.Received, OrderStatus.Verified, OrderStatus.Processing, OrderStatus.Shipped, OrderStatus.Completed };
}
@if (Model == OrderStatus.Cancelled)
{
    <p class="m-0"><span class="status-badge status-Cancelled"><i class="fa-solid fa-ban" aria-hidden="true"></i>Cancelled</span></p>
}
else
{
    <ol class="progress-steps" aria-label="Order progress">
        @foreach (var step in steps)
        {
            var done = step <= Model;
            <li class="@(done ? "done" : "")" aria-current="@(step == Model ? "step" : null)">@OrderEmailService.StatusLabel(step)</li>
        }
    </ol>
}
