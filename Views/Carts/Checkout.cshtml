@model CheckoutViewModel
@inject IOptions<StoreSettings> StoreOptions
@{
    var store = StoreOptions.Value;
    ViewData["Title"] = "Checkout";
    ViewData["NoIndex"] = true;
}

<div class="container-hs">
    <div class="page-head">
        <h1>Checkout</h1>
    </div>
    <ol class="checkout-steps" aria-label="Checkout progress">
        <li class="done"><span class="n"><i class="fa-solid fa-check" aria-hidden="true"></i></span>Cart</li>
        <li class="current" aria-current="step"><span class="n">2</span>Details &amp; delivery</li>
        <li><span class="n">3</span>Confirmation</li>
    </ol>

    <form method="post" asp-action="Checkout" data-once novalidate id="checkout-form">
        <input type="hidden" asp-for="Input.CheckoutToken" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="two-col">
            <div class="d-flex flex-column gap-4">
                <section class="card-hs" aria-labelledby="contact-title">
                    <h2 id="contact-title">1. Contact</h2>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Input.Email" class="form-label"></label>
                            <input asp-for="Input.Email" class="form-control" autocomplete="email" />
                            <span asp-validation-for="Input.Email"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.PhoneNumber" class="form-label"></label>
                            <input asp-for="Input.PhoneNumber" class="form-control" autocomplete="tel" inputmode="tel" />
                            <span asp-validation-for="Input.PhoneNumber"></span>
                            <div class="form-text">The courier will call this number before delivery.</div>
                        </div>
                    </div>
                </section>

                <section class="card-hs" aria-labelledby="address-title">
                    <h2 id="address-title">2. Shipping address</h2>
                    @if (Model.SavedAddresses.Count > 0)
                    {
                        <div class="mb-3">
                            <p class="form-label">Saved addresses</p>
                            <div class="chip-row">
                                @foreach (var address in Model.SavedAddresses)
                                {
                                    <button type="button" class="chip" data-fill-address
                                            data-full-name="@address.FullName" data-phone="@address.PhoneNumber" data-address="@address.AddressLine"
                                            data-city="@address.City" data-postal="@address.PostalCode" data-country="@address.Country">
                                        <i class="fa-solid fa-location-dot" aria-hidden="true"></i>@(address.Label ?? address.City)@(address.IsDefault ? " (default)" : "")
                                    </button>
                                }
                            </div>
                        </div>
                    }
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Input.FullName" class="form-label"></label>
                            <input asp-for="Input.FullName" class="form-control" autocomplete="name" />
                            <span asp-validation-for="Input.FullName"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Input.AddressLine" class="form-label"></label>
                            <input asp-for="Input.AddressLine" class="form-control" autocomplete="street-address" />
                            <span asp-validation-for="Input.AddressLine"></span>
                        </div>
                        <div class="col-md-5">
                            <label asp-for="Input.City" class="form-label"></label>
                            <input asp-for="Input.City" class="form-control" autocomplete="address-level2" />
                            <span asp-validation-for="Input.City"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.PostalCode" class="form-label"></label>
                            <input asp-for="Input.PostalCode" class="form-control" autocomplete="postal-code" />
                            <span asp-validation-for="Input.PostalCode"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.Country" class="form-label"></label>
                            <select asp-for="Input.Country" class="form-select" autocomplete="country-name">
                                @foreach (var country in new[] { "Kosovo", "Albania", "North Macedonia", "Montenegro" })
                                {
                                    <option value="@country">@country</option>
                                }
                            </select>
                            <span asp-validation-for="Input.Country"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Input.Comment" class="form-label"></label>
                            <textarea asp-for="Input.Comment" class="form-control" rows="2" maxlength="500" placeholder="e.g. delivery instructions"></textarea>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input asp-for="Input.SaveAddress" class="form-check-input" />
                                <label asp-for="Input.SaveAddress" class="form-check-label"></label>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="card-hs" aria-labelledby="shipping-title">
                    <h2 id="shipping-title">3. Delivery method</h2>
                    <fieldset>
                        <legend class="visually-hidden">Delivery method</legend>
                        @foreach (var method in Model.ShippingMethods)
                        {
                            var cost = store.ShippingCostFor(method, Math.Max(0, Model.Cart.Subtotal - Model.Cart.Discount));
                            <label class="option-card">
                                <input class="form-check-input" type="radio" name="Input.ShippingMethod" value="@method.Code"
                                       @(string.Equals(Model.Input.ShippingMethod, method.Code, StringComparison.OrdinalIgnoreCase) ? "checked" : "") data-shipping-method required />
                                <span class="grow">
                                    <strong class="d-block">@method.Name</strong>
                                    <span class="small text-muted">@method.EstimatedDays@(method.FreeOverThreshold && store.FreeShippingThreshold > 0 ? $" · free over {store.FormatPrice(store.FreeShippingThreshold)}" : "")</span>
                                </span>
                                <span class="cost">@(cost == 0 ? "Free" : store.FormatPrice(cost))</span>
                            </label>
                        }
                    </fieldset>
                    <span asp-validation-for="Input.ShippingMethod"></span>
                </section>

                <section class="card-hs" aria-labelledby="payment-title">
                    <h2 id="payment-title">4. Payment</h2>
                    <fieldset>
                        <legend class="visually-hidden">Payment method</legend>
                        @if (Model.CardProviderName != null)
                        {
                            <label class="option-card">
                                <input class="form-check-input" type="radio" name="Input.PaymentMethod" value="@PaymentMethods.Card" aria-describedby="card-help"
                                       @(Model.Input.PaymentMethod == PaymentMethods.Card ? "checked" : "") data-payment-method required />
                                <span class="grow">
                                    <strong class="d-block">
                                        <i class="fa-regular fa-credit-card me-2" aria-hidden="true"></i>@Model.CardProviderName
                                        @if (Model.CardTestMode)
                                        {
                                            <span class="status-badge status-Processing ms-1">Test mode</span>
                                        }
                                    </strong>
                                    <span class="small text-muted d-block" id="card-help">
                                        Visa, Mastercard and other debit or credit cards. You'll enter your card on the payment provider's secure page — HikingStore never sees or stores your card number.
                                        Your items are reserved for @Model.CardPaymentTimeoutMinutes minutes while you pay.
                                    </span>
                                    @if (Model.CardTestMode)
                                    {
                                        <span class="small d-block mt-1 fw-semibold">Test mode: no real money is charged. Use a provider test card.</span>
                                    }
                                </span>
                                <span class="cost" aria-hidden="true"><i class="fa-solid fa-lock"></i></span>
                            </label>
                        }
                        @if (Model.CashOnDeliveryAvailable)
                        {
                            <label class="option-card">
                                <input class="form-check-input" type="radio" name="Input.PaymentMethod" value="@PaymentMethods.CashOnDelivery" aria-describedby="cod-help"
                                       @(Model.Input.PaymentMethod != PaymentMethods.Card || Model.CardProviderName == null ? "checked" : "") data-payment-method required />
                                <span class="grow">
                                    <strong class="d-block"><i class="fa-solid fa-money-bill-wave me-2" aria-hidden="true"></i>Cash on delivery</strong>
                                    <span class="small text-muted" id="cod-help">Pay the courier in cash when your order arrives. Nothing is charged now.</span>
                                </span>
                            </label>
                        }
                    </fieldset>
                    <span asp-validation-for="Input.PaymentMethod"></span>
                    @if (!Model.HasPaymentMethod)
                    {
                        <p class="alert alert-warning mt-3 mb-0" role="alert">No payment method is available right now. Please contact us to place your order.</p>
                    }
                </section>
            </div>

            <aside class="sticky-summary" aria-labelledby="summary-title">
                <div class="card-hs beige">
                    <h2 id="summary-title">Order summary</h2>
                    <div data-checkout-summary aria-live="polite">
                        <partial name="_OrderSummary" model="Model.Cart" />
                    </div>
                    @{ var payByCard = Model.CardProviderName != null && (Model.Input.PaymentMethod == PaymentMethods.Card || !Model.CashOnDeliveryAvailable); }
                    <button type="submit" class="btn btn-primary btn-lg w-100 mt-2" data-checkout-submit
                            data-busy-text="@(payByCard ? "Opening secure payment…" : "Placing order…")"
                            data-label-card="Continue to secure payment" data-label-cod="Place order"
                            data-busy-card="Opening secure payment…" data-busy-cod="Placing order…"
                            @(Model.Cart.HasIssues || !Model.HasPaymentMethod ? "disabled" : "")>
                        @(payByCard ? "Continue to secure payment" : "Place order")
                    </button>
                    @if (Model.Cart.HasIssues)
                    {
                        <p class="small text-danger mt-2">Some items are no longer available. <a asp-action="Index">Review your cart</a>.</p>
                    }
                    <p class="small text-muted mt-3 mb-0">
                        By placing your order you agree to our <a asp-controller="Home" asp-action="Terms">terms</a> and
                        <a asp-controller="Home" asp-action="Privacy">privacy policy</a>.
                        <span data-pay-note="card" @(payByCard ? "" : "hidden")>You'll pay by card on a secure payment page; your order is confirmed once the payment provider confirms the payment.</span>
                        <span data-pay-note="cod" @(payByCard ? "hidden" : "")>You'll pay <strong>on delivery</strong>.</span>
                    </p>
                    <a class="d-inline-block small mt-3" asp-action="Index"><i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>Back to cart</a>
                </div>
            </aside>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const form = document.getElementById('checkout-form');
            const summary = document.querySelector('[data-checkout-summary]');
            form.querySelectorAll('[data-shipping-method]').forEach(radio => {
                radio.addEventListener('change', async () => {
                    try {
                        const response = await fetch('@Url.Action("CheckoutSummary")?shippingMethod=' + encodeURIComponent(radio.value));
                        if (response.ok) summary.innerHTML = await response.text();
                    } catch { /* the server recalculates totals on submit anyway */ }
                });
            });
            const submit = form.querySelector('[data-checkout-submit]');
            const syncPayment = () => {
                const selected = form.querySelector('[data-payment-method]:checked');
                const card = selected && selected.value === '@PaymentMethods.Card';
                submit.textContent = card ? submit.dataset.labelCard : submit.dataset.labelCod;
                submit.dataset.busyText = card ? submit.dataset.busyCard : submit.dataset.busyCod;
                form.querySelectorAll('[data-pay-note]').forEach(n => { n.hidden = n.dataset.payNote !== (card ? 'card' : 'cod'); });
            };
            form.querySelectorAll('[data-payment-method]').forEach(r => r.addEventListener('change', syncPayment));
            if (form.querySelector('[data-payment-method]')) syncPayment();
            const fields = {
                fullName: 'Input_FullName', phone: 'Input_PhoneNumber', address: 'Input_AddressLine',
                city: 'Input_City', postal: 'Input_PostalCode', country: 'Input_Country'
            };
            document.querySelectorAll('[data-fill-address]').forEach(btn => {
                btn.addEventListener('click', () => {
                    Object.entries(fields).forEach(([key, id]) => {
                        const el = document.getElementById(id);
                        if (el && btn.dataset[key] !== undefined) el.value = btn.dataset[key];
                    });
                    document.querySelectorAll('[data-fill-address]').forEach(b => b.classList.toggle('active', b === btn));
                    const save = document.getElementById('Input_SaveAddress');
                    if (save) save.checked = false;
                });
            });
        })();
    </script>
}
