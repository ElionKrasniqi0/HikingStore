@model ShoppingCartDetails
@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery antiforgery
@{
    var tokenSet = antiforgery.GetAndStoreTokens(Context);
}
<div class="container py-5">
    <div class="row">
        <div class="col-12">
            <h1 class="h2 fw-bold mb-4">Shopping Cart</h1>
        </div>
    </div>

    @if (Model.IsEmpty)
    {
        <div class="text-center py-5">
            <div class="empty-cart-icon mb-4">
                <i class="fas fa-shopping-cart fa-4x text-muted"></i>
            </div>
            <h3 class="text-muted mb-3">Your cart is empty</h3>
            <p class="text-muted mb-4">Start shopping to add items to your cart</p>
            <a href="/Home/Product" class="btn btn-primary btn-lg">
                <i class="fas fa-shopping-bag me-2"></i>Start Shopping
            </a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">Cart Items (@Model.Carts.Sum(c => c.Qty) items)</h5>
                    </div>
                    <div class="card-body p-0">
                        @foreach (var item in Model.Carts)
                        {
                            <div class="cart-item p-4 border-bottom">
                                <div class="row align-items-center">
                                    <div class="col-md-2">
                                        <img src="~/Product/@item.Product.ProImage" alt="@item.Product.ProName"
                                             class="img-fluid rounded" style="height: 80px; object-fit: cover;">
                                    </div>
                                    <div class="col-md-4">
                                        <h6 class="mb-1">@item.Product.ProName</h6>
                                        <small class="text-muted">@item.Product.Category?.CatName</small>
                                    </div>
                                    <div class="col-md-2">
                                        <span class="fw-bold text-primary">€@item.Product.Price.ToString("N2")</span>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="input-group input-group-sm">
                                            <input type="number" class="form-control" value="@item.Qty" min="1"
                                                   onchange="updateCartItem(@item.CartId, this.value)">
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <span class="fw-bold">€@((item.Product.Price * item.Qty).ToString("N2"))</span>
                                        <button class="btn btn-sm btn-outline-danger ms-2"
                                                onclick="removeCartItem(@item.CartId)">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="mt-4">
                    <a href="/Home/Product" class="btn btn-outline-primary">
                        <i class="fas fa-arrow-left me-2"></i>Continue Shopping
                    </a>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm sticky-top" style="top: 20px;">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">Order Summary</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal:</span>
                            <span>€@Model.TotalAmount.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Shipping:</span>
                            <span class="text-success">FREE</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tax:</span>
                            <span>€0.00</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-4">
                            <strong>Total:</strong>
                            <strong class="text-primary h5">€@Model.TotalAmount.ToString("N2")</strong>
                        </div>

                        <a href="/Carts/Checkout" class="btn btn-primary btn-lg w-100 mb-3">
                            <i class="fas fa-lock me-2"></i>Proceed to Checkout
                        </a>

                        <div class="text-center">
                            <small class="text-muted">
                                <i class="fas fa-lock me-1"></i>
                                Secure checkout
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<script>
    function updateCartItem(cartId, quantity) {
        if (quantity < 1) {
            removeCartItem(cartId);
            return;
        }

        $.post('/Carts/UpdateCartItem', { cartId: cartId, quantity: quantity })
            .done(function() {
                location.reload();
            })
            .fail(function() {
                alert('Error updating cart item');
            });
    }

    function removeCartItem(cartId) {
        if (confirm('Are you sure you want to remove this item from your cart?')) {
            $.post('/Carts/RemoveFromCart', { cartId: cartId })
                .done(function() {
                    location.reload();
                })
                .fail(function() {
                    alert('Error removing item from cart');
                });
        }
    }
</script>
