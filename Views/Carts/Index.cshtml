@model ShoppingCartDetails
@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery antiforgery
@{
    var tokenSet = antiforgery.GetAndStoreTokens(Context);
}
<br />
<br />
<div class="hero">
    <div class="container">
        <div class="row justify-content-between">
            <div class="col-lg-5">
                <div class="intro-excerpt">
                    <h1>Shopping Cart</h1>
                    <p class="text-muted">Review your items and proceed to checkout</p>
                </div>
            </div>
            @if (!Model.IsEmpty)
            {
                <div class="col-lg-7">
                    <!-- Steps indicator -->
                    <div class="checkout-steps d-flex justify-content-end">
                        <div class="step active">
                            <div class="step-number">1</div>
                            <div class="step-label">Cart</div>
                        </div>
                        <div class="step">
                            <div class="step-number">2</div>
                            <div class="step-label">Details</div>
                        </div>
                        <div class="step">
                            <div class="step-number">3</div>
                            <div class="step-label">Payment</div>
                        </div>
                        <div class="step">
                            <div class="step-number">4</div>
                            <div class="step-label">Complete</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<div class="container py-5">
    <div class="row">
        <div class="col-12">

    @if (Model.IsEmpty)
    {
        <div class="text-center py-5">
            <div class="empty-cart-icon mb-4">
                <i class="fas fa-shopping-cart fa-4x text-muted"></i>
            </div>
            <h3 class="text-muted mb-3">Your cart is empty</h3>
            <p class="text-muted mb-4">Start shopping to add items to your cart</p>
            <a href="/Home/Product" class="btn btn-primary btn-lg">
                <i class="fas fa-shopping-bag me-2"></i>Start Shopping
            </a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">Cart Items (@Model.Carts.Sum(c => c.Qty) items)</h5>
                    </div>
                    <div class="card-body p-0">
                        @foreach (var item in Model.Carts)
                        {
                            <div class="cart-item p-4 border-bottom">
                                <div class="row align-items-center">
                                    <div class="col-md-2">
                                        <img src="~/Product/@item.Product.ProImage" alt="@item.Product.ProName"
                                             class="img-fluid rounded" style="height: 80px; object-fit: cover;">
                                    </div>
                                    <div class="col-md-4">
                                        <h6 class="mb-1">@item.Product.ProName</h6>
                                        <small class="text-muted">@item.Product.Category?.CatName</small>
                                    </div>
                                    <div class="col-md-2">
                                        <span class="fw-bold text-primary">€@item.Product.Price.ToString("N2")</span>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="input-group input-group-sm">
                                            <input type="number" class="form-control" value="@item.Qty" min="1"
                                                   onchange="updateCartItem(@item.CartId, this.value)">
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <span class="fw-bold">€@((item.Product.Price * item.Qty).ToString("N2"))</span>
                                        <button class="btn btn-sm btn-outline-danger ms-2"
                                                onclick="removeCartItem(@item.CartId)">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="mt-4">
                    <a href="/Home/Product" class="btn btn-outline-primary">
                        <i class="fas fa-arrow-left me-2"></i>Continue Shopping
                    </a>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm sticky-top" style="top: 20px;">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">Order Summary</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal:</span>
                            <span>€@Model.TotalAmount.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Shipping:</span>
                            <span class="text-success">FREE</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tax:</span>
                            <span>€0.00</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-4">
                            <strong>Total:</strong>
                            <strong class="text-primary h5">€@Model.TotalAmount.ToString("N2")</strong>
                        </div>

                        <a href="/Carts/Checkout" class="btn btn-primary btn-lg w-100 mb-3">
                            <i class="fas fa-lock me-2"></i>Proceed to Checkout
                        </a>

                        <div class="text-center">
                            <small class="text-muted">
                                <i class="fas fa-lock me-1"></i>
                                Secure checkout
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    /* Checkout Steps */
    .checkout-steps {
        gap: 2rem;
    }

    .step {
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        cursor: default;
    }

        .step:not(:last-child):after {
            content: '';
            position: absolute;
            top: 20px;
            left: 60px;
            width: 60px;
            height: 2px;
            background: #dee2e6;
            transition: background 0.3s ease;
        }

        .step.active:not(:last-child):after,
        .step.completed:not(:last-child):after {
            background: #3b5d50;
        }

    .step-number {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #dee2e6;
        color: #6c757d;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        margin-bottom: 0.5rem;
        transition: all 0.3s ease;
        font-size: 0.9rem;
    }

    .step.active .step-number {
        background: #3b5d50;
        color: white;
        box-shadow: 0 4px 12px rgba(59, 93, 80, 0.3);
        transform: scale(1.1);
    }

    .step.completed .step-number {
        background: #28a745;
        color: white;
        box-shadow: 0 4px 12px rgba(40, 167, 69, 0.3);
    }

    .step.completed .step-number i {
        font-size: 0.875rem;
    }

    .step-label {
        font-size: 0.875rem;
        color: #6c757d;
        font-weight: 500;
        transition: all 0.3s ease;
    }

    .step.active .step-label {
        color: #3b5d50;
        font-weight: 600;
    }

    .step.completed .step-label {
        color: #28a745;
        font-weight: 600;
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .checkout-steps {
            gap: 1rem;
            margin-top: 1rem;
        }

        .step:not(:last-child):after {
            width: 30px;
            left: 45px;
        }

        .step-number {
            width: 35px;
            height: 35px;
            font-size: 0.875rem;
        }
    }

    @@media (max-width: 576px) {
        .step:not(:last-child):after {
            display: none;
        }

        .checkout-steps {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.5rem;
        }

        .step {
            flex-direction: row;
            width: 100%;
        }

        .step-number {
            margin-right: 1rem;
            margin-bottom: 0;
        }
    }
</style>

<script>
    function updateCartItem(cartId, quantity) {
        if (quantity < 1) {
            removeCartItem(cartId);
            return;
        }

        $.post('/Carts/UpdateCartItem', { cartId: cartId, quantity: quantity })
            .done(function() {
                location.reload();
            })
            .fail(function() {
                alert('Error updating cart item');
            });
    }

    function removeCartItem(cartId) {
        if (confirm('Are you sure you want to remove this item from your cart?')) {
            $.post('/Carts/RemoveFromCart', { cartId: cartId })
                .done(function() {
                    location.reload();
                })
                .fail(function() {
                    alert('Error removing item from cart');
                });
        }
    }
</script>
