@model CartSummary
@inject IOptions<StoreSettings> StoreOptions
@{
    var store = StoreOptions.Value;
    ViewData["Title"] = "Your cart";
    ViewData["NoIndex"] = true;
    var signedIn = User.Identity?.IsAuthenticated == true;
}

<div class="container-hs">
    <div class="page-head">
        <h1>Your cart @if (!Model.IsEmpty) { <span class="text-muted fs-5 fw-normal">(@Model.ItemCount @(Model.ItemCount == 1 ? "item" : "items"))</span> }</h1>
    </div>

    @if (Model.IsEmpty)
    {
        <div class="empty-state">
            <i class="fa-solid fa-bag-shopping" aria-hidden="true"></i>
            <h2>Your cart is empty</h2>
            <p>Find something for your next trip — new arrivals land every week.</p>
            <a class="btn btn-primary" asp-controller="Home" asp-action="Shop">Start shopping</a>
        </div>
    }
    else
    {
        <div class="two-col">
            <section aria-label="Cart items">
                @if (Model.HasIssues)
                {
                    <div class="alert alert-warning" role="alert">
                        <i class="fa-solid fa-triangle-exclamation me-2" aria-hidden="true"></i>Some items need your attention before you can check out.
                    </div>
                }
                <div class="card-hs">
                    @foreach (var line in Model.Lines)
                    {
                        <div class="cart-line @(line.Issue != null ? "has-issue" : "")">
                            <a class="thumb" asp-controller="Home" asp-action="ProductDetailes" asp-route-id="@line.ProId" tabindex="-1" aria-hidden="true">
                                @if (!string.IsNullOrEmpty(line.Image))
                                {
                                    <img src="~/Product/@line.Image" alt="" loading="lazy" width="96" height="96" />
                                }
                            </a>
                            <div class="min-w-0">
                                @if (!string.IsNullOrEmpty(line.Brand))
                                {
                                    <div class="p-brand">@line.Brand</div>
                                }
                                <a class="name" asp-controller="Home" asp-action="ProductDetailes" asp-route-id="@line.ProId">@line.Name</a>
                                @if (!string.IsNullOrEmpty(line.Size) || !string.IsNullOrEmpty(line.Color))
                                {
                                    <div class="variant">@string.Join(" · ", new[] { line.Color, line.Size is null ? null : $"Size {line.Size}" }.Where(v => !string.IsNullOrEmpty(v)))</div>
                                }
                                <div class="price small mt-1">
                                    <span class="now @(line.CompareAtPrice > line.UnitPrice ? "on-sale" : "")">@store.FormatPrice(line.UnitPrice)</span>
                                    @if (line.CompareAtPrice > line.UnitPrice)
                                    {
                                        <span class="was">@store.FormatPrice(line.CompareAtPrice.Value)</span>
                                    }
                                </div>
                                @if (line.Issue != null)
                                {
                                    <p class="small text-danger mt-1 mb-0"><i class="fa-solid fa-circle-exclamation me-1" aria-hidden="true"></i>@line.Issue</p>
                                }
                                <div class="d-flex flex-wrap align-items-center gap-3 mt-2">
                                    @if (line.IsAvailable || line.AvailableStock > 0)
                                    {
                                        <form method="post" asp-action="UpdateCartItem" class="d-flex align-items-center gap-2">
                                            <input type="hidden" name="lineKey" value="@line.LineKey" />
                                            <div class="qty-stepper sm">
                                                <button type="button" data-step="-1" aria-label="Decrease quantity of @line.Name"><i class="fa-solid fa-minus" aria-hidden="true"></i></button>
                                                <label class="visually-hidden" for="qty-@line.LineKey">Quantity of @line.Name</label>
                                                <input id="qty-@line.LineKey" type="number" name="quantity" value="@line.Quantity" min="1"
                                                       max="@Math.Max(1, Math.Min(line.AvailableStock, CartService.MaxQuantityPerLine))" inputmode="numeric" data-auto-submit />
                                                <button type="button" data-step="1" aria-label="Increase quantity of @line.Name"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
                                            </div>
                                            <noscript><button type="submit" class="btn btn-sm btn-outline-secondary">Update</button></noscript>
                                        </form>
                                    }
                                    <form method="post" asp-action="RemoveFromCart">
                                        <input type="hidden" name="lineKey" value="@line.LineKey" />
                                        <button type="submit" class="link-btn">Remove</button>
                                    </form>
                                </div>
                            </div>
                            <div class="line-total">@store.FormatPrice(line.LineTotal)</div>
                        </div>
                    }
                    <div class="d-flex justify-content-between flex-wrap gap-2 mt-3">
                        <a asp-controller="Home" asp-action="Shop"><i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>Continue shopping</a>
                        <form method="post" asp-action="RemoveAll" data-confirm="Remove all items from your cart?">
                            <button type="submit" class="link-btn">Empty cart</button>
                        </form>
                    </div>
                </div>
            </section>

            <aside class="sticky-summary" aria-label="Order summary">
                <div class="card-hs beige">
                    <h2>Order summary</h2>
                    @if (store.FreeShippingThreshold > 0)
                    {
                        var progress = (int)Math.Min(100, Math.Round(100 * (Model.Subtotal - Model.Discount) / store.FreeShippingThreshold));
                        <div class="free-ship-meter">
                            @if (Model.AmountUntilFreeShipping > 0)
                            {
                                <span>Add <strong>@store.FormatPrice(Model.AmountUntilFreeShipping)</strong> more for free standard shipping.</span>
                            }
                            else
                            {
                                <span><i class="fa-solid fa-circle-check text-success me-1" aria-hidden="true"></i>You've unlocked free standard shipping.</span>
                            }
                            <div class="bar" role="progressbar" aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100" aria-label="Progress to free shipping"><span style="width:@progress%"></span></div>
                        </div>
                    }

                    <partial name="_SummaryRows" model="Model" />

                    <div class="mb-3">
                        @if (!string.IsNullOrEmpty(Model.CouponCode) && Model.CouponError == null)
                        {
                            <form method="post" asp-action="RemoveCoupon" class="d-flex justify-content-between align-items-center small">
                                <span><i class="fa-solid fa-tag me-1" aria-hidden="true"></i><strong>@Model.CouponCode</strong> @Model.CouponDescription</span>
                                <button type="submit" class="link-btn">Remove</button>
                            </form>
                        }
                        else if (signedIn)
                        {
                            <form method="post" asp-action="ApplyCoupon" class="d-flex gap-2">
                                <label for="coupon" class="visually-hidden">Coupon code</label>
                                <input id="coupon" name="code" class="form-control" placeholder="Coupon code" maxlength="40" autocomplete="off" required />
                                <button type="submit" class="btn btn-outline-primary">Apply</button>
                            </form>
                            @if (Model.CouponError != null)
                            {
                                <p class="small text-danger mt-1 mb-0">@Model.CouponError</p>
                            }
                        }
                        else
                        {
                            <p class="small text-muted m-0">Have a coupon? <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="/Carts">Sign in</a> to apply it.</p>
                        }
                    </div>

                    @if (Model.HasIssues)
                    {
                        <button class="btn btn-primary btn-lg w-100" disabled>Checkout</button>
                        <p class="small text-muted mt-2 mb-0">Resolve the highlighted items to continue.</p>
                    }
                    else if (signedIn)
                    {
                        <a class="btn btn-primary btn-lg w-100" asp-action="Checkout">Checkout</a>
                    }
                    else
                    {
                        <a class="btn btn-primary btn-lg w-100" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="/Carts/Checkout">Sign in to check out</a>
                        <p class="small text-muted mt-2 mb-0">Your cart is kept when you sign in or <a asp-area="Identity" asp-page="/Account/Register" asp-route-returnUrl="/Carts/Checkout">create an account</a>.</p>
                    }

                    <ul class="trust-list">
                        <li><i class="fa-solid fa-money-bill-wave" aria-hidden="true"></i>Pay with cash on delivery</li>
                        <li><i class="fa-solid fa-rotate-left" aria-hidden="true"></i>@store.ReturnDays-day returns</li>
                    </ul>
                </div>
            </aside>
        </div>
    }
</div>
