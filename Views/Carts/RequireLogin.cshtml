@{
    ViewData["Title"] = "Login Required";
    var hasItems = ViewBag.HasSessionCart == true;
    var cartCount = ViewBag.SessionCartCount ?? 0;
}

<div class="container py-5 my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-gradient-primary text-white text-center py-4 border-0">
                    <div class="icon-wrapper bg-opacity-20 rounded-circle p-3 mx-auto mb-3">
                        <i class="fas fa-shopping-cart fa-lg text-white"></i>
                    </div>
                    <h2 class="h4 fw-bold mb-2">Login Required</h2>
                    <p class="mb-0 opacity-75">
                        @if (hasItems)
                        {
                            <span>Please log in to view your cart and proceed to checkout</span>
                        }
                        else
                        {
                            <span>Please log in to access your shopping cart</span>
                        }
                    </p>
                </div>
                <div class="card-body p-4">
                    @if (hasItems)
                    {
                        <div class="alert alert-info mb-4">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>You have @cartCount item(s) in your cart.</strong> 
                            Please log in to view your cart and continue with checkout.
                        </div>
                    }
                    
                    <div class="text-center mb-4">
                        <i class="fas fa-lock fa-3x text-primary mb-3"></i>
                        <h4 class="mb-3">Access to Shopping Cart</h4>
                        <p class="text-muted">
                            @if (hasItems)
                            {
                                <span>Log in to view your cart items and proceed to checkout.</span>
                            }
                            else
                            {
                                <span>You need to be logged in to add items to your cart and proceed to checkout.</span>
                            }
                        </p>
                    </div>

                    <div class="d-grid gap-3 mb-4">
                        <a asp-area="Identity" asp-page="/Account/Login"
                           asp-route-returnUrl="/Carts"
                           class="btn btn-primary btn-lg py-3">
                            <i class="fas fa-sign-in-alt me-2"></i>Log In to Continue
                        </a>

                        <a asp-area="Identity" asp-page="/Account/Register"
                           asp-route-returnUrl="/Carts"
                           class="btn btn-outline-primary btn-lg py-3">
                            <i class="fas fa-user-plus me-2"></i>Create New Account
                        </a>
                    </div>

                    <div class="border-top pt-4 mt-4 text-center">
                        <p class="text-muted small mb-2">Continue shopping as guest?</p>
                        <a href="/Home/Product" class="btn btn-outline-secondary">
                            <i class="fas fa-shopping-bag me-2"></i>Browse Products
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-gradient-primary {
        background: linear-gradient(135deg, #2d473d 0%, #3b5d50 50%, #4a7565 100%);
    }

    .icon-wrapper {
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>