@model Order
@inject IOptions<StoreSettings> StoreOptions
@{
    var store = StoreOptions.Value;
    ViewData["Title"] = $"Order {Model.OrderNumber} confirmed";
    ViewData["NoIndex"] = true;
    var isPickup = store.ShippingMethods.Any(m => m.Code == "pickup" && m.Name == Model.ShippingService);
    var paidByCard = Model.IsCardPayment && Model.PaymentStatus == PaymentStatuses.Paid;
}

<div class="container-hs" style="max-width:860px">
    <ol class="checkout-steps mt-4" aria-label="Checkout progress">
        <li class="done"><span class="n"><i class="fa-solid fa-check" aria-hidden="true"></i></span>Cart</li>
        <li class="done"><span class="n"><i class="fa-solid fa-check" aria-hidden="true"></i></span>Details &amp; delivery</li>
        <li class="current" aria-current="step"><span class="n">3</span>Confirmation</li>
    </ol>

    <div class="card-hs text-center py-5 mb-4">
        <i class="fa-solid fa-circle-check fa-3x mb-3" style="color:var(--hs-forest)" aria-hidden="true"></i>
        <h1 class="h2">Thank you, your order is placed</h1>
        <p class="m-0">Order number <strong>#@Model.OrderNumber</strong> · @Model.OrderDate.ToString("d MMM yyyy, HH:mm") UTC</p>
        <p class="text-muted mt-2 mb-0">
            We've sent a confirmation to <strong>@Model.Email</strong>.
            @if (paidByCard)
            {
                <text>Your card payment of <strong>@store.FormatPrice(Model.PaidAmount ?? Model.TotalAmount)</strong> was confirmed by the payment provider.</text>
            }
            else if (isPickup)
            {
                <text>Please have <strong>@store.FormatPrice(Model.TotalAmount)</strong> ready to pay when you collect your order.</text>
            }
            else
            {
                <text>Please have <strong>@store.FormatPrice(Model.TotalAmount)</strong> ready to pay the courier on delivery.</text>
            }
        </p>
        <div class="d-flex flex-wrap justify-content-center gap-2 mt-4">
            <a class="btn btn-primary" asp-controller="Orders" asp-action="Details" asp-route-id="@Model.OrderId">Track this order</a>
            <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Shop">Continue shopping</a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-7">
            <section class="card-hs h-100" aria-labelledby="items-title">
                <h2 id="items-title" class="h5">Items</h2>
                @foreach (var line in Model.OrderDetails)
                {
                    <div class="summary-line">
                        <div class="thumb">
                            @if (!string.IsNullOrEmpty(line.Product?.ProImage))
                            {
                                <img src="~/Product/@line.Product.ProImage" alt="" loading="lazy" />
                            }
                            <span class="qty-pill">×@line.Quantity</span>
                        </div>
                        <div class="min-w-0">
                            <span class="d-block fw-semibold">@line.DisplayName</span>
                            @if (!string.IsNullOrEmpty(line.SelectedSize) || !string.IsNullOrEmpty(line.SelectedColor))
                            {
                                <span class="text-muted">@string.Join(" · ", new[] { line.SelectedColor, line.SelectedSize }.Where(v => !string.IsNullOrEmpty(v)))</span>
                            }
                        </div>
                        <span>@store.FormatPrice(line.LineTotal)</span>
                    </div>
                }
                <hr />
                <ul class="summary-rows m-0">
                    <li><span>Subtotal</span><span>@store.FormatPrice(Model.Subtotal)</span></li>
                    @if (Model.DiscountAmount > 0)
                    {
                        <li class="discount"><span>Discount (@Model.CouponCode)</span><span>−@store.FormatPrice(Model.DiscountAmount)</span></li>
                    }
                    <li><span>Shipping (@Model.ShippingService)</span><span>@(Model.ShippingCost == 0 ? "Free" : store.FormatPrice(Model.ShippingCost))</span></li>
                    <li class="total"><span>@(paidByCard ? "Total paid" : isPickup ? "Total to pay at pickup" : "Total to pay on delivery")</span><span>@store.FormatPrice(Model.TotalAmount)</span></li>
                </ul>
            </section>
        </div>
        <div class="col-md-5">
            <section class="card-hs h-100" aria-labelledby="ship-title">
                <h2 id="ship-title" class="h5">@(isPickup ? "Pickup" : "Delivery")</h2>
                @if (isPickup)
                {
                    <address class="mb-3">
                        <strong>@store.Name</strong><br />
                        @store.Address
                        @foreach (var hours in store.OpeningHours)
                        {
                            <br />@hours
                        }
                    </address>
                    <p class="small text-muted">Contact: @Model.FullName · @Model.PhoneNumber</p>
                }
                else
                {
                    <address class="mb-3">
                        <strong>@Model.FullName</strong><br />
                        @Model.ShippingAddress<br />
                        @Model.PostalCode @Model.City<br />
                        @Model.Country<br />
                        @Model.PhoneNumber
                    </address>
                }
                <h3 class="h6">Payment</h3>
                <p class="mb-3">@PaymentMethods.DisplayName(Model.PaymentMethod) · @Model.PaymentStatusLabel</p>
                <h3 class="h6">What happens next</h3>
                <ol class="small text-muted ps-3 m-0">
                    @if (isPickup)
                    {
                        <li>We confirm your order and get it ready at the store.</li>
                        <li>We email you each time the order status changes, so you know when to come in.</li>
                        <li>@(paidByCard ? "Bring your order number when you collect it — it's already paid." : "Bring your order number and pay when you collect it.")</li>
                    }
                    else
                    {
                        <li>We confirm your order and prepare it for shipping.</li>
                        <li>You get an email when it ships, with a tracking number.</li>
                        <li>@(paidByCard ? "Your order is paid — nothing is due on delivery." : "Pay the courier when your parcel arrives.")</li>
                    }
                </ol>
            </section>
        </div>
    </div>
</div>
