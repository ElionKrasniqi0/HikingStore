@model List<Wishlist>
@using HikingStore.Models
@using Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<style>
    .wishlist-product-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border-radius: 12px;
        overflow: hidden;
    }

    .wishlist-product-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15) !important;
    }

    .wishlist-image-container {
        position: relative;
        width: 100%;
        height: 200px;
        background: #f8f9fa;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .wishlist-product-image {
        width: 100%;
        height: 100%;
        object-fit: contain;
        object-position: center;
        padding: 10px;
        transition: transform 0.3s ease;
        background: white;
    }

    .wishlist-product-card:hover .wishlist-product-image {
        transform: scale(1.05);
    }

    .wishlist-remove-btn {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
        transition: all 0.3s ease;
        font-size: 0.875rem;
    }

    .wishlist-remove-btn:hover {
        transform: scale(1.1);
        box-shadow: 0 4px 12px rgba(220, 53, 69, 0.4);
    }

    .wishlist-card-body {
        padding: 1rem;
    }

    .wishlist-product-title {
        font-size: 0.95rem;
        font-weight: 600;
        margin-bottom: 0.4rem;
        color: #2f2f2f;
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .wishlist-product-category {
        font-size: 0.8rem;
        color: #6c757d;
        margin-bottom: 0.4rem;
    }

    .wishlist-product-description {
        font-size: 0.8rem;
        color: #6c757d;
        line-height: 1.4;
        margin-bottom: 0.75rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .wishlist-price {
        font-size: 1.25rem;
        font-weight: 700;
        color: #3b5d50;
    }

    .wishlist-card-footer {
        background: #f8f9fa;
        border-top: 1px solid #e9ecef;
        padding: 0.5rem 1rem;
    }

    .wishlist-card-footer small {
        font-size: 0.75rem;
    }

    .wishlist-product-card .btn {
        font-size: 0.875rem;
        padding: 0.5rem 0.75rem;
    }

    .wishlist-product-card .badge {
        font-size: 0.75rem;
        padding: 0.35rem 0.65rem;
    }

    @@media (max-width: 768px) {
        .wishlist-image-container {
            height: 180px;
        }
    }

    /* Cart update animation */
    .cart-updated {
        animation: cartBounce 0.6s ease;
    }

    @@keyframes cartBounce {
        0%, 100% {
            transform: scale(1);
        }
        25% {
            transform: scale(1.1) rotate(-5deg);
        }
        50% {
            transform: scale(1.15) rotate(5deg);
        }
        75% {
            transform: scale(1.05) rotate(-2deg);
        }
    }
</style>

<div class="container py-5">
    <div class="row">
        <div class="col-12">
            <h1 class="h2 fw-bold mb-4">My Wishlist</h1>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5">
            <div class="empty-wishlist-icon mb-4">
                <i class="far fa-heart fa-4x text-muted"></i>
            </div>
            <h3 class="text-muted mb-3">Your wishlist is empty</h3>
            <p class="text-muted mb-4">Start adding products to your wishlist</p>
            <a href="/Home/Product" class="btn btn-primary btn-lg">
                <i class="fas fa-shopping-bag me-2"></i>Start Shopping
            </a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card border-0 shadow-sm h-100 wishlist-product-card">
                        <div class="wishlist-image-container">
                            <a href="/Home/ProductDetailes/@item.Product.ProId" class="w-100 h-100 d-block">
                                <img src="~/Product/@item.Product.ProImage" 
                                     alt="@item.Product.ProName"
                                     class="wishlist-product-image"
                                     loading="lazy">
                            </a>
                            <button class="btn btn-sm btn-danger position-absolute top-0 end-0 m-2 wishlist-remove-btn remove-wishlist-btn"
                                    data-product-id="@item.Product.ProId" 
                                    title="Remove from wishlist"
                                    type="button">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                        <div class="card-body d-flex flex-column wishlist-card-body">
                            <h5 class="wishlist-product-title">@item.Product.ProName</h5>
                            <p class="wishlist-product-category">
                                <i class="fas fa-tag me-1"></i>@item.Product.Category?.CatName
                            </p>
                            @if (!string.IsNullOrEmpty(item.Product.Descreption))
                            {
                                <p class="wishlist-product-description">
                                    @item.Product.Descreption
                                </p>
                            }
                            <div class="mt-auto">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="wishlist-price">€@item.Product.Price.ToString("N2")</span>
                                    @if (item.Product.IsInStock)
                                    {
                                        <span class="badge bg-success px-3 py-2">
                                            <i class="fas fa-check-circle me-1"></i>In Stock
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger px-3 py-2">
                                            <i class="fas fa-times-circle me-1"></i>Out of Stock
                                        </span>
                                    }
                                </div>
                                <div class="d-grid gap-2">
                                    <a href="/Home/ProductDetailes/@item.Product.ProId" class="btn btn-outline-primary">
                                        <i class="fas fa-eye me-2"></i>View Details
                                    </a>
                                    @if (item.Product.IsInStock)
                                    {
                                        <button class="btn btn-primary add-to-cart-btn" data-product-id="@item.Product.ProId">
                                            <i class="fas fa-shopping-cart me-2"></i>Add to Cart
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="card-footer wishlist-card-footer">
                            <small class="text-muted">
                                <i class="far fa-clock me-1"></i>
                                Added @item.AddedDate.ToString("MMM dd, yyyy")
                            </small>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function() {
        // Remove from wishlist
        $('.remove-wishlist-btn').click(function(e) {
            e.preventDefault();
            var btn = $(this);
            var productId = btn.data('product-id');
            
            if (confirm('Are you sure you want to remove this item from your wishlist?')) {
                $.ajax({
                    url: '/Wishlist/RemoveFromWishlist',
                    type: 'POST',
                    data: { productId: productId },
                    success: function(response) {
                        if (response.success) {
                            btn.closest('.col-md-6').fadeOut(300, function() {
                                $(this).remove();
                                // Check if wishlist is now empty
                                if ($('.remove-wishlist-btn').length === 0) {
                                    location.reload();
                                }
                            });
                            showNotification(response.message, 'success');
                        } else {
                            showNotification(response.message, 'error');
                        }
                    },
                    error: function() {
                        showNotification('Error removing item from wishlist', 'error');
                    }
                });
            }
        });

        // Add to cart
        $('.add-to-cart-btn').click(function(e) {
            e.preventDefault();
            var btn = $(this);
            var productId = btn.data('product-id');
            
            $.ajax({
                url: '/Carts/AddToCart',
                type: 'POST',
                data: { ProId: productId, qty: 1 },
                success: function(response) {
                    if (response.success) {
                        showNotification(response.message || 'Added to cart successfully', 'success');
                        updateCartCount();
                    } else {
                        showNotification(response.message || 'Failed to add to cart', 'error');
                    }
                },
                error: function() {
                    showNotification('Error adding to cart', 'error');
                }
            });
        });

        function showNotification(message, type) {
            var toast = $('<div class="toast align-items-center text-white bg-' + type + ' border-0 position-fixed bottom-0 end-0 m-3" style="z-index: 1060;">' +
                '<div class="d-flex">' +
                '<div class="toast-body">' + message + '</div>' +
                '<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>' +
                '</div>' +
                '</div>');
            $('body').append(toast);
            var bsToast = new bootstrap.Toast(toast[0]);
            bsToast.show();
            toast.on('hidden.bs.toast', function() {
                toast.remove();
            });
        }

        function updateCartCount() {
            $.ajax({
                url: '/Carts/GetCartCount',
                type: 'GET',
                success: function(response) {
                    var count = response.count || 0;
                    
                    // Update all cart count elements
                    $('.cart-count').each(function() {
                        $(this).text(count);
                    });
                    
                    // Update cart items count text if exists
                    $('.cart-items-count').each(function() {
                        if (count > 0) {
                            $(this).text(count + (count === 1 ? ' item' : ' items')).removeClass('empty');
                        } else {
                            $(this).text('Empty').addClass('empty');
                        }
                    });
                    
                    // Update cart badge visibility and structure
                    $('.cart-badge').each(function() {
                        if (count > 0) {
                            $(this).removeClass('empty').show();
                            // Ensure badge has pulse if count > 0
                            if ($(this).find('.cart-pulse').length === 0) {
                                $(this).append('<div class="cart-pulse"></div>');
                            }
                            // Show cart preview indicator if exists
                            $(this).siblings('.cart-preview-indicator').show();
                            // Add new item animation
                            $(this).addClass('new-item');
                            setTimeout(function() {
                                $('.cart-badge').removeClass('new-item');
                            }, 600);
                        } else {
                            $(this).addClass('empty');
                            // Hide cart preview indicator if exists
                            $(this).siblings('.cart-preview-indicator').hide();
                            // Remove pulse if exists
                            $(this).find('.cart-pulse').remove();
                        }
                    });
                    
                    // Update cart preview count if exists
                    $('.cart-preview-count').each(function() {
                        $(this).text(count + (count === 1 ? ' item' : ' items'));
                    });
                    
                    // Trigger a small animation on cart icon
                    $('.cart-icon-main').each(function() {
                        $(this).addClass('cart-updated');
                        setTimeout(function() {
                            $('.cart-icon-main').removeClass('cart-updated');
                        }, 600);
                    });
                },
                error: function(xhr, status, error) {
                    console.error('Error updating cart count:', error);
                    // Fallback: reload page after a short delay to ensure cart count is updated
                    setTimeout(function() {
                        // Only reload if we're still on the wishlist page
                        if (window.location.pathname.includes('/Wishlist')) {
                            window.location.reload();
                        }
                    }, 1000);
                }
            });
        }
    });
</script>
