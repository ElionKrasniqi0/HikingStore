@model List<ProductCardModel>
@{
    ViewData["Title"] = "My wishlist";
    ViewData["NoIndex"] = true;
    ViewData["AccountSection"] = "wishlist";
}

<div class="container-hs">
    <div class="page-head"><h1>My wishlist <span class="text-muted fs-5 fw-normal">(@Model.Count)</span></h1></div>
    <div class="account-layout">
        <partial name="_AccountNav" />
        <section aria-label="Saved products">
            @if (Model.Count == 0)
            {
                <div class="empty-state card-hs">
                    <i class="fa-regular fa-heart" aria-hidden="true"></i>
                    <h2>Nothing saved yet</h2>
                    <p>Tap the heart on any product to save it here for later.</p>
                    <a class="btn btn-primary" asp-controller="Home" asp-action="Shop">Browse gear</a>
                </div>
            }
            else
            {
                <div class="product-grid" style="grid-template-columns:repeat(auto-fill,minmax(180px,1fr))">
                    @foreach (var card in Model)
                    {
                        <div class="d-flex flex-column gap-2">
                            <partial name="_ProductCard" model="card" view-data='new ViewDataDictionary(ViewData) { ["RemoveOnUnsave"] = true }' />
                            @if (card.Product.IsInStock && card.Product.SizeOptions.Count == 0 && card.Product.ColorOptions.Count <= 1)
                            {
                                <form method="post" asp-controller="Carts" asp-action="AddToCart" data-add-to-cart>
                                    <input type="hidden" name="proId" value="@card.Product.ProId" />
                                    <input type="hidden" name="qty" value="1" />
                                    @if (card.Product.ColorOptions.Count == 1)
                                    {
                                        <input type="hidden" name="color" value="@card.Product.ColorOptions[0]" />
                                    }
                                    <button type="submit" class="btn btn-sm btn-primary w-100" data-busy-text="Adding…">Add to cart</button>
                                </form>
                            }
                            else if (card.Product.IsInStock)
                            {
                                <a class="btn btn-sm btn-outline-primary w-100" asp-controller="Home" asp-action="ProductDetailes" asp-route-id="@card.Product.ProId">Choose options</a>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary w-100" disabled>Sold out</button>
                            }
                        </div>
                    }
                </div>
            }
        </section>
    </div>
</div>
