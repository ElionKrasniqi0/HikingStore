@using HikingStore.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject ApplicationDbContext DbContext

<div class="navbar-nav align-items-center">
    @if (SignInManager.IsSignedIn(User))
    {
        var userId = UserManager.GetUserId(User);
        string displayName = UserManager.GetUserName(User) ?? "";
        ApplicationUser appUser = null;
        
        if (!string.IsNullOrEmpty(userId))
        {
            var user = await DbContext.Users.FirstOrDefaultAsync(u => u.Id == userId);
            if (user is ApplicationUser appUserType)
            {
                appUser = appUserType;
                var firstName = appUser.FirstName ?? "";
                var lastName = appUser.LastName ?? "";
                if (!string.IsNullOrWhiteSpace(firstName) || !string.IsNullOrWhiteSpace(lastName))
                {
                    displayName = $"{firstName} {lastName}".Trim();
                }
            }
        }
        <!-- User Dropdown for logged-in users -->
        <div class="dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center text-decoration-none user-dropdown-toggle"
               href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"
               aria-haspopup="true" aria-label="User account menu">
                <div class="user-avatar me-2">
                    <div class="avatar-circle">
                        <i class="fas fa-user"></i>
                    </div>
                </div>
                <div class="user-info d-none d-md-block">
                    <div class="user-name">@displayName</div>
                    <div class="user-role text-muted small">
                        @if (User.IsInRole("Admin"))
                        {
                            <span class="badge bg-primary">Administrator</span>
                        }
                        else
                        {
                            <span>Member</span>
                        }
                    </div>
                </div>
                <i class="fas fa-chevron-down dropdown-arrow ms-2 small"></i>
            </a>

            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 user-dropdown-menu"
                aria-labelledby="userDropdown">
                <!-- User Section -->
                <li>
                    <div class="dropdown-header user-welcome">
                        <div class="welcome-text">Welcome back</div>
                        <div class="user-email text-truncate">@displayName</div>
                    </div>
                </li>
                <li><hr class="dropdown-divider my-2"></li>

                <!-- User Links -->
                <li>
                    <a class="dropdown-item d-flex align-items-center"
                       asp-area="Identity" asp-page="/Account/Manage/Index">
                        <i class="fas fa-user-circle me-3 text-primary"></i>
                        <div>
                            <div class="dropdown-item-title">My Account</div>
                            <small class="text-muted">Manage your profile & settings</small>
                        </div>
                    </a>
                </li>
                <li>
                    <a class="dropdown-item d-flex align-items-center"
                       asp-area="" asp-controller="Orders" asp-action="Index">
                        <i class="fas fa-shopping-bag me-3 text-primary"></i>
                        <div>
                            <div class="dropdown-item-title">My Orders</div>
                            <small class="text-muted">View order history & tracking</small>
                        </div>
                    </a>
                </li>
                <li>
                    <a class="dropdown-item d-flex align-items-center"
                       asp-controller="Wishlist" asp-action="Index">
                        <i class="fas fa-heart me-3 text-danger"></i>
                        <div>
                            <div class="dropdown-item-title">My Wishlist</div>
                            <small class="text-muted">View your saved products</small>
                        </div>
                    </a>
                </li>

                <!-- Admin Section -->
                @if (User.IsInRole("Admin"))
                {
                    <li><hr class="dropdown-divider my-2"></li>
                    <li>
                        <div class="dropdown-header admin-section">
                            <i class="fas fa-shield-alt me-2 text-warning"></i>
                            Administration
                        </div>
                    </li>
                    <li>
                        <a class="dropdown-item d-flex align-items-center"
                           asp-area="Admin" asp-controller="Orders" asp-action="Index">
                            <i class="fas fa-clipboard-list me-3 text-warning"></i>
                            <div>
                                <div class="dropdown-item-title">Order Management</div>
                                <small class="text-muted">Manage customer orders</small>
                            </div>
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item d-flex align-items-center"
                           asp-area="Admin" asp-controller="Home" asp-action="Index">
                            <i class="fas fa-tachometer-alt me-3 text-warning"></i>
                            <div>
                                <div class="dropdown-item-title">Admin Dashboard</div>
                                <small class="text-muted">System administration</small>
                            </div>
                        </a>
                    </li>
                }

                <!-- Logout Section -->
                <li><hr class="dropdown-divider my-2"></li>
                <li>
                    <form class="form-inline logout-form"
                          asp-area="Identity" asp-page="/Account/Logout"
                          asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                          id="logoutForm">
                        <button type="submit"
                                class="dropdown-item d-flex align-items-center text-danger logout-button w-100"
                                aria-label="Sign out of your account">
                            <i class="fas fa-sign-out-alt me-3"></i>
                            <div>
                                <div class="dropdown-item-title">Sign Out</div>
                                <small class="text-muted">End your current session</small>
                            </div>
                        </button>
                    </form>
                </li>
            </ul>
        </div>
    }
    else
    {
        <!-- Single Login Button (like gjirafa50.com style) -->
        <a class="auth-button d-flex align-items-center" 
           asp-area="Identity" asp-page="/Account/Login"
           aria-label="Login">
            <i class="fas fa-user me-2"></i>
            <span class="auth-button-text">Login</span>
        </a>
    }
</div>

<style>
    /* User Dropdown Styles */
    .user-dropdown-toggle {
        padding: 0.5rem 1rem;
        border-radius: 8px;
        transition: all 0.3s ease;
        border: 1px solid transparent;
        color: var(--dark-text) !important;
    }

        .user-dropdown-toggle:hover {
            background: rgba(59, 93, 80, 0.08);
            border-color: rgba(59, 93, 80, 0.2);
        }

        .user-dropdown-toggle[aria-expanded="true"] {
            background: rgba(59, 93, 80, 0.12);
            border-color: rgba(59, 93, 80, 0.3);
        }

    /* Avatar Circle */
    .avatar-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--primary-light), var(--primary-color));
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1rem;
        box-shadow: 0 2px 8px rgba(59, 93, 80, 0.3);
    }

    /* User Info */
    .user-info {
        text-align: left;
    }

    .user-name {
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--dark-text);
        line-height: 1.2;
    }

    .user-role {
        font-size: 0.75rem;
        line-height: 1.2;
    }

        .user-role .badge {
            font-size: 0.7rem;
            padding: 0.25rem 0.5rem;
        }

    /* Dropdown Menu */
    .user-dropdown-menu {
        min-width: 280px;
        border-radius: 12px;
        padding: 0.5rem;
        margin-top: 0.5rem !important;
        border: 1px solid rgba(0,0,0,0.1);
    }

    .dropdown-header {
        padding: 0.75rem 1rem;
        font-weight: 600;
        color: var(--dark-text);
    }

    .user-welcome .welcome-text {
        font-size: 0.8rem;
        color: var(--gray-light);
        font-weight: 500;
    }

    .user-welcome .user-email {
        font-size: 0.9rem;
        color: var(--dark-text);
        font-weight: 600;
        margin-top: 0.25rem;
    }

    .admin-section {
        color: var(--primary-color);
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* Dropdown Items */
    .dropdown-item {
        padding: 0.75rem 1rem;
        border-radius: 8px;
        margin: 0.125rem 0;
        transition: all 0.2s ease;
        color: var(--dark-text);
        text-decoration: none;
    }

        .dropdown-item:hover {
            background: rgba(59, 93, 80, 0.08);
            animation: none !important;
            transform: none !important;
        }

    .dropdown-item-title {
        font-weight: 500;
        font-size: 0.9rem;
        line-height: 1.2;
    }

    .dropdown-item small {
        font-size: 0.75rem;
        line-height: 1.2;
    }

    /* Logout Button */
    .logout-button {
        background: none;
        border: none;
        width: 100%;
        text-align: left;
        cursor: pointer;
        padding: 0;
    }

        .logout-button:hover {
            background: rgba(220, 53, 69, 0.08) !important;
            color: var(--accent-color) !important;
            animation: none !important;
        }

        .logout-button:active {
            animation: none !important;
            transform: none !important;
        }

    /* Logout Form */
    .logout-form {
        margin: 0;
        padding: 0;
    }

    /* Single Login Button (like gjirafa50.com style) */
    .auth-button {
        display: inline-flex;
        align-items: center;
        padding: 0.5rem 1rem;
        background-color: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 8px;
        color: var(--dark-text);
        font-size: 0.95rem;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.2s ease;
        cursor: pointer;
    }

        .auth-button:hover {
            background-color: rgba(59, 93, 80, 0.1);
            border-color: rgba(59, 93, 80, 0.3);
            color: var(--primary-color);
            text-decoration: none;
        }

        .auth-button:focus {
            outline: 2px solid var(--primary-light);
            outline-offset: 2px;
        }

    .auth-button i {
        font-size: 1.1rem;
        color: var(--dark-text);
        transition: color 0.2s ease;
    }

    .auth-button:hover i {
        color: var(--primary-color);
    }

    .auth-button-text {
        font-weight: 500;
        letter-spacing: 0;
    }

    /* Dropdown Arrow Animation */
    .dropdown-arrow {
        transition: transform 0.3s ease;
    }

    .user-dropdown-toggle[aria-expanded="true"] .dropdown-arrow {
        transform: rotate(180deg);
    }

    /* Icons in Dropdown */
    .dropdown-item i {
        width: 16px;
        text-align: center;
    }

    /* Focus States for Accessibility */
    .user-dropdown-toggle:focus,
    .auth-button:focus,
    .dropdown-item:focus,
    .logout-button:focus {
        outline: 2px solid var(--primary-light);
        outline-offset: 2px;
    }

    /* Responsive Design - Tablet */
    @@media (max-width: 991.98px) {
        .auth-button {
            padding: 0.45rem 0.875rem;
            font-size: 0.9rem;
        }

        .user-info {
            display: none !important;
        }

        .dropdown-arrow {
            display: none;
        }
    }

    /* Responsive Design - Mobile */
    @@media (max-width: 767.98px) {
        .avatar-circle {
            width: 32px;
            height: 32px;
            font-size: 0.875rem;
        }

        .auth-button {
            padding: 0.4rem 0.75rem;
            font-size: 0.85rem;
        }

        .auth-button i {
            font-size: 1rem;
        }

        .auth-button-text {
            font-size: 0.85rem;
        }
    }

    /* Responsive Design - Small Mobile */
    @@media (max-width: 575.98px) {
        .auth-button {
            padding: 0.4rem 0.65rem;
        }

        .auth-button-text {
            display: none;
        }

        .auth-button i {
            margin-right: 0;
        }
    }

    /* Animation for Dropdown - No transform, only opacity */
    .dropdown-menu {
        animation: dropdownFadeIn 0.2s ease-out;
    }

    @@keyframes dropdownFadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

</style>

<script>
    // Enhanced dropdown interactions
    document.addEventListener('DOMContentLoaded', function() {
        const dropdownToggle = document.querySelector('.user-dropdown-toggle');
        const dropdownMenu = document.querySelector('.user-dropdown-menu');

        if (dropdownToggle && dropdownMenu) {
            // Close dropdown when clicking outside
            document.addEventListener('click', function(e) {
                if (!dropdownToggle.contains(e.target) && !dropdownMenu.contains(e.target)) {
                    const bootstrapDropdown = bootstrap.Dropdown.getInstance(dropdownToggle);
                    if (bootstrapDropdown) {
                        bootstrapDropdown.hide();
                    }
                }
            });

            // Enhanced keyboard navigation
            dropdownToggle.addEventListener('keydown', function(e) {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    this.click();
                }
            });
        }

        // Smooth logout - no delays, no vibration
        const logoutButtons = document.querySelectorAll('.logout-button');
        logoutButtons.forEach(button => {
            button.addEventListener('click', function(e) {
                // Allow form submission - no preventDefault
                // Smooth visual feedback
                this.style.opacity = '0.8';
            });
        });

        // Ensure auth button navigates smoothly
        const authButton = document.querySelector('.auth-button');
        if (authButton) {
            authButton.addEventListener('click', function(e) {
                // Allow default navigation - no preventDefault
                // Smooth visual feedback
                this.style.opacity = '0.8';
            });
        }

        // Smooth dropdown item navigation - no transforms
        const dropdownItems = document.querySelectorAll('.dropdown-item[href]');
        dropdownItems.forEach(item => {
            item.addEventListener('click', function(e) {
                // Allow default navigation
                // No transforms, only opacity change
                this.style.opacity = '0.9';
                this.style.transform = 'none';
            });
        });

    });
</script>
