@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject IOptions<StoreSettings> StoreOptions
@inject CatalogService Catalog
@inject CartService Cart
@inject ApplicationDbContext Db
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var store = StoreOptions.Value;
    var signedIn = SignInManager.IsSignedIn(User);
    var userId = signedIn ? UserManager.GetUserId(User) : null;
    var navCategories = await Catalog.GetNavigationTreeAsync();
    var cartCount = await Cart.GetItemCountAsync(userId);
    var wishlistCount = userId == null ? 0 : await Db.Wishlists.CountAsync(w => w.UserId == userId && w.Product!.IsActive);
    var title = ViewData["Title"] as string;
    var pageTitle = string.IsNullOrEmpty(title) ? $"{store.Name} – Outdoor & hiking gear" : $"{title} | {store.Name}";
    var description = ViewData["Description"] as string ?? "Hiking boots, backpacks, jackets and camping gear chosen for the trail. Free standard shipping over " + store.FormatPrice(store.FreeShippingThreshold) + ".";
    var canonical = ViewData["Canonical"] as string ?? $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
    var ogImage = ViewData["OgImage"] as string;
    var requestToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var currentCategory = Context.Request.Query["category"].ToString();
    var searchQuery = Context.Request.Query["q"].ToString();
    var socialLinks = store.SocialLinks.Where(s => !string.IsNullOrWhiteSpace(s.Value)).ToList();
    string SocialIcon(string name) => name.ToLowerInvariant() switch
    {
        "facebook" => "fa-facebook-f",
        "instagram" => "fa-instagram",
        "youtube" => "fa-youtube",
        "tiktok" => "fa-tiktok",
        "x" or "twitter" => "fa-x-twitter",
        _ => "fa-link"
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@pageTitle</title>
    <meta name="description" content="@description" />
    <meta name="csrf-token" content="@requestToken" />
    <meta name="theme-color" content="#163526" />
    @if (ViewData["NoIndex"] is true)
    {
        <meta name="robots" content="noindex" />
    }
    <link rel="canonical" href="@canonical" />
    <meta property="og:site_name" content="@store.Name" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@description" />
    <meta property="og:url" content="@canonical" />
    <meta property="og:type" content="@(ViewData["OgType"] as string ?? "website")" />
    @if (!string.IsNullOrEmpty(ogImage))
    {
        <meta property="og:image" content="@ogImage" />
    }
    <link rel="icon" href="~/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/hikingstore.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "OnlineStore",
          "name": "@store.Name",
          "url": "@($"{Context.Request.Scheme}://{Context.Request.Host}")",
          "email": "@store.SupportEmail",
          "telephone": "@store.SupportPhone"
        }
    </script>
</head>
<body class="@(ViewData["BodyClass"] as string)" data-signed-in="@(signedIn ? "true" : "false")"
      data-login-url="@Url.Page("/Account/Login", new { area = "Identity" })">
    <a class="skip-link" href="#main">Skip to content</a>

    @if (!string.IsNullOrWhiteSpace(store.AnnouncementText))
    {
        <div class="announcement-bar">@store.AnnouncementText</div>
    }

    <header class="site-header">
        <div class="container-hs header-main">
            <div class="d-flex align-items-center gap-1">
                <button class="action-btn menu-toggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileNav" aria-controls="mobileNav" aria-label="Open menu">
                    <i class="fa-solid fa-bars" aria-hidden="true"></i>
                </button>
                <a class="brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="@store.Name home">
                    <span class="brand-mark" aria-hidden="true"><i class="fa-solid fa-mountain-sun"></i></span>
                    <span class="brand-text">@store.Name</span>
                </a>
            </div>

            <form class="header-search" role="search" method="get" asp-area="" asp-controller="Home" asp-action="Shop" data-quick-search>
                <label for="site-search" class="visually-hidden">Search products</label>
                <i class="fa-solid fa-magnifying-glass search-icon" aria-hidden="true"></i>
                <input id="site-search" class="form-control" type="search" name="q" value="@searchQuery" maxlength="100"
                       placeholder="Search boots, jackets, tents…" autocomplete="off"
                       role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="search-suggest" />
                <div id="search-suggest" class="search-suggest" role="listbox" hidden></div>
            </form>

            <nav class="header-actions" aria-label="Account and cart">
                @if (signedIn)
                {
                    <div class="dropdown">
                        <button class="action-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fa-regular fa-user" aria-hidden="true"></i><span class="label">Account</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            <li><h2 class="dropdown-header text-truncate" style="max-width:240px">@User.Identity?.Name</h2></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Index"><i class="fa-regular fa-user me-2" aria-hidden="true"></i>My account</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="Orders" asp-action="Index"><i class="fa-solid fa-box me-2" aria-hidden="true"></i>Orders &amp; tracking</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="Wishlist" asp-action="Index"><i class="fa-regular fa-heart me-2" aria-hidden="true"></i>Wishlist</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="Chat" asp-action="Index"><i class="fa-regular fa-comments me-2" aria-hidden="true"></i>Support chat</a></li>
                            @if (User.IsInRole(DbInitializer.AdminRole))
                            {
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" asp-area="Admin" asp-controller="Home" asp-action="Index"><i class="fa-solid fa-gauge me-2" aria-hidden="true"></i>Admin dashboard</a></li>
                            }
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                    <button type="submit" class="dropdown-item"><i class="fa-solid fa-arrow-right-from-bracket me-2" aria-hidden="true"></i>Sign out</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                    <a class="action-btn hide-xs" asp-area="" asp-controller="Wishlist" asp-action="Index" aria-label="Wishlist, @wishlistCount items">
                        <i class="fa-regular fa-heart" aria-hidden="true"></i><span class="label">Wishlist</span>
                        <span class="count-badge" data-wishlist-count data-count="@wishlistCount">@wishlistCount</span>
                    </a>
                }
                else
                {
                    <a class="action-btn" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@($"{Context.Request.Path}{Context.Request.QueryString}")">
                        <i class="fa-regular fa-user" aria-hidden="true"></i><span class="label">Sign in</span>
                    </a>
                }
                <a class="action-btn" asp-area="" asp-controller="Carts" asp-action="Index" data-mini-cart-toggle aria-label="Cart, @cartCount items">
                    <i class="fa-solid fa-bag-shopping" aria-hidden="true"></i><span class="label">Cart</span>
                    <span class="count-badge" data-cart-count data-count="@cartCount">@cartCount</span>
                </a>
            </nav>
        </div>

        <nav class="cat-nav" aria-label="Product categories">
            <div class="container-hs">
                <ul>
                    <li><a class="nav-top @(controller == "Home" && action == "Shop" && string.IsNullOrEmpty(currentCategory) && Context.Request.Query.Count == 0 ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Shop">Shop all</a></li>
                    <li><a class="nav-top" asp-area="" asp-controller="Home" asp-action="Shop" asp-route-sort="newest">New in</a></li>
                    @foreach (var category in navCategories.Take(6))
                    {
                        var isActive = currentCategory == category.CatId.ToString() || category.Children.Any(c => c.CatId.ToString() == currentCategory);
                        if (category.Children.Count > 0)
                        {
                            <li class="has-mega">
                                <button class="nav-top @(isActive ? "active" : "")" type="button" aria-expanded="false" aria-controls="mega-@category.CatId" data-mega-toggle>
                                    @category.CatName <i class="fa-solid fa-chevron-down small" aria-hidden="true"></i>
                                </button>
                                <div class="mega" id="mega-@category.CatId" hidden>
                                    <div>
                                        <a class="fw-bold d-inline-block mb-2" asp-area="" asp-controller="Home" asp-action="Shop" asp-route-category="@category.CatId">All @category.CatName</a>
                                        <ul>
                                            @foreach (var child in category.Children)
                                            {
                                                <li><a asp-area="" asp-controller="Home" asp-action="Shop" asp-route-category="@child.CatId">@child.CatName</a></li>
                                            }
                                        </ul>
                                    </div>
                                    @if (!string.IsNullOrEmpty(category.CatPhoto))
                                    {
                                        <a class="mega-feature" asp-area="" asp-controller="Home" asp-action="Shop" asp-route-category="@category.CatId">
                                            <img src="~/category/@category.CatPhoto" alt="" loading="lazy" />
                                            <span>Shop @category.CatName</span>
                                        </a>
                                    }
                                </div>
                            </li>
                        }
                        else
                        {
                            <li><a class="nav-top @(isActive ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Shop" asp-route-category="@category.CatId">@category.CatName</a></li>
                        }
                    }
                    <li><a class="nav-top" asp-area="" asp-controller="Home" asp-action="Shop" asp-route-sort="popular">Best sellers</a></li>
                    <li><a class="nav-top sale" asp-area="" asp-controller="Home" asp-action="Shop" asp-route-onSale="true">Sale</a></li>
                </ul>
            </div>
        </nav>
    </header>

    <div class="offcanvas offcanvas-start mobile-nav" tabindex="-1" id="mobileNav" aria-labelledby="mobileNavLabel">
        <div class="offcanvas-header">
            <h2 class="offcanvas-title h5 m-0" id="mobileNavLabel">Menu</h2>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close menu"></button>
        </div>
        <div class="offcanvas-body p-0">
            <div class="list-group list-group-flush">
                <a class="list-group-item list-group-item-action" asp-area="" asp-controller="Home" asp-action="Shop">Shop all</a>
                <a class="list-group-item list-group-item-action" asp-area="" asp-controller="Home" asp-action="Shop" asp-route-sort="newest">New in</a>
                <a class="list-group-item list-group-item-action" asp-area="" asp-controller="Home" asp-action="Shop" asp-route-sort="popular">Best sellers</a>
                <a class="list-group-item list-group-item-action sale-link" asp-area="" asp-controller="Home" asp-action="Shop" asp-route-onSale="true">Sale</a>
                @foreach (var category in navCategories)
                {
                    <a class="list-group-item list-group-item-action fw-semibold" asp-area="" asp-controller="Home" asp-action="Shop" asp-route-category="@category.CatId">@category.CatName</a>
                    @foreach (var child in category.Children)
                    {
                        <a class="list-group-item list-group-item-action sub" asp-area="" asp-controller="Home" asp-action="Shop" asp-route-category="@child.CatId">@child.CatName</a>
                    }
                }
            </div>
            <div class="list-group list-group-flush border-top mt-2">
                @if (signedIn)
                {
                    <a class="list-group-item list-group-item-action" asp-area="" asp-controller="Account" asp-action="Index"><i class="fa-regular fa-user me-2" aria-hidden="true"></i>My account</a>
                    <a class="list-group-item list-group-item-action" asp-area="" asp-controller="Orders" asp-action="Index"><i class="fa-solid fa-box me-2" aria-hidden="true"></i>Orders</a>
                    <a class="list-group-item list-group-item-action" asp-area="" asp-controller="Wishlist" asp-action="Index"><i class="fa-regular fa-heart me-2" aria-hidden="true"></i>Wishlist</a>
                }
                else
                {
                    <a class="list-group-item list-group-item-action" asp-area="Identity" asp-page="/Account/Login"><i class="fa-regular fa-user me-2" aria-hidden="true"></i>Sign in</a>
                    <a class="list-group-item list-group-item-action" asp-area="Identity" asp-page="/Account/Register"><i class="fa-solid fa-user-plus me-2" aria-hidden="true"></i>Create account</a>
                }
                <a class="list-group-item list-group-item-action" asp-area="" asp-controller="Home" asp-action="Contact"><i class="fa-regular fa-envelope me-2" aria-hidden="true"></i>Contact us</a>
            </div>
        </div>
    </div>

    <div class="offcanvas offcanvas-end mini-cart" tabindex="-1" id="miniCart" aria-labelledby="miniCartLabel">
        <div class="offcanvas-header border-bottom">
            <h2 class="offcanvas-title h5 m-0" id="miniCartLabel">Your cart</h2>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close cart"></button>
        </div>
        <div class="offcanvas-body" data-mini-cart-body aria-live="polite">
            <div class="text-center text-muted py-5"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Loading…</div>
        </div>
    </div>

    <main id="main" tabindex="-1">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <section class="footer-newsletter" aria-labelledby="newsletter-title">
            <div class="container-hs">
                <div class="row g-3 align-items-center">
                    <div class="col-lg-6">
                        <h2 id="newsletter-title">Trail notes in your inbox</h2>
                        <p class="m-0" style="color:#DCE3D6">New arrivals and seasonal offers. No spam — unsubscribe any time by contacting us.</p>
                    </div>
                    <div class="col-lg-6">
                        <form method="post" asp-area="" asp-controller="Home" asp-action="Subscribe" class="d-flex gap-2">
                            <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                            <label for="newsletter-email" class="visually-hidden">Email address</label>
                            <input id="newsletter-email" type="email" name="email" class="form-control min-w-0" placeholder="Your email address" required maxlength="256" autocomplete="email" />
                            <button type="submit" class="btn btn-light flex-shrink-0">Subscribe</button>
                        </form>
                    </div>
                </div>
            </div>
        </section>
        <div class="container-hs py-5">
            <div class="row g-4">
                <div class="col-12 col-lg-4">
                    <a class="brand text-white mb-3" asp-area="" asp-controller="Home" asp-action="Index">
                        <span class="brand-mark" aria-hidden="true"><i class="fa-solid fa-mountain-sun"></i></span>@store.Name
                    </a>
                    <p class="mt-3">Gear for day hikes, long trails and nights under the stars.</p>
                    <ul>
                        @if (!string.IsNullOrEmpty(store.Address))
                        {
                            <li><i class="fa-solid fa-location-dot me-2" aria-hidden="true"></i>@store.Address</li>
                        }
                        @if (!string.IsNullOrEmpty(store.SupportPhone))
                        {
                            <li><i class="fa-solid fa-phone me-2" aria-hidden="true"></i><a href="tel:@store.SupportPhone.Replace(" ", "")">@store.SupportPhone</a></li>
                        }
                        @if (!string.IsNullOrEmpty(store.SupportEmail))
                        {
                            <li><i class="fa-regular fa-envelope me-2" aria-hidden="true"></i><a href="mailto:@store.SupportEmail">@store.SupportEmail</a></li>
                        }
                    </ul>
                    @if (socialLinks.Count > 0)
                    {
                        <div class="social-links mt-3">
                            @foreach (var link in socialLinks)
                            {
                                <a href="@link.Value" target="_blank" rel="noopener" aria-label="@store.Name on @link.Key"><i class="fa-brands @SocialIcon(link.Key)" aria-hidden="true"></i></a>
                            }
                        </div>
                    }
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <h2>Shop</h2>
                    <ul>
                        @foreach (var category in navCategories.Take(5))
                        {
                            <li><a asp-area="" asp-controller="Home" asp-action="Shop" asp-route-category="@category.CatId">@category.CatName</a></li>
                        }
                        <li><a asp-area="" asp-controller="Home" asp-action="Shop" asp-route-sort="newest">New in</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Shop" asp-route-onSale="true">Sale</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-4 col-lg-3">
                    <h2>Help</h2>
                    <ul>
                        <li><a asp-area="" asp-controller="Home" asp-action="Contact">Contact us</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Shipping">Shipping &amp; delivery</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Returns">Returns &amp; exchanges</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Faq">FAQ</a></li>
                        <li><a asp-area="" asp-controller="Orders" asp-action="Index">Track an order</a></li>
                    </ul>
                </div>
                <div class="col-12 col-md-4 col-lg-3">
                    <h2>Company</h2>
                    <ul>
                        <li><a asp-area="" asp-controller="Home" asp-action="About">About us</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy policy</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Terms">Terms &amp; conditions</a></li>
                    </ul>
                    <p class="mt-3 small mb-1">We accept</p>
                    @if (PaymentProviders.ActiveProvider != null)
                    {
                        <p class="small mb-1"><i class="fa-regular fa-credit-card me-2" aria-hidden="true"></i>Visa, Mastercard &amp; debit cards</p>
                    }
                    @if (PaymentProviders.CashOnDeliveryEnabled)
                    {
                        <p class="small m-0"><i class="fa-solid fa-money-bill-wave me-2" aria-hidden="true"></i>Cash on delivery</p>
                    }
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container-hs d-flex flex-wrap justify-content-between gap-2">
                <span>&copy; @DateTime.UtcNow.Year @store.Name. All rights reserved.</span>
                <span>Prices include VAT.</span>
            </div>
        </div>
    </footer>

    <div class="toast-stack" aria-live="polite" aria-atomic="false" data-toast-stack>
        @foreach (var key in new[] { "Success", "SuccessMessage" })
        {
            if (TempData[key] is string ok && !string.IsNullOrEmpty(ok))
            {
                <div class="toast-hs success" role="status"><i class="fa-solid fa-circle-check mt-1" aria-hidden="true"></i><span>@ok</span><button type="button" class="close" aria-label="Dismiss">&times;</button></div>
            }
        }
        @foreach (var key in new[] { "Error", "ErrorMessage" })
        {
            if (TempData[key] is string err && !string.IsNullOrEmpty(err))
            {
                <div class="toast-hs error" role="alert"><i class="fa-solid fa-circle-exclamation mt-1" aria-hidden="true"></i><span>@err</span><button type="button" class="close" aria-label="Dismiss">&times;</button></div>
            }
        }
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (signedIn)
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js" integrity="sha384-mU1xC5yC2LldSW74Rj1Ax8wPiLw/28V5eh51uKJMlBbRVsOtUYd4xyzNsgIAJARB" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
        <script src="~/js/realtime-updates.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
