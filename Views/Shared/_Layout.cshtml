<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="description" content="Premium hiking gear and outdoor equipment for your next adventure. Shop quality hiking boots, backpacks, camping gear, and outdoor clothing.">
    <meta name="keywords" content="hiking gear, outdoor equipment, camping supplies, hiking boots, backpacks, outdoor clothing">
    <meta name="author" content="HikingStore">
    <meta name="robots" content="index, follow">
    <meta name="theme-color" content="#2d473d">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="@(Context.Request.Scheme)://@(Context.Request.Host)">
    <meta property="og:title" content="@(ViewData["Title"] ?? "HikingStore") - Premium Hiking Gear">
    <meta property="og:description" content="Premium hiking gear and outdoor equipment for your next adventure">
    <meta property="og:image" content="@(Context.Request.Scheme)://@(Context.Request.Host)/img/banner-1.jpg">
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="@(Context.Request.Scheme)://@(Context.Request.Host)">
    <meta property="twitter:title" content="@(ViewData["Title"] ?? "HikingStore") - Premium Hiking Gear">
    <meta property="twitter:description" content="Premium hiking gear and outdoor equipment for your next adventure">
    <meta property="twitter:image" content="@(Context.Request.Scheme)://@(Context.Request.Host)/img/banner-1.jpg">
    
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} - " : "")HikingStore - Premium Hiking Gear & Outdoor Equipment</title>
    
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="canonical" href="@(Context.Request.Scheme)://@(Context.Request.Host)@(Context.Request.Path)" />

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet">
    <!-- Responsive Styles -->
    <link rel="stylesheet" href="~/css/responsive.css">
    <link rel="stylesheet" href="~/css/site.css">
    <link rel="stylesheet" href="~/css/print.css" media="print">

    <style>
        :root {
            --primary-color: #2d473d;
            --primary-light: #3b5d50;
            --secondary-color: #f9bf29;
            --accent-color: #e74c3c;
            --light-bg: #f8f9fa;
            --dark-text: #2c3e50;
            --gray-light: #6c757d;
            --white: #ffffff;
            --border-radius: 8px;
            --shadow: 0 4px 12px rgba(0,0,0,0.08);
            --transition: all 0.3s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            color: var(--dark-text);
            line-height: 1.6;
            background-color: var(--white);
        }

        /* Typography */
        h1, h2, h3, h4, h5, h6 {
            font-family: 'Playfair Display', serif;
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .display-1, .display-2, .display-3, .display-4, .display-5, .display-6 {
            font-family: 'Playfair Display', serif;
        }

        /* Navigation */
        .navbar {
            background: var(--white) !important;
            box-shadow: 0 2px 20px rgba(0,0,0,0.08);
            transition: var(--transition);
            padding: 1rem 0;
            z-index: 1030;
        }

        .navbar-scrolled {
            padding: 0.75rem 0;
            box-shadow: 0 2px 15px rgba(0,0,0,0.12);
        }

        .navbar-brand {
            font-family: 'Playfair Display', serif;
            font-weight: 700;
            font-size: 1.75rem;
            background: linear-gradient(135deg, var(--primary-color), var(--primary-light));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            transition: var(--transition);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

            .navbar-brand:hover {
                opacity: 0.9;
            }

            .navbar-brand i {
                background: linear-gradient(135deg, var(--primary-color), var(--primary-light));
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
            }

        .nav-link {
            font-weight: 500;
            color: var(--dark-text) !important;
            padding: 0.625rem 1rem !important;
            margin: 0 0.125rem;
            border-radius: var(--border-radius);
            transition: var(--transition);
            position: relative;
            font-size: 0.95rem;
        }

            .nav-link:hover,
            .nav-link.active {
                color: var(--primary-light) !important;
                background-color: rgba(59, 93, 80, 0.08);
            }

            .nav-link::after {
                content: '';
                position: absolute;
                bottom: 0.25rem;
                left: 50%;
                width: 0;
                height: 2px;
                background: var(--primary-light);
                transition: var(--transition);
                transform: translateX(-50%);
                border-radius: 2px;
            }

            .nav-link:hover::after,
            .nav-link.active::after {
                width: 70%;
            }

        /* Buttons */
        .btn {
            border-radius: var(--border-radius);
            font-weight: 500;
            padding: 0.75rem 1.5rem;
            transition: var(--transition);
            border: none;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary-light), var(--primary-color));
            color: var(--white);
            box-shadow: 0 4px 15px rgba(59, 93, 80, 0.3);
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(59, 93, 80, 0.4);
            }

        .btn-outline-primary {
            border: 2px solid var(--primary-light);
            color: var(--primary-light);
            background: transparent;
        }

            .btn-outline-primary:hover {
                background: var(--primary-light);
                color: var(--white);
                transform: translateY(-2px);
            }

        /* Cart Icon */
        .cart-icon {
            position: relative;
            padding: 0.5rem;
            border-radius: 50%;
            transition: var(--transition);
        }

            .cart-icon:hover {
                background: rgba(59, 93, 80, 0.1);
            }

        .cart-count {
            position: absolute;
            top: -5px;
            right: -5px;
            background: var(--accent-color);
            color: var(--white);
            border-radius: 50%;
            width: 20px;
            height: 20px;
            font-size: 0.75rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
        }

        /* Dropdown */
        .dropdown-menu {
            border: none;
            box-shadow: var(--shadow);
            border-radius: var(--border-radius);
            padding: 0.5rem;
            min-width: 200px;
        }

        .dropdown-item {
            padding: 0.75rem 1rem;
            border-radius: 6px;
            transition: var(--transition);
            color: var(--dark-text);
        }

            .dropdown-item:hover {
                background: rgba(59, 93, 80, 0.08);
                color: var(--primary-light);
            }

        /* Main Content */
        main {
            min-height: calc(100vh - 200px);
        }

        /* Footer */
        .footer {
            background: linear-gradient(135deg, var(--primary-color), var(--primary-light));
            color: var(--white);
            padding: 3rem 0 1rem;
            margin-top: 4rem;
        }

            .footer h5 {
                color: var(--white);
                margin-bottom: 1rem;
                font-weight: 600;
            }

            .footer a {
                color: rgba(255,255,255,0.8);
                text-decoration: none;
                transition: var(--transition);
            }

                .footer a:hover {
                    color: var(--white);
                    text-decoration: underline;
                }

            .footer .social-links a {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 40px;
                height: 40px;
                background: rgba(255,255,255,0.1);
                border-radius: 50%;
                margin-right: 0.5rem;
                transition: var(--transition);
            }

                .footer .social-links a:hover {
                    background: rgba(255,255,255,0.2);
                    transform: translateY(-2px);
                }

        /* Utility Classes */
        .text-primary {
            color: var(--primary-light) !important;
        }

        .bg-primary {
            background-color: var(--primary-light) !important;
        }

        .border-primary {
            border-color: var(--primary-light) !important;
        }

        .section-padding {
            padding: 4rem 0;
        }

        .card {
            border: none;
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
            transition: var(--transition);
        }

            .card:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 25px rgba(0,0,0,0.12);
            }

        /* Loading Animation */
        .loading-spinner {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 2px solid #f3f3f3;
            border-top: 2px solid var(--primary-light);
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }



        /* Search Bar Styling */
        .navbar-search-form {
            position: relative;
            max-width: 400px;
            width: 100%;
        }

        .navbar-search-form .form-control {
            border: 2px solid rgba(59, 93, 80, 0.15);
            border-radius: 25px;
            padding: 0.625rem 3rem 0.625rem 1.25rem;
            font-size: 0.9rem;
            transition: var(--transition);
            background: rgba(248, 249, 250, 0.8);
        }

            .navbar-search-form .form-control:focus {
                border-color: var(--primary-light);
                box-shadow: 0 0 0 0.2rem rgba(59, 93, 80, 0.15);
                background: var(--white);
            }

        .navbar-search-form .btn {
            position: absolute;
            right: 0.25rem;
            top: 50%;
            transform: translateY(-50%);
            border-radius: 50%;
            width: 36px;
            height: 36px;
            padding: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--primary-light);
            border: none;
            transition: var(--transition);
        }

            .navbar-search-form .btn:hover {
                background: var(--primary-color);
                transform: translateY(-50%) scale(1.05);
            }

        /* Navbar Container Improvements */
        .navbar .container {
            display: flex;
            align-items: center;
            gap: 1.5rem;
        }

        .navbar-collapse {
            flex-grow: 1;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1.5rem;
        }

        .navbar-nav.me-auto {
            display: flex;
            align-items: center;
            gap: 0.25rem;
        }

        /* Navbar Right Section */
        .navbar-right-section {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .btn {
            padding: 0.625rem 1.25rem;
        }

        .section-padding {
            padding: 2rem 0;
        }

        /* Desktop Navigation Styles */
        @@media (min-width: 992px) {
            .mobile-nav-content {
                display: none !important;
        }
        }

        /* Accessibility */
        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }

        .sr-only-focusable:focus {
            position: static;
            width: auto;
            height: auto;
            padding: 0.5rem 1rem;
            margin: 0;
            overflow: visible;
            clip: auto;
            white-space: normal;
            background: var(--primary-color);
            color: var(--white);
            z-index: 9999;
            border-radius: var(--border-radius);
        }

        .skip-link {
            position: absolute;
            top: -40px;
            left: 0;
            background: var(--primary-color);
            color: var(--white);
            padding: 8px;
            text-decoration: none;
            z-index: 10000;
        }

        .skip-link:focus {
            top: 0;
        }

        /* Focus states for accessibility */
        button:focus,
        a:focus,
        .btn:focus {
            outline: 2px solid var(--primary-light);
            outline-offset: 2px;
        }

        @@media print {
            /* Hide navigation, footer, and buttons when printing */
            .navbar,
            .sb-topnav,
            .footer,
            .breadcrumb,
            button,
            .btn,
            .dropdown,
            .nav-link,
            .cart-summary-wrapper,
            .user-dropdown-toggle,
            .auth-buttons-container,
            .no-print {
                display: none !important;
            }
            /* Simple print layout */
            body {
                background: white !important;
                color: black !important;
                font-size: 12pt !important;
                margin: 0 !important;
                padding: 10mm !important;
            }
            /* Remove backgrounds and shadows */
            * {
                background: transparent !important;
                box-shadow: none !important;
                text-shadow: none !important;
            }
            /* Show URLs for links */
            a[href]:after {
                content: " (" attr(href) ")";
                font-size: 90%;
            }
            /* Don't show links for images or internal links */
            a[href^="#"]:after,
            a[href^="javascript:"]:after {
                content: "";
            }
        }
    </style>

    @RenderSection("Styles", required: false)
    
    <!-- Structured Data for SEO -->
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "Store",
        "name": "HikingStore",
        "description": "Premium hiking gear and outdoor equipment for your next adventure",
        "url": "@(Context.Request.Scheme)://@(Context.Request.Host)",
        "logo": "@(Context.Request.Scheme)://@(Context.Request.Host)/img/banner-1.jpg",
        "sameAs": [
            "https://www.facebook.com/",
            "https://www.x.com/",
            "https://www.instagram.com/",
            "https://www.linkedin.com/"
        ]
    }
    </script>
</head>
<body>
    <!-- Skip to main content for accessibility -->
    <a href="#main-content" class="sr-only sr-only-focusable skip-link">Skip to main content</a>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-light sticky-top" role="navigation" aria-label="Main navigation">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index" aria-label="HikingStore Home">
                <i class="fas fa-mountain" aria-hidden="true"></i>
                <span>HikingStore</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation"
                    style="border: 2px solid rgba(59, 93, 80, 0.2); border-radius: 8px; padding: 0.5rem;">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <!-- Desktop: Navigation Links -->
                <ul class="navbar-nav me-auto d-none d-lg-flex">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" && ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")"
                           asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Shop" ? "active" : "")"
                           asp-controller="Home" asp-action="Shop">Shop</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Product" ? "active" : "")"
                           asp-controller="Home" asp-action="Product">Products</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Contact" ? "active" : "")"
                           asp-controller="Home" asp-action="Contact">Contact</a>
                    </li>
                </ul>

                <!-- Desktop: Right section with search, auth, and cart -->
                <div class="navbar-right-section d-none d-lg-flex align-items-center">
                    <!-- Search Bar (Desktop) -->
                    <form class="navbar-search-form" role="search" onsubmit="handleSearch(event)">
                        <input type="text" class="form-control" placeholder="Search products..."
                               aria-label="Search products" aria-describedby="search-button" 
                               id="navbar-search-input" name="search">
                        <button class="btn btn-primary" type="submit" id="search-button" aria-label="Submit search">
                            <i class="fas fa-search" aria-hidden="true"></i>
                        </button>
                    </form>

                    <!-- User Authentication (Desktop) -->
                    <partial name="_LoginPartial" />

                    <!-- Cart Summary (Desktop) -->
                    @await Component.InvokeAsync("CartSummary")
                </div>

                <!-- Mobile: Stacked layout -->
                <div class="mobile-nav-content d-lg-none w-100">
                    <!-- Mobile Search - Top -->
                    <form class="mobile-search-form mb-3" role="search" onsubmit="handleSearch(event)">
                        <div class="input-group">
                            <input type="text" class="form-control" placeholder="Search products..."
                                   aria-label="Search products" id="mobile-search-input" name="search"
                                   style="font-size: 16px;">
                            <button class="btn btn-primary" type="submit" aria-label="Submit search">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </form>

                    <!-- Navigation Links - Middle -->
                    <ul class="navbar-nav mobile-nav-links mb-3">
                    <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" && ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")"
                               asp-controller="Home" asp-action="Index">
                                <i class="fas fa-home me-2"></i>Home
                            </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Shop" ? "active" : "")"
                               asp-controller="Home" asp-action="Shop">
                                <i class="fas fa-store me-2"></i>Shop
                            </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Product" ? "active" : "")"
                               asp-controller="Home" asp-action="Product">
                                <i class="fas fa-box me-2"></i>Products
                            </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Contact" ? "active" : "")"
                               asp-controller="Home" asp-action="Contact">
                                <i class="fas fa-envelope me-2"></i>Contact
                            </a>
                    </li>
                </ul>

                    <!-- Mobile Bottom Section: Cart and Auth -->
                    <div class="mobile-nav-bottom d-flex align-items-center justify-content-between">
                        <!-- Cart (Mobile) -->
                        <div class="mobile-cart-wrapper">
                            @await Component.InvokeAsync("CartSummary")
                        </div>

                        <!-- User Authentication (Mobile) -->
                        <div class="mobile-auth-wrapper">
                    <partial name="_LoginPartial" />
                </div>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main id="main-content" role="main" tabindex="-1">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <h5>
                        <i class="fas fa-mountain me-2"></i>HikingStore
                    </h5>
                    <p class="mb-4">Your trusted partner for premium hiking gear and outdoor equipment. Explore nature with confidence and style.</p>
                    <div class="social-links" role="list">
                        <a href="https://www.facebook.com/" target="_blank" rel="noopener noreferrer" aria-label="Visit our Facebook page"><i class="fa fa-brands fa-facebook-f" aria-hidden="true"></i></a>
                        <a href="https://www.x.com/" target="_blank" rel="noopener noreferrer" aria-label="Visit our Twitter page"><i class="fa fa-brands fa-twitter" aria-hidden="true"></i></a>
                        <a href="https://www.instagram.com/" target="_blank" rel="noopener noreferrer" aria-label="Visit our Instagram page"><i class="fa fa-brands fa-instagram" aria-hidden="true"></i></a>
                        <a href="https://www.linkedin.com/" target="_blank" rel="noopener noreferrer" aria-label="Visit our LinkedIn page"><i class="fa fa-brands fa-linkedin" aria-hidden="true"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h6>Shop</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="#">Hiking Gear</a></li>
                        <li class="mb-2"><a href="#">Camping Equipment</a></li>
                        <li class="mb-2"><a href="#">Outdoor Clothing</a></li>
                        <li class="mb-2"><a href="#">Accessories</a></li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h6>Support</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="/Home/About/">About Us</a></li>
                        <li class="mb-2"><a href="/Home/Services/">Services</a></li>
                        <li class="mb-2"><a href="/Home/Contact/">Contact</a></li>
                        <li class="mb-2"><a href="#">FAQ</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-6">
                    <h6>Newsletter</h6>
                    <p class="mb-3">Subscribe to get special offers, free giveaways, and outdoor tips.</p>
                    <div class="input-group mb-3">
                        <input type="email" class="form-control" placeholder="Your email address"
                               aria-label="Email address" aria-describedby="subscribe-button">
                        <button class="btn btn-outline-light" type="button" id="subscribe-button">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </div>
                    <small class="text-muted">We respect your privacy. Unsubscribe at any time.</small>
                </div>
            </div>

            <hr class="my-4" style="border-color: rgba(255,255,255,0.1);">

            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start">
                    <p class="mb-0">&copy; <span id="year"></span> HikingStore. All rights reserved.</p>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <a href="/Home/Privacy/" class="text-white-50 text-decoration-none me-3">Privacy Policy</a>
                    <a href="/Home/Services" class="text-white-50 text-decoration-none">Terms of Service</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        // Navbar scroll effect
        window.addEventListener('scroll', function() {
            const navbar = document.querySelector('.navbar');
            if (window.scrollY > 50) {
                navbar.classList.add('navbar-scrolled');
            } else {
                navbar.classList.remove('navbar-scrolled');
            }
        });

        // Search functionality
        function handleSearch(event) {
            event.preventDefault();
            const searchInput = document.getElementById('navbar-search-input') || document.getElementById('mobile-search-input');
            const searchTerm = searchInput ? searchInput.value.trim() : '';
            if (searchTerm !== '') {
                window.location.href = '/Home/SearchProduct?search=' + encodeURIComponent(searchTerm);
            }
        }

        // Allow Enter key to submit search for both inputs
        const searchInputs = [document.getElementById('navbar-search-input'), document.getElementById('mobile-search-input')];
        searchInputs.forEach(searchInput => {
            if (searchInput) {
                searchInput.addEventListener('keypress', function(e) {
                    if (e.key === 'Enter') {
                        handleSearch(e);
                    }
                });
            }
        });

        // Close mobile search when clicking outside
        document.addEventListener('click', function(e) {
            const mobileSearch = document.getElementById('mobileSearch');
            const mobileSearchBtn = document.querySelector('[data-bs-target="#mobileSearch"]');
            if (mobileSearch && mobileSearchBtn && 
                !mobileSearch.contains(e.target) && 
                !mobileSearchBtn.contains(e.target) &&
                mobileSearch.classList.contains('show')) {
                const bsCollapse = bootstrap.Collapse.getInstance(mobileSearch);
                if (bsCollapse) {
                    bsCollapse.hide();
                }
            }
        });

        // Cart functionality
        function updateCartItem(cartId, quantity) {
            $.post('/Carts/UpdateCartItem', { cartId: cartId, quantity: quantity })
                .done(function(data) {
                    location.reload();
                })
                .fail(function() {
                    alert('Error updating cart item');
                });
        }


        // Smooth scrolling for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });
            document.querySelector("#year").textContent = new Date().getFullYear();

    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>