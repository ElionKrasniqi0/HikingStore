@model double
@{
    var rounded = Math.Round(Model * 2, MidpointRounding.AwayFromZero) / 2;
}
<span class="stars" role="img" aria-label="Rated @Model.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) out of 5">
    @for (var i = 1; i <= 5; i++)
    {
        if (rounded >= i)
        {
            <i class="fa-solid fa-star" aria-hidden="true"></i>
        }
        else if (rounded >= i - 0.5)
        {
            <i class="fa-solid fa-star-half-stroke" aria-hidden="true"></i>
        }
        else
        {
            <i class="fa-regular fa-star empty" aria-hidden="true"></i>
        }
    }
</span>
