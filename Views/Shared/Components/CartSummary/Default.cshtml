@model CartSummaryViewModel
@using HikingStore.Data.ViewComponents

<div class="cart-summary-wrapper" style="position: relative; display: inline-flex; align-items: center; margin-left: 0.25rem;">
    <a title="Shopping cart" id="topcartlink" class="ico-cart flex items-center bg-blur-hover-effect relative mr-2" 
       asp-controller="Carts" asp-action="Index"
       aria-label="Shopping cart - @Model.ItemCount items">
        <span class="icon-cart-shopping text-3xl">
            <i class="fas fa-shopping-cart"></i>
        </span>
        <span class="cart-qty animate-flip bg-primary rounded-full absolute top-0 right-0 text-gray-300 flex" style="@(Model.ItemCount > 0 ? "" : "display: none;")">@Model.ItemCount</span>
    </a>

    <aside id="flyout-cart" class="flyout-cart hidden md:rounded bg-white shadow-md">
        @if (Model.ItemCount > 0)
        {
            <section class="flex w-full justify-between count text-sm text-gray-600 border-b border-gray-300 p-3">
                <a href="/Carts" style="text-decoration: none; color: #4b5563;">&nbsp;@Model.ItemCount product@(Model.ItemCount == 1 ? "" : "s")&nbsp;</a>
                <button name="updatecart" class="remove-all font-medium hover:underline cursor-pointer" onclick="removeAllFromCart()">Remove All</button>
            </section>

            <section class="w-full p-2 flex flex-col gap-1 overflow-y-auto md:max-h-[240px]">
                @foreach (var item in Model.CartItems)
                {
                    <article class="group item first flex justify-between items-center p-2 rounded hover:bg-gray-100 cart-item" id="cart-item-@item.CartId">
                        <a class="w-10 h-10 relative flex justify-center items-center small-image-container mr-4" 
                           href="@Url.Action("ProductDetailes", "Home", new { id = item.ProductId })" 
                           title="Show details for @item.ProductName">
                            @if (!string.IsNullOrEmpty(item.ProductImage))
                            {
                                <img class="max-h-full max-w-full object-contain mix-blend-darken" 
                                     alt="@item.ProductName" 
                                     src="~/Product/@item.ProductImage" 
                                     title="@item.ProductName" 
                                     width="40" height="40">
                            }
                            else
                            {
                                <div class="w-10 h-10 bg-gray-200 flex items-center justify-center">
                                    <i class="fas fa-image text-gray-400"></i>
                                </div>
                            }
                        </a>
                        <div class="name flex flex-col w-4/5 mr-4 text-gray-600 text-xs overflow-hidden">
                            <a title="@item.ProductName" 
                               class="font-medium text-sm text-gray-700 truncate hover:underline w-full mb-1" 
                               href="@Url.Action("ProductDetailes", "Home", new { id = item.ProductId })">@item.ProductName</a>
                            <div class="price mb-1">Unit price: <span class="text-gray-700 font-bold">€@item.Price.ToString("N2")</span></div>
                            <div class="quantity cart-quantity flex items-center gap-1">
                                <input type="button" value="-" 
                                       class="flyout-qty-click-input qtyminus minus bg-white h-5 w-5 rounded-full border text-xs flex items-center justify-center hover:border-primary hover:text-primary focus:text-primary" 
                                       style="height:24px; width:24px" 
                                       data-cart-id="@item.CartId"
                                       data-quantity="decrease"
                                       onclick="updateFlyoutQuantity(@item.CartId, @item.Quantity - 1)">

                                <input name="itemquantity@(item.CartId)" 
                                       id="itemquantity@(item.CartId)" 
                                       type="number" 
                                       value="@item.Quantity" 
                                       class="qty qty-input cart-qty text-gray-700" 
                                       aria-label="Quantity" 
                                       data-productid="@item.ProductId" 
                                       data-itemid="@item.CartId" 
                                       min="1" 
                                       max="1000" 
                                       disabled="">

                                <input type="button" value="+" 
                                       class="flyout-qty-click-input qtyplus plus bg-white h-5 w-5 rounded-full border text-xs flex items-center justify-center hover:border-primary hover:text-primary focus:text-primary" 
                                       style="height:24px; width:24px" 
                                       data-cart-id="@item.CartId"
                                       data-quantity="increase"
                                       onclick="updateFlyoutQuantity(@item.CartId, @item.Quantity + 1)">
                            </div>
                        </div>

                        <button name="updatecart" 
                                type="button"
                                class="icon-trash self-start" 
                                onclick="removeFromFlyoutCart(@item.CartId)"
                                title="Remove item from cart"
                                aria-label="Remove @item.ProductName from cart">
                            <i class="fas fa-trash"></i>
                        </button>
                    </article>
                }
            </section>
            <section class="buttons flex justify-center p-3 border-t">
                <button type="button" class="cart-button w-full text-sm text-center" onclick="window.location.href='/Carts'">
                    <span class="mx-auto">Go to cart (€@Model.TotalAmount.ToString("N2"))</span>
                </button>
            </section>
        }
        else
        {
            <section class="w-full p-4 text-center text-gray-500">
                <i class="fas fa-shopping-cart text-4xl mb-2"></i>
                <p>Your cart is empty</p>
            </section>
        }
    </aside>
</div>

<style>
    /* Cart Summary Wrapper */
    .cart-summary-wrapper {
        position: relative;
        display: inline-flex;
        align-items: center;
    }

    /* Cart Icon Styles - Matching gjirafa50.com */
    .ico-cart {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.5rem;
        color: #ffffff;
        text-decoration: none;
        transition: opacity 0.2s ease;
        cursor: pointer;
        outline: none;
        border: none;
        box-shadow: none;
    }

    .ico-cart:hover {
        opacity: 0.8;
    }

    .ico-cart:focus,
    .ico-cart:active,
    .ico-cart:focus-visible {
        outline: none;
        border: none;
        box-shadow: none;
    }

    .icon-cart-shopping {
        font-size: 1.5rem;
        color: #000;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Cart Badge - Orange like gjirafa50.com */
    .cart-qty {
        position: absolute;
        top: 0;
        right: 0;
        background: #ff6600;
        color: #ffffff;
        border-radius: 50%;
        min-width: 20px;
        height: 20px;
        padding: 0 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.7rem;
        font-weight: 700;
        transform: translate(25%, -25%);
        z-index: 10;
    }

    /* Flyout Cart */
    .flyout-cart {
        position: absolute;
        top: 100%;
        right: 0;
        width: 380px;
        max-width: 90vw;
        background: #ffffff;
        border-radius: 8px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
        border: 1px solid rgba(0, 0, 0, 0.1);
        margin-top: 0.5rem;
        opacity: 0;
        visibility: hidden;
        transform: translateY(-10px);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: 1000;
        overflow: hidden;
    }

    .flyout-cart.show {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    .flyout-cart:hover {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    /* Flyout Header */
    .flyout-cart section.count {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.75rem 1rem;
        border-bottom: 1px solid #e5e7eb;
        background: #ffffff;
    }

    .flyout-cart section.count a {
        color: #4b5563;
        text-decoration: none;
        font-weight: 500;
    }

    .flyout-cart section.count a:hover {
        text-decoration: underline;
        color: #4b5563;
    }

    .remove-all {
        color: #ff6600;
        background: none;
        border: none;
        cursor: pointer;
        font-weight: 500;
        padding: 0;
        text-decoration: none;
    }

    .remove-all:hover {
        text-decoration: underline;
        color: #ff6600;
    }

    /* Cart Items List */
    .flyout-cart section.w-full {
        max-height: 300px;
        overflow-y: auto;
    }

    .cart-item {
        transition: background-color 0.2s ease;
    }

    .cart-item:hover {
        background-color: #f3f4f6;
    }

    .small-image-container {
        flex-shrink: 0;
    }

    .small-image-container img {
        object-fit: contain;
    }

    /* Quantity Controls */
    .cart-quantity {
        margin-top: 0.5rem;
    }

    .qtyminus,
    .qtyplus {
        cursor: pointer;
        border: 1px solid #d1d5db;
        background: #ffffff;
        transition: all 0.2s ease;
    }

    .qtyminus:hover,
    .qtyplus:hover {
        border-color: #ff6600;
        color: #ff6600;
    }

    .qty-input {
        width: 40px;
        text-align: center;
        border: 1px solid #d1d5db;
        border-radius: 4px;
        padding: 0.25rem;
    }

    /* Remove Button - Professional styling */
    .icon-trash {
        cursor: pointer;
        transition: all 0.2s ease;
        padding: 0.5rem;
        border: none;
        background: transparent;
        color: #9ca3af;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        width: 32px;
        height: 32px;
        outline: none;
    }

    .icon-trash:hover {
        color: #ff6600;
        background-color: rgba(255, 102, 0, 0.1);
        transform: scale(1.1);
    }

    .icon-trash:active {
        transform: scale(0.95);
    }

    .icon-trash:focus {
        outline: none;
        box-shadow: 0 0 0 2px rgba(255, 102, 0, 0.2);
    }

    .icon-trash i {
        font-size: 1rem;
    }

    /* Footer Button */
    .flyout-cart section.buttons {
        border-top: 1px solid #e5e7eb;
        padding: 0.75rem 1rem;
    }

    .cart-button {
        background: #ff6600;
        color: #ffffff;
        border: none;
        border-radius: 6px;
        padding: 0.75rem 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.2s ease;
        width: 100%;
    }

    .cart-button:hover {
        background: #e55a00;
        color: #ffffff;
    }

    /* Animations */
    @@keyframes animate-flip {
        0% {
            transform: translate(25%, -25%) scale(1);
        }
        50% {
            transform: translate(25%, -25%) scale(1.2);
        }
        100% {
            transform: translate(25%, -25%) scale(1);
        }
    }

    .animate-flip {
        animation: animate-flip 0.3s ease;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .flyout-cart {
            width: 320px;
            right: -50%;
        }
    }

    @@media (max-width: 576px) {
        .flyout-cart {
            width: 280px;
            right: -100%;
        }
    }
</style>

<script>
    // Use global updateCartCount from layout if available
    if (typeof window.updateCartCount !== 'function') {
        window.updateCartCount = function(count) {
            const cartBadge = document.querySelector('.cart-qty');
            if (cartBadge) {
                if (count > 0) {
                    cartBadge.textContent = count;
                    cartBadge.style.display = 'flex';
                } else {
                    cartBadge.style.display = 'none';
                }
            }
        };
    }

    // Update quantity in flyout
    function updateFlyoutQuantity(cartId, newQuantity) {
        if (newQuantity < 1) {
            removeFromFlyoutCart(cartId);
            return;
        }

        fetch('/Carts/UpdateCartItem', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            },
            body: `cartId=${cartId}&quantity=${newQuantity}`
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Update cart count
                if (typeof window.updateCartCount === 'function') {
                    window.updateCartCount(data.cartItemCount);
                }
                // Update flyout without reload
                if (typeof window.updateCartFlyout === 'function') {
                    window.updateCartFlyout();
                }
            } else {
                alert(data.message || 'Error updating cart item');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Error updating cart item');
        });
    }

    // Remove item from flyout cart
    function removeFromFlyoutCart(cartId) {
        if (!confirm('Are you sure you want to remove this item from your cart?')) {
            return;
        }

        fetch('/Carts/RemoveFromCart?cartId=' + cartId, {
            method: 'POST',
            headers: {
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Update cart count
                if (typeof window.updateCartCount === 'function') {
                    window.updateCartCount(data.cartItemCount);
                }
                // Update flyout without reload
                if (typeof window.updateCartFlyout === 'function') {
                    window.updateCartFlyout();
                }
            } else {
                alert(data.message || 'Error removing item');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Error removing item');
        });
    }

    // Remove all items from cart
    function removeAllFromCart() {
        if (!confirm('Are you sure you want to remove all items from your cart?')) {
            return;
        }

        fetch('/Carts/RemoveAll', {
            method: 'POST',
            headers: {
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Update cart count
                if (typeof window.updateCartCount === 'function') {
                    window.updateCartCount(0);
                }
                // Update flyout without reload
                if (typeof window.updateCartFlyout === 'function') {
                    window.updateCartFlyout();
                }
            } else {
                alert(data.message || 'Error removing all items');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Error removing all items');
        });
    }

    // Listen for cart updates
    window.addEventListener('cartUpdated', function(event) {
        if (event.detail && event.detail.cartItemCount !== undefined) {
            if (typeof window.updateCartCount === 'function') {
                window.updateCartCount(event.detail.cartItemCount);
            }
            // Update flyout without reload
            if (typeof window.updateCartFlyout === 'function') {
                window.updateCartFlyout();
            }
        }
    });

    document.addEventListener('DOMContentLoaded', function() {
        // Toggle flyout on click
        const flyoutCart = document.getElementById('flyout-cart');
        const cartLink = document.getElementById('topcartlink');
        const cartWrapper = document.querySelector('.cart-summary-wrapper');
        
        if (flyoutCart && cartLink && cartWrapper) {
            let hoverTimeout;
            let isOpen = false;
            
            function showFlyout() {
                clearTimeout(hoverTimeout);
                flyoutCart.classList.remove('hidden');
                flyoutCart.classList.add('show');
                isOpen = true;
            }
            
            function hideFlyout() {
                hoverTimeout = setTimeout(() => {
                    flyoutCart.classList.remove('show');
                    flyoutCart.classList.add('hidden');
                    isOpen = false;
                }, 200);
            }
            
            // Toggle on click
            cartLink.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                if (isOpen) {
                    hideFlyout();
                } else {
                    showFlyout();
                }
            });
            
            // Allow navigation when clicking "Go to cart" button
            const goToCartBtn = flyoutCart.querySelector('.cart-button');
            if (goToCartBtn) {
                goToCartBtn.addEventListener('click', function(e) {
                    window.location.href = '/Carts';
                });
            }
            
            // Keep open on hover
            cartWrapper.addEventListener('mouseenter', function() {
                if (isOpen) {
                    clearTimeout(hoverTimeout);
                }
            });
            
            cartWrapper.addEventListener('mouseleave', hideFlyout);
            flyoutCart.addEventListener('mouseenter', function() {
                clearTimeout(hoverTimeout);
            });
            flyoutCart.addEventListener('mouseleave', hideFlyout);
            
            // Close when clicking outside
            document.addEventListener('click', function(e) {
                if (isOpen && 
                    !cartWrapper.contains(e.target) && 
                    !flyoutCart.contains(e.target)) {
                    hideFlyout();
                }
            });
        }
    });
</script>
