@model int

<div class="cart-summary-wrapper">
    <a class="cart-summary-link position-relative text-decoration-none"
       asp-controller="Carts" asp-action="Index"
       aria-label="Shopping cart - @Model items"
       data-bs-toggle="tooltip"
       data-bs-placement="bottom"
       data-bs-title="View your shopping cart">

        <!-- Cart Icon Container -->
        <div class="cart-icon-container">
            <!-- Main Cart Icon -->
            <div class="cart-icon-main">
                <i class="fas fa-shopping-bag"></i>
            </div>

            <!-- Cart Badge with Count -->
            @if (Model > 0)
            {
                <div class="cart-badge" aria-live="polite" aria-atomic="true">
                    <span class="cart-count">@Model</span>
                    <div class="cart-pulse"></div>
                </div>

                <!-- Mini Cart Preview (Desktop only) -->
                <div class="cart-preview-indicator"></div>
            }
            else
            {
                <div class="cart-badge empty" aria-label="Cart is empty">
                    <span class="cart-count">0</span>
                </div>
            }
        </div>

        <!-- Cart Text (Desktop only) -->
        <div class="cart-text d-none d-md-block">
            <div class="cart-label">Cart</div>
            @if (Model > 0)
            {
                <div class="cart-items-count">@Model item@(Model == 1 ? "" : "s")</div>
            }
            else
            {
                <div class="cart-items-count empty">Empty</div>
            }
        </div>
    </a>

    <!-- Cart Preview Dropdown (Desktop only) -->
    @if (Model > 0)
    {
        <div class="cart-preview-dropdown">
            <div class="cart-preview-header">
                <h6 class="mb-0">Your Cart</h6>
                <span class="cart-preview-count">@Model item@(Model == 1 ? "" : "s")</span>
            </div>
            <div class="cart-preview-content">
                <div class="cart-preview-message">
                    <i class="fas fa-shopping-bag me-2"></i>
                    <span>Items added to your cart</span>
                </div>
            </div>
            <div class="cart-preview-footer">
                <a asp-controller="Carts" asp-action="Index" class="btn btn-primary btn-sm w-100">
                    View Cart & Checkout
                </a>
            </div>
        </div>
    }
</div>

<style>
    /* Cart Summary Wrapper */
    .cart-summary-wrapper {
        position: relative;
        display: inline-block;
    }

    /* Cart Summary Link */
    .cart-summary-link {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.5rem 1rem;
        border-radius: 10px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid transparent;
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(10px);
        color: var(--dark-text);
    }

        .cart-summary-link:hover {
            background: var(--white);
            border-color: rgba(59, 93, 80, 0.2);
            box-shadow: 0 4px 15px rgba(59, 93, 80, 0.15);
            transform: translateY(-1px);
            color: var(--primary-light);
            text-decoration: none;
        }

        .cart-summary-link:active {
            transform: translateY(0);
        }

    /* Cart Icon Container */
    .cart-icon-container {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Main Cart Icon */
    .cart-icon-main {
        width: 44px;
        height: 44px;
        background: linear-gradient(135deg, var(--primary-light), var(--primary-color));
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--white);
        font-size: 1.1rem;
        box-shadow: 0 4px 12px rgba(59, 93, 80, 0.25);
        transition: all 0.3s ease;
        position: relative;
        z-index: 2;
    }

    .cart-summary-link:hover .cart-icon-main {
        transform: scale(1.05) rotate(-5deg);
        box-shadow: 0 6px 20px rgba(59, 93, 80, 0.4);
    }

    /* Cart Badge */
    .cart-badge {
        position: absolute;
        top: -6px;
        right: -6px;
        background: linear-gradient(135deg, #e74c3c, #c0392b);
        color: var(--white);
        border-radius: 12px;
        min-width: 22px;
        height: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.7rem;
        font-weight: 700;
        border: 2px solid var(--white);
        box-shadow: 0 2px 8px rgba(231, 76, 60, 0.4);
        z-index: 3;
        animation: badgeAppear 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .cart-badge.empty {
            background: var(--gray-light);
            box-shadow: 0 2px 8px rgba(108, 117, 125, 0.3);
        }

    .cart-count {
        line-height: 1;
        font-variant-numeric: tabular-nums;
    }

    /* Cart Pulse Animation */
    .cart-pulse {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        border-radius: 50%;
        background: inherit;
        animation: pulse 2s infinite;
        z-index: -1;
    }

    /* Cart Text */
    .cart-text {
        text-align: left;
        line-height: 1.2;
    }

    .cart-label {
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--dark-text);
        margin-bottom: 0.125rem;
    }

    .cart-items-count {
        font-size: 0.75rem;
        color: var(--gray-light);
        font-weight: 500;
    }

        .cart-items-count.empty {
            font-style: italic;
            color: var(--gray-light);
        }

    /* Cart Preview Dropdown */
    .cart-preview-dropdown {
        position: absolute;
        top: 100%;
        right: 0;
        width: 320px;
        background: var(--white);
        border-radius: 16px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
        border: 1px solid rgba(0, 0, 0, 0.08);
        margin-top: 0.75rem;
        opacity: 0;
        visibility: hidden;
        transform: translateY(-10px);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: 1000;
        overflow: hidden;
    }

    .cart-summary-wrapper:hover .cart-preview-dropdown {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    .cart-preview-header {
        padding: 1.25rem 1.5rem 0.75rem;
        border-bottom: 1px solid rgba(0, 0, 0, 0.06);
        background: linear-gradient(135deg, #f8f9fa, #e9ecef);
    }

        .cart-preview-header h6 {
            color: var(--dark-text);
            font-weight: 700;
        }

    .cart-preview-count {
        font-size: 0.8rem;
        color: var(--primary-light);
        font-weight: 600;
    }

    .cart-preview-content {
        padding: 1.5rem;
    }

    .cart-preview-message {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        background: rgba(59, 93, 80, 0.05);
        border-radius: 10px;
        color: var(--primary-light);
        font-weight: 500;
    }

    .cart-preview-footer {
        padding: 1rem 1.5rem 1.5rem;
        border-top: 1px solid rgba(0, 0, 0, 0.06);
    }

        .cart-preview-footer .btn {
            border-radius: 8px;
            font-weight: 600;
            padding: 0.75rem 1rem;
        }

    /* Preview Indicator */
    .cart-preview-indicator {
        position: absolute;
        bottom: -2px;
        right: -2px;
        width: 8px;
        height: 8px;
        background: var(--secondary-color);
        border-radius: 50%;
        border: 2px solid var(--white);
        animation: previewPulse 3s infinite;
    }

    /* Animations */
    @@keyframes badgeAppear {
        0% {
            transform: scale(0) rotate(-180deg);
            opacity: 0;
        }

        50% {
            transform: scale(1.2) rotate(-90deg);
        }

        100% {
            transform: scale(1) rotate(0);
            opacity: 1;
        }
    }

    @@keyframes pulse {
        0% {
            transform: scale(1);
            opacity: 1;
        }

        50% {
            transform: scale(1.8);
            opacity: 0;
        }

        100% {
            transform: scale(2.2);
            opacity: 0;
        }
    }

    @@keyframes previewPulse {
        0%, 100% {
            opacity: 1;
            transform: scale(1);
        }

        50% {
            opacity: 0.7;
            transform: scale(1.2);
        }
    }

    /* New Item Animation */
    .cart-badge.new-item {
        animation: newItemBounce 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }

    @@keyframes newItemBounce {
        0%, 20%, 53%, 80%, 100% {
            transform: scale(1) translate3d(0,0,0);
        }

        40%, 43% {
            transform: scale(1.3) translate3d(0,-8px,0);
        }

        70% {
            transform: scale(1.2) translate3d(0,-4px,0);
        }

        90% {
            transform: scale(1.1) translate3d(0,-2px,0);
        }
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .cart-summary-link {
            padding: 0.375rem 0.75rem;
            gap: 0.5rem;
        }

        .cart-icon-main {
            width: 40px;
            height: 40px;
            font-size: 1rem;
            border-radius: 10px;
        }

        .cart-badge {
            min-width: 20px;
            height: 20px;
            font-size: 0.65rem;
            top: -4px;
            right: -4px;
        }

        .cart-preview-dropdown {
            width: 280px;
            right: -50%;
        }
    }

    @@media (max-width: 576px) {
        .cart-summary-link {
            padding: 0.25rem 0.5rem;
        }

        .cart-icon-main {
            width: 36px;
            height: 36px;
            font-size: 0.9rem;
        }

        .cart-badge {
            min-width: 18px;
            height: 18px;
            font-size: 0.6rem;
        }

        .cart-text {
            display: none !important;
        }
    }

    /* Focus States for Accessibility */
    .cart-summary-link:focus {
        outline: 2px solid var(--primary-light);
        outline-offset: 2px;
        background: var(--white);
        box-shadow: 0 0 0 4px rgba(59, 93, 80, 0.1);
    }

    /* High Contrast Mode Support */
    @@media (prefers-contrast: high) {
        .cart-summary-link {
            border: 2px solid currentColor;
        }

        .cart-badge {
            border: 2px solid var(--white);
        }
    }

    /* Reduced Motion Support */
    @@media (prefers-reduced-motion: reduce) {
        .cart-summary-link,
        .cart-icon-main,
        .cart-badge,
        .cart-preview-dropdown {
            transition: none;
            animation: none;
        }

        .cart-pulse {
            display: none;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const cartLink = document.querySelector('.cart-summary-link');
        const cartBadge = document.querySelector('.cart-badge');

        if (cartLink && cartBadge) {
            // Add tooltip initialization
            const tooltip = new bootstrap.Tooltip(cartLink);

            // Handle focus for accessibility
            cartLink.addEventListener('focus', function() {
                this.style.outline = '2px solid var(--primary-light)';
                this.style.outlineOffset = '2px';
            });

            cartLink.addEventListener('blur', function() {
                this.style.outline = '';
            });

            // Add new item animation when count changes
            const currentCount = @Model;
            const previousCount = sessionStorage.getItem('previousCartCount');

            if (previousCount && currentCount > parseInt(previousCount)) {
                cartBadge.classList.add('new-item');
                setTimeout(() => {
                    cartBadge.classList.remove('new-item');
                }, 1000);
            }

            // Store current count for next comparison
            sessionStorage.setItem('previousCartCount', currentCount);

            // Keyboard navigation
            cartLink.addEventListener('keydown', function(e) {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    window.location.href = this.href;
                }
            });
        }

        // Close cart preview when clicking outside
        document.addEventListener('click', function(e) {
            const cartWrapper = document.querySelector('.cart-summary-wrapper');
            const cartPreview = document.querySelector('.cart-preview-dropdown');

            if (cartWrapper && cartPreview && !cartWrapper.contains(e.target)) {
                cartPreview.style.opacity = '0';
                cartPreview.style.visibility = 'hidden';
            }
        });
    });
</script>
