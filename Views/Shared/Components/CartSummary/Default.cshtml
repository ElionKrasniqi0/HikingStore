@model CartSummaryViewModel
@using HikingStore.Data.ViewComponents

<div class="cart-summary-wrapper" style="position: relative; display: inline-flex; align-items: center; margin-left: 0.25rem;">
    <a title="Shopping cart" id="topcartlink" class="ico-cart flex items-center bg-blur-hover-effect relative mr-2"
       asp-controller="Carts" asp-action="Index"
       aria-label="Shopping cart - @Model.ItemCount items">
        <span class="icon-cart-shopping text-3xl">
            <i class="fas fa-shopping-cart"></i>
        </span>
        <span class="cart-qty animate-flip bg-primary rounded-full absolute top-0 right-0 text-gray-300 flex" style="@(Model.ItemCount > 0 ? "" : "display: none;")">@Model.ItemCount</span>
    </a>

    <aside id="flyout-cart" class="flyout-cart hidden md:rounded bg-white shadow-md">
        @if (Model.ItemCount > 0)
        {
            <section class="flyout-cart-header">
                <span class="flyout-cart-count">@Model.ItemCount product@(Model.ItemCount == 1 ? "" : "s")</span>
                <button type="button" name="updatecart" class="flyout-remove-all" onclick="removeAllFromCart()">Remove All</button>
            </section>

            <section class="flyout-cart-items">
                @foreach (var item in Model.CartItems)
                {
                    <article class="flyout-cart-item cart-item" id="cart-item-@item.CartId">
                        <a class="flyout-item-image"
                           href="@Url.Action("ProductDetailes", "Home", new { id = item.ProductId })"
                           title="Show details for @item.ProductName">
                            @if (!string.IsNullOrEmpty(item.ProductImage))
                            {
                                <img alt="@item.ProductName"
                                     src="~/Product/@item.ProductImage"
                                     title="@item.ProductName"
                                     width="40" height="40">
                            }
                            else
                            {
                                <div class="flyout-item-placeholder">
                                    <i class="fas fa-image"></i>
                                </div>
                            }
                        </a>
                        <div class="flyout-item-details">
                            <a class="flyout-item-name" title="@item.ProductName"
                               href="@Url.Action("ProductDetailes", "Home", new { id = item.ProductId })">@item.ProductName</a>
                            <div class="flyout-item-price">Unit price: <strong>€@item.Price.ToString("N2")</strong></div>
                            <div class="flyout-item-linetotal">Line total: <strong>€@((item.Price * item.Quantity).ToString("N2"))</strong></div>
                            <div class="flyout-item-qty">
                                <input type="button" value="-"
                                       class="flyout-qty-btn flyout-qty-minus"
                                       data-cart-id="@item.CartId"
                                       data-quantity="decrease"
                                       onclick="updateFlyoutQuantity(@item.CartId, @item.Quantity - 1)"
                                       aria-label="Decrease quantity">
                                <input name="itemquantity@(item.CartId)"
                                       id="itemquantity@(item.CartId)"
                                       type="number"
                                       value="@item.Quantity"
                                       class="flyout-qty-input cart-qty"
                                       aria-label="Quantity"
                                       data-productid="@item.ProductId"
                                       data-itemid="@item.CartId"
                                       min="1"
                                       max="1000"
                                       disabled="">
                                <input type="button" value="+"
                                       class="flyout-qty-btn flyout-qty-plus"
                                       data-cart-id="@item.CartId"
                                       data-quantity="increase"
                                       onclick="updateFlyoutQuantity(@item.CartId, @item.Quantity + 1)"
                                       aria-label="Increase quantity">
                            </div>
                        </div>
                        <button type="button" name="updatecart" class="flyout-item-remove"
                                onclick="removeFromFlyoutCart(@item.CartId)"
                                title="Remove item from cart"
                                aria-label="Remove @item.ProductName from cart">
                            <i class="fas fa-trash"></i>
                        </button>
                    </article>
                }
            </section>
            <section class="flyout-cart-footer">
                <button type="button" class="flyout-cart-cta" onclick="window.location.href='/Carts'">
                    Go to cart (€@Model.TotalAmount.ToString("N2"))
                </button>
            </section>
        }
        else
        {
            <section class="flyout-cart-empty">
                <i class="fas fa-shopping-cart"></i>
                <p>Your cart is empty</p>
            </section>
        }
    </aside>
</div>

<style>
    /* App primary color */
    :root {
        --flyout-primary: #3b5d50;
        --flyout-primary-hover: #2d473d;
        --flyout-text: #1f2937;
        --flyout-text-muted: #6b7280;
        --flyout-border: #e5e7eb;
    }

    .cart-summary-wrapper {
        position: relative;
        display: inline-flex;
        align-items: center;
    }

    .ico-cart {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.5rem;
        color: #ffffff;
        text-decoration: none;
        transition: opacity 0.2s ease;
        cursor: pointer;
        outline: none;
        border: none;
        box-shadow: none;
    }

        .ico-cart:hover {
            opacity: 0.8;
        }

        .ico-cart:focus, .ico-cart:active, .ico-cart:focus-visible {
            outline: none;
            border: none;
            box-shadow: none;
        }

    .icon-cart-shopping {
        font-size: 1.5rem;
        color: #000;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .cart-qty {
        position: absolute;
        top: 0;
        right: 0;
        background: var(--flyout-primary);
        color: #ffffff;
        border-radius: 50%;
        min-width: 20px;
        height: 20px;
        padding: 0 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.7rem;
        font-weight: 700;
        transform: translate(25%, -25%);
        z-index: 10;
    }

    /* Flyout panel - gjirafa50-style layout */
    .flyout-cart {
        position: absolute;
        top: 100%;
        right: 0;
        width: 380px;
        max-width: 90vw;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.12);
        border: 1px solid var(--flyout-border);
        margin-top: 0.5rem;
        opacity: 0;
        visibility: hidden;
        transform: translateY(-8px);
        transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
        z-index: 1000;
        overflow: hidden;
    }

        .flyout-cart.show,
        .flyout-cart:hover {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

    /* Header: count + Remove All */
    .flyout-cart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.75rem 1rem;
        border-bottom: 1px solid var(--flyout-border);
        background: #fff;
    }

    .flyout-cart-count {
        font-size: 0.875rem;
        color: var(--flyout-text-muted);
    }

    .flyout-remove-all {
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--flyout-primary);
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
        text-decoration: none;
        transition: color 0.15s ease;
    }

        .flyout-remove-all:hover {
            text-decoration: underline;
            color: var(--flyout-primary-hover);
        }

        .flyout-remove-all:focus {
            outline: none;
            box-shadow: none;
        }

    /* Scrollable items list */
    .flyout-cart-items {
        max-height: 240px;
        overflow-y: auto;
        padding: 0.5rem;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .flyout-cart-item {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        padding: 0.75rem;
        border-radius: 6px;
        transition: background-color 0.15s ease;
    }

        .flyout-cart-item:hover {
            background-color: #f9fafb;
        }

    .flyout-item-image {
        flex-shrink: 0;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border-radius: 4px;
        background: #f3f4f6;
    }

        .flyout-item-image img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            mix-blend-mode: darken;
        }

    .flyout-item-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #9ca3af;
        font-size: 1rem;
    }

    .flyout-item-details {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .flyout-item-name {
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--flyout-text);
        text-decoration: none;
        display: block;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        line-height: 1.3;
    }

        .flyout-item-name:hover {
            text-decoration: underline;
            color: var(--flyout-primary);
        }

    .flyout-item-price {
        font-size: 0.75rem;
        color: var(--flyout-text-muted);
    }

        .flyout-item-price strong {
            color: var(--flyout-text);
            font-weight: 600;
        }

    .flyout-item-linetotal {
        font-size: 0.75rem;
        color: var(--flyout-text-muted);
        margin-top: 0.125rem;
    }

        .flyout-item-linetotal strong {
            color: var(--flyout-primary);
            font-weight: 600;
        }

    .flyout-item-qty {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        margin-top: 0.25rem;
    }

    .flyout-qty-btn {
        width: 26px;
        height: 26px;
        min-width: 26px;
        min-height: 26px;
        border-radius: 50%;
        border: 1px solid var(--flyout-border);
        background: #fff;
        color: var(--flyout-text-muted);
        font-size: 0.875rem;
        font-weight: 600;
        line-height: 1;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
        -webkit-appearance: none;
        appearance: none;
    }

        .flyout-qty-btn:hover {
            border-color: var(--flyout-primary);
            color: var(--flyout-primary);
            background: rgba(59, 93, 80, 0.06);
        }

        .flyout-qty-btn:focus {
            outline: none;
            box-shadow: 0 0 0 2px rgba(59, 93, 80, 0.2);
        }

    .flyout-qty-input {
        width: 2.25rem;
        min-width: 2.25rem;
        height: 26px;
        text-align: center;
        border: 1px solid var(--flyout-border);
        border-radius: 4px;
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--flyout-text);
        background: #fff;
        padding: 0 2px;
        -moz-appearance: textfield;
        appearance: textfield;
        display: inline-block;
        box-sizing: border-box;
    }

        .flyout-qty-input::-webkit-outer-spin-button,
        .flyout-qty-input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }
        /* Keep disabled quantity input clearly visible (read-only display) */
        .flyout-qty-input:disabled {
            opacity: 1;
            cursor: default;
            background: #f9fafb;
        }

    /* Remove item: trash icon only, right-aligned in row */
    .flyout-item-remove {
        flex-shrink: 0;
        width: 36px;
        height: 36px;
        min-width: 36px;
        min-height: 36px;
        border: none;
        background: transparent;
        color: var(--flyout-text-muted);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        padding: 0;
        transition: color 0.15s ease, background 0.15s ease;
        align-self: flex-start;
        -webkit-appearance: none;
        appearance: none;
    }

        .flyout-item-remove:hover {
            color: var(--flyout-primary);
            background: rgba(59, 93, 80, 0.08);
        }

        .flyout-item-remove:focus {
            outline: none;
            box-shadow: 0 0 0 2px rgba(59, 93, 80, 0.2);
        }

        .flyout-item-remove i {
            font-size: 0.9375rem;
            display: inline-block;
        }

    /* Footer CTA - full-width primary button */
    .flyout-cart-footer {
        padding: 0.75rem 1rem;
        border-top: 1px solid var(--flyout-border);
        background: #fff;
    }

    .flyout-cart-cta {
        width: 100%;
        padding: 0.75rem 1rem;
        font-size: 0.875rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.02em;
        color: #fff;
        background: var(--flyout-primary);
        border: none;
        border-radius: 6px;
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

        .flyout-cart-cta:hover {
            background: var(--flyout-primary-hover);
            color: #fff;
        }

    /* Empty state */
    .flyout-cart-empty {
        padding: 1.5rem 1rem;
        text-align: center;
        color: var(--flyout-text-muted);
    }

        .flyout-cart-empty i {
            font-size: 2rem;
            margin-bottom: 0.5rem;
            display: block;
            opacity: 0.6;
        }

        .flyout-cart-empty p {
            margin: 0;
            font-size: 0.875rem;
        }

    @@keyframes animate-flip {
        0% {
            transform: translate(25%, -25%) scale(1);
        }

        50% {
            transform: translate(25%, -25%) scale(1.2);
        }

        100% {
            transform: translate(25%, -25%) scale(1);
        }
    }

    .animate-flip {
        animation: animate-flip 0.3s ease;
    }

    @@media (max-width: 768px) {
        .flyout-cart {
            width: 320px;
            right: -50%;
        }
    }

    @@media (max-width: 576px) {
        .flyout-cart {
            width: 280px;
            right: -100%;
        }
    }
</style>

<script>
    // Use global updateCartCount from layout if available
    if (typeof window.updateCartCount !== 'function') {
        window.updateCartCount = function(count) {
            const cartBadge = document.querySelector('.cart-qty');
            if (cartBadge) {
                if (count > 0) {
                    cartBadge.textContent = count;
                    cartBadge.style.display = 'flex';
                } else {
                    cartBadge.style.display = 'none';
                }
            }
        };
    }

    // Helper so flyout POSTs have anti-forgery token (from layout's hidden form)
    function getRequestVerificationToken() {
        var input = document.querySelector('input[name="__RequestVerificationToken"]');
        return input ? input.value : '';
    }

    // Update quantity in flyout — in-place update so the product row does not move
    window.updateFlyoutQuantity = function(cartId, newQuantity) {
        if (newQuantity < 1) {
            window.removeFromFlyoutCart(cartId);
            return;
        }
        var token = getRequestVerificationToken();
        var body = 'cartId=' + encodeURIComponent(cartId) + '&quantity=' + encodeURIComponent(newQuantity) + '&__RequestVerificationToken=' + encodeURIComponent(token);
        fetch('/Carts/UpdateCartItem', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body
        })
        .then(function(response) { return response.json(); })
        .then(function(data) {
            if (data.success) {
                if (typeof window.updateCartCount === 'function') {
                    window.updateCartCount(data.cartItemCount);
                }
                // Update flyout in place so the list doesn't re-render and items don't move
                var article = document.getElementById('cart-item-' + cartId);
                if (article) {
                    var qtyInput = article.querySelector('.flyout-qty-input');
                    if (qtyInput) qtyInput.value = newQuantity;
                    var minusBtn = article.querySelector('.flyout-qty-minus');
                    if (minusBtn) minusBtn.setAttribute('onclick', 'updateFlyoutQuantity(' + cartId + ', ' + (newQuantity - 1) + ')');
                    var plusBtn = article.querySelector('.flyout-qty-plus');
                    if (plusBtn) plusBtn.setAttribute('onclick', 'updateFlyoutQuantity(' + cartId + ', ' + (newQuantity + 1) + ')');
                }
                var countEl = document.querySelector('.flyout-cart-count');
                if (countEl) countEl.textContent = data.cartItemCount + ' product' + (data.cartItemCount === 1 ? '' : 's');
                var ctaBtn = document.querySelector('.flyout-cart-cta');
                if (ctaBtn) ctaBtn.textContent = 'Go to cart (€' + (typeof data.totalAmount === 'number' ? data.totalAmount.toFixed(2) : data.totalAmount) + ')';
                // Update this item's line total (+ adds unit price, - removes unit price)
                var lineTotalEl = article ? article.querySelector('.flyout-item-linetotal') : null;
                if (lineTotalEl && data.itemTotal != null) {
                    var val = typeof data.itemTotal === 'number' ? data.itemTotal.toFixed(2) : data.itemTotal;
                    lineTotalEl.innerHTML = 'Line total: <strong>€' + val + '</strong>';
                }
            } else {
                alert(data.message || 'Error updating cart item');
            }
        })
        .catch(function(error) {
            console.error('Error:', error);
            alert('Error updating cart item');
        });
    };

    // Remove item from flyout cart
    window.removeFromFlyoutCart = function(cartId) {
        if (!confirm('Are you sure you want to remove this item from your cart?')) {
            return;
        }
        var token = getRequestVerificationToken();
        fetch('/Carts/RemoveFromCart', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'cartId=' + encodeURIComponent(cartId) + '&__RequestVerificationToken=' + encodeURIComponent(token)
        })
        .then(function(response) { return response.json(); })
        .then(function(data) {
            if (data.success) {
                if (typeof window.updateCartCount === 'function') {
                    window.updateCartCount(data.cartItemCount);
                }
                if (typeof window.updateCartFlyout === 'function') {
                    window.updateCartFlyout();
                }
            } else {
                alert(data.message || 'Error removing item');
            }
        })
        .catch(function(error) {
            console.error('Error:', error);
            alert('Error removing item');
        });
    };

    // Remove all items from cart
    window.removeAllFromCart = function() {
        if (!confirm('Are you sure you want to remove all items from your cart?')) {
            return;
        }
        var token = getRequestVerificationToken();
        fetch('/Carts/RemoveAll', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: '__RequestVerificationToken=' + encodeURIComponent(token)
        })
        .then(function(response) { return response.json(); })
        .then(function(data) {
            if (data.success) {
                if (typeof window.updateCartCount === 'function') {
                    window.updateCartCount(0);
                }
                if (typeof window.updateCartFlyout === 'function') {
                    window.updateCartFlyout();
                }
            } else {
                alert(data.message || 'Error removing all items');
            }
        })
        .catch(function(error) {
            console.error('Error:', error);
            alert('Error removing all items');
        });
    };

    // Listen for cart updates
    window.addEventListener('cartUpdated', function(event) {
        if (event.detail && event.detail.cartItemCount !== undefined) {
            if (typeof window.updateCartCount === 'function') {
                window.updateCartCount(event.detail.cartItemCount);
            }
            // Update flyout without reload
            if (typeof window.updateCartFlyout === 'function') {
                window.updateCartFlyout();
            }
        }
    });

    document.addEventListener('DOMContentLoaded', function() {
        // Toggle flyout on click
        const flyoutCart = document.getElementById('flyout-cart');
        const cartLink = document.getElementById('topcartlink');
        const cartWrapper = document.querySelector('.cart-summary-wrapper');

        if (flyoutCart && cartLink && cartWrapper) {
            let hoverTimeout;
            let isOpen = false;

            function showFlyout() {
                clearTimeout(hoverTimeout);
                flyoutCart.classList.remove('hidden');
                flyoutCart.classList.add('show');
                isOpen = true;
            }

            function hideFlyout() {
                hoverTimeout = setTimeout(() => {
                    flyoutCart.classList.remove('show');
                    flyoutCart.classList.add('hidden');
                    isOpen = false;
                }, 200);
            }

            // Toggle on click
            cartLink.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                if (isOpen) {
                    hideFlyout();
                } else {
                    showFlyout();
                }
            });

            // Allow navigation when clicking "Go to cart" button
            const goToCartBtn = flyoutCart.querySelector('.flyout-cart-cta');
            if (goToCartBtn) {
                goToCartBtn.addEventListener('click', function(e) {
                    window.location.href = '/Carts';
                });
            }

            // Keep open on hover
            cartWrapper.addEventListener('mouseenter', function() {
                if (isOpen) {
                    clearTimeout(hoverTimeout);
                }
            });

            cartWrapper.addEventListener('mouseleave', hideFlyout);
            flyoutCart.addEventListener('mouseenter', function() {
                clearTimeout(hoverTimeout);
            });
            flyoutCart.addEventListener('mouseleave', hideFlyout);

            // Close when clicking outside
            document.addEventListener('click', function(e) {
                if (isOpen &&
                    !cartWrapper.contains(e.target) &&
                    !flyoutCart.contains(e.target)) {
                    hideFlyout();
                }
            });
        }
    });
</script>