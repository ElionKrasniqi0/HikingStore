@model ProductCardModel
@inject IOptions<StoreSettings> StoreOptions
@{
    var store = StoreOptions.Value;
    var p = Model.Product;
    var images = p.AllImagePaths;
    var isNew = p.CreatedAt >= DateTime.UtcNow.AddDays(-30);
    var removeOnUnsave = ViewData["RemoveOnUnsave"] is true;
}
<article class="p-card">
    <a class="p-media" asp-controller="Home" asp-action="ProductDetailes" asp-route-id="@p.ProId" tabindex="-1" aria-hidden="true">
        @if (images.Count > 0)
        {
            <img src="~/Product/@images[0]" alt="" loading="lazy" decoding="async" width="400" height="500" />
            @if (images.Count > 1)
            {
                <img class="img-alt" src="~/Product/@images[1]" alt="" loading="lazy" decoding="async" width="400" height="500" />
            }
        }
        else
        {
            <span class="d-grid h-100 place-items-center text-muted" style="place-items:center"><i class="fa-solid fa-mountain fa-2x" aria-hidden="true"></i></span>
        }
    </a>
    <div class="p-badges">
        @if (!p.IsInStock)
        {
            <span class="badge-hs badge-out">Sold out</span>
        }
        else if (p.IsOnSale)
        {
            <span class="badge-hs badge-sale">−@p.DiscountPercent%</span>
        }
        @if (isNew && p.IsInStock)
        {
            <span class="badge-hs badge-new">New</span>
        }
    </div>
    <button type="button" class="p-wish" data-wishlist-toggle data-product-id="@p.ProId" data-remove-card="@(removeOnUnsave ? "true" : "false")"
            aria-pressed="@(Model.InWishlist ? "true" : "false")" aria-label="@(Model.InWishlist ? "Remove from" : "Add to") wishlist">
        <i class="@(Model.InWishlist ? "fa-solid" : "fa-regular") fa-heart" aria-hidden="true"></i>
    </button>
    <div class="p-body">
        @if (!string.IsNullOrEmpty(p.Brand))
        {
            <span class="p-brand">@p.Brand</span>
        }
        <a class="p-name" asp-controller="Home" asp-action="ProductDetailes" asp-route-id="@p.ProId">@p.ProName</a>
        <div class="price">
            <span class="now @(p.IsOnSale ? "on-sale" : "")">@store.FormatPrice(p.Price)</span>
            @if (p.IsOnSale)
            {
                <span class="was"><span class="visually-hidden">Was </span>@store.FormatPrice(p.CompareAtPrice!.Value)</span>
            }
        </div>
        @if (Model.ReviewCount > 0 && Model.AverageRating.HasValue)
        {
            <div class="p-meta">
                <partial name="_Stars" model="Model.AverageRating.Value" />
                <span>(@Model.ReviewCount)</span>
            </div>
        }
        @if (p.ColorOptions.Count > 1)
        {
            <div class="p-swatches">@p.ColorOptions.Count colours</div>
        }
    </div>
</article>
