@model PaymentRedirect
@{
    ViewData["Title"] = "Redirecting to secure payment";
    ViewData["NoIndex"] = true;
}

<div class="container-hs" style="max-width:640px">
    <section class="card-hs text-center py-5">
        <span class="spinner-border mb-3" style="color:var(--hs-forest);width:3rem;height:3rem" aria-hidden="true"></span>
        <h1 class="h3">Taking you to the secure payment page…</h1>
        <p class="text-muted">You'll enter your card details on the payment provider's page. HikingStore never sees your card number.</p>
        <form method="post" action="@Model.Url" id="provider-form" asp-antiforgery="false">
            @foreach (var field in Model.FormFields!)
            {
                <input type="hidden" name="@field.Key" value="@field.Value" />
            }
            <noscript><p>JavaScript is off — press the button to continue.</p></noscript>
            <button type="submit" class="btn btn-primary">Continue to payment</button>
        </form>
    </section>
</div>

@section Scripts {
    <script>document.getElementById('provider-form').submit();</script>
}
