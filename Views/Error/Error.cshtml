@{
    var code = ViewBag.ErrorCode as string;
    ViewData["Title"] = code ?? "Error";
    ViewData["NoIndex"] = true;
}

<div class="container-hs">
    <div class="empty-state" style="padding-top:var(--hs-space-8)">
        <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
        <h1 class="h2">@(code?.Split('-')[0].Trim() ?? "Error")</h1>
        <p>@(ViewBag.ErrorMessage ?? "Sorry, an error occurred while processing your request.")</p>
        <div class="d-flex flex-wrap justify-content-center gap-2">
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Home</a>
            <a class="btn btn-outline-primary" asp-controller="Home" asp-action="Shop">Shop all gear</a>
            <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Contact">Contact us</a>
        </div>

        @if (ViewBag.ExceptionMessage != null)
        {
            <div class="card-hs text-start mt-5 p-3 mx-auto" style="max-width:860px">
                <h2 class="h6 font-body fw-bold">Error details (development only)</h2>
                <p class="small mb-1"><strong>Path:</strong> <code>@ViewBag.ExceptionPath</code></p>
                <p class="small mb-1"><strong>Type:</strong> @ViewBag.ExceptionType</p>
                <p class="small mb-2"><strong>Message:</strong> @ViewBag.ExceptionMessage</p>
                <pre class="small mb-0" style="max-height:240px;overflow:auto;white-space:pre-wrap">@ViewBag.StackTrace</pre>
            </div>
        }
    </div>
</div>
