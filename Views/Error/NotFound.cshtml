@{
    ViewData["Title"] = "Page not found";
    ViewData["NoIndex"] = true;
}

<div class="container-hs">
    <div class="empty-state" style="padding-top:var(--hs-space-8)">
        <i class="fa-solid fa-route" aria-hidden="true"></i>
        <h1 class="h2">This trail doesn't go anywhere</h1>
        <p>The page you're looking for doesn't exist or has moved. Try a search, or head back to the shop.</p>
        <form method="get" asp-controller="Home" asp-action="Shop" role="search" class="d-flex gap-2 mx-auto mb-4" style="max-width:420px">
            <label for="nf-search" class="visually-hidden">Search products</label>
            <input id="nf-search" name="q" type="search" class="form-control" placeholder="Search gear" />
            <button class="btn btn-primary" type="submit" aria-label="Search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
        </form>
        <div class="d-flex flex-wrap justify-content-center gap-2">
            <a class="btn btn-outline-primary" asp-controller="Home" asp-action="Index">Home</a>
            <a class="btn btn-outline-primary" asp-controller="Home" asp-action="Shop">Shop all gear</a>
            <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Contact">Contact us</a>
        </div>
    </div>
</div>
